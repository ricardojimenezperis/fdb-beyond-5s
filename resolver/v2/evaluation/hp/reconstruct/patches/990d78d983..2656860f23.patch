+// Inside an active write batch, an internal node all of whose children are expired: every one is reclaimed and the
+// node itself goes with the last, in every arm, since the circular head never meets a live child.
+void bitmapCleanupBatchAllChildrenExpired() {
+    Tree tree(64, 0);
+    const std::vector<Version> cvs{1, 1, 1, 1};
+    auto* parent = bitmapParentOfLeaves(tree, cvs);
+    tree.validationMinRV_ = 1;
+    {
+        Tree::WriteBatchScope batch(tree);
+        CHECK(tree.purgeInsertionHead(parent));
+        CHECK(!parent->allocated);
+        CHECK(contents(tree).empty());
+    }
+    CHECK(!tree.retired_ && !tree.writeBatchActive_);
+    for (unsigned i = 0; i < cvs.size(); ++i) CHECK(!tree.hasConflict(1, sv(key(4 * i)), sv(key(4 * i + 1))));
+    verify(tree);
+}
