+void relaxedPressureFusion() {
+    for (unsigned limit : {Tree::Capacity - 1, Tree::Capacity}) {
+        Version cv = 10000000;
+        auto tree = filledTree(600, false, cv);
+        Tree::Node* left = tree->firstLeaf_;
+        while (left && (!left->parent || !left->navigation.leaf.next || left->parent != left->navigation.leaf.next->parent))
+            left = left->navigation.leaf.next;
+        CHECK(left);
+        auto* right = left->navigation.leaf.next;
+        unsigned a = limit / 2, b = limit - a;
+        shape(*tree, left, a, 1, cv);
+        shape(*tree, right, b, 1, cv);
+        checkTree(*tree);
+        CHECK(!tree->tryPressurePair(left, right, false));
+        tree->fictitious_.pressureMergedLimit = limit;
+        for (auto* x = tree->firstLeaf_; x; x = x->navigation.leaf.next) tree->markPair(x);
+        checkTree(*tree);
+        CHECK(!tree->fuseLeafNeighbour(left, false));
+        const auto before = tree->stats();
+        const auto leaves = tree->leafCount();
+        CHECK(tree->tryPressurePair(left, right, false));
+        CHECK(tree->leafCount() == leaves - 1 && left->size() == limit);
+        CHECK(tree->stats().fictitiousFusionConsumed == before.fictitiousFusionConsumed + 2);
+        CHECK(left->critical == (limit == Tree::Capacity));
+        checkTree(*tree);
+    }
+    Tree invalid(8, 0, memoryFor(8, false));
+    for (unsigned limit : {0u, 1u, Tree::Capacity + 1}) {
+        const Tree::FictitiousLeafConfig config = reserveConfig(R, limit);
+        bool caught = false;
+        try { invalid.configureFictitiousLeaves(config); } catch (const std::invalid_argument&) { caught = true; }
+        CHECK(caught);
+    }
+}
