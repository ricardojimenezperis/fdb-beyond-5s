diff --git a/fdbserver/resolver/btree/run-btree-tests.sh b/fdbserver/resolver/btree/run-btree-tests.sh
new file mode 100755
index 0000000000000000000000000000000000000000..445f08d884ff41bc91ac8669fd45737cb93f52e5
--- /dev/null
+++ b/fdbserver/resolver/btree/run-btree-tests.sh
@@ -0,0 +1,79 @@
+#!/usr/bin/env bash
+# Builds and runs the paged B+ conflict set's standalone battery against the real FDB
+# libraries, inside the project's own build image.
+#
+# Follows ../run-paged-tests.sh: the include flags are those the real build uses for
+# PagedBTreeConflictSet.cpp, read from build.ninja, and the battery links the build tree's
+# flow, fdbclient, fdbrpc and fdbserver_core. The existing component (PagedTemporalSkipList.cpp)
+# is compiled in once, for PagePool and TemporalHeap. The battery's main never enters the
+# Resolver library: this directory is not collected by fdb_find_sources.
+#
+#   usage: run-btree-tests.sh [build-dir]
+#
+#   The search counters are built in (PAGED_RESOLVER_SEARCH_STATS=1) unless BTREE_SEARCH_STATS=0:
+#   some cases check them when they are compiled. fdbserver builds them out unless its CMake
+#   option says otherwise
+#
+#   SANITIZE=1      -O1 -g with ASan and UBSan on the component, the skip list and the battery;
+#                   the FDB libraries and libc++ are not instrumented
+#   BTREE_SRC=dir   take PagedBTreeConflictSet.{h,cpp} from dir instead (mutation runs)
+#   BTREE_HEAP_SRC=dir  take PagedTemporalSkipList.{h,cpp}, the shared heap, from dir instead
+#   BTREE_TESTS=f   the battery source, by default tests/BTreeTests.cpp
+#   BTREE_TIMEOUT=s seconds before the battery is killed, 1800 by default
+#   BTREE_SEARCH_STATS=0  build the component without its diagnostic counters
+#   BTREE_FLAGS=...  extra compiler flags, e.g. -DPAGED_BTREE_WRITE_PREFETCH=0
+#   BTREE_SKIP_LIBS=1  do not bring the FDB libraries up to date first (parallel mutation runs,
+#                   which must not start several ninja processes in one build tree)
+set -euo pipefail
+
+HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+RESOLVER=$(dirname "$HERE")
+REPO=$(git -C "$HERE" rev-parse --show-toplevel)
+# The directory shared with the container: FDB_ROOT, or the top two levels of the repository path
+ROOT=${FDB_ROOT:-$(cut -d/ -f1-3 <<< "$REPO")}
+BUILD=${1:-$REPO-build}
+SRC=${BTREE_SRC:-$RESOLVER}
