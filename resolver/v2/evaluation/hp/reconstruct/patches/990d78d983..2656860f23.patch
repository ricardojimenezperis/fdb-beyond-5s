+++ b/fdbserver/resolver/by5mono/generate.cpp
@@ -0,0 +1,34 @@
+#include "../By5Monotonic.h"
+#include <filesystem>
+#include <iostream>
+static uint64_t number(const std::string& s){by5::require(!s.empty() && s[0]!='-',"invalid unsigned value");size_t used=0;auto n=std::stoull(s,&used);by5::require(used==s.size(),"invalid number");return n;}
+int main(int argc,char** argv){try{
+ std::string path;uint64_t prefixes=1,seconds=0,measure=300,seed=1;
+ for(int i=1;i<argc;i+=2){by5::require(i+1<argc,"option requires value");std::string a=argv[i],v=argv[i+1];
+  if(a=="--out")path=v;else if(a=="--prefixes")prefixes=number(v);else if(a=="--seconds")seconds=number(v);
+  else if(a=="--measure")measure=number(v);else if(a=="--seed")seed=number(v);else throw std::runtime_error("unknown option "+a);
+ }
+ by5::require(!path.empty() && prefixes<=16,"--out required, prefixes <= 16");
+ auto c=by5::monotonicConfig(uint32_t(prefixes),seconds,measure,seed);
+ by5::require(!std::filesystem::exists(path) && !std::filesystem::exists(path+".partial"),"output exists");
+ const uint64_t bytes=104+c.longAgesUs.size()*8+16+c.totalBatches()*c.batchSize*32;
+ auto parent=std::filesystem::path(path).parent_path();if(parent.empty())parent=".";
+ by5::require(std::filesystem::space(parent).available>bytes+64*1024*1024,"insufficient disk space for trace");
+ std::ofstream out(path+".partial",std::ios::binary);by5::writeHeader(out,c);by5::MonotonicGenerator gen(c);
+ uint64_t hash=14695981039346656037ULL;const uint64_t window=600*c.batchesPerSecond();
+ std::vector<uint64_t> windowConflicts,windowReads;
+ for(uint64_t b=0;b<c.totalBatches();++b){
+  if(b%window==0){windowConflicts.push_back(0);windowReads.push_back(0);}
+  for(const auto&t:gen.batch(b)){
+   by5::writeTransaction(out,t);windowConflicts.back()+=t.expectedConflict;windowReads.back()+=by5::hasRead(t.read);
+   for(auto v:{uint64_t(t.read.begin),uint64_t(t.read.end),uint64_t(t.write.begin),uint64_t(t.write.end),uint64_t(t.readVersion),uint64_t(t.ageClass),uint64_t(t.expectedConflict)})by5::hashWord(hash,v);
+  }
+  if(b && b%4096==0)std::cerr<<"batch="<<b<<" oracleSegments="<<gen.historySegments()<<"\n";
+ }
+ out.close();by5::require(bool(out),"trace close failed");std::filesystem::rename(path+".partial",path);
+ std::cout<<"trace="<<path<<" bytes="<<bytes<<" hash="<<std::hex<<hash<<std::dec<<" prefixes="<<c.prefixes<<" batches="<<c.totalBatches()
+          <<" conflicts="<<gen.conflicts<<" emptyReads="<<gen.emptyReads<<" clampedReads="<<gen.clampedReads<<" pointReads="<<gen.pointReads
+          <<" rangeReads="<<gen.rangeReads<<" pointRetries="<<gen.pointRetries<<" oracleSegments="<<gen.historySegments()<<"\n";
+ for(uint32_t p=0;p<c.prefixes;++p)std::cout<<"prefix="<<p<<" assignedKeys="<<gen.assignedPerPrefix[p]<<" acceptedInserts="<<gen.acceptedPerPrefix[p]<<" reads="<<gen.readsPerPrefix[p]<<"\n";
+ for(size_t w=0;w<windowConflicts.size();++w)std::cout<<"window="<<w*600<<"-"<<(w+1)*600<<" reads="<<windowReads[w]<<" conflicts="<<windowConflicts[w]<<" ppm="<<(windowReads[w]?windowConflicts[w]*1e6/windowReads[w]:0)<<"\n";
+}catch(const std::exception&e){std::cerr<<e.what()<<"\n";return 1;}}
