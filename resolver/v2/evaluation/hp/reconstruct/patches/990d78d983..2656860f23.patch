+void stableHintIncarnationSaturates() {
+    if constexpr (!Tree::InlineOnlyKeys || Tree::InlineKeyBytes < 4) return;
+    Tree tree(64, 0);
+    for (unsigned i = 0; i < 300; ++i) tree.addRange(1, sv(key(4 * i)), sv(key(4 * i + 2)));
+    Tree::Reservation reservation;
+    tree.reserve(reservation, 1);
+    Tree::Node* node = reservation.nodes[0];
+    node->incarnation = Tree::SaturatedIncarnation - 1;
+    tree.releaseReservation(reservation);
+    CHECK(node->incarnation == Tree::SaturatedIncarnation - 1);
+    tree.reserve(reservation, 1);
+    CHECK(reservation.nodes[0] == node && node->incarnation == Tree::SaturatedIncarnation);
+    tree.releaseReservation(reservation);
+    tree.reserve(reservation, 1);
+    CHECK(reservation.nodes[0] == node && node->incarnation == Tree::SaturatedIncarnation);
+    tree.releaseReservation(reservation);
+    CHECK(node->incarnation == Tree::SaturatedIncarnation);
+    // The saturated node becomes a leaf of the tree and receives writes normally
+    for (unsigned i = 0; i < 4000 && !node->allocated; ++i) tree.addRange(2, sv(key(100000 + 4 * i)), sv(key(100002 + 4 * i)));
+    CHECK(node->allocated && node->incarnation == Tree::SaturatedIncarnation);
+    std::printf("[saturated node back as %s] ", node->leaf ? "a leaf" : "an internal node");
+    CHECK(node->leaf);
+    {
+        const std::string begin = entryBytes(tree, node->at(0));
+        const auto stale = staleHints(tree);
+        CHECK(tree.resolveWriteHint(sv(begin), Tree::LeafHint{node, node->incarnation}) == tree.findLeaf(sv(begin)));
+        CHECK(tree.findLeaf(sv(begin)) == node);
+        if constexpr (Tree::Stats::searchEnabled) CHECK(staleHints(tree) == stale + 1);
+        tree.addRange(3, sv(begin), sv(begin + '\0'));
+        CHECK(tree.hasConflict(2, sv(begin), sv(begin + '\0')));
+    }
+    verify(tree);
+}
