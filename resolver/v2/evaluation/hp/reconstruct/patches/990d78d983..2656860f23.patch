+void mergeConservesReserve() {
+    Tree tree(256, 0, memoryFor(256, false));
+    tree.configureFictitiousLeaves(reserveConfig(R));
+    std::vector<std::string> keys(2001);
+    for (unsigned i = 0; i <= 2000; ++i) keys[i] = key(10 * i);
+    std::mt19937 random(9);
+    std::vector<unsigned> order(1000);
+    for (unsigned i = 0; i < 1000; ++i) order[i] = i;
+    std::shuffle(order.begin(), order.end(), random);
+    for (unsigned i = 0; i < 1000; ++i) {
+        Tree::Write w{ sv(keys[2 * order[i]]), sv(keys[2 * order[i] + 1]), ConflictKind::Range };
+        tree.addWrites(Version(i + 1), &w, 1);
+    }
+    tree.validationMinRV_ = 700;
+    Tree::Node* left = nullptr;
+    Tree::Node* right = nullptr;
+    for (Tree::Node* x = tree.firstLeaf_; x && !left; x = x->navigation.leaf.next) {
+        Tree::Node* y = x->navigation.leaf.next;
+        if (!y || y->parent != x->parent) continue;
+        unsigned a = 0, b = 0;
+        for (unsigned r = 0; r < x->size(); ++r) a += x->at(r).cv > 700;
+        for (unsigned r = 0; r < y->size(); ++r) b += y->at(r).cv > 700;
+        if (a && b && a + b + 3 <= tree.probFusion_.maxMergedEntries) { left = x; right = y; }
+    }
+    CHECK(left && right);
+    tree.purgeHead(left);
+    tree.purgeHead(right);
+    auto& s = tree.stats_;
+    s.fictitiousRetired += left->fict.fictitious + right->fict.fictitious;
+    tree.setFictitious(left, 0);
+    tree.setFictitious(right, 0);
+    s.fictitiousCreated += 3;
+    tree.setFictitious(left, 1);
+    tree.setFictitious(right, 2);
+    tree.refreshUp(left);
+    tree.refreshUp(right);
+    checkTree(tree);
+    const unsigned real = left->size() + right->size();
+    const uint64_t leaves = tree.leafCount();
+    CHECK(tree.fuseLeafNeighbour(left, false));
+    CHECK(tree.leafCount() == leaves - 1 && left->fict.fictitious == 3 && left->size() == real);
+    checkTree(tree);
+    for (unsigned r = 0; r < left->size(); ++r) left->at(r).cv = 600;
+    tree.purgeHead(left);
+    CHECK(!left->size());
+    const uint64_t retiredBefore = s.fictitiousRetired;
+    tree.removeEmpty(left);
+    CHECK(s.fictitiousRetired == retiredBefore + 3);
+    checkTree(tree);
+}
+
+using Item = std::tuple<std::string, std::string, Version>;
+
+std::vector<Item> snapshot(const Tree& tree) {
+    std::vector<Item> items;
+    for (const Tree::Node* leaf = tree.firstLeaf_; leaf; leaf = leaf->navigation.leaf.next)
+        for (unsigned rank = 0; rank < leaf->size(); ++rank)
+            items.emplace_back(beginOf(tree, leaf->at(rank)), endOf(tree, leaf->at(rank)), leaf->at(rank).cv);
+    return items;
+}
+
+void insertItem(std::vector<Item>& items, const Item& item) {
+    items.insert(std::upper_bound(items.begin(), items.end(), item), item);
+}
+
+std::unique_ptr<Tree> filledTree(unsigned writes, bool shuffled, Version& cv, bool fictitiousFromStart = true) {
+    auto tree = std::make_unique<Tree>(256, 0, memoryFor(256, false));
+    tree->configureFictitiousLeaves(reserveConfig(fictitiousFromStart ? R : 0));
+    std::vector<unsigned> order(writes);
+    for (unsigned i = 0; i < writes; ++i) order[i] = i;
+    if (shuffled) {
+        std::mt19937 random(17);
+        std::shuffle(order.begin(), order.end(), random);
+    }
+    for (unsigned i : order) {
+        const std::string a = key(1000 * i + 1000), b = key(1000 * i + 1001);
+        Tree::Write w{ sv(a), sv(b), ConflictKind::Range };
+        tree->addWrites(++cv, &w, 1);
+    }
+    if (!fictitiousFromStart) tree->fictitious_ = reserveConfig(R);
+    checkTree(*tree);
+    return tree;
+}
+
+void setFictitious(Tree& tree, Tree::Node* node, unsigned fictitious) {
+    auto& s = tree.stats_;
+    s.fictitiousRetired += node->fict.fictitious;
+    tree.setFictitious(node, 0);
+    s.fictitiousCreated += fictitious;
+    tree.setFictitious(node, fictitious);
+    tree.refreshUp(node);
+}
+
+void shape(Tree& tree, Tree::Node* node, unsigned real, unsigned fictitious, Version& cv) {
+    setFictitious(tree, node, 0);
+    const unsigned keep = real > 3 ? real - 3 : 1;
+    while (node->size() > keep) tree.eraseSlot(node, node->size() - 1);
+    while (node->size() < real) {
+        const uint64_t end = number(endOf(tree, node->at(node->size() - 1)));
+        const std::string a = key(end + 3), b = key(end + 6);
+        tree.insertSlot(node, node->size(), tree.prepareWrite(++cv, sv(a), sv(b)));
+    }
+    tree.refreshUp(node);
+    setFictitious(tree, node, fictitious);
+}
+
+struct Neighbourhood {
+    Tree::Node* left = nullptr;
+    Tree::Node* source = nullptr;
+    Tree::Node* right = nullptr;
+};
+
+Neighbourhood neighbourhood(Tree& tree, bool leftShared, bool rightShared, const std::function<bool(const Neighbourhood&)>& accept) {
+    for (Tree::Node* x = tree.firstLeaf_; x; x = x->navigation.leaf.next) {
+        const Neighbourhood n{ x->navigation.leaf.previous, x, x->navigation.leaf.next };
+        if (!n.left || !n.right || (n.left->parent == x->parent) != leftShared || (n.right->parent == x->parent) != rightShared) continue;
+        if (accept(n)) return n;
+    }
+    return {};
+}
+
+bool roomy(const Tree::Node* node) {
+    return Tree::Capacity - node->size() >= node->criticalChildren + 4;
+}
+
+bool shapeable(const Neighbourhood& n) {
+    const Tree::Node* parent = n.source->parent;
+    unsigned critical = 0;
+    for (unsigned rank = 0; rank < parent->size(); ++rank) {
+        const Tree::Node* child = parent->at(rank).payload.link.child;
+        critical += child != n.left && child != n.source && child != n.right && child->critical;
+    }
+    return Tree::Capacity - parent->size() >= critical + 3;
+}
+
+Tree::InsertCursor insertAtRank(Tree& tree, Tree::Node* leaf, unsigned rank, Version cv, Item& inserted) {
+    const uint64_t low = rank ? number(endOf(tree, leaf->at(rank - 1))) : number(beginOf(tree, leaf->at(0))) - 4;
+    if (rank < leaf->size()) CHECK(low + 2 < number(beginOf(tree, leaf->at(rank))));
+    const std::string begin = key(low + 1), end = key(low + 2);
+    inserted = Item{ begin, end, cv };
+    Tree::Reservation reservation;
+    const auto cursor = tree.insertAt({ leaf, rank }, tree.prepareWrite(cv, sv(begin), sv(end)), reservation);
+    tree.releaseReservation(reservation);
+    return cursor;
+}
+
+void redistributionRanks() {
+    constexpr unsigned C = Tree::Capacity;
+    for (unsigned direction = 0; direction < 2; ++direction)
+        for (unsigned rank = 0; rank <= C; ++rank) {
+            Version cv = 10000000;
+            auto tree = filledTree(600, false, cv);
+            const auto n = neighbourhood(*tree, true, true, shapeable);
+            CHECK(n.source);
+            shape(*tree, n.left, direction ? C : C - 3, 0, cv);
+            shape(*tree, n.right, direction ? C - 3 : C, 0, cv);
+            shape(*tree, n.source, C, 0, cv);
+            checkTree(*tree);
+            const auto s = tree->stats();
+            auto expected = snapshot(*tree);
+            Item inserted;
+            const auto cursor = insertAtRank(*tree, n.source, rank, ++cv, inserted);
+            insertItem(expected, inserted);
+            CHECK(snapshot(*tree) == expected);
+            const auto& t = tree->stats();
+            Tree::Node* target = direction ? n.right : n.left;
+            const bool moved = direction ? rank == C : rank == 0;
+            CHECK(t.splits == s.splits && t.fictitiousReleased == s.fictitiousReleased && t.redistIncomingMoved == s.redistIncomingMoved + moved);
+            CHECK(direction ? t.redistRightFree == s.redistRightFree + 1 && t.redistRejectedFull == s.redistRejectedFull + 1
+                            : t.redistLeftFree == s.redistLeftFree + 1 && t.redistRejectedFull == s.redistRejectedFull);
+            CHECK(n.source->size() == C && target->size() == C - 2);
+            CHECK(cursor.leaf == (moved ? target : n.source) && beginOf(*tree, cursor.leaf->at(cursor.rank - 1)) == std::get<0>(inserted));
+            if (moved) CHECK(cursor.rank == (direction ? 1 : target->size()));
+            checkTree(*tree);
+        }
+}
+
+void redistributionPriority() {
+    constexpr unsigned C = Tree::Capacity;
+    enum Outcome { Here, ConsumeHere, LeftFree, LeftFictitious, RightFree, RightFictitious, Split };
+    struct Case { unsigned sourceReal, sourceFictitious, leftReal, leftFictitious, rightReal, rightFictitious; Outcome outcome; };
+    const Case cases[] = {
+        { C - 3, 0, C, 0, C, 0, Here },
+        { C - 2, 2, C, 0, C, 0, ConsumeHere },
+        { C, 0, C - 3, 0, C - 3, 0, LeftFree },
+        { C, 0, C - 3, 3, C - 3, 0, LeftFictitious },
+        { C, 0, C, 0, C - 3, 0, RightFree },
+        { C, 0, C, 0, C - 3, 3, RightFictitious },
+        { C, 0, C, 0, C, 0, Split },
+    };
+    for (const auto& c : cases) {
+        Version cv = 10000000;
+        auto tree = filledTree(600, false, cv);
+        const auto n = neighbourhood(*tree, true, true, shapeable);
+        CHECK(n.source);
+        shape(*tree, n.left, c.leftReal, c.leftFictitious, cv);
+        shape(*tree, n.right, c.rightReal, c.rightFictitious, cv);
+        shape(*tree, n.source, c.sourceReal, c.sourceFictitious, cv);
+        checkTree(*tree);
+        const auto s = tree->stats();
+        auto expected = snapshot(*tree);
+        Item inserted;
+        insertAtRank(*tree, n.source, c.sourceReal / 2, ++cv, inserted);
+        insertItem(expected, inserted);
+        CHECK(snapshot(*tree) == expected);
+        const auto& t = tree->stats();
+        const bool left = c.outcome == LeftFree || c.outcome == LeftFictitious, right = c.outcome == RightFree || c.outcome == RightFictitious;
+        const bool consumed = c.outcome == ConsumeHere || c.outcome == LeftFictitious || c.outcome == RightFictitious;
+        CHECK(t.fictitiousReleased == s.fictitiousReleased + consumed);
+        CHECK(t.redistLeftFree == s.redistLeftFree + (c.outcome == LeftFree) && t.redistLeftFictitious == s.redistLeftFictitious + (c.outcome == LeftFictitious));
+        CHECK(t.redistRightFree == s.redistRightFree + (c.outcome == RightFree) && t.redistRightFictitious == s.redistRightFictitious + (c.outcome == RightFictitious));
+        const uint64_t rejected = t.redistRejectedFull - s.redistRejectedFull;
+        CHECK(c.outcome == Split ? rejected >= 2 && rejected % 2 == 0 : rejected == right);
+        CHECK(t.splits == s.splits + (c.outcome == Split));
+        if (c.outcome != Split) {
+            CHECK(n.left->size() == c.leftReal + left && n.right->size() == c.rightReal + right);
+            CHECK(n.left->fict.fictitious == c.leftFictitious - (c.outcome == LeftFictitious));
+            CHECK(n.right->fict.fictitious == c.rightFictitious - (c.outcome == RightFictitious));
+            CHECK(n.source->size() == c.sourceReal + (c.outcome == Here || c.outcome == ConsumeHere));
+            CHECK(n.source->fict.fictitious == c.sourceFictitious - (c.outcome == ConsumeHere));
+        }
+        checkTree(*tree);
+    }
+}
