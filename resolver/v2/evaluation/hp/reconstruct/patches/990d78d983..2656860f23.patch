+void splitMaxCVKeepsExactAgeOrder() {
+    PagePool pool(1);
+    pool.configureNodeAges(0, 64, 3);
+    auto* raw = pool.tryAcquire(PageUse::Index);
+    pool.registerNodePage(raw);
+    auto* a = new (raw->bytes) ReclaimLink;
+    auto* b = new (raw->bytes + 64) ReclaimLink;
+    auto* c = new (raw->bytes + 128) ReclaimLink;
+    for (auto* link : {a,b,c}) link->ageIndex = pool.nodeAgeIndex(link);
+    pool.raiseAge(a, 20, PageUse::Index);
+    pool.raiseAge(b, 30, PageUse::Index);
+    pool.raiseAge(c, 40, PageUse::Index);
+    b->incarnation = 71;
+    pool.lowerNodeAgeAfterSplit(b, 25);
+    CHECK(b->maxCV == 25 && pool.ageCV(b) == 25 && pool.exceptionAgeCount() == 0);
+    CHECK(pool.oldestAge() == a && pool.nextAge(a) == b && pool.nextAge(b) == c);
+    pool.lowerNodeAgeAfterSplit(b, 5);
+    CHECK(b->maxCV == 5 && pool.ageCV(b) == 5 && b->incarnation == 71 && pool.exceptionAgeCount() == 1);
+    CHECK(pool.oldestAge() == b && pool.oldestAgeCV() == 5 && pool.nextAge(b) == a && pool.nextAge(a) == c);
+    CHECK(!pool.previousAge(b) && pool.previousAge(a) == b && pool.previousAge(c) == a && !pool.nextAge(c));
+    pool.raiseAge(b, 5, PageUse::Index);
+    CHECK(pool.oldestAge() == b && pool.nextAge(b) == a);
+    pool.raiseAge(b, 10, PageUse::Index);
+    CHECK(b->maxCV == 10 && pool.ageCV(b) == 10 && b->incarnation == 71 && pool.exceptionAgeCount() == 1);
+    CHECK(pool.oldestAge() == b && pool.nextAge(b) == a && pool.nextAge(a) == c);
+    pool.raiseAge(b, 35, PageUse::Index);
+    CHECK(pool.exceptionAgeCount() == 1 && pool.oldestAge() == a && pool.nextAge(a) == b && pool.nextAge(b) == c);
+    pool.raiseAge(b, 45, PageUse::Index);
+    CHECK(pool.exceptionAgeCount() == 0 && pool.nextAge(c) == b && !pool.nextAge(b) && pool.previousAge(b) == c);
+    pool.unlinkAge(a); pool.unlinkAge(b); pool.unlinkAge(c);
+    CHECK(pool.exceptionAgeCount() == 0 && !pool.oldestAge());
+}
