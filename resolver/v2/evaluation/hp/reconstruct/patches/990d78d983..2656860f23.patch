+void cleanupBudgetsAndQueues() {
+    Tree tree(512, 0);
+    tree.configureFictitiousLeaves({ 0, 0 });
+    std::vector<unsigned> order(3000);
+    for (unsigned i = 0; i < order.size(); ++i) order[i] = i;
+    std::shuffle(order.begin(), order.end(), std::mt19937(21));
+    for (unsigned i : order) if (i % 2) tree.addRange(1, sv(key(2 * i)), sv(key(2 * i + 1)));
+    for (unsigned i : order) if (i % 2 == 0) tree.addRange(2, sv(key(2 * i)), sv(key(2 * i + 1)));
+    tree.validationMinRV_ = 1;
+    for (unsigned budget : {0U, 1U, 3U, 17U}) {
+        const auto before = tree.stats();
+        const auto leaves = tree.leafCount_;
+        tree.cleanup(budget, 0, false);
+        CHECK(tree.stats().cleanupLeavesVisited == before.cleanupLeavesVisited && tree.leafCount_ == leaves);
+        CHECK(tree.stats().expiredIntervals == before.expiredIntervals);
+        CHECK(tree.stats().mergeCandidatesExamined == before.mergeCandidatesExamined);
+        CHECK(tree.stats().merges == before.merges && tree.stats().merges == 0);
+        verify(tree);
+    }
+    drainExpired(tree);
+    // Merge candidates examined: never more than the budget
+    for (unsigned candidates : {0U, 1U, 2U, 5U, 40U}) {
+        const auto before = tree.stats();
+        tree.cleanup(0, candidates, true);
+        CHECK(tree.stats().mergeCandidatesExamined == before.mergeCandidatesExamined);
+        verify(tree);
+    }
+    CHECK(tree.stats().merges == 0);
+    // Everything expires; draining removes empty ancestors and contracts the root to nothing
+    tree.validationMinRV_ = 2;
+    drainExpired(tree);
+    for (unsigned pass = 0; pass < 1000 && tree.root_; ++pass) {
+        tree.cleanup(7, 3, pass % 2 == 0);
+        verify(tree);
+    }
+    CHECK(!tree.root_ && tree.nodeCount() == 0 && tree.leafCount() == 0 && tree.freeNodes_ + tree.keyBlockCount() == tree.budget().indexPages * tree.nodesPerPage());
+
+    // A full leaf is critical; once cleanup removes some of its entries it is not, and its
+    // ancestors count it no longer
+    Tree full(16, 0);
+    for (unsigned i = 1; i < 400; i += 2) full.addRange(1, sv(key(4 * i)), sv(key(4 * i + 1)));
+    for (unsigned i = 0; i < 400; i += 2) full.addRange(2, sv(key(4 * i)), sv(key(4 * i + 1)));
+    Tree::Node* leaf = full.firstLeaf_;
+    const std::string base = entryBytes(full, leaf->at(0), true);
+    for (char suffix = 1; leaf->size() < Tree::Capacity && suffix < 64; ++suffix)
+        full.addRange(2, sv(base + suffix), sv(base + suffix + '\x01'));
+    CHECK(leaf->size() == Tree::Capacity && leaf->critical && leaf->parent);
+    verify(full);
+    full.validationMinRV_ = 1;
+    purgeExpired(full, leaf);
+    CHECK(leaf->allocated && leaf->size() < Tree::Capacity && !leaf->critical);
+    verify(full);
+}
