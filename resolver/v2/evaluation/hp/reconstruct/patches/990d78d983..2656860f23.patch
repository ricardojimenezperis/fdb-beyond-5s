+void inlineComparisonBoundaries() {
+    Tree tree(64, 0);
+    std::vector<std::string> keys = {"", std::string(1, '\0'), std::string(1, '\xff')};
+    const size_t k = Tree::InlineKeyBytes;
+    for (size_t n : {size_t{0}, k ? k - 1 : 0, k, k + 1, k + 9}) {
+        for (unsigned char byte : {0, 1, 127, 255}) {
+            std::string value(n, static_cast<char>(byte));
+            keys.push_back(value);
+            keys.push_back(value + '\0');
+            keys.push_back(value + '\xff');
+            if (n) { value.back() ^= 1; keys.push_back(value); }
+        }
+    }
+    auto sign = [](int value) { return (value > 0) - (value < 0); };
+    for (const auto& lhs : keys) {
+        const std::string end = lhs + '\0';
+        const auto record = tree.heap_.appendRange(1, sv(lhs), sv(end));
+        CHECK(record.present());
+        Tree::Entry entry;
+        entry.begin = {record.get().pageID,
+                       record.get().offset + static_cast<uint32_t>(sizeof(RangeConflictHeader)),
+                       static_cast<uint32_t>(lhs.size())};
+        Tree::cacheKey(entry.beginInline, sv(lhs));
+        for (const auto& rhs : keys) {
+            const int expected = (sv(rhs) < sv(lhs)) - (sv(lhs) < sv(rhs));
+#if PAGED_RESOLVER_SEARCH_STATS
+            const size_t common = std::min(lhs.size(), rhs.size());
+            const size_t local = std::min(common, k);
+            const bool resolved = common <= k || (local && std::memcmp(lhs.data(), rhs.data(), local));
+            const auto before = tree.stats();
+#endif
+            const uint8_t* cached = nullptr;
+            CHECK(sign(tree.compareBegin(entry, sv(rhs), &cached)) == expected);
+#if PAGED_RESOLVER_SEARCH_STATS
+            CHECK(tree.stats().heapKeyLoads - before.heapKeyLoads == (resolved ? 0 : 1));
+#endif
+#if PAGED_RESOLVER_SEARCH_STATS
+            CHECK(tree.stats().keyComparisonFallbacks - before.keyComparisonFallbacks == (resolved ? 0 : 1));
+#endif
+            CHECK(sign(tree.compareBegin(entry, sv(rhs), &cached)) == expected);
+#if PAGED_RESOLVER_SEARCH_STATS
+            CHECK(tree.stats().heapKeyLoads - before.heapKeyLoads == (resolved ? 0 : 1));
