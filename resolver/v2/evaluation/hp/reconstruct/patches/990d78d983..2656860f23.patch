-	BNodeHeader* sibling;
-	if (node->kind == BNodeKind::Internal) {
-		sibling = &splitInternal(reinterpret_cast<InternalBlock*>(node), cv)->header;
-	} else {
-		assert(leaf == reinterpret_cast<LeafBlock*>(node));
-		sibling = &splitLeaf(leaf, rank, found, cv)->header;
-	}
