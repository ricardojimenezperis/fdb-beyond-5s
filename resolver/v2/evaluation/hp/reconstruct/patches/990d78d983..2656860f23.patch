+void commonAgeOrderingAndInheritance() {
+    PagePool pool(1);
+    pool.configureNodeAges(0, 64, 4);
+    auto* raw = pool.tryAcquire(PageUse::Index);
+    pool.registerNodePage(raw);
+    auto& a = *new (raw->bytes) ReclaimLink;
+    auto& b = *new (raw->bytes + 64) ReclaimLink;
+    auto& c = *new (raw->bytes + 128) ReclaimLink;
+    auto& sibling = *new (raw->bytes + 192) ReclaimLink;
+    for (auto* link : {&a, &b, &c, &sibling}) link->ageIndex = pool.nodeAgeIndex(link);
+    pool.raiseAge(&a, 10, PageUse::Index);
+    pool.raiseAge(&b, 20, PageUse::Heap);
+    pool.raiseAge(&c, 30, PageUse::Index);
+    pool.inheritAge(&sibling, &a, PageUse::Index);
+    CHECK(pool.oldestAge() == &a && pool.nextAge(&a) == &sibling && pool.nextAge(&sibling) == &b);
+    CHECK(sibling.maxCV == 10 && pool.previousAge(&sibling) == &a);
+    pool.raiseAge(&a, 40, PageUse::Index);
+    CHECK(pool.oldestAge() == &sibling && pool.nextAge(&c) == &a && !pool.nextAge(&a));
+    pool.raiseAge(&b, 20, PageUse::Heap);
+    CHECK(pool.nextAge(&sibling) == &b && pool.nextAge(&b) == &c); // unchanged CV does not move
+    pool.inheritAge(&sibling, &c, PageUse::Index);
+    CHECK(pool.oldestAge() == &b && pool.nextAge(&c) == &sibling && pool.nextAge(&sibling) == &a);
+    CHECK(pool.ageCV(&sibling) == 30 && pool.ageCV(&a) == 40);
+    CHECK(sibling.maxCV == 30); // inherited old bound stays before 40
+    pool.unlinkAge(&b); pool.unlinkAge(&sibling); pool.unlinkAge(&a); pool.unlinkAge(&c);
+    CHECK(!pool.oldestAge());
+    CHECK(!a.ageLinked && !pool.nextAge(&a) && !pool.previousAge(&a));
+}
