+    std::vector<std::string> keys(200001);
+    for (unsigned i = 0; i <= 200000; ++i) keys[i] = key(i);
+    Version cv = 10000000;
+    const auto& s = tree.stats();
+    for (unsigned i = 0; i < 100000 && !s.reclaimAgeCandidates; ++i) {
+        Tree::Write w{ sv(keys[2 * i]), sv(keys[2 * i + 1]), ConflictKind::Range };
+        const Version floor = tree.validationMinRV();
+        const uint64_t ages = s.reclaimAgeCandidates;
+        tree.addWrites(++cv, &w, 1);
+        if (tree.validationMinRV() != floor) CHECK(s.reclaimAgeCandidates > ages);
+    }
+    CHECK(s.reclaimAgeCandidates > 0 && s.pressureFallbacks > 0);
+    checkTree(tree);
+    std::printf("[pressure=%llu fallbacks=%llu inspectedMax=%llu ages=%llu floor=%lld] ", (unsigned long long)s.pressureEvents,
+                (unsigned long long)s.pressureFallbacks, (unsigned long long)s.pressureCandidatesMax, (unsigned long long)s.reclaimAgeCandidates,
+                (long long)tree.validationMinRV());
+}
