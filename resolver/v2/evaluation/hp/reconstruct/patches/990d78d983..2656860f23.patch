+// The incarnation saturates instead of wrapping: the node keeps working, but no hint to it is trusted
+void stableHintLeafReusedAsKeyBlock() {
+    Tree tree(64, 0);
+    for (unsigned i = 0; i < 300; ++i) tree.addRange(1, sv(key(4 * i)), sv(key(4 * i + 2)));
+    Tree::Node* victim = middleLeaf(tree);
+    const Tree::LeafHint hint{victim, victim->incarnation};
+    const std::string begin = entryBytes(tree, victim->at(0));
+    while (victim->size()) tree.eraseSlot(victim, 0);
+    tree.removeEmpty(victim);
+    CHECK(!victim->allocated && tree.free_ == victim && victim->incarnation == hint.incarnation);
+    const auto blocks = tree.keyBlockCount();
+    auto* block = Tree::acquireKeyBlock(&tree);
+    CHECK(Tree::keyBlockOwner(block) == victim && !victim->allocated && victim->incarnation == hint.incarnation + 1);
+    Tree::raiseKeyBlock(&tree, block, 1);
+    CHECK(tree.keyBlockCount() == blocks + 1 && Tree::findKeyBlock(&tree, block->id) == block);
+    const auto stale = staleHints(tree);
+    CHECK(tree.resolveWriteHint(sv(begin), hint) == tree.findLeaf(sv(begin)));
+    if constexpr (Tree::Stats::searchEnabled) CHECK(staleHints(tree) == stale + 1);
+    Tree::releaseKeyBlock(&tree, block);
+    CHECK(tree.keyBlockCount() == blocks);
+    tree.addRange(2, sv(begin), sv(key(4 * 300)));
+    CHECK(tree.hasConflict(1, sv(begin), sv(key(4 * 300))));
+    verify(tree);
+}
