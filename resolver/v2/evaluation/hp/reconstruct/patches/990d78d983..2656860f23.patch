+bool contains(const std::vector<const Tree::Node*>& nodes, const Tree::Node* node) {
+    return std::find(nodes.begin(), nodes.end(), node) != nodes.end();
+}
+
+bool makeCritical(Tree& tree, Tree::Node* node, const std::vector<const Tree::Node*>& keep) {
+    if (node->critical) return true;
+    if (contains(keep, node) || !node->size()) return false;
+    if (node->leaf) {
+        setFictitious(tree, node, Tree::Capacity - node->size());
+        return true;
+    }
+    for (unsigned rank = 0; rank < node->size() && !node->critical; ++rank) makeCritical(tree, node->at(rank).payload.link.child, keep);
+    return node->critical;
+}
+
+bool tighten(Tree& tree, Tree::Node* parent, unsigned criticalChildren, const std::vector<const Tree::Node*>& keep) {
+    for (unsigned rank = 0; rank < parent->size() && parent->criticalChildren < criticalChildren; ++rank)
+        makeCritical(tree, parent->at(rank).payload.link.child, keep);
+    return parent->criticalChildren == criticalChildren;
+}
+
+unsigned criticalAfterShape(const Tree::Node* parent, const Tree::Node* left, const Tree::Node* source, const Tree::Node* right, bool rightFull) {
+    unsigned count = 0;
+    for (unsigned rank = 0; rank < parent->size(); ++rank) {
+        const Tree::Node* child = parent->at(rank).payload.link.child;
+        if (child == left) continue;
+        count += child == source ? 1 : child == right ? rightFull : child->critical;
+    }
+    return count;
+}
+
+unsigned criticalReach(const Tree::Node* parent, const std::vector<const Tree::Node*>& keep) {
+    unsigned count = 0;
+    for (unsigned rank = 0; rank < parent->size(); ++rank) {
+        const Tree::Node* child = parent->at(rank).payload.link.child;
+        count += child->critical || (!contains(keep, child) && 2 * child->size() >= Tree::Capacity);
+    }
+    return count;
+}
+
+struct SlackCase {
+    const char* name;
+    bool leftShared, rightShared;
+    unsigned rightReal;
+    int parentSlack;
+    bool grandparentCritical;
+    bool acceptLeft;
+};
+
+void runSlackCase(const SlackCase& c) {
+    constexpr unsigned C = Tree::Capacity;
+    Version cv = 10000000;
+    const auto accept = [&](const Neighbourhood& x) {
+        const Tree::Node* p = x.left->parent;
+        const unsigned size = p->size(), base = criticalAfterShape(p, x.left, x.source, x.right, c.rightReal == C);
+        if (c.parentSlack > 1 && C - size < base + 2) return false;
+        if (c.parentSlack <= 1) {
+            const unsigned target = C - size - (c.parentSlack == 1);
+            if (C - size < 1u + (c.parentSlack == 1) || base > target || target > size - 2 + (c.rightReal == C)) return false;
+        }
+        if (x.source->parent != p && !roomy(x.source->parent)) return false;
+        const Tree::Node* g = p->parent;
+        if (!c.grandparentCritical) return !g || roomy(g);
+        if (!g || (g->parent && !roomy(g->parent))) return false;
+        return C - g->size() <= criticalReach(g, { p, x.source->parent });
+    };
+    std::unique_ptr<Tree> tree;
+    Neighbourhood n;
+    for (unsigned writes : { 20000u, 40000u, 60000u }) {
+        for (bool shuffled : { true, false }) {
+            cv = 10000000;
+            tree = filledTree(writes, shuffled, cv, false);
+            n = neighbourhood(*tree, c.leftShared, c.rightShared, accept);
+            if (n.source) break;
+        }
+        if (n.source) break;
+    }
+    CHECK(n.source);
+    Tree::Node* p = n.left->parent;
+    shape(*tree, n.left, C - 1, 0, cv);
+    shape(*tree, n.right, c.rightReal, 0, cv);
+    shape(*tree, n.source, C, 0, cv);
+    const std::vector<const Tree::Node*> keep{ n.left, n.right, n.source, p, n.source->parent };
+    if (c.parentSlack <= 1) CHECK(tighten(*tree, p, C - p->size() - (c.parentSlack == 1), keep));
+    CHECK(p->critical == (c.parentSlack < 0));
+    if (c.grandparentCritical) {
+        Tree::Node* g = p->parent;
+        CHECK(tighten(*tree, g, C - g->size(), keep) && g->critical && !p->critical);
+    }
+    checkTree(*tree);
+    CHECK(tree->promotionSafe(n.left) == c.acceptLeft);
+    const auto s = tree->stats();
+    auto expected = snapshot(*tree);
+    Item inserted;
+    insertAtRank(*tree, n.source, C / 2, ++cv, inserted);
+    insertItem(expected, inserted);
+    CHECK(snapshot(*tree) == expected);
+    const auto& t = tree->stats();
+    const bool rightRoom = c.rightReal < C - 1;
+    CHECK(t.redistLeftFree == s.redistLeftFree + c.acceptLeft);
+    const uint64_t rejected = t.redistRejectedSlack - s.redistRejectedSlack;
+    CHECK(!c.acceptLeft && !rightRoom ? rejected >= 1 : rejected == !c.acceptLeft);
+    CHECK(t.redistRightFree == s.redistRightFree + (!c.acceptLeft && rightRoom));
+    CHECK(t.splits == s.splits + (!c.acceptLeft && !rightRoom));
+    CHECK(t.redistCrossParent == s.redistCrossParent + (c.acceptLeft ? !c.leftShared : rightRoom && !c.rightShared));
+    if (c.acceptLeft) CHECK(n.left->critical && n.left->size() == C);
+    if (c.acceptLeft && c.parentSlack == 1) CHECK(p->critical);
+    std::printf("[%s parent=%u/%u] ", c.name, p->size(), p->criticalChildren);
+    checkTree(*tree);
+}
+
+void redistributionSlack() {
+    constexpr unsigned C = Tree::Capacity;
+    const SlackCase cases[] = {
+        { "sharedRoomy", true, true, C, 4, false, true },
+        { "sharedPromotes", true, true, C, 1, false, true },
+        { "sharedCriticalParent", true, true, C - 3, -1, false, false },
+        { "sharedGrandparent", true, true, C, 1, true, false },
+        { "crossRoomy", false, true, C, 4, false, true },
+        { "crossCriticalParent", false, true, C - 3, -1, false, false },
+        { "crossGrandparent", false, true, C - 3, 1, true, false },
+        { "crossRight", true, false, C - 3, -1, false, false },
+    };
+    for (const auto& c : cases) runSlackCase(c);
+}
