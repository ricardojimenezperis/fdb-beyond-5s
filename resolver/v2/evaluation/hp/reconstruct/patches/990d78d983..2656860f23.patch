@@ -0,0 +1,193 @@
+bool PagePool::ageException(uint32_t id) const {
+    return ageEntry(id).previous == id;
+}
+bool PagePool::exceptionLess(uint32_t a, uint32_t b) const {
+    const Version av = ageEntry(a).maxCV, bv = ageEntry(b).maxCV;
+    return av < bv || (av == bv && a < b);
+}
+void PagePool::exceptionSwap(size_t a, size_t b) {
+    std::swap(exceptionAges_[a], exceptionAges_[b]);
+    ageEntry(exceptionAges_[a]).next = static_cast<uint32_t>(a);
+    ageEntry(exceptionAges_[b]).next = static_cast<uint32_t>(b);
+    ++exceptionStats_.swaps;
+}
+void PagePool::exceptionRepair(size_t pos) {
+    while (pos && exceptionLess(exceptionAges_[pos], exceptionAges_[(pos - 1) / 2])) {
+        const size_t parent = (pos - 1) / 2;
+        exceptionSwap(pos, parent);
+        pos = parent;
+    }
+    for (;;) {
+        const size_t left = pos * 2 + 1;
+        if (left >= exceptionAges_.size()) break;
+        const size_t right = left + 1;
+        const size_t best = right < exceptionAges_.size() &&
+            exceptionLess(exceptionAges_[right], exceptionAges_[left]) ? right : left;
+        if (!exceptionLess(exceptionAges_[best], exceptionAges_[pos])) break;
+        exceptionSwap(pos, best);
+        pos = best;
+    }
+}
+void PagePool::reserveExceptionSlot() {
+    if (exceptionAges_.size() == exceptionAges_.capacity()) {
+        if (exceptionAges_.size() >= NoAge - 1) throw std::length_error("exception age capacity");
+        const size_t capacity = std::min<size_t>(NoAge - 1,
+            std::max<size_t>(8, exceptionAges_.capacity() * 2));
+        exceptionAges_.reserve(capacity);
+    }
+}
+void PagePool::insertException(uint32_t id) {
+    ASSERT(exceptionAges_.size() < exceptionAges_.capacity());
+    auto& entry = ageEntry(id);
+    entry.previous = id;
+    entry.next = static_cast<uint32_t>(exceptionAges_.size());
+    exceptionAges_.push_back(id);
+    exceptionRepair(exceptionAges_.size() - 1);
+    ++exceptionStats_.insertions;
+    exceptionStats_.peak = std::max<uint64_t>(exceptionStats_.peak, exceptionAges_.size());
+}
+void PagePool::eraseException(uint32_t id) {
+    const size_t pos = ageEntry(id).next;
+    ASSERT(pos < exceptionAges_.size() && exceptionAges_[pos] == id);
+    const uint32_t last = exceptionAges_.back();
+    exceptionAges_.pop_back();
+    if (pos < exceptionAges_.size()) {
+        exceptionAges_[pos] = last;
+        ageEntry(last).next = static_cast<uint32_t>(pos);
+        exceptionRepair(pos);
+    }
+    ageEntry(id).previous = ageEntry(id).next = NoAge;
+    ++exceptionStats_.removals;
+}
+void PagePool::appendMainAge(uint32_t id) {
+    auto& entry = ageEntry(id);
+    ASSERT(newestAge_ == NoAge || ageEntry(newestAge_).maxCV <= entry.maxCV);
+    entry.previous = newestAge_;
+    entry.next = NoAge;
+    if (newestAge_ != NoAge) ageEntry(newestAge_).next = id;
+    else oldestAge_ = id;
+    newestAge_ = id;
+}
+ReclaimLink* PagePool::oldestAge() const {
+    if (exceptionAges_.empty()) return ageObject(oldestAge_);
+    const uint32_t top = exceptionAges_.front();
+    if (oldestAge_ == NoAge || ageEntry(top).maxCV < ageEntry(oldestAge_).maxCV)
+        return ageObject(top);
+    return ageObject(oldestAge_);
+}
+ReclaimLink* PagePool::adjacentAge(const ReclaimLink* link, bool forward) const {
+    if (!link->ageLinked) return nullptr;
+    size_t ordinal = 0, currentOrdinal = 0;
+    bool found = false;
+    auto locate = [&](uint32_t id) {
+        if (id == link->ageIndex) { currentOrdinal = ordinal; found = true; }
+        ++ordinal;
+    };
+    for (uint32_t id = oldestAge_; id != NoAge; id = ageEntry(id).next) locate(id);
+    for (uint32_t id : exceptionAges_) locate(id);
+    ASSERT(found);
+    const Version currentCV = ageEntry(link->ageIndex).maxCV;
+    uint32_t best = NoAge;
+    Version bestCV = 0;
+    size_t bestOrdinal = 0;
+    ordinal = 0;
+    auto visit = [&](uint32_t id) {
+        const Version cv = ageEntry(id).maxCV;
+        const bool after = cv > currentCV || (cv == currentCV && ordinal > currentOrdinal);
+        const bool before = cv < currentCV || (cv == currentCV && ordinal < currentOrdinal);
+        const bool eligible = forward ? after : before;
+        const bool better = best == NoAge || (forward
+            ? (cv < bestCV || (cv == bestCV && ordinal < bestOrdinal))
+            : (cv > bestCV || (cv == bestCV && ordinal > bestOrdinal)));
+        if (eligible && better) { best = id; bestCV = cv; bestOrdinal = ordinal; }
+        ++ordinal;
+    };
+    for (uint32_t id = oldestAge_; id != NoAge; id = ageEntry(id).next) visit(id);
+    for (uint32_t id : exceptionAges_) visit(id);
+    return ageObject(best);
+}
+ReclaimLink* PagePool::nextAge(const ReclaimLink* link) const { return adjacentAge(link, true); }
+ReclaimLink* PagePool::previousAge(const ReclaimLink* link) const { return adjacentAge(link, false); }
+Version PagePool::oldestAgeCV() const {
+    const auto* link = oldestAge();
+    ASSERT(link);
+    return ageEntry(link->ageIndex).maxCV;
+}
+size_t PagePool::ageMetadataBytes() const {
+    return nodeAges_.capacity() * sizeof(AgeEntry)
+        + (pageAgeBlocks_.capacity() + nodeBlockPages_.capacity() + freeAgeBlocks_.capacity()) * sizeof(uint32_t)
+        + exceptionAgeMetadataBytes();
+}
+void PagePool::unlinkAge(ReclaimLink* link) {
+    if (!link->ageLinked) return;
+    auto& entry = ageEntry(link->ageIndex);
+    if (ageException(link->ageIndex)) eraseException(link->ageIndex);
+    else {
+        if (entry.previous != NoAge) ageEntry(entry.previous).next = entry.next;
+        else oldestAge_ = entry.next;
+        if (entry.next != NoAge) ageEntry(entry.next).previous = entry.previous;
+        else newestAge_ = entry.previous;
+        entry.previous = entry.next = NoAge;
+    }
+    link->ageLinked = false;
+}
+void PagePool::raiseAge(ReclaimLink* link, Version cv, PageUse use) {
+    if (link->ageLinked && cv <= link->maxCV) return;
+    ASSERT(cv >= link->maxCV);
+    ensureAgeIndex(link, use);
+    const bool exceptional = newestAge_ != NoAge && cv < ageEntry(newestAge_).maxCV;
+    if (exceptional && link->ageLinked && ageException(link->ageIndex)) {
+        link->maxCV = ageEntry(link->ageIndex).maxCV = cv;
+        link->ageUse = use;
+        exceptionRepair(ageEntry(link->ageIndex).next);
+        ++exceptionStats_.updates;
+        return;
+    }
+    if (exceptional) reserveExceptionSlot();
+    unlinkAge(link);
+    link->maxCV = cv; link->ageUse = use;
+    ageEntry(link->ageIndex).maxCV = cv;
+    if (exceptional) insertException(link->ageIndex);
+    else appendMainAge(link->ageIndex);
+    link->ageLinked = true;
+}
+void PagePool::lowerNodeAgeAfterSplit(ReclaimLink* link, Version cv) {
+    ASSERT(link->ageLinked && link->ageUse == PageUse::Index);
+    auto& entry = ageEntry(link->ageIndex);
+    ASSERT(entry.maxCV == link->maxCV && cv <= link->maxCV);
+    if (cv == link->maxCV) return;
+    if (ageException(link->ageIndex)) {
+        link->maxCV = entry.maxCV = cv;
+        exceptionRepair(entry.next);
+        ++exceptionStats_.updates;
+        return;
+    }
+    if (entry.previous == NoAge || ageEntry(entry.previous).maxCV <= cv) {
+        link->maxCV = entry.maxCV = cv;
+        return;
+    }
+    reserveExceptionSlot();
+    unlinkAge(link);
+    link->maxCV = entry.maxCV = cv;
+    insertException(link->ageIndex);
+    link->ageLinked = true;
+}
+void PagePool::inheritAge(ReclaimLink* link, const ReclaimLink* source, PageUse use) {
+    ASSERT(source != link && source->ageLinked);
+    ensureAgeIndex(link, use);
+    const bool exceptional = ageException(source->ageIndex);
+    if (exceptional) reserveExceptionSlot();
+    unlinkAge(link);
+    auto& entry = ageEntry(link->ageIndex);
+    const Version cv = ageEntry(source->ageIndex).maxCV;
+    link->maxCV = entry.maxCV = cv; link->ageUse = use;
+    if (exceptional) insertException(link->ageIndex);
+    else {
+        auto& previous = ageEntry(source->ageIndex);
+        entry.previous = source->ageIndex; entry.next = previous.next;
+        if (entry.next != NoAge) ageEntry(entry.next).previous = link->ageIndex;
+        else newestAge_ = link->ageIndex;
+        previous.next = link->ageIndex;
+    }
+    link->ageLinked = true;
+}
diff --git a/fdbserver/resolver/LocalFictitious.h b/fdbserver/resolver/LocalFictitious.h
new file mode 100644
index 0000000000000000000000000000000000000000..fee9d8350749e9f0970d9a88dd8f644e96ab5fed
--- /dev/null
+++ b/fdbserver/resolver/LocalFictitious.h
@@ -0,0 +1,116 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+namespace by5fictitious4 {
+constexpr std::uint32_t none=std::numeric_limits<std::uint32_t>::max();
+struct Links {
+    std::uint8_t fictitious=0;
+    std::uint32_t previous=none,next=none;
+};
+template<unsigned C=23> class Buckets {
+    static_assert(C>0 && C<=31);
+    std::array<std::uint32_t,C+1> heads;
+    std::uint32_t mask=0;
+public:
+    Buckets() { heads.fill(none); }
+    unsigned highest() const {
+        for(unsigned n=C;n;--n) if(mask&(std::uint32_t(1)<<n)) return n;
+        return 0;
+    }
+    std::uint32_t head(unsigned n) const {
+        if(n>C) throw std::invalid_argument("bucket");
+        return heads[n];
+    }
+    template<class Lookup,class TryCandidate>
+    bool visitDescending(Lookup&& get,TryCandidate&& attempt,std::uint64_t& inspected) {
+        for(unsigned n=highest();n;--n) {
+            for(auto id=heads[n];id!=none;) {
+                auto next=get(id).next;
+                ++inspected;
+                if(attempt(id)) return true;
+                id=next;
+            }
+        }
+        return false;
+    }
+    template<class Lookup> void set(std::uint32_t id,unsigned count,Lookup&& get) {
+        if(id==none || count>C) throw std::invalid_argument("membership");
+        auto& x=get(id);
+        unsigned old=x.fictitious;
+        if(old>C) throw std::logic_error("corrupt counter");
+        if(old) {
+            if(x.previous!=none) get(x.previous).next=x.next;
+            else {
+                if(heads[old]!=id) throw std::logic_error("unregistered leaf");
+                heads[old]=x.next;
+            }
+            if(x.next!=none) get(x.next).previous=x.previous;
+            if(heads[old]==none) mask&=~(std::uint32_t(1)<<old);
+        } else if(x.previous!=none || x.next!=none) throw std::logic_error("zero-count membership");
+        x.fictitious=static_cast<std::uint8_t>(count);
+        x.previous=x.next=none;
+        if(count) {
+            x.next=heads[count];
+            if(x.next!=none) get(x.next).previous=id;
+            heads[count]=id;
+            mask|=std::uint32_t(1)<<count;
+        }
+    }
+};
+struct FusionPlan { bool possible=false; unsigned removeLeft=0,removeRight=0; };
+template<unsigned C=23> struct Policy {
+    struct Split { unsigned leftReal,rightReal,leftFictitious,rightFictitious; bool insertRight; };
+    static unsigned occupancy(unsigned real,unsigned fictitious) {
+        if(real>C || fictitious>C-real) throw std::invalid_argument("occupancy");
+        return real+fictitious;
+    }
+    static bool needsSingleRelease(unsigned real,unsigned fictitious) {
+        return occupancy(real,fictitious)==C && fictitious>0;
+    }
+    static FusionPlan planFusion(unsigned lr,unsigned lf,unsigned rr,unsigned rf,bool sameParent,
+                                 unsigned mergedLimit=17,unsigned sourceLimit=6) {
+        occupancy(lr,lf);occupancy(rr,rf);
+        if(!mergedLimit || mergedLimit>C || sourceLimit>C) throw std::invalid_argument("fusion limits");
+        if(!sameParent || !lr || !rr || lr+rr>mergedLimit || std::min(lr,rr)>sourceLimit) return {};
+        unsigned sum=lr+lf+rr+rf;
+        unsigned needed=sum>mergedLimit?sum-mergedLimit:0;
+        FusionPlan best;
+        unsigned bestRemoved=2*C+1;
+        for(unsigned side=0;side<2;++side) {
+            if((side?rr:lr)>sourceLimit) continue;
+            unsigned a=0,b=0;
+            if(side==0) a=lr+lf>sourceLimit?lr+lf-sourceLimit:0;
+            else b=rr+rf>sourceLimit?rr+rf-sourceLimit:0;
+            unsigned remaining=needed>a+b?needed-a-b:0;
+            unsigned da=std::min(remaining,lf-a);a+=da;remaining-=da;
+            unsigned db=std::min(remaining,rf-b);b+=db;remaining-=db;
+            if(remaining) continue;
+            if(a+b<bestRemoved) { best={true,a,b};bestRemoved=a+b; }
+        }
+        return best;
+    }
+    static Split split(unsigned real,unsigned fictitious,unsigned rank,unsigned addedReserve,std::uint64_t choice) {
+        occupancy(real,fictitious);
+        if(real!=C || fictitious || rank>real || addedReserve>=C) throw std::invalid_argument("release before splitting");
+        unsigned peakBest=2*C+1,gapBest=2*C+1,count=0;
+        for(unsigned pass=0;pass<2;++pass) {
+            unsigned selected=pass?static_cast<unsigned>(choice%count):0;
+            for(unsigned left=1;left<real;++left) for(unsigned lf=0;lf<=addedReserve;++lf) {
+                bool right=rank>=left;
+                unsigned rf=addedReserve-lf,a=left+lf+!right,b=real-left+rf+right;
+                if(a>=C || b>=C) continue;
+                unsigned peak=std::max(a,b),gap=std::max(a,b)-std::min(a,b);
+                if(!pass) {
+                    if(peak<peakBest || (peak==peakBest && gap<gapBest)) { peakBest=peak;gapBest=gap;count=0; }
+                    if(peak==peakBest && gap==gapBest) ++count;
+                } else if(peak==peakBest && gap==gapBest && !selected--) return {left,real-left,lf,rf,right};
+            }
+            if(!count) throw std::runtime_error("no split");
+        }
+        throw std::logic_error("split selection");
+    }
+};
+}
diff --git a/fdbserver/resolver/PagePoolTests.cpp b/fdbserver/resolver/PagePoolTests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3871541669768112139293d588924d3cdc729d75
--- /dev/null
+++ b/fdbserver/resolver/PagePoolTests.cpp
@@ -0,0 +1,254 @@
+// Standalone battery for PagePool, runnable before the structure reaches the fork.
+// Each case is written as it will be written there: one property per case, with the
+// counters checked after every transition. Build and run with build-pagepool-tests.sh.
+
+#include "PagedTemporalSkipList.h"
+
+#include <cstdio>
+#include <cstring>
+#include <set>
+#include <vector>
+
+namespace {
+
+int failures = 0;
+
+void check(bool condition, const char* what) {
+	if (!condition) {
+		printf("  FAIL  %s\n", what);
+		++failures;
+	}
+}
+
+// freePages + heapPages + indexPages == limitPages, after every transition.
+void checkBudgetInvariant(const PagePool& pool, const char* where) {
+	const PageBudget& b = pool.budget();
+	check(b.freePages + b.heapPages + b.indexPages == b.limitPages, where);
+}
+
+void aPoolStartsEmptyAndAligned() {
+	printf("aPoolStartsEmptyAndAligned\n");
+	PagePool pool(4);
+	const PageBudget& b = pool.budget();
+
+	check(b.limitPages == 4, "limitPages is the requested capacity");
+	check(b.freePages == 4, "every page starts free");
+	check(b.heapPages == 0 && b.indexPages == 0, "nothing is assigned yet");
+	check(b.occupiedPages() == 0, "occupiedPages is zero");
+	check(b.reservedPages() == 4, "reservedPages is the capacity");
+	checkBudgetInvariant(pool, "budget invariant at construction");
+
+	PoolPage* page = pool.tryAcquire(PageUse::Heap);
+	check(page != nullptr, "the first page is available");
+	check(reinterpret_cast<uintptr_t>(page) % HISTORY_PAGE_BYTES == 0,
+	      "pages are aligned to HISTORY_PAGE_BYTES");
+}
+
+void acquiringMovesPagesBetweenCounters() {
+	printf("acquiringMovesPagesBetweenCounters\n");
+	PagePool pool(4);
+
+	PoolPage* heapPage = pool.tryAcquire(PageUse::Heap);
+	check(pool.budget().heapPages == 1, "a heap acquisition counts as heap");
+	check(pool.budget().indexPages == 0, "and not as index");
+	check(pool.budget().freePages == 3, "one page left the free count");
+	checkBudgetInvariant(pool, "budget invariant after a heap acquisition");
+
+	PoolPage* indexPage = pool.tryAcquire(PageUse::Index);
+	check(pool.budget().indexPages == 1, "an index acquisition counts as index");
+	check(pool.budget().occupiedPages() == 2, "two pages are occupied");
+	check(heapPage != indexPage, "acquisitions return distinct pages");
+	checkBudgetInvariant(pool, "budget invariant after an index acquisition");
+
+	pool.release(heapPage, PageUse::Heap);
+	check(pool.budget().heapPages == 0, "releasing debits the same counter");
+	check(pool.budget().indexPages == 1, "the other counter is untouched");
+	check(pool.budget().freePages == 3, "the page returns to the free count");
+	checkBudgetInvariant(pool, "budget invariant after a release");
+}
+
+void pagesAreDistinctAndWithinTheRegion() {
+	printf("pagesAreDistinctAndWithinTheRegion\n");
+	const uint64_t capacity = 8;
+	PagePool pool(capacity);
+
+	std::set<PoolPage*> seen;
+	std::vector<PoolPage*> pages;
+	for (uint64_t i = 0; i < capacity; ++i) {
+		PoolPage* page = pool.tryAcquire(PageUse::Index);
+		check(page != nullptr, "a page is available while capacity remains");
+		check(seen.insert(page).second, "every acquisition returns a distinct page");
+		pages.push_back(page);
+	}
+
+	// Consecutive acquisitions from the unused cursor walk the region in order.
+	for (size_t i = 1; i < pages.size(); ++i) {
+		const auto previous = reinterpret_cast<uintptr_t>(pages[i - 1]);
+		const auto current = reinterpret_cast<uintptr_t>(pages[i]);
+		check(current - previous == HISTORY_PAGE_BYTES, "unused pages are consecutive");
+	}
+}
+
+void anExhaustedPoolReturnsNull() {
+	printf("anExhaustedPoolReturnsNull\n");
+	PagePool pool(2);
+
+	PoolPage* first = pool.tryAcquire(PageUse::Heap);
+	PoolPage* second = pool.tryAcquire(PageUse::Heap);
+	check(first != nullptr && second != nullptr, "both pages are handed out");
+
+	check(pool.tryAcquire(PageUse::Heap) == nullptr, "an exhausted pool returns null for heap");
+	check(pool.tryAcquire(PageUse::Index) == nullptr, "an exhausted pool returns null for index");
+	check(pool.budget().freePages == 0, "no free page remains");
+	check(pool.budget().occupiedPages() == 2, "both pages are occupied");
+	checkBudgetInvariant(pool, "budget invariant at exhaustion");
+
+	pool.release(first, PageUse::Heap);
+	check(pool.tryAcquire(PageUse::Heap) == first, "the released page is available again");
+}
+
+void acquireHandsOutPagesUntilExhausted() {
+	printf("acquireHandsOutPagesUntilExhausted\n");
+	PagePool pool(2);
+
+	// gc() reclaims nothing yet, so acquire hands out what tryAcquire would and then
+	// returns null; it must not report a page it does not have.
+	PoolPage* first = pool.acquire(PageUse::Heap);
+	PoolPage* second = pool.acquire(PageUse::Index);
+	check(first != nullptr && second != nullptr && first != second, "both pages are handed out, distinct");
+	check(pool.budget().heapPages == 1 && pool.budget().indexPages == 1, "each counted under its use");
+	check(pool.acquire(PageUse::Heap) == nullptr, "an exhausted pool returns null through acquire");
+	checkBudgetInvariant(pool, "budget invariant at exhaustion through acquire");
+
+	pool.release(first, PageUse::Heap);
+	check(pool.acquire(PageUse::Index) == first, "a released page is handed out again");
+	check(pool.budget().heapPages == 0 && pool.budget().indexPages == 2, "under its new use");
+	checkBudgetInvariant(pool, "budget invariant after reuse through acquire");
+}
+
+void releasedPagesAreReusedBeforeUnusedOnes() {
+	printf("releasedPagesAreReusedBeforeUnusedOnes\n");
+	PagePool pool(4);
+
+	PoolPage* first = pool.tryAcquire(PageUse::Heap);
+	PoolPage* second = pool.tryAcquire(PageUse::Heap);
+
+	pool.release(first, PageUse::Heap);
+	pool.release(second, PageUse::Heap);
+
+	// The free list is intrusive and last-in first-out.
+	check(pool.tryAcquire(PageUse::Heap) == second, "the last release is served first");
+	check(pool.tryAcquire(PageUse::Heap) == first, "then the earlier one");
+	check(pool.budget().freePages == 2, "the two never-used pages remain");
+	checkBudgetInvariant(pool, "budget invariant after reuse");
+}
+
+void aPageReleasedForOneUseServesTheOther() {
+	printf("aPageReleasedForOneUseServesTheOther\n");
+	PagePool pool(1);
+
+	PoolPage* page = pool.tryAcquire(PageUse::Index);
+	check(page != nullptr, "the only page is available");
+	pool.release(page, PageUse::Index);
+
+	PoolPage* again = pool.tryAcquire(PageUse::Heap);
+	check(again == page, "the same page serves the other use");
+	check(pool.budget().heapPages == 1 && pool.budget().indexPages == 0,
+	      "the capacity moved from index to heap");
+	checkBudgetInvariant(pool, "budget invariant across uses");
+}
+
+void reuseKeepsTheContentsBeyondTheLink() {
+	printf("reuseKeepsTheContentsBeyondTheLink\n");
+	PagePool pool(2);
+
+	PoolPage* page = pool.tryAcquire(PageUse::Heap);
+	std::memset(page->bytes, 0xAB, HISTORY_PAGE_BYTES);
+
+	pool.release(page, PageUse::Heap);
+	PoolPage* again = pool.tryAcquire(PageUse::Heap);
+	check(again == page, "the released page comes back");
+
+	// release() writes the free-list link into the first bytes and touches nothing else.
+	bool preserved = true;
+	for (size_t i = sizeof(PageIndex); i < HISTORY_PAGE_BYTES; ++i) {
+		if (page->bytes[i] != std::byte{ 0xAB }) {
+			preserved = false;
+			break;
+		}
+	}
+	check(preserved, "everything past the link survives release and reuse");
+}
+
+void theWholeRegionIsWritable() {
+	printf("theWholeRegionIsWritable\n");
+	const uint64_t capacity = 4;
+	PagePool pool(capacity);
+
+	std::vector<PoolPage*> pages;
+	for (uint64_t i = 0; i < capacity; ++i) {
+		PoolPage* page = pool.tryAcquire(PageUse::Heap);
+		std::memset(page->bytes, static_cast<int>(i + 1), HISTORY_PAGE_BYTES);
+		pages.push_back(page);
+	}
+
+	// Distinct pages do not overlap: each keeps the pattern written into it.
+	for (uint64_t i = 0; i < capacity; ++i) {
+		const auto expected = std::byte(i + 1);
+		check(pages[i]->bytes[0] == expected && pages[i]->bytes[HISTORY_PAGE_BYTES - 1] == expected,
+		      "a page keeps its own contents from first to last byte");
+	}
+}
+
+void aPoolOfOnePageWorks() {
+	printf("aPoolOfOnePageWorks\n");
+	PagePool pool(1);
+
+	check(pool.budget().freePages == 1, "the single page is free");
+	PoolPage* page = pool.tryAcquire(PageUse::Heap);
+	check(page != nullptr, "it can be acquired");
+	check(pool.tryAcquire(PageUse::Heap) == nullptr, "and then the pool is exhausted");
+
+	pool.release(page, PageUse::Heap);
+	check(pool.budget().freePages == 1, "releasing it restores the capacity");
+	checkBudgetInvariant(pool, "budget invariant with one page");
+}
+
+void aReservationTooLargeThrows() {
+	printf("aReservationTooLargeThrows\n");
+
+	// The only way into the constructor's failure path: a region that cannot be
+	// reserved at all. 2^45 pages is 2^61 bytes, beyond any address space.
+	bool threw = false;
+	int code = 0;
+	try {
+		PagePool pool(uint64_t(1) << 45);
+	} catch (Error& e) {
+		threw = true;
+		code = e.code();
+	}
+	check(threw, "a reservation that cannot be satisfied throws");
+	check(code == error_code_platform_error, "and it throws platform_error");
+}
+
+} // namespace
+
+int main() {
+	// Unbuffered, so an assertion that aborts the process loses none of the report.
+	setvbuf(stdout, nullptr, _IONBF, 0);
+
+	aPoolStartsEmptyAndAligned();
+	acquiringMovesPagesBetweenCounters();
+	pagesAreDistinctAndWithinTheRegion();
+	anExhaustedPoolReturnsNull();
+	acquireHandsOutPagesUntilExhausted();
+	releasedPagesAreReusedBeforeUnusedOnes();
+	aPageReleasedForOneUseServesTheOther();
+	reuseKeepsTheContentsBeyondTheLink();
+	theWholeRegionIsWritable();
+	aPoolOfOnePageWorks();
+	aReservationTooLargeThrows();
+
+	printf("\n%s\n", failures == 0 ? "todos los casos OK" : "HAY FALLOS");
+	return failures == 0 ? 0 : 1;
+}
