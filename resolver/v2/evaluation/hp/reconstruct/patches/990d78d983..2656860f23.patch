+// The live entry that begins at the given key, as stored
+Tree::Entry entryAt(Tree& tree, const std::string& begin) {
+    for (auto* leaf = tree.firstLeaf_; leaf; leaf = leaf->navigation.leaf.next)
+        for (unsigned i = 0; i < leaf->size(); ++i)
+            if (leaf->at(i).cv > tree.validationMinRV() && entryBytes(tree, leaf->at(i)) == begin) return leaf->at(i);
+    throw std::runtime_error("no entry begins at " + hex(begin));
+}
+bool sameRef(const HeapRef& a, const HeapRef& b) {
+    return a.pageID == b.pageID && a.offset == b.offset && a.length == b.length;
+}
