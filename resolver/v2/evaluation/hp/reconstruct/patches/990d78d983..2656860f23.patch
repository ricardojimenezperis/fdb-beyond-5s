diff --git a/fdbserver/resolver/PagedTemporalSkipList-permutations.cpp b/fdbserver/resolver/PagedTemporalSkipList-permutations.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e19f74a3fdd4a030289e969c009d174051a3d18a
--- /dev/null
+++ b/fdbserver/resolver/PagedTemporalSkipList-permutations.cpp
@@ -0,0 +1,536 @@
+// The blocked layout: TemporalSkipBlock keeps its cells' key order in a KeyPermutation of
+// nibbles packed in one 64-bit word. As of commit ebdc3ecce1, the last before individual cells
+// replaced the blocks. Kept for reference: no target builds it, since it defines the same
+// classes as PagedTemporalSkipList.h
+
+#include "PagedTemporalSkipList-permutations.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <new>
+
+#include "flow/FaultInjection.h"
+#include "flow/Platform.h"
+#include "flow/Trace.h"
+
+namespace {
+
+constexpr size_t RECORD_ALIGNMENT =
+	std::max(alignof(PointConflictHeader), alignof(RangeConflictHeader));
+
+constexpr size_t alignRecordSize(size_t bytes) {
+	return (bytes + RECORD_ALIGNMENT - 1) & ~(RECORD_ALIGNMENT - 1);
+}
+
+constexpr size_t FIRST_RECORD_OFFSET = alignRecordSize(sizeof(HistoryPage));
+
+static_assert(FIRST_RECORD_OFFSET < HISTORY_PAGE_BYTES);
+static_assert(HISTORY_PAGE_BYTES % RECORD_ALIGNMENT == 0);
+
+} // namespace
+
+// A released page stores the next free-page index in its first bytes.
+static_assert(sizeof(PageIndex) <= HISTORY_PAGE_BYTES);
+
+PagePool::PagePool(uint64_t limitPages) {
+	constexpr uint64_t maxPages =
+		std::numeric_limits<size_t>::max() / HISTORY_PAGE_BYTES;
+	ASSERT(limitPages > 0);
+	ASSERT(limitPages <= maxPages);
+	const size_t bytes = static_cast<size_t>(limitPages) * HISTORY_PAGE_BYTES;
+
+	INJECT_FAULT(platform_error, "PagePool reservation");
+	void* region = aligned_alloc(HISTORY_PAGE_BYTES, bytes);
+	if (region == nullptr) {
+		TraceEvent(SevError, "PagePoolReservationFailed")
+			.detail("Pages", limitPages)
+			.detail("Bytes", bytes)
+			.GetLastError();
+		throw platform_error();
+	}
+	base_ = static_cast<std::byte*>(region);
+	budget_.limitPages = limitPages;
+	budget_.freePages = limitPages;
+	// Previously unused pages are first touched by their consumers.
+}
+
+PagePool::~PagePool() {
+	// The constructor either reserves the region or throws, and a constructor that
+	// throws leaves no object to destroy, so base_ is always a live region here.
+	aligned_free(base_);
+}
+
+PoolPage* PagePool::tryAcquire(PageUse use) {
+	PageIndex index;
+	if (firstFreePage_ != NULL_PAGE_INDEX) {
+		index = firstFreePage_;
+		firstFreePage_ = getNextFree(index);
+	} else if (nextUnusedPage_ < budget_.limitPages) {
+		index = nextUnusedPage_++;
+	} else {
+		ASSERT(budget_.freePages == 0);
+		return nullptr;
+	}
+	ASSERT(budget_.freePages > 0);
+	--budget_.freePages;
+	if (use == PageUse::Heap) {
+		++budget_.heapPages;
+	} else {
+		++budget_.indexPages;
+	}
+	return pageAt(index);
+}
+
+void PagePool::release(PoolPage* page, PageUse use) {
+	ASSERT(page != nullptr);
+	const PageIndex index = indexOf(page);
+	ASSERT(index < nextUnusedPage_);
+
+	// Retain the storage; overwrite only the free-list link.
+	setNextFree(index, firstFreePage_);
+	firstFreePage_ = index;
+	++budget_.freePages;
+	ASSERT(budget_.freePages <= budget_.limitPages);
+	if (use == PageUse::Heap) {
+		ASSERT(budget_.heapPages > 0);
+		--budget_.heapPages;
+	} else {
+		ASSERT(budget_.indexPages > 0);
+		--budget_.indexPages;
+	}
+}
+
+PoolPage* PagePool::pageAt(PageIndex index) const {
+	ASSERT(index < budget_.limitPages);
+	return reinterpret_cast<PoolPage*>(
+		base_ + static_cast<size_t>(index) * HISTORY_PAGE_BYTES);
+}
+
+PageIndex PagePool::indexOf(const PoolPage* page) const {
+	// Integer addresses avoid subtracting pointers to unrelated allocations.
+	const uintptr_t address = reinterpret_cast<uintptr_t>(page);
+	const uintptr_t baseAddress = reinterpret_cast<uintptr_t>(base_);
+	ASSERT(address >= baseAddress);
+	const uintptr_t offset = address - baseAddress;
+	const size_t regionBytes =
+		static_cast<size_t>(budget_.limitPages) * HISTORY_PAGE_BYTES;
+	ASSERT(offset < regionBytes);
+	ASSERT(offset % HISTORY_PAGE_BYTES == 0);
+	return static_cast<PageIndex>(offset / HISTORY_PAGE_BYTES);
+}
+
+PageIndex PagePool::getNextFree(PageIndex index) const {
+	PageIndex next;
+	std::memcpy(&next, pageAt(index)->bytes, sizeof(next));
+	return next;
+}
+
+void PagePool::setNextFree(PageIndex index, PageIndex next) {
+	std::memcpy(pageAt(index)->bytes, &next, sizeof(next));
+}
+
+// ---------- HeapPageTable ----------
+
+HeapPageTable::HeapPageTable(size_t capacity)
+	: slots_(capacity, nullptr) {
+	ASSERT(capacity > 0);
+}
+
+void HeapPageTable::insert(HistoryPage* page) {
+	ASSERT(page != nullptr);
+	ASSERT(page->id == nextID_);
+	ASSERT(nextID_ - firstID_ < slots_.size());
+	const size_t slot = page->id % slots_.size();
+	ASSERT(slots_[slot] == nullptr);
+	slots_[slot] = page;
+	++nextID_;
+}
+
+HistoryPage* HeapPageTable::find(PageID id) const {
+	if (id < firstID_ || id >= nextID_) {
+		return nullptr;
+	}
+	return slots_[id % slots_.size()];
+}
+
+void HeapPageTable::erase(PageID id) {
+	ASSERT(firstID_ < nextID_);
+	ASSERT(id == firstID_);
+	const size_t slot = id % slots_.size();
+	ASSERT(slots_[slot] != nullptr);
+	slots_[slot] = nullptr;
+	++firstID_;
+}
+
+// ---------- TemporalHeap ----------
+
+TemporalHeap::TemporalHeap(PagePool& pool)
+	: pool_(pool), pages_(pool.budget().limitPages) {}
+
+TemporalHeap::~TemporalHeap() {
+	while (oldest_ != nullptr) {
+		reclaimOldest();
+	}
+}
+
+Optional<HeapRef> TemporalHeap::appendPoint(Version cv, StringRef key) {
+	const size_t recordSize = sizeof(PointConflictHeader) + key.size();
+	const Optional<HeapRef> ref =
+		allocateRecord(static_cast<uint32_t>(recordSize), cv);
+	if (!ref.present()) {
+		return {};
+	}
+
+	// The reservation is always on the newest page.
+	auto* record = reinterpret_cast<std::byte*>(newest_) + ref.get().offset;
+	new (record) PointConflictHeader{cv, static_cast<uint32_t>(key.size())};
+	if (key.size() > 0) {
+		std::memcpy(
+			record + sizeof(PointConflictHeader), key.begin(), key.size());
+	}
+	return ref;
+}
+
+Optional<HeapRef> TemporalHeap::appendRange(
+	Version cv, StringRef begin, StringRef end) {
+	ASSERT(begin < end);
+	const size_t recordSize =
+		sizeof(RangeConflictHeader) + begin.size() + end.size();
+	const Optional<HeapRef> ref =
+		allocateRecord(static_cast<uint32_t>(recordSize), cv);
+	if (!ref.present()) {
+		return {};
+	}
+
+	auto* record = reinterpret_cast<std::byte*>(newest_) + ref.get().offset;
+	new (record) RangeConflictHeader{
+		cv,
+		static_cast<uint32_t>(begin.size()),
+		static_cast<uint32_t>(end.size())
+	};
+	auto* keys = record + sizeof(RangeConflictHeader);
+	if (begin.size() > 0) {
+		std::memcpy(keys, begin.begin(), begin.size());
+	}
+	std::memcpy(keys + begin.size(), end.begin(), end.size());
+	return ref;
+}
+
+Optional<PointConflictView> TemporalHeap::getPoint(const HeapRef& ref) const {
+	HistoryPage* page = findPage(ref.pageID);
+	if (page == nullptr) {
+		return {};
+	}
+
+	ASSERT(ref.offset >= FIRST_RECORD_OFFSET);
+	ASSERT(ref.offset % RECORD_ALIGNMENT == 0);
+	ASSERT(ref.offset <= page->usedBytes);
+	ASSERT(ref.length <= page->usedBytes - ref.offset);
+	ASSERT(ref.length >= sizeof(PointConflictHeader));
+
+	const auto* record =
+		reinterpret_cast<const std::byte*>(page) + ref.offset;
+	const auto* header =
+		reinterpret_cast<const PointConflictHeader*>(record);
+	ASSERT(header->keyLength == ref.length - sizeof(PointConflictHeader));
+
+	const auto* key =
+		reinterpret_cast<const uint8_t*>(record + sizeof(PointConflictHeader));
+	return PointConflictView{
+		header->cv,
+		StringRef(key, static_cast<int>(header->keyLength))
+	};
+}
+
+Optional<RangeConflictView> TemporalHeap::getRange(const HeapRef& ref) const {
+	HistoryPage* page = findPage(ref.pageID);
+	if (page == nullptr) {
+		return {};
+	}
+
+	ASSERT(ref.offset >= FIRST_RECORD_OFFSET);
+	ASSERT(ref.offset % RECORD_ALIGNMENT == 0);
+	ASSERT(ref.offset <= page->usedBytes);
+	ASSERT(ref.length <= page->usedBytes - ref.offset);
+	ASSERT(ref.length >= sizeof(RangeConflictHeader));
+
+	const auto* record =
+		reinterpret_cast<const std::byte*>(page) + ref.offset;
+	const auto* header =
+		reinterpret_cast<const RangeConflictHeader*>(record);
+	const size_t keyBytes = ref.length - sizeof(RangeConflictHeader);
+	ASSERT(header->beginLength <= keyBytes);
+	ASSERT(header->endLength == keyBytes - header->beginLength);
+
+	const auto* keys =
+		reinterpret_cast<const uint8_t*>(record + sizeof(RangeConflictHeader));
+	return RangeConflictView{
+		header->cv,
+		StringRef(keys, static_cast<int>(header->beginLength)),
+		StringRef(keys + header->beginLength, static_cast<int>(header->endLength))
+	};
+}
+
+Optional<Version> TemporalHeap::reclaimOldest() {
+	if (oldest_ == nullptr) {
+		return {};
+	}
+	HistoryPage* pageToRelease = oldest_;
+	const Optional<Version> cv = pageToRelease->newestCV;
+	oldest_ = pageToRelease->newer;
+	if (oldest_ != nullptr) {
+		oldest_->older = nullptr;
+	} else {
+		newest_ = nullptr;
+	}
+	pages_.erase(pageToRelease->id);
+	lastReclaimedPageID_ = pageToRelease->id;
+	// A linked page always carries a version: allocateRecord sets newestCV on the page
+	// it selects, and nothing between the two can fail. An absent one would break that
+	// invariant, so it is reported rather than skipped.
+	ASSERT(cv.present());
+	if (!reclaimedThroughCV_.present() || cv.get() > reclaimedThroughCV_.get()) {
+		reclaimedThroughCV_ = cv;
+	}
+	pool_.release(reinterpret_cast<PoolPage*>(pageToRelease), PageUse::Heap);
+	return cv;
+}
+
+HistoryPage* TemporalHeap::acquirePage() {
+	PoolPage* page = pool_.tryAcquire(PageUse::Heap);
+	if (page == nullptr) {
+		return nullptr;
+	}
+	HistoryPage* newHistoryPage = new (page->bytes) HistoryPage{};
+	newHistoryPage->id = nextPageID_++;
+	newHistoryPage->usedBytes = static_cast<uint32_t>(FIRST_RECORD_OFFSET);
+	newHistoryPage->payload = page->bytes + FIRST_RECORD_OFFSET;
+	newHistoryPage->newer = nullptr;
+	newHistoryPage->older = newest_;
+	if (newest_ != nullptr) {
+		newest_->newer = newHistoryPage;
+	} else {
+		oldest_ = newHistoryPage;
+	}
+	newest_ = newHistoryPage;
+	pages_.insert(newHistoryPage);
+	return newHistoryPage;
+}
+
+HistoryPage* TemporalHeap::findPage(PageID id) const {
+	return pages_.find(id);
+}
+
+Optional<HeapRef> TemporalHeap::allocateRecord(uint32_t bytes, Version cv) {
+	// A record that cannot fit in an empty page violates the caller's contract.
+	ASSERT(bytes <= HISTORY_PAGE_BYTES - FIRST_RECORD_OFFSET);
+	const size_t reserved = alignRecordSize(bytes);
+
+	if (newest_ == nullptr || reserved > HISTORY_PAGE_BYTES - newest_->usedBytes) {
+		if (acquirePage() == nullptr) {
+			return {};
+		}
+	}
+
+	const uint32_t offset = newest_->usedBytes;
+
+	// The reserved record must fit entirely within the selected page.
+	ASSERT(offset + reserved <= HISTORY_PAGE_BYTES);
+
+	newest_->usedBytes += static_cast<uint32_t>(reserved);
+	newest_->newestCV = cv;
+	return HeapRef{ newest_->id, offset, bytes };
+}
+// ---------- KeyPermutation ----------
+
+uint8_t KeyPermutation::size() const {
+	return static_cast<uint8_t>(bits_ & 0xF);
+}
+
+bool KeyPermutation::empty() const {
+	return size() == 0;
+}
+
+bool KeyPermutation::full() const {
+	return size() == SKIP_BLOCK_CAPACITY;
+}
+
+uint8_t KeyPermutation::slotAt(uint8_t rank) const {
+	ASSERT(rank < size());
+	uint64_t bits = bits_ >> (rank * 4 + 4);
+	return static_cast<uint8_t>(bits & 0xF);
+}
+
+// Finds the key-order rank of an occupied physical slot.
+// Compares all packed nibbles at once: XOR makes matching nibbles zero,
+// and shifted ORs detect each zero nibble. The count and unused nibbles
+// are excluded before locating the first match with ctzll().
+uint8_t KeyPermutation::rankOfSlot(uint8_t slot) const {
+	ASSERT(slot < SKIP_BLOCK_CAPACITY);
+
+	// Each hexadecimal 1 is one nibble containing 0b0001.
+	constexpr uint64_t ONE_PER_NIBBLE = 0x1111111111111111ull;
+
+	// Repeat slot in every nibble. Matching nibbles become zero.
+	const uint64_t x = bits_ ^ (static_cast<uint64_t>(slot) * ONE_PER_NIBBLE);
+
+	// Each nibble's four bits contribute to its low bit. After negation,
+	// that bit is 1 exactly when the original nibble was zero.
+	const uint64_t zeroNibbles =
+	    ~(x | (x >> 1) | (x >> 2) | (x >> 3)) & ONE_PER_NIBBLE;
+
+	// Keep size() slot nibbles, starting after the count nibble.
+	// The largest shift is 4 * 15 = 60.
+	const uint64_t occupied = ((uint64_t{ 1 } << (4 * size())) - 1) << 4;
+	const uint64_t matches = zeroNibbles & occupied;
+
+	// The slot must be present; ctzll() requires a nonzero argument.
+	ASSERT(matches != 0);
+
+	// Divide the bit position by four to get its nibble, then skip
+	// nibble zero, which contains the count.
+	return static_cast<uint8_t>(ctzll(matches) / 4 - 1);
+}
+
+void KeyPermutation::insert(uint8_t rank, uint8_t slot) {
+	ASSERT(size() < SKIP_BLOCK_CAPACITY);
+	ASSERT(rank <= size());
+	ASSERT(slot < SKIP_BLOCK_CAPACITY);
+
+	const uint64_t slotShift = 4 * rank + 4;
+	const uint64_t maskUpper = static_cast<uint64_t>(-1) << slotShift;
+	const uint64_t maskLower = ~maskUpper;
+
+	bits_ = ((bits_ & maskUpper) << 4)
+		  | (bits_ & maskLower)
+		  | (static_cast<uint64_t>(slot) << slotShift);
+	// increment the size in the low nibble
+	++bits_;
+}
+
+void KeyPermutation::erase(uint8_t rank) {
+	ASSERT(rank < size());
+
+	const uint64_t lowerShift = 4 * (rank + 1);
+	const uint64_t upperShift = lowerShift + 4;
+	const uint64_t allOnes = static_cast<uint64_t>(-1);
+	// No upper slots remain when upperShift == 64.
+	const uint64_t maskUpper =
+		upperShift == 64 ? 0 : (allOnes << upperShift);
+	const uint64_t maskLower = allOnes >> (64 - lowerShift);
+
+	bits_ = ((bits_ & maskUpper) >> 4)
+		  | (bits_ & maskLower);
+	--bits_;
+}
+
+void KeyPermutation::clear() {
+	bits_ = 0;
+}
+
+// ---------- TemporalSkipBlock ----------
+
+TemporalSkipBlock::TemporalSkipBlock(ConflictKind kind, Level level)
+	: kind(kind), level(level) {}
+
+uint8_t TemporalSkipBlock::size() const {
+	return static_cast<uint8_t>(end_ - begin_);
+}
+
+bool TemporalSkipBlock::empty() const {
+	return begin_ == end_;
+}
+
+bool TemporalSkipBlock::full() const {
+	return end_ - begin_ == SKIP_BLOCK_CAPACITY;
+}
+
+LogicalPosition TemporalSkipBlock::beginPosition() const {
+	return begin_;
+}
+
+LogicalPosition TemporalSkipBlock::endPosition() const {
+	return end_;
+}
+
+bool TemporalSkipBlock::contains(LogicalPosition position) const {
+	return position >= begin_ && position < end_;
+}
+
+SkipEntry& TemporalSkipBlock::entryAt(LogicalPosition position) {
+	ASSERT(contains(position));
+	return slots_[position % SKIP_BLOCK_CAPACITY];
+}
+
+const SkipEntry& TemporalSkipBlock::entryAt(LogicalPosition position) const {
+	ASSERT(contains(position));
+	return slots_[position % SKIP_BLOCK_CAPACITY];
+}
+
+LogicalPosition TemporalSkipBlock::positionAtRank(uint8_t rank) const {
+	const uint8_t slot = keyOrder_.slotAt(rank);
+	const LogicalPosition circularDistance =
+		(slot + SKIP_BLOCK_CAPACITY - begin_ % SKIP_BLOCK_CAPACITY)
+		% SKIP_BLOCK_CAPACITY;
+	return begin_ + circularDistance;
+}
+
+SkipEntry& TemporalSkipBlock::entryAtRank(uint8_t rank) {
+	return slots_[keyOrder_.slotAt(rank)];
+}
+
+const SkipEntry& TemporalSkipBlock::entryAtRank(uint8_t rank) const {
+	return slots_[keyOrder_.slotAt(rank)];
+}
+
+EntryRef TemporalSkipBlock::append(const SkipEntry& entry, const TemporalHeap& heap) {
+	ASSERT(!full());
+	ASSERT(empty() || entry.recordCV >= entryAt(end_ - 1).recordCV);
+
+	const StringRef newKey = keyOf(entry, heap);
+	uint8_t low = 0;
+	uint8_t high = keyOrder_.size();
+
+	while (low < high) {
+		const uint8_t mid = low + (high - low) / 2;
+		if (newKey < keyOf(entryAtRank(mid), heap)) {
+			high = mid;
+		} else {
+			low = mid + 1;
+		}
+	}
+
+	const LogicalPosition position = end_;
+	const uint8_t slot = static_cast<uint8_t>(position % SKIP_BLOCK_CAPACITY);
+	slots_[slot] = entry;
+	keyOrder_.insert(low, slot);
+	++end_;
+	return EntryRef{ this, position };
+}
+
+void TemporalSkipBlock::popFront() {
+	ASSERT(!empty());
+
+	const uint8_t slot = static_cast<uint8_t>(begin_ % SKIP_BLOCK_CAPACITY);
+	keyOrder_.erase(rankOfSlot(slot));
+	++begin_;
+}
+
+StringRef TemporalSkipBlock::keyOf(
+    const SkipEntry& entry, const TemporalHeap& heap) const {
+	if (kind == ConflictKind::Point) {
+		const Optional<PointConflictView> view = heap.getPoint(entry.record);
+		ASSERT(view.present());
+		return view.get().key;
+	}
+
+	const Optional<RangeConflictView> view = heap.getRange(entry.record);
+	ASSERT(view.present());
+	return view.get().begin;
+}
+
+uint8_t TemporalSkipBlock::rankOfSlot(uint8_t slot) const {
+	return keyOrder_.rankOfSlot(slot);
+}
