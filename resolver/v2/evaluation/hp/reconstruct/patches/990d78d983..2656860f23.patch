+void everyRecordIsAligned() {
+	begin("everyRecordIsAligned");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+
+	// Odd sizes, so that any missing round-up shows as a misaligned offset.
+	for (int i = 0; i < 20; ++i) {
+		const std::string key(static_cast<size_t>(i) * 7 + 1, 'x');
+		const HeapRef r = appended(heap.appendPoint(i + 1, asRef(key)),
+								   "the record is appended");
+		check(r.offset % RECORD_ALIGNMENT == 0, "its offset is aligned");
+		check(r.offset >= FIRST_RECORD_OFFSET, "it does not overlap the header");
+		check(pointAt(heap, r, "it is readable").key.size() == static_cast<int>(key.size()),
+			  "its length is exact, not rounded up");
+	}
+	end();
+}
