+		writePoint(set, mirror, 2, 1, "k");
+		writePoint(set, mirror, 1, 2, "k");
+		PreparedWrite group[3];
+		preparePoint(set, mirror, group[0], 1, 10, "j");
+		preparePoint(set, mirror, group[1], 2, 10, "k");
+		preparePoint(set, mirror, group[2], 1, 10, "l");
+		set.points_.findInsertionPaths(group, 3, set.validationMinRV_);
+		set.points_.linkGroup(group, 3, set.validationMinRV_, set.cleanup_);
+		check(levelVersions(set.points_, 0) == (std::vector<Version>{ 10, 1, 2, 10, 10 }),
+		      "the new k follows both older ks at level 0, between j and l");
+		check(levelVersions(set.points_, 1) == (std::vector<Version>{ 1, 10 }), "and the older k at level 1");
+		check(indexesAreSound(set), "the index is sound");
+	});
+	end();
+}
