+
+// Is every cell of this write's tower in the same linked state?
+bool towerIsWhole(const SkipEntry* bottom) {
+	for (const SkipEntry* e = bottom->up; e != nullptr; e = e->up) {
+		if (e->linkedInLevel != bottom->linkedInLevel) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void theSearchRemovesExpiredTowersWhole() {
+	begin("theSearchRemovesExpiredTowersWhole");
+	for (ConflictKind kind : { ConflictKind::Point, ConflictKind::Range }) {
+		Index index(kind);
+		std::mt19937 random(17);
+		// Ends grow with the version, so the largest end in any span is its newest write's
+		// and live: a summary transfer that loses an end shows up as a live end not bounded.
+		for (int i = 0; i < 400; ++i) {
+			const std::string key = randomKey(random, 5, 3);
+			char end[16];
+			snprintf(end, sizeof end, "~%05d", i + 1);
+			index.add(key, kind == ConflictKind::Range ? std::string(end) : "", i + 1);
+		}
+		std::vector<SkipEntry*> bottoms = levelsOf(index.list)[0];
+
+		// A search past everything with half the versions expired.
+		constexpr Version boundary = 200;
+		const std::string top = largestKey();
+		index.list.findInsertionPath(asRef(top), boundary);
+
+		bool liveStay = true, onlyExpiredGo = true, whole = true;
+		size_t removed = 0;
+		for (SkipEntry* b : bottoms) {
+			liveStay = liveStay && (b->recordCV <= boundary || b->linkedInLevel);
+			onlyExpiredGo = onlyExpiredGo && (b->linkedInLevel || b->recordCV <= boundary);
+			whole = whole && towerIsWhole(b);
+			removed += b->linkedInLevel ? 0 : 1;
+		}
+		check(liveStay, "every live write stays in the index");
+		check(onlyExpiredGo, "only expired writes leave it");
+		check(whole, "and a tower leaves whole, from every level");
+		check(removed > 0, "the search did remove expired towers");
+
+		const auto levels = levelsOf(index.list);
+		check(towersAreSound(index.list, index.heap, levels), "the index is sound after the removals");
+		check(summariesBoundTheirSpans(kind, index.heap, levels, boundary, false),
+		      "and every summary still bounds the live writes it covers");
+	}
+	end();
+}
+
+void aWriteAtTheBoundaryHasExpired() {
+	begin("aWriteAtTheBoundaryHasExpired");
+	for (ConflictKind kind : { ConflictKind::Point, ConflictKind::Range }) {
+		Index index(kind);
+		index.add("k", kind == ConflictKind::Range ? "z" : "", 5);
+		const std::string top = largestKey();
+
+		// Expiry is recordCV <= validationMinRV: one below the version keeps the write,
+		// the version itself removes it.
+		index.list.findInsertionPath(asRef(top), 4);
+		check(!index.list.empty(), "a write newer than the boundary stays");
+		index.list.findInsertionPath(asRef(top), 5);
+		check(index.list.empty(), "a write at the boundary is removed");
+	}
+	end();
+}
+
+void insertingPastExpiredWritesStaysSound() {
+	begin("insertingPastExpiredWritesStaysSound");
+	for (ConflictKind kind : { ConflictKind::Point, ConflictKind::Range }) {
+		Index index(kind);
+		std::mt19937 random(19);
+		// The boundary rises as writes arrive, so insertions keep meeting expired towers
+		// and, for ranges, endpoints whose source has expired.
+		for (int i = 0; i < 600; ++i) {
+			const std::string key = randomKey(random, 5, 3);
+			const Version boundary = i > 50 ? i - 50 : 0;
+			index.add(key, kind == ConflictKind::Range ? key + randomKey(random, 3, 2) : "", i + 1, boundary);
+		}
+		const Version finalBoundary = 600 - 51;
+		const auto levels = levelsOf(index.list);
+		bool liveStay = true;
+		for (const Written& w : index.writes) {
+			if (w.cv <= finalBoundary) {
+				continue;
+			}
+			bool found = false;
+			for (SkipEntry* e : levels[0]) {
+				found = found || sameRef(e->record, w.record);
+			}
+			liveStay = liveStay && found;
+		}
+		check(liveStay, "every write newer than the boundary is in the index");
+		check(towersAreSound(index.list, index.heap, levels), "the index is sound");
+		check(summariesBoundTheirSpans(kind, index.heap, levels, finalBoundary, false),
+		      "and every summary bounds the live writes it covers");
+	}
+	end();
+}
+
+void equalVersionsKeepSummariesBounded() {
+	begin("equalVersionsKeepSummariesBounded");
+	for (ConflictKind kind : { ConflictKind::Point, ConflictKind::Range }) {
+		Index index(kind);
+		std::mt19937 random(29);
+		// Several writes per version, as a batch commits them: the new version is then
+		// no greater than the bound it joins.
+		for (int i = 0; i < 600; ++i) {
+			const std::string key = randomKey(random, 5, 3);
+			index.add(key, kind == ConflictKind::Range ? key + randomKey(random, 4, 2) : "", 1 + i / 8);
+		}
+		const auto levels = levelsOf(index.list);
+		check(towersAreSound(index.list, index.heap, levels), "the index is sound");
+		check(summariesBoundTheirSpans(kind, index.heap, levels, 0, true),
+		      "and every summary bounds its span, exactly at level zero");
+	}
+	end();
+}
+
+void reclaimedEndpointsLeaveSummariesForRepair() {
+	begin("reclaimedEndpointsLeaveSummariesForRepair");
+	// Long ends fill heap pages quickly, so the oldest page can be reclaimed while the
+	// index still holds cells whose summaries name endpoints on it.
+	Index index(ConflictKind::Range, 256);
+	std::mt19937 random(31);
+	const std::string tail(1500, 'z');
+	for (int i = 0; i < 200; ++i) {
+		const std::string key = randomKey(random, 5, 3);
+		index.add(key, key + tail, i + 1);
+	}
+	const Optional<Version> reclaimed = index.heap.reclaimOldest();
+	if (!check(reclaimed.present(), "the oldest heap page is reclaimed")) {
+		return end();
+	}
+	// From here on the boundary covers the reclaimed page, as it must before a page goes.
+	const Version boundary = reclaimed.get();
+	for (int i = 200; i < 300; ++i) {
+		const std::string key = randomKey(random, 5, 3);
+		index.add(key, key + tail, i + 1, boundary);
+	}
+
+	const auto levels = levelsOf(index.list, boundary);
+	bool liveStay = true;
+	for (const Written& w : index.writes) {
+		if (w.cv <= boundary) {
+			continue;
+		}
+		bool found = false;
+		for (SkipEntry* e : levels[0]) {
+			found = found || sameRef(e->record, w.record);
+		}
+		liveStay = liveStay && found;
+	}
+	check(liveStay, "every write newer than the boundary is in the index");
+	check(towersAreSound(index.list, index.heap, levels, boundary), "the index is sound");
+	check(summariesBoundTheirSpans(ConflictKind::Range, index.heap, levels, boundary, false),
+	      "and no summary claims a bound it cannot read");
+	end();
+}
+
+// ---------- CleanupList ----------
+
+// The queue agrees with the model: oldestCV() is the model head's version, and the
+// temporal links, walked from that head, visit exactly the model in order and end on
+// a null link at its tail. The queue's ends are private, so the walk starts from the
+// model's head; oldestCV() and popOldest() are what tie it to the queue's own.
+bool queueAgrees(const CleanupList& queue, const std::deque<SkipEntry*>& model, const char* what) {
+	bool agrees = queue.empty() == model.empty();
+	if (agrees && !model.empty()) {
+		agrees = queue.oldestCV() == model.front()->recordCV;
+		const SkipEntry* e = model.front();
+		for (size_t i = 0; agrees && i < model.size(); ++i) {
+			agrees = e == model[i];
+			if (agrees) {
+				e = e->newerForCleanup;
+			}
+		}
+		agrees = agrees && e == nullptr;
+	}
+	return check(agrees, what);
+}
+
+void anEmptyQueueHasNoHead() {
+	begin("anEmptyQueueHasNoHead");
+	const CleanupList queue;
+	check(queue.empty(), "a new queue is empty");
+	end();
+}
+
+void theFirstAppendMakesTheHead() {
+	begin("theFirstAppendMakesTheHead");
+	auto cells = makeCells(1);
+	CleanupList queue;
+	queue.append(cells[0].get());
+
+	if (check(!queue.empty(), "the queue is no longer empty")) {
+		check(queue.oldestCV() == 0, "its head is the one cell");
+		check(cells[0]->newerForCleanup == nullptr, "which has nothing after it");
+		check(queue.popOldest() == cells[0].get(), "and is what comes out");
+		check(queue.empty(), "leaving the queue empty");
+	}
+	end();
+}
+
+void cellsLeaveInTheOrderTheyArrived() {
+	begin("cellsLeaveInTheOrderTheyArrived");
+	auto cells = makeCells(8);
+	CleanupList queue;
+	std::deque<SkipEntry*> model;
+	for (auto& c : cells) {
+		queue.append(c.get());
+		model.push_back(c.get());
+		queueAgrees(queue, model, "the queue agrees after every append");
+	}
+	bool inOrder = true;
+	while (!model.empty()) {
+		inOrder = inOrder && !queue.empty() && queue.popOldest() == model.front();
+		model.pop_front();
+		inOrder = queueAgrees(queue, model, "and after every pop") && inOrder;
+	}
+	check(inOrder, "the cells left first in, first out");
+	end();
+}
+
+void theHeadNeedNotHoldTheSmallestVersion() {
+	begin("theHeadNeedNotHoldTheSmallestVersion");
+	auto cells = makeCells(4);
+	const Version versions[] = { 5, 3, 9, 1 };
+	CleanupList queue;
+	for (int i = 0; i < 4; ++i) {
+		cells[i]->recordCV = versions[i];
+		queue.append(cells[i].get());
+	}
+
+	// Versions arrive out of order, and the queue does not reorder them: oldestCV() is
+	// the head's version, not the minimum, and cells still leave in arrival order.
+	check(!queue.empty() && queue.oldestCV() == 5, "the head's version, not the smallest in the queue");
+	bool arrivalOrder = true;
+	for (int i = 0; i < 4; ++i) {
+		arrivalOrder = arrivalOrder && !queue.empty() && queue.oldestCV() == versions[i] &&
+		               queue.popOldest() == cells[i].get();
+	}
+	check(arrivalOrder, "cells leave in arrival order whatever their versions");
+	check(queue.empty(), "and the queue ends empty");
+	end();
+}
+
+void equalVersionsKeepArrivalOrder() {
+	begin("equalVersionsKeepArrivalOrder");
+	auto cells = makeCells(5);
+	CleanupList queue;
+	for (auto& c : cells) {
+		c->recordCV = 42;
+		queue.append(c.get());
+	}
+	bool inOrder = true;
+	for (auto& c : cells) {
+		inOrder = inOrder && !queue.empty() && queue.oldestCV() == 42 && queue.popOldest() == c.get();
+	}
+	check(inOrder, "cells with the same version leave in the order they arrived");
+	end();
+}
+
+void appendOverwritesAStaleLink() {
+	begin("appendOverwritesAStaleLink");
+	auto cells = makeCells(4);
+	CleanupList queue;
+	std::deque<SkipEntry*> model;
+
+	// A recycled cell arrives still naming a cell that is in no queue. Appending it as
+	// the tail must clear that link, or the queue would run on into a stranger.
+	cells[1]->newerForCleanup = cells[3].get();
+	for (int i = 0; i < 2; ++i) {
+		queue.append(cells[i].get());
+		model.push_back(cells[i].get());
+	}
+	queueAgrees(queue, model, "the tail's stale link was overwritten");
+
+	// Appended in the middle of a sequence, a stale link is overwritten by the next append.
+	cells[2]->newerForCleanup = cells[3].get();
+	queue.append(cells[2].get());
+	model.push_back(cells[2].get());
+	queueAgrees(queue, model, "and so was the next one's");
+	check(cells[3]->newerForCleanup == nullptr, "the cell the stale links named was not written");
+	end();
+}
+
+void aPoppedCellKeepsItsLink() {
+	begin("aPoppedCellKeepsItsLink");
+	auto cells = makeCells(3);
+	CleanupList queue;
+	for (auto& c : cells) {
+		queue.append(c.get());
+	}
+
+	// The contract leaves the link alone: it is no longer a queue link, and whoever
+	// reuses the cell overwrites it.
+	SkipEntry* popped = queue.popOldest();
+	check(popped == cells[0].get(), "the head came out");
+	check(popped->newerForCleanup == cells[1].get(), "and still names the cell that was behind it");
+	check(!queue.empty() && queue.oldestCV() == 1, "while the queue's head moved on");
+	end();
+}
+
+void anEmptiedQueueIsReusable() {
+	begin("anEmptiedQueueIsReusable");
+	auto cells = makeCells(4);
+	CleanupList queue;
+	std::deque<SkipEntry*> model;
+
+	// Emptying the queue must clear both ends: a stale tail would link the next append
+	// behind a cell that has already left.
+	queue.append(cells[0].get());
+	queue.append(cells[1].get());
+	queue.popOldest();
+	queue.popOldest();
+	check(queue.empty(), "the queue was emptied");
+
+	for (int i = 2; i < 4; ++i) {
+		queue.append(cells[i].get());
+		model.push_back(cells[i].get());
+	}
+	queueAgrees(queue, model, "and fills again from scratch");
+	check(cells[1]->newerForCleanup == nullptr, "without linking the departed tail to the newcomer");
+	end();
+}
+
+void aPoppedCellCanBeAppendedAgain() {
+	begin("aPoppedCellCanBeAppendedAgain");
+	auto cells = makeCells(3);
+	CleanupList queue;
+	std::deque<SkipEntry*> model;
+	for (auto& c : cells) {
+		queue.append(c.get());
+		model.push_back(c.get());
+	}
+
+	// A recycled cell rejoins at the tail, carrying the link of its old position.
+	SkipEntry* recycled = queue.popOldest();
+	model.pop_front();
+	queue.append(recycled);
+	model.push_back(recycled);
+	queueAgrees(queue, model, "it joins at the new position, not its former one");
+	end();
+}
+
+void queueOperationsTouchOnlyTheTemporalLink() {
+	begin("queueOperationsTouchOnlyTheTemporalLink");
+	auto cells = makeCells(3);
+	auto others = makeCells(6);
+	CleanupList queue;
+
+	for (int i = 0; i < 3; ++i) {
+		cells[i]->previous = others[i].get();
+		cells[i]->next = others[i + 3].get();
+		cells[i]->up = others[(i + 1) % 6].get();
+		cells[i]->down = others[(i + 2) % 6].get();
+		cells[i]->summary.maxCV = 100 + i;
+		cells[i]->kind = i % 2 == 0 ? ConflictKind::Point : ConflictKind::Range;
+		cells[i]->level = static_cast<Level>(i);
+		queue.append(cells[i].get());
+	}
+	queue.popOldest();
+
+	bool untouched = true;
+	for (int i = 0; i < 3; ++i) {
+		untouched = untouched && cells[i]->previous == others[i].get() &&
+		            cells[i]->next == others[i + 3].get() && cells[i]->up == others[(i + 1) % 6].get() &&
+		            cells[i]->down == others[(i + 2) % 6].get() && cells[i]->summary.maxCV.present() &&
+		            cells[i]->summary.maxCV.get() == 100 + i && cells[i]->recordCV == i &&
+		            cells[i]->level == static_cast<Level>(i) &&
+		            cells[i]->kind == (i % 2 == 0 ? ConflictKind::Point : ConflictKind::Range);
+	}
+	check(untouched, "horizontal and vertical links, summaries and data are as they were");
+	end();
+}
+
+void randomAppendsAndPopsAgreeWithTheModel() {
+	begin("randomAppendsAndPopsAgreeWithTheModel");
+	constexpr int CELLS = 40;
+	constexpr int STEPS = 20000;
+	auto cells = makeCells(CELLS);
+	CleanupList queue;
+	std::deque<SkipEntry*> model;
+	std::vector<SkipEntry*> spare;
+
+	// Both kinds, several levels and repeated versions, as one queue shared by both
+	// indexes and every level holds. A fixed seed, so a failure reproduces; popped cells
+	// rejoin with the link of their previous position still in them.
+	std::mt19937 random(20260927);
+	for (int i = 0; i < CELLS; ++i) {
+		cells[i]->kind = i % 2 == 0 ? ConflictKind::Point : ConflictKind::Range;
+		cells[i]->level = static_cast<Level>(i % 4);
+		cells[i]->recordCV = static_cast<Version>(random() % 8);
+		spare.push_back(cells[i].get());
+	}
+
+	int appends = 0, pops = 0, emptied = 0;
+	bool agrees = true;
+	for (int step = 0; step < STEPS && agrees; ++step) {
+		const bool append = model.empty() || (!spare.empty() && random() % 2 == 0);
+		if (append) {
+			const size_t pick = random() % spare.size();
+			SkipEntry* entry = spare[pick];
+			spare.erase(spare.begin() + pick);
+			queue.append(entry);
+			model.push_back(entry);
+			++appends;
+		} else {
+			SkipEntry* popped = queue.empty() ? nullptr : queue.popOldest();
+			agrees = check(popped == model.front(), "every pop returns the model's head");
+			spare.push_back(model.front());
+			model.pop_front();
+			++pops;
+			emptied += model.empty() ? 1 : 0;
+		}
+		agrees = queueAgrees(queue, model, "the queue agrees with the model after every step") && agrees;
+	}
+
+	check(appends > STEPS / 3 && pops > STEPS / 3, "both operations were exercised");
+	check(emptied > 0, "and the queue was emptied and refilled along the way");
+	end();
+}
+
+// ---------- HeapPageTable ----------
+
+void anEmptyTableFindsNothing() {
