+void keysWithZeroBytesRoundTrip() {
+	begin("keysWithZeroBytesRoundTrip");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+
+	// Keys are arbitrary bytes, so a zero byte is data, never a terminator, and
+	// a length must never be recomputed from the bytes.
+	std::string key = "ab";
+	key.push_back('\0');
+	key += "cd";
+	key.push_back('\0');
+	key.push_back('\0');
+	const std::string allZeros(8, '\0');
+
+	const HeapRef p = appended(heap.appendPoint(1, asRef(key)),
+							   "a key with embedded zero bytes is appended");
+	const PointConflictView pv = pointAt(heap, p, "and it is readable");
+	check(pv.key.size() == static_cast<int>(key.size()), "its length counts the zero bytes");
+	check(pv.key == asRef(key), "and every byte, zeros included, survives");
+
+	const HeapRef z = appended(heap.appendPoint(2, asRef(allZeros)),
+							   "a key of nothing but zero bytes is appended");
+	const PointConflictView zv = pointAt(heap, z, "and it is readable");
+	check(zv.key == asRef(allZeros), "it reads back whole");
+	check(zv.key.size() == 8, "with its full length");
+
+	// The two keys of a range must stay separate when both contain zeros.
+	std::string from = "a";
+	from.push_back('\0');
+	std::string to = "b";
+	to.push_back('\0');
+	to.push_back('\0');
+	const HeapRef r = appended(heap.appendRange(3, asRef(from), asRef(to)),
+							   "a range with zero bytes in both keys is appended");
+	const RangeConflictView rv = rangeAt(heap, r, "and it is readable");
+	check(rv.begin == asRef(from), "the begin key is exact");
+	check(rv.end == asRef(to), "the end key is exact, and the split is by length");
+	end();
+}
