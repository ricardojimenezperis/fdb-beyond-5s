+void pointBatchesSplitMergeAndBecomeRanges() {
+    constexpr unsigned count = 1500;
+    const unsigned length = std::max<size_t>(4, Tree::InlineKeyBytes + 8);
+    std::vector<std::string> begins, ends;
+    begins.reserve(count);
+    ends.reserve(count);
+    for (unsigned i = 0; i < count; ++i) {
+        begins.push_back(key(4 * i, length));
+        ends.push_back(begins.back() + '\0');
+    }
+    Tree tree(256, 0);
+    std::vector<Tree::Write> writes;
+    for (unsigned i = 0; i < count; ++i) writes.push_back({sv(begins[i]), StringRef(), ConflictKind::Point});
+    tree.addWrites(1, writes.data(), writes.size());
+    CHECK(tree.root_ && !tree.root_->leaf);
+    verify(tree);
+    writes.clear();
+    for (unsigned i = 0; i < count; i += 3) writes.push_back({sv(begins[i]), StringRef(), ConflictKind::Point});
+    tree.addWrites(2, writes.data(), writes.size());
+    verify(tree);
+    auto checkQueries = [&](Version rv, unsigned stride) {
+        std::vector<Tree::Query> queries;
+        for (unsigned i = 0; i < count; ++i) queries.push_back({rv, sv(begins[i]), sv(ends[i]), false});
+        tree.hasConflicts(queries.data(), queries.size());
+        for (unsigned i = 0; i < count; ++i) CHECK(queries[i].conflict == (i % stride == 0));
+    };
+    checkQueries(0, 1);
+    checkQueries(1, 3);
+    tree.validationMinRV_ = 1;
+    drainExpired(tree);
+    tree.cleanup(tree.leafCount_, tree.nodeCount());
+    verify(tree);
+    checkQueries(1, 3);
+    for (auto* leaf = tree.firstLeaf_; leaf; leaf = leaf->navigation.leaf.next)
+        for (unsigned i = 0; i < leaf->size(); ++i)
+            if (leaf->at(i).cv > tree.validationMinRV()) CHECK(Tree::endSharesStorage(leaf->at(i)));
+    const std::string finish = key(4 * count, length);
+    tree.addRange(3, sv(begins[0]), sv(finish));
+    CHECK(contents(tree) == (std::vector<Interval>{{begins[0], finish, 3}}));
+    CHECK(!Tree::endSharesStorage(tree.root_->at(0)));
+    verify(tree);
+    writes.clear();
+    for (unsigned i = 0; i < count; i += 11) writes.push_back({sv(begins[i]), StringRef(), ConflictKind::Point});
+    tree.addWrites(4, writes.data(), writes.size());
+    verify(tree);
+    checkQueries(3, 11);
+}
