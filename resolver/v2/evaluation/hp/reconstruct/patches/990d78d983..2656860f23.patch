+void splitOneIntervalThroughLeafPartition() {
+    for (unsigned count : {Tree::Capacity - 1, Tree::Capacity})
+        for (unsigned oldRank : {0U, Tree::Capacity / 2 - 1, count - 1}) {
+        Tree tree(32, 0);
+        std::vector<Interval> expected;
+        for (unsigned i = 0; i < count; ++i) {
+            tree.addRange(1, sv(key(4 * i)), sv(key(4 * i + 3)));
+            if (i != oldRank) expected.emplace_back(key(4 * i), key(4 * i + 3), 1);
+            else {
+                expected.emplace_back(key(4 * i), key(4 * i + 1), 1);
+                expected.emplace_back(key(4 * i + 1), key(4 * i + 2), 2);
+                expected.emplace_back(key(4 * i + 2), key(4 * i + 3), 1);
+            }
+        }
+        const auto before = tree.stats();
+        tree.addRange(2, sv(key(4 * oldRank + 1)), sv(key(4 * oldRank + 2)));
+        CHECK(contents(tree) == expected);
+        CHECK(tree.stats().splits == before.splits + 1 && tree.height() == 2);
+        CHECK(tree.stats().intervalInsertions == before.intervalInsertions + 2);
+        CHECK(tree.stats().splitFragmentsInserted == before.splitFragmentsInserted + 1);
+        CHECK(tree.stats().leftFragmentsTrimmed == before.leftFragmentsTrimmed + 1);
+        if constexpr (Tree::Stats::searchEnabled) CHECK(tree.stats().writeRootSearches == before.writeRootSearches);
+        const auto left = entryAt(tree, key(4 * oldRank));
+        const auto middle = entryAt(tree, key(4 * oldRank + 1));
+        const auto right = entryAt(tree, key(4 * oldRank + 2));
+        CHECK(sameRef(left.end, middle.begin) && sameRef(right.begin, middle.end));
+        verify(tree);
+    }
