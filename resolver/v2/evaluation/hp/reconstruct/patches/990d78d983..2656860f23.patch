+void workloadReversalsShareSlots() {
+    for (unsigned budget : {2U, 4U, 8U}) for (bool startsLong : {false, true}) {
+        Tree tree(budget, 0);
+        std::vector<Interval> model;
+        std::map<const Tree::Node*, unsigned> uses;
+        unsigned keyToIndex = 0, indexToKey = 0;
+        bool full = false;
+        Version cv = 0;
+        unsigned serial = 0;
+        std::mt19937 rng(32 + budget + startsLong);
+        auto observe = [&] {
+            for (auto* page = tree.pages_; page; page = page->next) {
+                auto* raw = reinterpret_cast<const std::byte*>(page) + Tree::nodeOffset();
+                for (size_t j = 0; j < Tree::nodesPerPage(); ++j) {
+                    const auto* node = reinterpret_cast<const Tree::Node*>(raw + j * sizeof(Tree::Node));
+                    const unsigned use = node->allocated ? 2 : node->ageLinked && node->ageUse == PageUse::Heap ? 1 : 0;
+                    if (!use) continue;
+                    auto& old = uses[node];
+                    keyToIndex += old == 1 && use == 2;
+                    indexToKey += old == 2 && use == 1;
+                    old = use;
+                }
+            }
+            full |= tree.budget().freePages == 0;
+            CHECK(tree.budget().heapPages == 0 && tree.budget().indexPages + tree.budget().freePages == budget);
+        };
+        for (unsigned phase = 0; phase < 3; ++phase) {
+            const bool longKeys = startsLong != bool(phase & 1);
+            const unsigned length = longKeys ? 4096 : 16;
+            const unsigned total = longKeys ? budget * 128 : budget * Tree::nodesPerPage() * Tree::Capacity * 2;
+            for (unsigned n = 0; n < total; n += 64) {
+                ++cv;
+                std::vector<std::string> storage;
+                std::vector<Tree::Write> writes;
+                storage.reserve(128); writes.reserve(64);
+                for (unsigned j = 0; j < std::min(64U, total - n); ++j) {
+                    // Alternating point/range traffic; byte order stays disjoint.
+                    const unsigned id = 4 * serial++;
+                    storage.push_back(key(id, length));
+                    storage.push_back(key(id + 2, length));
+                    const bool point = j & 1;
+                    writes.push_back({sv(storage[2*j]), point ? StringRef() : sv(storage[2*j+1]),
+                                      point ? ConflictKind::Point : ConflictKind::Range});
+                    model.emplace_back(storage[2*j], point ? storage[2*j] + '\0' : storage[2*j+1], cv);
+                }
+                tree.addWrites(cv, writes.data(), writes.size());
+                const Version floor = tree.validationMinRV();
+                pruneModel(model, floor);
+                for (unsigned q = 0; q < 12; ++q) {
+                    std::string begin, end;
+                    if (!model.empty() && (q & 1)) {
+                        const auto& old = model[rng() % model.size()];
+                        begin = std::get<0>(old); end = std::get<1>(old);
+                    } else {
+                        const unsigned start = rng() % (4*serial + 1);
+                        begin = key(start, 16); end = key(start + 1 + rng()%16, 16);
+                    }
+                    const Version rv = floor + rng() % (cv - floor + 1);
+                    CHECK(tree.hasConflict(rv, sv(begin), sv(end)) == referenceConflict(model, rv, begin, end));
+                }
+                observe();
+                if ((n / 64) % 8 == 0) verify(tree);
+            }
+            CHECK(full && tree.validationMinRV() > 0);
+            verify(tree);
+            std::printf("[pool=%u start=%s phase=%u keys=%u heap=%llu B=%llu floor=%lld] ",
+                        budget, startsLong ? "long" : "short", phase, length,
+                        (unsigned long long)tree.budget().heapPages,
+                        (unsigned long long)tree.budget().indexPages, (long long)tree.validationMinRV());
+        }
+        CHECK(keyToIndex > 0 && indexToKey > 0);
+        CHECK(uses.size() <= budget * Tree::nodesPerPage());
+        CHECK(tree.stats().reclaimAgeCandidates > 0 && tree.stats().reclaimNodeCandidates > 0);
+        CHECK(tree.stats().reclaimLeavesVisited == 0);
+        CHECK(tree.budget().occupiedPages() <= budget);
+        std::printf("[key->B=%u B->key=%u] ", keyToIndex, indexToKey);
+    }
+}
