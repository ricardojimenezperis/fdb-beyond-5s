+		check(levelVersions(low.ranges_, 1) == std::vector<Version>{ 1 } &&
+		          levelVersions(low.ranges_, 0) == (std::vector<Version>{ 1, 20 }),
+		      "the conflicting write is only at level zero, after a tall tower");
+		check(rangeConflict(low, 10, "n", "o"), "a conflict that exists only at level zero is found");
+		check(!rangeConflict(low, 20, "n", "o"), "and is a conflict only above the read version");
