+
+unsigned KeyPermutation::slotAt(unsigned rank) const {
+    ASSERT(rank < size());
+    return (bits_ >> (4 * rank + 4)) & 15;
+}
+
+unsigned KeyPermutation::rankOfSlot(unsigned slot) const {
+    constexpr uint64_t ones = 0x1111111111111111ULL;
+    const uint64_t x = bits_ ^ (slot * ones);
+    const uint64_t zeroes = ~(x | (x >> 1) | (x >> 2) | (x >> 3)) & ones;
+    const uint64_t occupied = ((uint64_t{1} << (4 * size())) - 1) << 4;
+    ASSERT((zeroes & occupied) != 0);
+    return __builtin_ctzll(zeroes & occupied) / 4 - 1;
+}
+
+void KeyPermutation::insert(unsigned rank, unsigned slot) {
+    ASSERT(size() < Capacity && rank <= size() && slot < Capacity);
+    const unsigned shift = 4 * rank + 4;
+    const uint64_t upper = ~uint64_t{0} << shift;
+    bits_ = ((bits_ & upper) << 4) | (bits_ & ~upper) | (uint64_t{slot} << shift);
+    ++bits_;
+}
+
+void KeyPermutation::erase(unsigned rank) {
+    ASSERT(rank < size());
+    const unsigned shift = 4 * (rank + 1);
+    const uint64_t upper = shift == 60 ? 0 : ~uint64_t{0} << (shift + 4);
+    const uint64_t lower = (uint64_t{1} << shift) - 1;
+    bits_ = ((bits_ & upper) >> 4) | (bits_ & lower);
+    --bits_;
+}
+
+void OccupancyHistory::added(unsigned count) {
+    if (count >= 64) bits = ~uint64_t{0};
+    else if (count) bits = (bits << count) | ((uint64_t{1} << count) - 1);
+}
+
+void OccupancyHistory::removed(unsigned count) {
+    if (count >= 64) bits = 0;
+    else if (count) bits <<= count;
+}
+
+int OccupancyHistory::balance() const { return 2 * __builtin_popcountll(bits) - 64; }
+bool OccupancyHistory::recovering() const {
+    return __builtin_popcountll(bits & 0xFFFF) > 8;
+}
+
+PagedBTreeConflictSet::PagedBTreeConflictSet(uint64_t limitPages, Version initialValidationMinRV)
+  : validationMinRV_(initialValidationMinRV), pool_(limitPages), heap_(pool_) {
+    pool_.setReclaimer(this, reclaimThunk);
+}
+
+PagedBTreeConflictSet::~PagedBTreeConflictSet() {
+    // Nodes contain no owning allocations, and the heap is destroyed before the pool
+    pool_.setReclaimer(nullptr, nullptr);
+}
+
+size_t PagedBTreeConflictSet::nodeOffset() {
+    return (sizeof(NodePage) + alignof(Node) - 1) & ~(alignof(Node) - 1);
+}
+
+size_t PagedBTreeConflictSet::nodesPerPage() {
+    return (HISTORY_PAGE_BYTES - nodeOffset()) / sizeof(Node);
+}
+
+void PagedBTreeConflictSet::addFree(Node* node) {
+    node->freePrevious = nullptr;
+    node->freeNext = free_;
+    if (free_) free_->freePrevious = node;
+    free_ = node;
+    ++freeNodes_;
+}
+
+void PagedBTreeConflictSet::removeFree(Node* node) {
+    if (node->freePrevious) node->freePrevious->freeNext = node->freeNext;
+    else free_ = node->freeNext;
+    if (node->freeNext) node->freeNext->freePrevious = node->freePrevious;
+    --freeNodes_;
+}
+
+PagedBTreeConflictSet::Node* PagedBTreeConflictSet::allocateNode() {
+    if (!free_) {
+        PoolPage* raw = pool_.acquire(PageUse::Index);
+        if (raw) {
+            auto* page = new (raw) NodePage{nullptr, pages_, 0};
+            if (pages_) pages_->previous = page;
+            pages_ = page;
+            auto* bytes = reinterpret_cast<std::byte*>(page) + nodeOffset();
+            for (size_t i = 0; i < nodesPerPage(); ++i) {
+                auto* node = new (bytes + i * sizeof(Node)) Node;
+                node->owner = page;
+                addFree(node);
+            }
+        }
+    }
+    // Reclamation can supply free nodes instead of a whole page
+    if (!free_) throw std::bad_alloc();
+    Node* node = free_;
+    removeFree(node);
+    node->allocated = true;
+    ++node->owner->live;
+    return node;
+}
+
+void PagedBTreeConflictSet::releaseNode(Node* node) {
+    unqueue(node);
+    ASSERT(node->allocated);
+    --node->owner->live;
+    node->allocated = false;
+    addFree(node);
+}
+
+void PagedBTreeConflictSet::releaseEmptyPages() {
+    for (NodePage* page = pages_; page;) {
+        NodePage* next = page->next;
+        if (page->live == 0) {
+            auto* bytes = reinterpret_cast<std::byte*>(page) + nodeOffset();
+            for (size_t i = 0; i < nodesPerPage(); ++i)
+                removeFree(reinterpret_cast<Node*>(bytes + i * sizeof(Node)));
+            if (page->previous) page->previous->next = page->next;
+            else pages_ = page->next;
+            if (page->next) page->next->previous = page->previous;
+            pool_.release(reinterpret_cast<PoolPage*>(page), PageUse::Index);
+            ++stats_.indexPagesReleased;
+        }
+        page = next;
+    }
+}
+
+void PagedBTreeConflictSet::reserve(Reservation& reservation) {
+    // At most three interval insertions, each needing one sibling and possibly a root
+    while (reservation.size < reservation.nodes.size()) {
+        reservation.nodes[reservation.size++] = allocateNode();
+        BTREE_SEARCH_STAT(++stats_.nodesReserved);
+    }
+}
+
+PagedBTreeConflictSet::Node* PagedBTreeConflictSet::take(Reservation& reservation, bool leaf) {
+    ASSERT(reservation.size != 0);
+    Node* node = reservation.nodes[--reservation.size];
+    BTREE_SEARCH_STAT(++stats_.nodesTaken);
+    NodePage* owner = node->owner;
+    *node = Node{};
+    node->owner = owner;
+    node->allocated = true;
+    node->leaf = leaf;
+    enqueue(node);
+    if (leaf) ++leafCount_;
+    return node;
+}
+
+void PagedBTreeConflictSet::releaseReservation(Reservation& reservation) {
+    while (reservation.size) releaseNode(reservation.nodes[--reservation.size]);
+}
+
+void PagedBTreeConflictSet::reclaimThunk(void* context, PageUse use) {
+    static_cast<PagedBTreeConflictSet*>(context)->reclaim(use);
+}
+
+void PagedBTreeConflictSet::reclaim(PageUse use) {
+    ++stats_.reclaimCalls;
+    const uint64_t visits = leafCount_;
+    for (uint64_t i = 0; i < visits && firstLeaf_; ++i) {
+        Node* leaf = cleanupCursor_ ? cleanupCursor_ : firstLeaf_;
+        Node* next = leaf->leafNext;
+        purgeLeaf(leaf);
+        ++stats_.reclaimLeavesVisited;
+        cleanupCursor_ = next ? next : firstLeaf_;
+        if (use == PageUse::Index && freeNodes_) return;
+    }
+    releaseEmptyPages();
+    if (pool_.budget().freePages || (use == PageUse::Index && freeNodes_)) return;
+    if (use == PageUse::Index && pool_.budget().heapPages <= 1) return;
+    const auto oldest = heap_.oldestPageNewestCV();
+    if (!oldest.present()) return;
+    validationMinRV_ = std::max(validationMinRV_, oldest.get());
+    heap_.reclaimOldest();
+    ++stats_.heapPagesReclaimed;
+}
+
+void PagedBTreeConflictSet::unqueue(Node* node) {
+    if (!node->queued) return;
+    Queue& queue = queues_[node->leaf][node->queueCount];
+    if (node->queuePrevious) node->queuePrevious->queueNext = node->queueNext;
+    else queue.head = node->queueNext;
+    if (node->queueNext) node->queueNext->queuePrevious = node->queuePrevious;
+    else queue.tail = node->queuePrevious;
+    --queue.count;
+    node->queued = false;
+}
+
+void PagedBTreeConflictSet::enqueue(Node* node) {
+    unqueue(node);
+    Queue& queue = queues_[node->leaf][node->size()];
+    node->queuePrevious = queue.tail;
+    node->queueNext = nullptr;
+    if (queue.tail) queue.tail->queueNext = node;
+    else queue.head = node;
+    queue.tail = node;
+    ++queue.count;
+    node->queueCount = node->size();
+    node->queued = true;
+}
+
+void PagedBTreeConflictSet::insertSlot(Node* node, unsigned rank, const Entry& entry) {
+    const unsigned freeMask = (~node->occupied) & 0x7FFF;
+    ASSERT(freeMask != 0);
+    unsigned candidates = freeMask & (~0U << node->cursor);
+    if (!candidates) candidates = freeMask;
+    const unsigned slot = __builtin_ctz(candidates);
+    node->cursor = (slot + 1) % Capacity;
+    node->slots[slot] = entry;
+    node->occupied |= 1U << slot;
+    node->order.insert(rank, slot);
+    BTREE_SEARCH_STAT(++stats_.slotInserts);
+    if (entry.child) {
+        entry.child->parent = node;
+        entry.child->parentSlot = slot;
+    }
+    node->history.added(1);
+    enqueue(node);
+}
+
+void PagedBTreeConflictSet::eraseSlot(Node* node, unsigned rank) {
+    const unsigned slot = node->order.slotAt(rank);
+    node->occupied &= ~(1U << slot);
+    node->order.erase(rank);
+    BTREE_SEARCH_STAT(++stats_.slotErases);
+    node->history.removed(1);
+    enqueue(node);
+}
+
+StringRef PagedBTreeConflictSet::key(const HeapRef& ref) const {
+    return heap_.getKey(ref).get();
+}
+
+PagedBTreeConflictSet::Entry PagedBTreeConflictSet::minimum(Node* node) {
+    BTREE_SEARCH_STAT(++stats_.minimumCalls);
+    for (unsigned rank = 0; rank < node->size(); ++rank) {
+        Entry& entry = node->at(rank);
+        BTREE_SEARCH_STAT(++stats_.minimumEntries);
+        if (entry.cv <= validationMinRV_) continue;
+        if (node->leaf) return entry;
+        refreshSeparator(entry);
+        Entry result = entry;
+        result.cv = entry.firstCV;
+        return result;
+    }
+    return Entry{};
+}
+
+void PagedBTreeConflictSet::refreshSeparator(Entry& entry) {
+    if (entry.firstCV > validationMinRV_) return;
+    ASSERT(entry.cv > validationMinRV_);
+    const Entry first = minimum(entry.child);
+    entry.begin = first.begin;
+    entry.firstCV = first.cv;
+    BTREE_SEARCH_STAT(++stats_.separatorRefreshes);
+}
+
+void PagedBTreeConflictSet::refresh(Node* node) {
+    BTREE_SEARCH_STAT(++stats_.refreshes);
+    BTREE_SEARCH_STAT(stats_.refreshEntries += node->size());
+    node->maxCV = NoVersion;
+    unsigned criticalChildren = 0;
+    for (unsigned i = 0; i < node->size(); ++i) {
+        Entry& entry = node->at(i);
+        if (!node->leaf) {
+            entry.cv = entry.child->maxCV;
+            const Entry first = minimum(entry.child);
+            entry.begin = first.begin;
+            entry.firstCV = first.cv;
+            criticalChildren += entry.child->critical;
+        }
+        node->maxCV = std::max(node->maxCV, entry.cv);
+    }
+    // Deletions increase slack, and merges must explicitly preserve this invariant
+    ASSERT(node->leaf || Capacity - node->size() >= criticalChildren);
+    node->critical = node->leaf ? node->size() == Capacity
+                               : Capacity - node->size() == criticalChildren;
+}
+
+void PagedBTreeConflictSet::refreshUp(Node* node) {
+    while (node) {
+        refresh(node);
+        node = node->parent;
+    }
+}
+
+unsigned PagedBTreeConflictSet::liveRanks(Node* node, std::array<unsigned, Capacity>& ranks) {
+    unsigned count = 0;
+    for (unsigned i = 0; i < node->size(); ++i)
+        if (node->at(i).cv > validationMinRV_) ranks[count++] = i;
+    BTREE_SEARCH_STAT(stats_.liveRankEntries += node->size());
+    return count;
+}
+
+unsigned PagedBTreeConflictSet::childRank(Node* node, StringRef begin) {
+    std::array<unsigned, Capacity> ranks;
+    const unsigned count = liveRanks(node, ranks);
+    ASSERT(count != 0);
+    unsigned lo = 0, hi = count;
+    while (lo < hi) {
+        const unsigned mid = lo + (hi - lo) / 2;
+        BTREE_SEARCH_STAT(++stats_.childRankProbes);
+        Entry& entry = node->at(ranks[mid]);
+        refreshSeparator(entry);
+        if (!(begin < key(entry.begin))) lo = mid + 1;
+        else hi = mid;
+    }
+    return ranks[lo == 0 ? 0 : lo - 1];
+}
+
+PagedBTreeConflictSet::Node* PagedBTreeConflictSet::findLeaf(StringRef begin) {
+    Node* node = root_;
+    BTREE_SEARCH_STAT(++stats_.descents);
+    while (!node->leaf) {
+        BTREE_SEARCH_STAT(++stats_.descentNodes);
+        node = node->at(childRank(node, begin)).child;
+    }
+    return node;
+}
+
+void PagedBTreeConflictSet::collapseRoot() {
+    while (root_ && !root_->leaf && root_->size() == 1) {
+        Node* old = root_;
+        root_ = old->at(0).child;
+        root_->parent = nullptr;
+        releaseNode(old);
+    }
+}
+
+void PagedBTreeConflictSet::removeEmpty(Node* node) {
+    ASSERT(node->size() == 0);
+    Node* parent = node->parent;
+    if (node->leaf) {
+        if (node->leafPrevious) node->leafPrevious->leafNext = node->leafNext;
+        else firstLeaf_ = node->leafNext;
+        if (node->leafNext) node->leafNext->leafPrevious = node->leafPrevious;
+        if (cleanupCursor_ == node) cleanupCursor_ = node->leafNext;
+        --leafCount_;
+    }
+    if (parent) eraseSlot(parent, parent->order.rankOfSlot(node->parentSlot));
+    else root_ = nullptr;
+    releaseNode(node);
+    if (parent && !parent->size()) removeEmpty(parent);
+    else if (parent) refreshUp(parent);
+    collapseRoot();
+}
+
+void PagedBTreeConflictSet::purgeLeaf(Node* leaf) {
+    bool changed = false;
+    for (unsigned rank = 0; rank < leaf->size();) {
+        if (leaf->at(rank).cv <= validationMinRV_) {
+            eraseSlot(leaf, rank);
+            ++stats_.expiredIntervals;
+            changed = true;
+        } else ++rank;
+    }
+    if (!leaf->size()) removeEmpty(leaf);
+    else if (changed) refreshUp(leaf);
+}
+
+void PagedBTreeConflictSet::destroySubtree(Node* node) {
+    if (!node->leaf) {
+        for (unsigned i = 0; i < node->size(); ++i) destroySubtree(node->at(i).child);
+    } else {
+        --leafCount_;
+        stats_.expiredIntervals += node->size();
+    }
+    releaseNode(node);
+}
+
+PagedBTreeConflictSet::Node* PagedBTreeConflictSet::split(Node* node, Reservation& reservation) {
+    ASSERT(node->critical);
+    Node* parent = node->parent;
+    Node* right = take(reservation, node->leaf);
+    const unsigned cut = node->size() / 2;
+    while (node->size() > cut) {
+        Entry entry = node->at(cut);
+        eraseSlot(node, cut);
+        insertSlot(right, right->size(), entry);
+    }
+    if (node->leaf) {
+        right->leafNext = node->leafNext;
+        right->leafPrevious = node;
+        if (right->leafNext) right->leafNext->leafPrevious = right;
+        node->leafNext = right;
+    }
+    refresh(node);
+    refresh(right);
+    if (!parent) {
+        parent = take(reservation, false);
+        root_ = parent;
+        Entry leftEntry;
+        leftEntry.child = node;
+        insertSlot(parent, 0, leftEntry);
+    }
+    Entry rightEntry;
+    rightEntry.child = right;
+    const unsigned rank = parent->order.rankOfSlot(node->parentSlot);
+    insertSlot(parent, rank + 1, rightEntry);
+    refreshUp(parent);
+    ++stats_.splits;
+    if (!node->leaf) ++stats_.internalSplits;
+    return right;
+}
+
+void PagedBTreeConflictSet::insertInterval(const Entry& interval, Reservation& reservation) {
+    if (root_ && root_->maxCV <= validationMinRV_) {
+        destroySubtree(root_);
+        root_ = firstLeaf_ = cleanupCursor_ = nullptr;
+    }
+    if (!root_) {
+        root_ = take(reservation, true);
+        firstLeaf_ = root_;
+    }
+    Node* leaf = root_->leaf ? root_ : findLeaf(key(interval.begin));
+    if (leaf->size()) purgeLeaf(leaf);
+    if (!root_) {
+        root_ = take(reservation, true);
+        firstLeaf_ = root_;
+        leaf = root_;
+    }
+    // A leaf selected through a live child cannot disappear in purgeLeaf
+    Node* critical = nullptr;
+    for (Node* node = leaf; node; node = node->parent) {
+        if (node->critical) { critical = node; break; }
+    }
+    if (critical) {
+        Node* right = split(critical, reservation);
+        if (critical == leaf && !(key(interval.begin) < key(right->at(0).begin))) leaf = right;
+    }
+    const StringRef begin = key(interval.begin);
+    unsigned lo = 0, hi = leaf->size();
+    while (lo < hi) {
+        const unsigned mid = lo + (hi - lo) / 2;
+        BTREE_SEARCH_STAT(++stats_.leafSearchProbes);
+        if (key(leaf->at(mid).begin) < begin) lo = mid + 1;
+        else hi = mid;
+    }
+    insertSlot(leaf, lo, interval);
+    refreshUp(leaf);
+    ++stats_.intervalInsertions;
+}
+
+void PagedBTreeConflictSet::overwrite(const Entry& incoming, Reservation& reservation) {
+    if (root_ && root_->maxCV <= validationMinRV_) {
+        destroySubtree(root_);
+        root_ = firstLeaf_ = cleanupCursor_ = nullptr;
+    }
+    Entry left, right;
+    const StringRef begin = key(incoming.begin);
+    const StringRef end = key(incoming.end);
+    Node* leaf = root_ ? findLeaf(begin) : nullptr;
+    bool done = false;
+    while (leaf && !done) {
+        Node* next = leaf->leafNext;
+        bool changed = false;
+        BTREE_SEARCH_STAT(++stats_.overwriteLeaves);
+        for (unsigned rank = 0; rank < leaf->size();) {
+            const Entry old = leaf->at(rank);
+            BTREE_SEARCH_STAT(++stats_.overwriteEntries);
+            if (old.cv <= validationMinRV_) {
+                eraseSlot(leaf, rank);
+                ++stats_.expiredIntervals;
+                changed = true;
+                continue;
+            }
+            const StringRef oldBegin = key(old.begin);
+            if (!(oldBegin < end)) { done = true; break; }
+            const StringRef oldEnd = key(old.end);
+            if (!(begin < oldEnd)) { ++rank; continue; }
+            if (oldBegin < begin) {
+                left = old;
+                left.end = incoming.begin;
+            }
+            if (end < oldEnd) {
+                right = old;
+                right.begin = incoming.end;
+            }
+            eraseSlot(leaf, rank);
+            ++stats_.overwrittenIntervals;
+            changed = true;
+        }
+        if (!leaf->size()) removeEmpty(leaf);
+        else if (changed) refreshUp(leaf);
+        leaf = next;
+    }
+    if (left.cv != NoVersion) insertInterval(left, reservation);
+    insertInterval(incoming, reservation);
+    if (right.cv != NoVersion) insertInterval(right, reservation);
+}
+
+void PagedBTreeConflictSet::addRange(Version cv, StringRef begin, StringRef end) {
+    ASSERT(begin < end);
+    ASSERT(cv >= lastWriteCV_);
+    BTREE_SEARCH_STAT(++stats_.writes);
+    lastWriteCV_ = cv;
+    if (cv <= validationMinRV_) { ++stats_.discardedWrites; return; }
+    const auto record = heap_.appendRange(cv, begin, end);
+    if (!record.present()) throw std::bad_alloc();
+    Reservation reservation;
+    reserve(reservation);
+    // No paths or endpoint views survive an allocation boundary
+    if (cv <= validationMinRV_) {
+        releaseReservation(reservation);
+        ++stats_.discardedWrites;
+        return;
+    }
+    Entry incoming;
+    incoming.cv = cv;
+    incoming.begin = {record.get().pageID,
+                      record.get().offset + static_cast<uint32_t>(sizeof(RangeConflictHeader)),
+                      static_cast<uint32_t>(begin.size())};
+    incoming.end = {record.get().pageID, incoming.begin.offset + incoming.begin.length,
+                    static_cast<uint32_t>(end.size())};
+    overwrite(incoming, reservation);
+    releaseReservation(reservation);
+}
+
+void PagedBTreeConflictSet::addPoint(Version cv, StringRef point) {
+    std::string end;
+    if (point.size()) end.assign(reinterpret_cast<const char*>(point.begin()), point.size());
+    end.push_back('\0');
+    addRange(cv, point, StringRef(reinterpret_cast<const uint8_t*>(end.data()), end.size()));
+}
+
+void PagedBTreeConflictSet::addWrites(Version cv, const Write* writes, size_t count) {
+    for (size_t i = 0; i < count; ++i) {
+        if (cv <= validationMinRV_) { stats_.discardedWrites += count - i; return; }
+        if (writes[i].kind == ConflictKind::Point) addPoint(cv, writes[i].begin);
+        else addRange(cv, writes[i].begin, writes[i].end);
+    }
+}
+
+void PagedBTreeConflictSet::prepareSearchNode(Search& search) {
+    Node* node = search.frames[search.depth - 1].node;
+    BTREE_SEARCH_STAT(++stats_.visitedNodes);
+    for (unsigned i = 0; i < node->size(); ++i) {
+        Entry& entry = node->at(i);
+        if (entry.cv <= validationMinRV_) continue;
+        if (!node->leaf) refreshSeparator(entry);
+        __builtin_prefetch(heap_.recordAddress(entry.begin), 0, 1);
+        if (node->leaf && entry.cv > search.query->readVersion)
+            __builtin_prefetch(heap_.recordAddress(entry.end), 0, 1);
+    }
+    search.prepare = false;
+}
+
+bool PagedBTreeConflictSet::step(Search& search) {
+    if (!search.depth) return true;
+    Frame& frame = search.frames[search.depth - 1];
+    Node* node = frame.node;
+    Query& query = *search.query;
+    if (node->maxCV <= query.readVersion) {
+        --search.depth;
+        search.prepare = false;
+        return search.depth == 0;
+    }
+    if (search.prepare) { prepareSearchNode(search); return false; }
+    if (node->leaf) {
+        // At most fifteen local entries, with both endpoint loads prefetched
+        for (unsigned i = 0; i < node->size(); ++i) {
+            const Entry& entry = node->at(i);
+            BTREE_SEARCH_STAT(++stats_.queryLeafEntries);
+            if (entry.cv <= query.readVersion) continue;
+            if (!(key(entry.begin) < query.end)) break;
+            if (query.begin < key(entry.end)) { query.conflict = true; return true; }
+        }
+        --search.depth;
+        return search.depth == 0;
+    }
+    if (frame.next < 0) frame.next = childRank(node, query.begin);
+    while (static_cast<unsigned>(frame.next) < node->size()) {
+        Entry& entry = node->at(frame.next++);
+        if (entry.cv <= query.readVersion) continue;
+        // A previous visit may have skipped this separator by maxCV
+        refreshSeparator(entry);
+        if (!(key(entry.begin) < query.end)) {
+            --search.depth;
+            return search.depth == 0;
+        }
+        ASSERT(search.depth < MaxHeight);
+        search.frames[search.depth++] = Frame{entry.child};
+        __builtin_prefetch(entry.child, 0, 1);
+        search.prepare = true;
+        return false;
+    }
+    --search.depth;
+    return search.depth == 0;
+}
+
+void PagedBTreeConflictSet::hasConflicts(Query* queries, size_t count) {
+    for (size_t i = 0; i < count; ++i)
+        if (queries[i].readVersion < validationMinRV_) throw transaction_too_old();
+    BTREE_SEARCH_STAT(const uint64_t probesBefore = stats_.childRankProbes);
+    BTREE_SEARCH_STAT(const uint64_t liveBefore = stats_.liveRankEntries);
+    std::array<Search, SearchWidth> searches;
+    for (size_t start = 0; start < count; start += SearchWidth) {
+        const unsigned width = std::min<size_t>(SearchWidth, count - start);
+        unsigned remaining = 0;
+        for (unsigned i = 0; i < width; ++i) {
+            Query& query = queries[start + i];
+            query.conflict = false;
+            BTREE_SEARCH_STAT(++stats_.queries);
+            Search& search = searches[i];
+            search.query = &query;
+            search.depth = 0;
+            search.prepare = true;
+            if (root_ && root_->maxCV > query.readVersion && query.begin < query.end) {
+                search.frames[0] = Frame{root_};
+                search.depth = 1;
+                ++remaining;
+            }
+        }
+        while (remaining) {
+            for (unsigned i = 0; i < width; ++i) {
+                if (!searches[i].depth) continue;
+                if (step(searches[i])) { searches[i].depth = 0; --remaining; }
+            }
+        }
+    }
+    BTREE_SEARCH_STAT(stats_.queryChildRankProbes += stats_.childRankProbes - probesBefore);
+    BTREE_SEARCH_STAT(stats_.queryLiveRankEntries += stats_.liveRankEntries - liveBefore);
+}
+
+bool PagedBTreeConflictSet::hasConflict(Version readVersion, StringRef begin, StringRef end) {
+    Query query{readVersion, begin, end};
+    hasConflicts(&query, 1);
+    return query.conflict;
+}
+
+bool PagedBTreeConflictSet::tryMerge(Node* node, bool memoryPressure) {
+    if (!node->parent) return false;
+    if (!memoryPressure && (node->history.balance() > 0 || node->history.recovering())) return false;
+    Node* parent = node->parent;
+    const unsigned rank = parent->order.rankOfSlot(node->parentSlot);
+    Node* left = node;
+    Node* right = nullptr;
+    if (rank + 1 < parent->size()) right = parent->at(rank + 1).child;
+    else if (rank) { left = parent->at(rank - 1).child; right = node; }
+    if (!right || left->size() + right->size() > 12) return false;
+    unsigned criticalChildren = 0;
+    if (!node->leaf) {
+        for (unsigned i = 0; i < left->size(); ++i) criticalChildren += left->at(i).child->critical;
+        for (unsigned i = 0; i < right->size(); ++i) criticalChildren += right->at(i).child->critical;
+        if (left->size() + right->size() + criticalChildren > Capacity) return false;
+    }
+    while (right->size()) {
+        const Entry entry = right->at(0);
+        eraseSlot(right, 0);
+        insertSlot(left, left->size(), entry);
+    }
+    if (left->leaf) {
+        left->leafNext = right->leafNext;
+        if (right->leafNext) right->leafNext->leafPrevious = left;
+        if (cleanupCursor_ == right) cleanupCursor_ = left;
+        --leafCount_;
+    }
+    eraseSlot(parent, parent->order.rankOfSlot(right->parentSlot));
+    releaseNode(right);
+    refreshUp(left);
+    const bool internal = !left->leaf;
+    collapseRoot();
+    ++stats_.merges;
+    if (internal) ++stats_.internalMerges;
+    return true;
+}
+
+uint64_t PagedBTreeConflictSet::cleanup(unsigned leafBudget, unsigned mergeCandidates, bool memoryPressure) {
+    const uint64_t before = stats_.expiredIntervals;
+    const uint64_t visits = std::min<uint64_t>(leafBudget, leafCount_);
+    for (uint64_t i = 0; i < visits && firstLeaf_; ++i) {
+        Node* leaf = cleanupCursor_ ? cleanupCursor_ : firstLeaf_;
+        Node* next = leaf->leafNext;
+        purgeLeaf(leaf);
+        ++stats_.cleanupLeavesVisited;
+        cleanupCursor_ = next ? next : firstLeaf_;
+    }
+    unsigned examined = 0;
+    for (unsigned count = 1; count <= 6 && examined < mergeCandidates; ++count) {
+        for (unsigned type = 0; type < 2 && examined < mergeCandidates; ++type) {
+            Node* candidate = queues_[type][count].head;
+            // Look beyond a growing head, without changing its occupancy age
+            for (unsigned lookahead = 0; candidate && lookahead < 2 && examined < mergeCandidates;
+                 ++lookahead) {
+                ++examined;
+                ++stats_.mergeCandidatesExamined;
+                Node* next = candidate->queueNext;
+                if (tryMerge(candidate, memoryPressure)) break;
+                candidate = next;
+            }
+        }
+    }
+    releaseEmptyPages();
+    return stats_.expiredIntervals - before;
+}
+
+unsigned PagedBTreeConflictSet::height() const {
+    unsigned result = 0;
+    for (Node* node = root_; node; node = node->leaf ? nullptr : node->at(0).child) ++result;
+    return result;
+}
+
+uint64_t PagedBTreeConflictSet::occupancy(bool leaves, unsigned count) const {
+    ASSERT(count <= Capacity);
+    return queues_[leaves][count].count;
+}
+
+uint64_t PagedBTreeConflictSet::nodeCount() const {
+    uint64_t result = 0;
+    for (const auto& type : queues_)
+        for (const Queue& queue : type) result += queue.count;
+    return result;
+}
+
+std::vector<PagedBTreeConflictSet::Level> PagedBTreeConflictSet::levels() const {
+    std::vector<Level> result;
+    auto visit = [&](auto&& self, const Node* node, unsigned depth) -> void {
+        // Indexed on every access: the recursion below can grow the vector and move its elements
+        if (result.size() <= depth) result.resize(depth + 1);
+        ++result[depth].nodes;
+        result[depth].entries += node->size();
+        for (unsigned i = 0; i < node->size(); ++i) {
+            if (node->at(i).cv > validationMinRV_) ++result[depth].liveEntries;
+            if (!node->leaf) self(self, node->at(i).child, depth + 1);
+        }
+    };
+    if (root_) visit(visit, root_, 0);
+    return result;
+}
+
+} // namespace paged_btree
diff --git a/fdbserver/resolver/btree/initial/PagedBTreeConflictSet.h b/fdbserver/resolver/btree/initial/PagedBTreeConflictSet.h
new file mode 100644
index 0000000000000000000000000000000000000000..23cb6b106c39fb48d49901a18f64ea6ad29cea5d
--- /dev/null
+++ b/fdbserver/resolver/btree/initial/PagedBTreeConflictSet.h
@@ -0,0 +1,242 @@
+#pragma once
+
+#include "PagedTemporalSkipList.h"
+
+#include <array>
+#include <cstdint>
+#include <limits>
+#include <vector>
+
+namespace paged_btree {
+
+// Adapted from the supplied KeyPermutation, with fifteen physical slots
+class KeyPermutation {
+public:
+    static constexpr unsigned Capacity = 15;
+    unsigned size() const { return bits_ & 15; }
+    unsigned slotAt(unsigned rank) const;
+    unsigned rankOfSlot(unsigned slot) const;
+    void insert(unsigned rank, unsigned slot);
+    void erase(unsigned rank);
+private:
+    uint64_t bits_ = 0;
+};
+
+struct OccupancyHistory {
+    uint64_t bits = 0xAAAAAAAAAAAAAAAAULL;
+    void added(unsigned count);
+    void removed(unsigned count);
+    int balance() const;
+    bool recovering() const;
+};
+
+class PagedBTreeConflictSet {
+public:
+    static constexpr unsigned Capacity = KeyPermutation::Capacity;
+    static constexpr unsigned SearchWidth = 16;
+    static constexpr unsigned MaxHeight = 64;
+
+    struct Write {
+        StringRef begin;
+        StringRef end;
+        ConflictKind kind = ConflictKind::Range;
+    };
+    struct Query {
+        Version readVersion;
+        StringRef begin;
+        StringRef end;
+        bool conflict = false;
+    };
+    // Structural counters are always kept: they change once per modification. The three search
+    // counters change in the query loop and are kept only when PAGED_RESOLVER_SEARCH_STATS is
+    // set, as the skip list's are; otherwise they stay zero. The layout is the same either way
+    struct Stats {
+        static constexpr bool searchEnabled = PAGED_RESOLVER_SEARCH_STATS;
+        uint64_t splits = 0;
+        uint64_t internalSplits = 0;
+        uint64_t intervalInsertions = 0;
+        uint64_t merges = 0;
+        uint64_t internalMerges = 0;
+        uint64_t mergeCandidatesExamined = 0;
+        uint64_t cleanupLeavesVisited = 0;
+        uint64_t indexPagesReleased = 0;
+        uint64_t reclaimCalls = 0;
+        uint64_t reclaimLeavesVisited = 0;
+        uint64_t heapPagesReclaimed = 0;
+        uint64_t expiredIntervals = 0;
+        uint64_t overwrittenIntervals = 0;
+        uint64_t discardedWrites = 0;
+        uint64_t separatorRefreshes = 0;
+        uint64_t visitedNodes = 0;
+        uint64_t queries = 0;
+        // Diagnostic work counts, kept only with PAGED_RESOLVER_SEARCH_STATS: per write they tell
+        // repeated work from waiting on memory
+        uint64_t writes = 0;
+        uint64_t descents = 0;
+        uint64_t descentNodes = 0;
+        uint64_t childRankProbes = 0;
+        uint64_t liveRankEntries = 0;
+        uint64_t refreshes = 0;
+        uint64_t refreshEntries = 0;
+        uint64_t minimumCalls = 0;
+        uint64_t minimumEntries = 0;
+        uint64_t overwriteLeaves = 0;
+        uint64_t overwriteEntries = 0;
+        uint64_t leafSearchProbes = 0;
+        uint64_t slotInserts = 0;
+        uint64_t slotErases = 0;
+        uint64_t nodesReserved = 0;
+        uint64_t nodesTaken = 0;
+        uint64_t queryLeafEntries = 0;
+        // The share of childRankProbes and liveRankEntries spent inside hasConflicts
+        uint64_t queryChildRankProbes = 0;
+        uint64_t queryLiveRankEntries = 0;
+    };
+    // Nodes and entries at one depth, the root being depth zero; a diagnostic walk of the tree
+    struct Level {
+        uint64_t nodes = 0;
+        uint64_t entries = 0;
+        uint64_t liveEntries = 0;
+    };
+
+    explicit PagedBTreeConflictSet(uint64_t limitPages, Version initialValidationMinRV);
+    ~PagedBTreeConflictSet();
+    PagedBTreeConflictSet(const PagedBTreeConflictSet&) = delete;
+    PagedBTreeConflictSet& operator=(const PagedBTreeConflictSet&) = delete;
+
+    void addRange(Version cv, StringRef begin, StringRef end);
+    void addPoint(Version cv, StringRef key);
+    void addWrites(Version cv, const Write* writes, size_t count);
+    bool hasConflict(Version readVersion, StringRef begin, StringRef end);
+
+    // Callers must admit every query before calling the batch API
+    // An inadmissible query throws before any result is changed
+    void hasConflicts(Query* queries, size_t count);
+
+    // Budgets count visited leaves and attempted merge candidates respectively
+    // Empty ancestor removal is immediate, occupancy restoration is deferred
+    uint64_t cleanup(unsigned leafBudget = 64, unsigned mergeCandidates = 8,
+                     bool memoryPressure = false);
+
+    Version validationMinRV() const { return validationMinRV_; }
+    const PageBudget& budget() const { return pool_.budget(); }
+    // History pages reclaimed under pool pressure so far, for the Resolver's metrics
+    PageID reclaimedHistoryPages() const { return heap_.lastReclaimedPageID(); }
+    const Stats& stats() const { return stats_; }
+    unsigned height() const;
+    uint64_t occupancy(bool leaves, unsigned count) const;
+    uint64_t leafCount() const { return leafCount_; }
+    uint64_t nodeCount() const;
+    // Visits every node: for reports, not for the batch path
+    std::vector<Level> levels() const;
+
+private:
+    static constexpr Version NoVersion = std::numeric_limits<Version>::lowest();
+    struct Node;
+    struct NodePage;
+    struct Entry {
+        HeapRef begin{};
+        HeapRef end{};
+        Version cv = NoVersion;
+        Node* child = nullptr;
+        Version firstCV = NoVersion;
+    };
+    struct alignas(64) Node {
+        KeyPermutation order;
+        OccupancyHistory history;
+        Version maxCV = NoVersion;
+        NodePage* owner = nullptr;
+        Node* parent = nullptr;
+        Node* leafPrevious = nullptr;
+        Node* leafNext = nullptr;
+        Node* queuePrevious = nullptr;
+        Node* queueNext = nullptr;
+        Node* freePrevious = nullptr;
+        Node* freeNext = nullptr;
+        uint16_t occupied = 0;
+        uint8_t cursor = 0;
+        uint8_t parentSlot = 0;
+        uint8_t queueCount = 0;
+        bool leaf = true;
+        bool critical = false;
+        bool queued = false;
+        bool allocated = false;
+        std::array<Entry, Capacity> slots{};
+        Entry& at(unsigned rank) { return slots[order.slotAt(rank)]; }
+        const Entry& at(unsigned rank) const { return slots[order.slotAt(rank)]; }
+        unsigned size() const { return order.size(); }
+    };
+    struct NodePage {
+        NodePage* previous;
+        NodePage* next;
+        uint32_t live;
+    };
+    struct Queue {
+        Node* head = nullptr;
+        Node* tail = nullptr;
+        uint64_t count = 0;
+    };
+    struct Reservation {
+        std::array<Node*, 6> nodes{};
+        unsigned size = 0;
+    };
+    struct Frame { Node* node; int next = -1; };
+    struct Search {
+        Query* query = nullptr;
+        std::array<Frame, MaxHeight> frames{};
+        unsigned depth = 0;
+        bool prepare = true;
+    };
+
+    Version validationMinRV_;
+    Version lastWriteCV_ = NoVersion;
+    PagePool pool_;
+    TemporalHeap heap_;
+    NodePage* pages_ = nullptr;
+    Node* free_ = nullptr;
+    uint64_t freeNodes_ = 0;
+    Node* root_ = nullptr;
+    Node* firstLeaf_ = nullptr;
+    Node* cleanupCursor_ = nullptr;
+    uint64_t leafCount_ = 0;
+    std::array<std::array<Queue, Capacity + 1>, 2> queues_{};
+    Stats stats_;
+
+    static size_t nodeOffset();
+    static size_t nodesPerPage();
+    Node* allocateNode();
+    void releaseNode(Node* node);
+    void addFree(Node* node);
+    void removeFree(Node* node);
+    void releaseEmptyPages();
+    Node* take(Reservation& reservation, bool leaf);
+    void reserve(Reservation& reservation);
+    void releaseReservation(Reservation& reservation);
+    static void reclaimThunk(void* context, PageUse use);
+    void reclaim(PageUse use);
+
+    void unqueue(Node* node);
+    void enqueue(Node* node);
+    void insertSlot(Node* node, unsigned rank, const Entry& entry);
+    void eraseSlot(Node* node, unsigned rank);
+    void refresh(Node* node);
+    void refreshUp(Node* node);
+    void refreshSeparator(Entry& entry);
+    Entry minimum(Node* node);
+    StringRef key(const HeapRef& ref) const;
+    unsigned liveRanks(Node* node, std::array<unsigned, Capacity>& ranks);
+    unsigned childRank(Node* node, StringRef begin);
+    Node* findLeaf(StringRef begin);
+    void purgeLeaf(Node* leaf);
+    void removeEmpty(Node* node);
+    void collapseRoot();
+    void destroySubtree(Node* node);
+    Node* split(Node* node, Reservation& reservation);
+    void insertInterval(const Entry& interval, Reservation& reservation);
+    void overwrite(const Entry& incoming, Reservation& reservation);
+    bool tryMerge(Node* node, bool memoryPressure);
+    void prepareSearchNode(Search& search);
+    bool step(Search& search);
+};
+
+} // namespace paged_btree
