+void getKeyReadsTheBytesARefNames() {
+	begin("getKeyReadsTheBytesARefNames");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+	const HeapRef record = rangeRecord(heap, 3, "begin", "the end");
+	const RangeConflictView view = rangeAt(heap, record, "the range reads back");
+
+	// A reference to the end bytes alone, as a maxEnd summary holds one.
+	const HeapRef endRef{ record.pageID, record.offset + record.length - 7, 7 };
+	Optional<StringRef> endBytes = heap.getKey(endRef);
+	if (check(endBytes.present(), "the end reads back through its own reference")) {
+		check(endBytes.get() == asRef("the end"), "byte for byte");
+		check(endBytes.get().begin() == view.end.begin(), "from the record itself, not a copy");
+	}
+	const HeapRef beginRef{ record.pageID, record.offset + static_cast<uint32_t>(sizeof(RangeConflictHeader)), 5 };
+	Optional<StringRef> beginBytes = heap.getKey(beginRef);
+	check(beginBytes.present() && beginBytes.get() == asRef("begin"), "and so does the begin");
+	const HeapRef emptyRef{ record.pageID, record.offset + record.length, 0 };
+	Optional<StringRef> nothing = heap.getKey(emptyRef);
+	check(nothing.present() && nothing.get().size() == 0, "an empty reference reads back empty");
+	end();
+}
