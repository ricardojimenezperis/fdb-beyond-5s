+	check(!heap.reclaimOldest().present(), "there is nothing to reclaim");
+	check(heap.lastReclaimedPageID() == 0, "no page has been reclaimed");
+	check(!heap.reclaimedThroughCV().present(), "no version has been discarded");
+	check(pool.budget().heapPages == 0, "the heap holds no page");
