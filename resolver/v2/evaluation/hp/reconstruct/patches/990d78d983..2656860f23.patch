+void partitionConfigurationAndExhaustion() {
+    for (unsigned n : {1U, 2U, 9U, 10U, 11U, 100U}) {
+        Tree tree(n, 0);
+        CHECK(tree.pool_.indexPool() && tree.budget().limitPages == n && tree.budget().freePages == n);
+        std::vector<PoolPage*> index;
+        CHECK(tree.pool_.hasAvailable(PageUse::Index) && !tree.pool_.hasAvailable(PageUse::Heap));
+        CHECK(!tree.pool_.tryAcquire(PageUse::Heap));
+        while (auto* page = tree.pool_.tryAcquire(PageUse::Index)) index.push_back(page);
+        CHECK(index.size() == n && !tree.budget().freePages && tree.budget().indexPages == n);
+        CHECK(!tree.pool_.hasAvailable(PageUse::Index) && !tree.pool_.hasAvailable(PageUse::Heap));
+        for (auto* page : index) tree.pool_.release(page, PageUse::Index);
+        CHECK(tree.budget().freePages == n && !tree.budget().indexPages && !tree.budget().heapPages);
+        std::set<PoolPage*> released(index.begin(), index.end()), again;
+        while (auto* page = tree.pool_.tryAcquire(PageUse::Index)) again.insert(page);
+        CHECK(again == released);
+        for (auto* page : again) tree.pool_.release(page, PageUse::Index);
+    }
+    Tree tree(1, 0);
+    tree.addPoint(1, sv(""));
+    const auto before = contents(tree);
+    const std::string tooLong(tree.maximumHeapRecordBytes() + 1, 'x');
+    Tree::Write writes[] = {{sv(""), {}, ConflictKind::Point}, {sv(tooLong), {}, ConflictKind::Point}};
+    bool rejected = false;
+    try { tree.addWrites(2, writes, 2); } catch (const std::invalid_argument&) { rejected = true; }
+    CHECK(rejected && contents(tree) == before && tree.lastWriteCV_ == 1);
+    verify(tree);
+}
