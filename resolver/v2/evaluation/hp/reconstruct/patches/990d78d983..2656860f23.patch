+// A write's anchor leaf holds expired entries on both sides of a live one, their records on a heap page already
+// reclaimed: reading any of their keys would fail. Arm 3 leaves them to the rank sweep, which must erase each one
+// before the binary search compares a key. A second write covers every live entry of another such leaf, which stays
+// attached while empty until the write's own interval is inserted. The ancestors' separators and bounds follow both
+// changes, and reads keep their decisions for points and ranges.
+void probFusionLimitsAndSameParent() {
+    Tree tree(512, 0);
+    tree.configureFictitiousLeaves({ 0, 0 });
+    std::mt19937 random(5);
+    std::vector<unsigned> order(6000);
+    for (unsigned i = 0; i < order.size(); ++i) order[i] = i;
+    std::shuffle(order.begin(), order.end(), random);
+    for (unsigned i : order) tree.addPoint(1, sv(key(4 * i)));
+    const unsigned maxMerged = tree.probFusion_.maxMergedEntries, maxSource = tree.probFusion_.maxSourceEntries;
+    CHECK(maxMerged == Tree::ProbFusionMaxMergedEntries && maxSource == Tree::ProbFusionMaxSourceEntries);
+    CHECK(maxSource < maxMerged);
+    auto sameParent = [](Tree::Node* a, Tree::Node* b) { return a && b && a->parent == b->parent; };
+    Tree::Node* middle = nullptr;
+    Tree::Node* crossing = nullptr;
+    for (auto* leaf = tree.firstLeaf_; leaf; leaf = leaf->navigation.leaf.next) {
+        auto* previous = leaf->navigation.leaf.previous;
+        auto* next = leaf->navigation.leaf.next;
+        if (!crossing && previous && !sameParent(leaf, previous) && leaf->size() > 1) crossing = leaf;
+        if (!middle && sameParent(leaf, previous) && sameParent(leaf, next) && previous->size() + maxSource > maxMerged &&
+            next->size() + maxSource > maxMerged && leaf->size() > maxSource) middle = leaf;
+    }
+    CHECK(middle && crossing);
+    auto shrink = [&](Tree::Node* leaf, unsigned size) {
+        while (leaf->size() > size) tree.eraseSlot(leaf, leaf->size() - 1);
+        tree.refreshUp(leaf);
+    };
+    auto snapshot = [&](Tree::Node* leaf) {
+        std::vector<std::string> keys;
+        for (unsigned i = 0; i < leaf->size(); ++i) keys.push_back(entryBytes(tree, leaf->at(i)));
+        return keys;
+    };
+    Tree::Node* previous = middle->navigation.leaf.previous;
+    Tree::Node* next = middle->navigation.leaf.next;
+    const auto before = tree.stats();
+    shrink(previous, maxMerged - maxSource - 1);
+    shrink(middle, maxSource + 1);
+    verify(tree);
+    for (uint64_t seed = 1; seed <= 64; ++seed) {
+        setThreadLocalDeterministicRandomSeed(seed);
+        tree.maybeProbFusion({middle, middle->incarnation, middle->size() + 1});
+    }
+    CHECK(tree.stats().merges == before.merges && tree.stats().mergeCandidatesExamined == before.mergeCandidatesExamined);
+    shrink(middle, maxSource);
+    shrink(next, maxMerged - maxSource + 1);
+    CHECK(next->size() + middle->size() == maxMerged + 1 && next->size() + middle->size() <= Tree::Capacity);
+    CHECK(previous->size() + middle->size() < maxMerged);
+    CHECK(!tree.fuseLeafNeighbour(middle, false));
+    CHECK(!tree.fuseLeafNeighbour(crossing, true));
+    CHECK(tree.stats().merges == before.merges && middle->allocated && next->allocated);
+    verify(tree);
+    auto expected = snapshot(previous);
+    for (const auto& k : snapshot(middle)) expected.push_back(k);
+    const auto parentSize = previous->parent->size();
+    CHECK(tree.fuseLeafNeighbour(middle, true));
+    CHECK(tree.stats().merges == before.merges + 1 && tree.stats().internalMerges == before.internalMerges);
+    CHECK(previous->allocated && previous->size() == expected.size() && snapshot(previous) == expected);
+    CHECK(previous->parent->size() == parentSize - 1 && previous->navigation.leaf.next == next);
+    verify(tree);
+    std::printf("[maxSource=%u maxMerged=%u] ", maxSource, maxMerged);
+}
