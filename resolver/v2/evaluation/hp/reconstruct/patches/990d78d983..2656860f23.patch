+void retiredNodesWaitForBatchEnd() {
+    Tree tree(64, 0);
+    for (unsigned i = 0; i < 300; ++i)
+        tree.addRange(1, sv(key(4 * i)), sv(key(4 * i + 2)));
+    std::vector<Tree::Node*> spare;
+    while (tree.freeNodes_ < 3) spare.push_back(tree.allocateNode());
+    Tree::Node* victim = tree.firstLeaf_->navigation.leaf.next;
+    Tree::NodePage* page = victim->owner;
+    const auto pageLive = page->live;
+    const Tree::LeafHint old{victim, victim->incarnation};
+    const std::string begin = entryBytes(tree, victim->at(0));
+    {
+        Tree::WriteBatchScope batch(tree);
+        while (victim->size()) tree.eraseSlot(victim, 0);
+        tree.removeEmpty(victim);
+        CHECK(!victim->allocated && retiredItems(tree) == std::vector<Tree::Node*>{victim});
+        CHECK(page->live == pageLive - 1);
+        for (auto* node : freeItems(tree)) CHECK(node != victim);
+        // Rejected because the node is retired (not allocated), not by its identity: same incarnation
+        const auto stale = tree.stats().writeHintStale;
+        CHECK(victim->incarnation == old.incarnation);
+        CHECK(tree.resolveWriteHint(sv(begin), old) == tree.findLeaf(sv(begin)));
+        CHECK(tree.stats().writeHintStale == stale);
+        const auto freeBefore = tree.freeNodes_;
+        Tree::Reservation reservation;
+        tree.reserve(reservation, 3);
+        for (unsigned i = 0; i < reservation.size; ++i) CHECK(reservation.nodes[i] != victim);
+        tree.releaseReservation(reservation);
+        CHECK(tree.freeNodes_ == freeBefore);
+        CHECK(retiredItems(tree) == std::vector<Tree::Node*>{victim});
+    }
+    CHECK(!tree.retired_ && !tree.writeBatchActive_ && tree.writeHints_.empty());
+    CHECK(page->live == pageLive - 1);
+    // The page still has live nodes, and allocation reuses the newly recycled slot
+    CHECK(freeItems(tree).front() == victim);
+    Tree::Node* reused = tree.allocateNode();
+    CHECK(reused == victim && reused->allocated);
+    tree.recycleNode(reused);
+    for (auto* node : spare) tree.recycleNode(node);
+    verify(tree);
+}
