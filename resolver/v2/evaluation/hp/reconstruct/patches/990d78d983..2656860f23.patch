+using Tree = paged_btree::PagedBTreeConflictSet;
+using paged_btree::KeyPermutation;
+
+#define CHECK(c) do { if (!(c)) throw std::runtime_error(std::string(#c) + " line " + std::to_string(__LINE__)); } while (false)
+StringRef sv(const std::string& value) {
+    return StringRef(reinterpret_cast<const uint8_t*>(value.data()), value.size());
+}
+std::string key(unsigned number, unsigned length = 4) {
+    std::string result(length, 'x');
+    for (int i = 3; i >= 0; --i) { result[i] = static_cast<char>(number & 255); number >>= 8; }
+    return result;
+}
+std::string bytes(StringRef value) {
+    return value.size() ? std::string(reinterpret_cast<const char*>(value.begin()), value.size()) : std::string();
+}
+std::string entryBytes(Tree& tree, const Tree::Entry& entry, bool end=false) {
+    Tree::KeyScratch scratch;
+    return bytes(tree.storedKey(end ? entry.end : entry.begin,
+                               end ? Tree::endPrefix(entry) : entry.beginInline, scratch));
+}
+using Interval = std::tuple<std::string, std::string, Version>;
+std::vector<Interval> contents(Tree& tree) {
+    std::vector<Interval> result;
+    for (auto* leaf = tree.firstLeaf_; leaf; leaf = leaf->navigation.leaf.next)
+        for (unsigned i = 0; i < leaf->size(); ++i) {
+            const auto& entry = leaf->at(i);
+            if (entry.cv > tree.validationMinRV()) result.emplace_back(entryBytes(tree, entry), entryBytes(tree, entry, true), entry.cv);
+        }
+    return result;
+}
+using NodeQueuePool = paged_btree::BlockQueuePool<Tree::Node*, 64>;
+std::vector<Tree::Node*> queueItems(const NodeQueuePool::Queue& queue) {
+    std::vector<Tree::Node*> result;
+    NodeQueuePool::Block* previous = nullptr;
+    for (auto* block = queue.head; block; block = block->next) {
+        CHECK(block->previous == previous && block->live && block->used <= 64);
+        CHECK(block->used == 64 || (block->live >> block->used) == 0);
+        for (unsigned i = 0; i < block->used; ++i) {
+            if (block->live & (uint64_t{1} << i)) {
+                CHECK(block->entries[i]);
+                result.push_back(block->entries[i]);
+            } else CHECK(!block->entries[i]);
+        }
+        previous = block;
+    }
+    CHECK(previous == queue.tail && result.size() == queue.count);
+    return result;
+}
+
+std::vector<Tree::Node*> listItems(const Tree& tree, Tree::Node* head, uint64_t limit) {
+    std::vector<Tree::Node*> items;
+    for (auto* node = head; node; node = static_cast<Tree::Node*>(tree.pool_.detachedNext(node))) {
+        items.push_back(node);
+        CHECK(items.size() <= limit);
+    }
+    return items;
+}
+std::vector<Tree::Node*> freeItems(const Tree& tree) { return listItems(tree, tree.free_, tree.freeNodes_); }
+std::vector<Tree::Node*> retiredItems(const Tree& tree) {
+    auto items = listItems(tree, tree.retired_, tree.retiredCount_);
+    CHECK(items.size() == tree.retiredCount_ && (items.empty() ? !tree.retiredTail_ : items.back() == tree.retiredTail_));
+    return items;
+}
+
+void verify(Tree& tree) {
+    std::set<Tree::Node*> visited;
+    std::vector<Tree::Node*> leaves;
+    unsigned leafDepth = 0;
+    auto visit = [&](auto&& self, Tree::Node* node, unsigned depth) -> Version {
+        CHECK(visited.insert(node).second);
+        CHECK(node->allocated);
+        CHECK(node->size() > 0 && node->size() <= Tree::Capacity);
+        CHECK(__builtin_popcount(node->occupied) == static_cast<int>(node->size()));
+        if constexpr (PAGED_BTREE_BITMAP_CLEANUP == 0) CHECK(node->occupied & (1U << node->reclaimHead));
+        Version maximum = Tree::NoVersion;
+        unsigned critical = 0;
+        uint32_t slots = 0;
+        for (unsigned i = 0; i < node->size(); ++i) {
+            const unsigned slot = node->order.slotAt(i);
+            CHECK(!(slots & (1U << slot)));
+            slots |= 1U << slot;
+            auto& entry = node->at(i);
+            auto verifyPrefix = [&](const auto& ref, const Tree::KeyPrefix& prefix) {
+                const size_t n = std::min<size_t>(Tree::InlineKeyBytes, ref.length);
+                Tree::KeyScratch scratch;
+                if (n) CHECK(std::memcmp(prefix.data(), tree.storedKey(ref, prefix, scratch).begin(), n) == 0);
+            };
+            if (node->leaf && entry.cv > tree.validationMinRV()) {
+                verifyPrefix(entry.begin, entry.beginInline);
+                verifyPrefix(entry.end, Tree::endPrefix(entry));
+            } else if (!node->leaf && entry.payload.link.firstCV > tree.validationMinRV()) {
+                const auto plain = tree.plainSeparator(node, entry);
+                verifyPrefix(plain.begin, plain.beginInline);
+                if (entry.end.length) {
+                    CHECK(Tree::NodePrefixEnabled && node->navigation.prefix.initialized);
+                    CHECK(entry.end.length == node->navigation.prefix.length);
+                    CHECK(entry.begin.length >= entry.end.length);
+                    Tree::KeyScratch scratch;
+                    const auto full = tree.storedKey(plain.begin, plain.beginInline, scratch);
+                    CHECK(std::memcmp(full.begin(), node->navigation.prefix.bytes.data(), entry.end.length) == 0);
+                    const size_t n = std::min<size_t>(Tree::InlineKeyBytes, entry.begin.length - entry.end.length);
+                    if (n) CHECK(std::memcmp(entry.beginInline.data(), full.begin() + entry.end.length, n) == 0);
+                }
+            }
+            if (!node->leaf) {
+                CHECK(entry.payload.link.child->parent == node && entry.payload.link.child->parentSlot == slot);
+                CHECK(self(self, entry.payload.link.child, depth + 1) == entry.cv);
+                critical += entry.payload.link.child->critical;
+                if (entry.payload.link.firstCV > tree.validationMinRV()) {
+                    const auto minimum = tree.minimum(entry.payload.link.child);
+                    CHECK(entry.payload.link.firstCV == minimum.cv);
+                    CHECK(entryBytes(tree, tree.plainSeparator(node, entry)) == entryBytes(tree, minimum));
+                }
+            }
+            maximum = std::max(maximum, entry.cv);
+        }
+        CHECK(slots == node->occupied);
+        CHECK(node->maxCV >= maximum);
+        if (node->leaf) {
+            if (!leafDepth) leafDepth = depth;
+            CHECK(leafDepth == depth);
+            leaves.push_back(node);
+            CHECK(node->critical == (node->size() + node->fict.fictitious == Tree::Capacity));
+        } else {
+            CHECK(Tree::Capacity - node->size() >= critical);
+            CHECK(node->critical == (Tree::Capacity - node->size() == critical));
+            // The count refreshUp keeps instead of reading every child
+            CHECK(node->criticalChildren == critical);
+        }
+        return node->maxCV;
+    };
+    if (tree.root_) { CHECK(tree.root_->parent == nullptr); visit(visit, tree.root_, 1); }
+    std::set<ReclaimLink*> aged;
+    ReclaimLink* previousAge = nullptr;
+    uint64_t heapAgeCount = 0;
+    std::set<HistoryPage*> keyBlocks;
+    for (auto* link = tree.pool_.oldestAge(); link; link = tree.pool_.nextAge(link)) {
+        CHECK(aged.insert(link).second && link->ageLinked && tree.pool_.previousAge(link) == previousAge);
+        CHECK(tree.pool_.ageCV(link) == link->maxCV);
+        CHECK(!previousAge || previousAge->maxCV <= link->maxCV);
+        if (link->ageUse == PageUse::Index) CHECK(visited.count(static_cast<Tree::Node*>(link)));
+        else {
+            CHECK(link->ageUse == PageUse::Heap && !static_cast<Tree::Node*>(link)->allocated);
+            auto* page = reinterpret_cast<HistoryPage*>(static_cast<Tree::Node*>(link)->keyStorage);
+            CHECK(page->newestCV.present() && page->newestCV.get() == link->maxCV);
+            CHECK(Tree::findKeyBlock(&tree, page->id) == page && keyBlocks.insert(page).second);
+            ++heapAgeCount;
+        }
+        previousAge = link;
+    }
+    CHECK(heapAgeCount == tree.keyBlockCount() && tree.budget().heapPages == 0);
+    CHECK(tree.heap_.oldestPageNewestCV().present() == !keyBlocks.empty());
+    for (auto* page : keyBlocks) CHECK(tree.heap_.oldestPageNewestCV().get() <= page->newestCV.get());
+    uint64_t enumerated = 0;
+    tree.pool_.forEachAge([&](const ReclaimLink* link) { CHECK(aged.count(const_cast<ReclaimLink*>(link))); ++enumerated; });
+    CHECK(enumerated == aged.size());
+    if (!aged.empty()) CHECK(tree.pool_.oldestAgeCV() == tree.pool_.oldestAge()->maxCV);
+    for (auto* node : visited) CHECK(aged.count(node));
+    CHECK(leaves.size() == tree.leafCount_);
+    CHECK((leaves.empty() ? nullptr : leaves.front()) == tree.firstLeaf_);
+    for (size_t i = 0; i < leaves.size(); ++i) {
+        CHECK(leaves[i]->navigation.leaf.previous == (i ? leaves[i - 1] : nullptr));
+        CHECK(leaves[i]->navigation.leaf.next == (i + 1 < leaves.size() ? leaves[i + 1] : nullptr));
+    }
+    auto live = contents(tree);
+    for (size_t i = 0; i < live.size(); ++i) {
+        CHECK(sv(std::get<0>(live[i])) < sv(std::get<1>(live[i])));
+        if (i) CHECK(!(sv(std::get<0>(live[i])) < sv(std::get<1>(live[i - 1]))));
+    }
+    CHECK(visited.size() == tree.nodeCount());
+    std::set<Tree::Node*> free;
+    for (auto* node : freeItems(tree)) {
+        CHECK(free.insert(node).second && !node->allocated && !visited.count(node));
+        CHECK(!node->ageLinked);
+    }
+    CHECK(free.size() == tree.freeNodes_);
+    CHECK(!tree.retired_ && !tree.retiredTail_ && tree.retiredCount_ == 0 && !tree.writeBatchActive_);
+    CHECK(tree.cleanupMetadataBytes() == 0);
+    std::set<Tree::NodePage*> emptyPages;
+    Tree::NodePage* previousEmpty = nullptr;
+    for (auto* page = tree.emptyPages_; page; page = page->emptyNext) {
+        CHECK(!page->live && page->emptyPrevious == previousEmpty && emptyPages.insert(page).second);
+        previousEmpty = page;
+    }
+    uint64_t pages = 0;
+    for (auto* page = tree.pages_; page; page = page->next) {
+        unsigned liveCount = 0;
+        auto* address = reinterpret_cast<std::byte*>(page) + tree.nodeOffset();
+        for (size_t i = 0; i < tree.nodesPerPage(); ++i) {
+            auto* node = reinterpret_cast<Tree::Node*>(address + i * sizeof(Tree::Node));
+            CHECK(node->owner == page);
+            if (node->allocated) { ++liveCount; CHECK(visited.count(node)); }
+            else if (node->ageLinked && node->ageUse == PageUse::Heap) {
+                ++liveCount;
+                CHECK(keyBlocks.count(reinterpret_cast<HistoryPage*>(node->keyStorage)));
+            } else CHECK(free.count(node));
+        }
+        CHECK(liveCount == page->live);
+        CHECK(emptyPages.count(page) == (page->live == 0));
+        ++pages;
+    }
+    CHECK(pages == tree.budget().indexPages);
+    CHECK(tree.budget().freePages + tree.budget().occupiedPages() == tree.budget().limitPages);
+}
+
+void permutation() {
+    std::mt19937 random(7);
+    for (unsigned run = 0; run < 100; ++run) {
+        KeyPermutation p;
+        std::vector<unsigned> slots;
+        for (unsigned i = 0; i < 1000; ++i) {
+            if (slots.empty() || (slots.size() < KeyPermutation::Capacity && random() % 2)) {
+                unsigned slot;
+                do { slot = random() % KeyPermutation::Capacity; } while (std::find(slots.begin(), slots.end(), slot) != slots.end());
+                const unsigned rank = random() % (slots.size() + 1);
+                p.insert(rank, slot);
+                slots.insert(slots.begin() + rank, slot);
+            } else {
+                const unsigned rank = random() % slots.size();
+                p.erase(rank);
+                slots.erase(slots.begin() + rank);
+            }
+            CHECK(p.size() == slots.size());
+            for (unsigned rank = 0; rank < slots.size(); ++rank) {
+                CHECK(p.slotAt(rank) == slots[rank]);
+                CHECK(p.rankOfSlot(slots[rank]) == rank);
+            }
+        }
+    }
+}
+
+void permutationFullCapacityAndReuse() {
+    KeyPermutation order;
+    for (unsigned slot = 0; slot < KeyPermutation::Capacity; ++slot)
+        order.insert(0, slot);
+    CHECK(order.size() == KeyPermutation::Capacity);
+    for (unsigned rank = 0; rank < order.size(); ++rank) {
+        const unsigned slot = KeyPermutation::Capacity - 1 - rank;
+        CHECK(order.slotAt(rank) == slot);
+        CHECK(order.rankOfSlot(slot) == rank);
+    }
+    // Exercise both SIMD halves and the full-to-empty transition
+    while (order.size()) order.erase(order.size() / 2);
+    order.insert(0, 0);
+    CHECK(order.size() == 1 && order.slotAt(0) == 0 && order.rankOfSlot(0) == 0);
+    for (unsigned slot = 1; slot < KeyPermutation::Capacity; ++slot)
+        order.insert(order.size(), slot);
+    for (unsigned rank = 0; rank < order.size(); ++rank) {
+        CHECK(order.slotAt(rank) == rank);
+        CHECK(order.rankOfSlot(rank) == rank);
+    }
+}
+
+
+void fragments() {
+    Tree tree(32, 0);
+    tree.addRange(10, sv("a"), sv("z"));
+    // The first write into an empty tree leaves one root leaf holding it
+    CHECK(tree.root_ && tree.root_->leaf && tree.root_->size() == 1);
+    auto original = tree.root_->at(0);
+    tree.addRange(20, sv("d"), sv("m"));
+    CHECK(contents(tree) == (std::vector<Interval>{{"a", "d", 10}, {"d", "m", 20}, {"m", "z", 10}}));
+    auto left = tree.root_->at(0), middle = tree.root_->at(1), right = tree.root_->at(2);
+    CHECK(left.begin.offset == original.begin.offset && right.end.offset == original.end.offset);
+    CHECK(left.end.offset == middle.begin.offset && right.begin.offset == middle.end.offset);
+    CHECK(left.end.pageID == middle.begin.pageID && right.begin.pageID == middle.end.pageID);
+    CHECK(tree.hasConflict(10, sv("d"), sv("m")));
+    CHECK(!tree.hasConflict(10, sv("a"), sv("d")));
+    CHECK(!tree.hasConflict(20, sv("a"), sv("z")));
+    CHECK(!tree.hasConflict(0, sv("z"), sv("zz")));
+    CHECK(!tree.hasConflict(0, sv("d"), sv("d")));
+    tree.addRange(30, sv("b"), sv("y"));
+    CHECK(contents(tree) == (std::vector<Interval>{{"a", "b", 10}, {"b", "y", 30}, {"y", "z", 10}}));
+    tree.addRange(40, sv(""), sv("zz"));
+    CHECK(contents(tree) == (std::vector<Interval>{{"", "zz", 40}}));
+    verify(tree);
+}
+
+void slotsAndBinaryKeys() {
+    Tree tree(32, 0);
+    tree.addRange(1, sv("a"), sv("b"));
+    tree.addRange(1, sv("c"), sv("d"));
+    tree.addRange(1, sv("e"), sv("f"));
+    const unsigned aSlot = tree.root_->order.slotAt(0), eSlot = tree.root_->order.slotAt(2);
+    for (unsigned cv = 2; cv < 50; ++cv) {
+        tree.addRange(cv, sv("c"), sv("d"));
+        CHECK(tree.root_->order.slotAt(0) == aSlot && tree.root_->order.slotAt(2) == eSlot);
+    }
+    const std::string point("p\0q", 3);
+    tree.addPoint(50, sv(point));
+    CHECK(tree.hasConflict(49, sv(point), sv(point + '\0')));
+    CHECK(!tree.hasConflict(49, sv(point + '\0'), sv("z")));
+    tree.addPoint(51, sv(""));
+    CHECK(tree.hasConflict(50, sv(""), sv(std::string(1, '\0'))));
+    verify(tree);
+}
+
+void proactiveSplits() {
+    for (bool shuffled : {false, true}) {
+        Tree tree(1024, 0);
+        std::vector<unsigned> values(std::max(12000U, Tree::Capacity * Tree::Capacity * Tree::Capacity + 1));
+        for (unsigned i = 0; i < values.size(); ++i) values[i] = i;
+        if (shuffled) std::shuffle(values.begin(), values.end(), std::mt19937(4));
+        for (unsigned i = 0; i < values.size(); ++i) {
+            const auto splits = tree.stats().splits;
+            tree.addRange(i + 1, sv(key(2 * values[i])), sv(key(2 * values[i] + 1)));
+            CHECK(tree.stats().splits - splits <= 1);
+            if (i % 200 == 0) verify(tree);
+        }
+        CHECK(tree.height() >= 4);
+        for (unsigned i = 0; i < values.size(); i += 79)
+            CHECK(tree.hasConflict(0, sv(key(2 * i)), sv(key(2 * i + 1))));
+        const Version overwriteCV = static_cast<Version>(values.size()) + 1;
+        tree.addRange(overwriteCV, sv(key(199)), sv(key(22001)));
+        verify(tree);
+        CHECK(tree.hasConflict(overwriteCV - 1, sv(key(200)), sv(key(201))));
+        CHECK(!tree.hasConflict(overwriteCV - 1, sv(key(0)), sv(key(1))));
+    }
+}
+
+void purgeExpired(Tree& tree, Tree::Node* leaf) {
+    bool changed = false;
+    if constexpr (Tree::InlineOnlyKeys) changed = tree.purgeHead(leaf);
+    else for (unsigned rank = 0; rank < leaf->size();) {
+        if (leaf->at(rank).cv <= tree.validationMinRV_) {
+            tree.eraseSlot(leaf, rank);
+            ++tree.stats_.expiredIntervals;
+            changed = true;
+        } else ++rank;
+    }
+    if (!leaf->size()) tree.removeEmpty(leaf);
+    else if (changed) tree.refreshUp(leaf);
+}
+
+void drainExpired(Tree& tree) {
+    std::vector<Tree::Node*> leaves;
+    for (auto* leaf = tree.firstLeaf_; leaf; leaf = leaf->navigation.leaf.next) leaves.push_back(leaf);
+    for (auto* leaf : leaves) purgeExpired(tree, leaf);
+}
+
+void expiryAndMerges() {
+    Tree tree(256, 0);
+    for (unsigned parity = 0; parity < 2; ++parity)
+        for (unsigned i = parity; i < 2400; i += 2)
+            tree.addRange(parity + 1, sv(key(2 * i)), sv(key(2 * i + 1)));
+    tree.validationMinRV_ = 1;
+    const auto before = tree.leafCount_;
+    drainExpired(tree);
+    for (unsigned i = 0; i < 100; ++i) tree.cleanup(100, 100, true);
+    CHECK(contents(tree).size() == 1200);
+    CHECK(tree.leafCount_ <= before && tree.stats().merges == 0);
+    verify(tree);
+    for (unsigned i = 0; i < 2400; i += 2)
+        tree.addRange(3, sv(key(2 * i)), sv(key(2 * i + 1)));
+    verify(tree);
+    tree.validationMinRV_ = 3;
+    drainExpired(tree);
+    tree.cleanup(10000, 100, true);
+    CHECK(!tree.root_ && !tree.leafCount_ && tree.freeNodes_ + tree.keyBlockCount() == tree.budget().indexPages * tree.nodesPerPage());
+    verify(tree);
+}
+
+bool referenceConflict(const std::vector<Interval>& writes, Version rv, const std::string& begin, const std::string& end) {
+    if (!(sv(begin) < sv(end))) return false;
+    for (const auto& [wb, we, cv] : writes)
+        if (cv > rv && sv(wb) < sv(end) && sv(begin) < sv(we)) return true;
+    return false;
+}
+
+void model() {
+    for (unsigned seed : {1, 17, 903}) {
+        Tree tree(12, 0);
+        std::vector<Interval> writes;
+        std::mt19937 random(seed);
+        for (unsigned operation = 1; operation <= 3000; ++operation) {
+            const unsigned start = random() % 1000;
+            const unsigned length = 1 + random() % 30;
+            auto begin = key(start, 600), end = key(start + length, 600);
+            writes.emplace_back(begin, end, operation);
+            tree.addRange(operation, sv(begin), sv(end));
+            if (operation % 7 == 0) tree.cleanup(3, 4);
+            if (operation % 13 == 0) verify(tree);
+            for (unsigned j = 0; j < 4; ++j) {
+                const unsigned a = random() % 1000;
+                auto qb = key(a, 600), qe = key(a + random() % 40, 600);
+                const Version floor = tree.validationMinRV();
+                const Version rv = floor + random() % (operation - floor + 1);
+                CHECK(tree.hasConflict(rv, sv(qb), sv(qe)) == referenceConflict(writes, rv, qb, qe));
+            }
+        }
+        CHECK(tree.heap_.lastReclaimedPageID() > 0 && tree.validationMinRV() > 0);
+        verify(tree);
+    }
+}
+
+void separatorLifetime() {
+    Tree tree(128, 0);
+    for (unsigned i = 0; i < 180; ++i)
+        tree.addRange(1, sv(key(4 * i, 1200)), sv(key(4 * i + 1, 1200)));
+    for (unsigned i = 0; i < 180; ++i)
+        tree.addRange(2, sv(key(4 * i + 2, 1200)), sv(key(4 * i + 3, 1200)));
+    uint64_t reclaimed = 0;
+    while (tree.heap_.oldestPageNewestCV().present() && tree.heap_.oldestPageNewestCV().get() == 1) {
+        tree.validationMinRV_ = 1;
+        tree.heap_.reclaimOldest();
+        ++reclaimed;
+    }
+    CHECK(reclaimed > 0);
+    for (unsigned i = 0; i < 180; ++i) {
+        CHECK(tree.hasConflict(1, sv(key(4 * i + 2, 1200)), sv(key(4 * i + 3, 1200))));
+        CHECK(!tree.hasConflict(1, sv(key(4 * i, 1200)), sv(key(4 * i + 1, 1200))));
+    }
+    if constexpr (Tree::Stats::searchEnabled) CHECK(tree.stats().separatorRefreshes > 0);
+    verify(tree);
+    tree.addRange(3, sv(key(500, 1200)), sv(key(550, 1200)));
+    verify(tree);
+}
