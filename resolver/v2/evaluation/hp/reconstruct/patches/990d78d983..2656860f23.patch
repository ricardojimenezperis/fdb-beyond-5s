+void expiredNodesStillDelimitLiveSpans() {
+	begin("expiredNodesStillDelimitLiveSpans");
+	onFreshThread([] {
+		TemporalConflictSet set(16, 0);
+		LevelMirror mirror;
+		writeRange(set, mirror, 3, 1, "m", "n");
+		Version cv = 1;
+		while (set.budget().heapPages < 2 && cv < 1000) {
+			++cv;
+			writePoint(set, mirror, 1, cv, paddedKey("~" + std::to_string(cv), 1000));
+		}
+		writeRange(set, mirror, 1, ++cv, "o", "q");
+		writeRange(set, mirror, 1, ++cv, "r", "s");
+		const Optional<Version> newest = set.heap_.oldestPageNewestCV();
+		if (!check(newest.present() && newest.get() < cv - 1, "the live ranges are on a newer page than the tall tower")) {
+			return;
+		}
+		// The boundary covers the page before it goes, as reclamation does
+		set.validationMinRV_ = newest.get();
+		set.heap_.reclaimOldest();
+		SkipEntry* expired = set.ranges_.levels_[2].first_;
+		if (!check(levelVersions(set.ranges_, 2) == std::vector<Version>{ 1 } &&
+		               levelVersions(set.ranges_, 1) == std::vector<Version>{ 1 } &&
+		               levelVersions(set.ranges_, 0) == (std::vector<Version>{ 1, cv - 1, cv }),
+		           "the tall tower alone reaches levels 1 and 2, the live ranges only level 0")) {
+			return;
+		}
+		check(expired->recordCV == 1 && set.heap_.obsolete(expired->record),
+		      "the tall tower has expired and its record's page is reclaimed");
+		check(expired->summary.maxCV.present() && expired->summary.maxCV.get() == cv,
+		      "and its span, at every level above zero, holds the live ranges");
+
+		const std::vector<LinkRow> links = linksOf(set.ranges_);
+		const std::vector<SkipEntry*> queue = queueCells(set);
+		const Version rv = newest.get();
+		check(rangeConflict(set, rv, "p", "z"), "a live write in the expired tower's span is found");
+		check(rangeConflict(set, rv, "q", "r\x01"), "and a later one in the same span, after passing an earlier one");
+		check(!rangeConflict(set, rv, "t", "z"), "and a read past them finds nothing");
+		check(!rangeConflict(set, cv, "a", "z"), "nor one above every version");
+		check(answers(ownerConflict(set, rv, "p", "z"), true), "the owner finds it too");
+		check(linksOf(set.ranges_) == links, "the range search changed no link and no mark");
+		check(queueCells(set) == queue, "nor the cleanup queue");
+		check(expired->linkedInLevel, "the expired tower is still linked");
+	});
+	end();
+}
