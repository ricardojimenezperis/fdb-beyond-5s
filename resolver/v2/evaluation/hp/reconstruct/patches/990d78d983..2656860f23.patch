+// ---------- Cases added against real FDB types ----------
+
+std::string hex(const std::string& value) {
+    static const char digits[] = "0123456789abcdef";
+    std::string result;
+    for (unsigned char c : value.substr(0, 24)) { result += digits[c >> 4]; result += digits[c & 15]; }
+    if (value.size() > 24) result += "...(" + std::to_string(value.size()) + " bytes)";
+    return result.empty() ? "<empty>" : result;
+}
+
+// Binary keys exercise embedded zeros, length-only differences and occasional long suffixes.
+std::string randomKey(std::mt19937& random, unsigned maxLength = 6) {
+    static const char alphabet[] = {'\0', '\x01', 'a', 'b', '\x7f', '\xff'};
+    std::string result;
+    const unsigned length = random() % (maxLength + 1);
+    for (unsigned i = 0; i < length; ++i) result.push_back(alphabet[random() % 6]);
+    if (random() % 32 == 0) result += std::string(100 + random() % 1500, static_cast<char>('a' + random() % 3));
+    return result;
+}
+
+// The independent model checks CV > RV and half-open overlap; expired writes are irrelevant
+// to admitted reads and may be dropped.
+void pruneModel(std::vector<Interval>& writes, Version floor) {
+    writes.erase(std::remove_if(writes.begin(), writes.end(),
+                                [&](const Interval& w) { return std::get<2>(w) <= floor; }),
+                 writes.end());
+}
+
+void mixedModel() {
+    for (unsigned seed : {11, 29, 71, 505, 2026}) {
+        Tree tree(Tree::InlineOnlyKeys ? 2 : 4, 0);
+        std::vector<Interval> writes;
+        std::mt19937 random(seed);
+        Version cv = 0;
+        uint64_t queries = 0, conflicts = 0, sameVersionBatches = 0;
+        for (unsigned batch = 0; batch < 700; ++batch) {
+            if (random() % 4 || cv == 0) cv += 1 + random() % 3;
+            else ++sameVersionBatches;
+            const unsigned count = random() % 12;
+            std::vector<std::string> storage;
+            storage.reserve(2 * count);
+            std::vector<Tree::Write> batchWrites;
+            for (unsigned i = 0; i < count; ++i) {
+                std::string begin = randomKey(random), end;
+                const bool point = random() % 2;
+                if (point) end = begin + '\0';
+                else {
+                    end = randomKey(random);
+                    if (sv(end) < sv(begin)) std::swap(begin, end);
+                    if (!(sv(begin) < sv(end))) end = begin + '\x01';
+                }
+                storage.push_back(begin);
+                storage.push_back(end);
+                batchWrites.push_back({sv(storage[2 * i]), sv(storage[2 * i + 1]),
+                                       point ? ConflictKind::Point : ConflictKind::Range});
+                writes.emplace_back(begin, end, cv);
+            }
+            const auto before = tree.stats();
+            tree.addWrites(cv, batchWrites.data(), batchWrites.size());
+            // One split at most per interval entered, whatever the overwrites produced
+            CHECK(tree.stats().splits - before.splits <= tree.stats().intervalInsertions - before.intervalInsertions);
+            if (random() % 3 == 0) tree.cleanup(random() % 8, random() % 6, random() % 4 == 0);
+
+            const Version floor = tree.validationMinRV();
+            pruneModel(writes, floor);
+            const unsigned queryCount = random() % 40;
+            std::vector<std::string> keys;
+            keys.reserve(2 * queryCount);
+            std::vector<Tree::Query> batchQueries;
+            for (unsigned i = 0; i < queryCount; ++i) {
+                keys.push_back(randomKey(random));
+                // Points, ranges, and empty or reversed reads, which conflict with nothing
+                const unsigned shape = random() % 8;
+                keys.push_back(shape < 3 ? keys.back() + '\0' : shape == 7 ? keys.back() : randomKey(random));
+                if (shape >= 3 && shape < 6 && sv(keys[2 * i + 1]) < sv(keys[2 * i])) std::swap(keys[2 * i], keys[2 * i + 1]);
+                const Version rv = floor + random() % (cv - floor + 1);
+                batchQueries.push_back({rv, sv(keys[2 * i]), sv(keys[2 * i + 1]), random() % 2 == 0});
+            }
+            tree.hasConflicts(batchQueries.data(), batchQueries.size());
+            for (unsigned i = 0; i < queryCount; ++i) {
+                const bool expected = referenceConflict(writes, batchQueries[i].readVersion, keys[2 * i], keys[2 * i + 1]);
+                if (batchQueries[i].conflict != expected)
+                    throw std::runtime_error("seed " + std::to_string(seed) + " batch " + std::to_string(batch) +
+                                             " query " + std::to_string(i) + " rv " +
+                                             std::to_string(batchQueries[i].readVersion) + " floor " +
+                                             std::to_string(floor) + " [" + hex(keys[2 * i]) + ", " +
+                                             hex(keys[2 * i + 1]) + ") got " +
+                                             std::to_string(batchQueries[i].conflict) + " expected " +
+                                             std::to_string(expected));
+                ++queries;
+                conflicts += expected;
+            }
+            // A read below the boundary is refused before any result changes
+            if (floor > 0 && random() % 10 == 0) {
+                Tree::Query refused[] = {{floor, sv(""), sv("\xff"), true}, {floor - 1, sv(""), sv("\xff"), true}};
+                bool threw = false;
+                try { tree.hasConflicts(refused, 2); } catch (const Error& e) { threw = e.code() == error_code_transaction_too_old; }
+                CHECK(threw && refused[0].conflict && refused[1].conflict);
+            }
+            if (batch % 25 == 0) verify(tree);
+        }
+        verify(tree);
+        // The run must have reached what it is meant to exercise
+        CHECK(tree.heap_.lastReclaimedPageID() > 0 && tree.validationMinRV() > 0);
+        CHECK(sameVersionBatches > 0 && conflicts > 0 && conflicts < queries);
+        CHECK(tree.stats().internalMerges == 0 && tree.stats().splits > 0 && tree.stats().overwrittenIntervals > 0);
+    }
+}
+
+void splitBoundAfterMerges() {
+    Tree tree(2048, 0);
+    std::mt19937 random(8);
+    std::vector<unsigned> order(20000);
+    for (unsigned i = 0; i < order.size(); ++i) order[i] = i;
+    std::shuffle(order.begin(), order.end(), random);
+    // Three of every four intervals expire, spread through the key space; versions never decrease
+    for (unsigned i : order) if (i % 4) tree.addRange(1, sv(key(2 * i)), sv(key(2 * i + 1)));
+    for (unsigned i : order) if (i % 4 == 0) tree.addRange(2, sv(key(2 * i)), sv(key(2 * i + 1)));
+    tree.validationMinRV_ = 1;
+    if constexpr (Tree::InlineOnlyKeys) {
+        // Head reclamation may retain expired entries. Rewrite at the same CV to force
+        // touched-leaf purging before merges and regrowth.
+        for (unsigned i = 0; i < 20000; i += 4)
+            tree.addRange(2, sv(key(2 * i)), sv(key(2 * i + 1)));
+    } else drainExpired(tree);
+    for (unsigned pass = 0; pass < 600; ++pass) tree.cleanup(64, 64, true);
+    verify(tree);
+    CHECK(tree.stats().internalMerges == 0);
+    const auto splitsBeforeGrowth = tree.stats().splits;
+
+    std::vector<Interval> writes;
+    for (unsigned i = 0; i < 20000; i += 4) writes.emplace_back(key(2 * i), key(2 * i + 1), 2);
+    for (unsigned n = 0; n < 20000; ++n) {
+        const Version cv = 3 + n;
+        const unsigned start = random() % 40000;
+        const unsigned length = random() % 10 == 0 ? 1 + random() % 400 : 1 + random() % 3;
+        const auto before = tree.stats();
+        tree.addRange(cv, sv(key(start)), sv(key(start + length)));
+        writes.emplace_back(key(start), key(start + length), cv);
+        const auto inserted = tree.stats().intervalInsertions - before.intervalInsertions;
+        CHECK(inserted >= 1 && inserted <= 2);
+        CHECK(tree.stats().splits - before.splits <= inserted);
+        if (n % 50 == 0) tree.cleanup(8, 4, false);
+        if (n % 1000 == 0) verify(tree);
+    }
+    verify(tree);
+    CHECK(tree.stats().splits > splitsBeforeGrowth && tree.stats().internalSplits > 0);
+    // The model answers on the final tree, after merges, splits and overwrites
+    for (unsigned q = 0; q < 2000; ++q) {
+        const unsigned a = random() % 40000;
+        const std::string qb = key(a), qe = key(a + 1 + random() % 20);
+        const Version rv = 1 + random() % 20003;
+        CHECK(tree.hasConflict(rv, sv(qb), sv(qe)) == referenceConflict(writes, rv, qb, qe));
+    }
+}
+
+void criticalMarginOnMerge() {
+    for (bool fillAll : {true, false}) {
+        Tree tree(256, 0);
+        tree.configureFictitiousLeaves({ 0, 0 });
+        const unsigned retained = Tree::Capacity / 3;
+        std::vector<unsigned> order(Tree::Capacity * Tree::Capacity * Tree::Capacity);
+        for (unsigned i = 0; i < order.size(); ++i) order[i] = i;
+        std::shuffle(order.begin(), order.end(), std::mt19937(31));
+        for (unsigned i : order) {
+            tree.addRange(1, sv(key(4 * i)), sv(key(4 * i + 1)));
+            if (tree.height() == 3 && tree.root_->size() >= 3 && tree.root_->at(0).payload.link.child->size() > retained &&
+                tree.root_->at(1).payload.link.child->size() > retained)
+                break;
+        }
+        CHECK(tree.height() == 3 && tree.root_->size() >= 3);
+        for (unsigned side = 0; side < 2; ++side) {
+            Tree::Node* node = tree.root_->at(side).payload.link.child;
+            for (unsigned rank = 0; rank + 1 < retained && rank < node->size(); ++rank) {
+                Tree::Node* leaf = node->at(rank).payload.link.child;
+                if (!leaf->critical) continue;
+                tree.eraseSlot(leaf, leaf->size() - 1);
+                tree.refreshUp(leaf);
+            }
+        }
+        Tree::Node* first = tree.root_->at(0).payload.link.child;
+        Tree::Node* second = tree.root_->at(1).payload.link.child;
+        // Keep enough children for criticality to decide whether merging is allowed
+        for (Tree::Node* node : {first, second}) {
+            CHECK(!node->leaf && node->size() > retained);
+            Tree::Node* boundary = node->at(retained - 1).payload.link.child;
+            Tree::Node* last = node->at(node->size() - 1).payload.link.child;
+            const std::string from = entryBytes(tree, boundary->at(0));
+            const std::string to = entryBytes(tree, last->at(last->size() - 1), true);
+            tree.addRange(2, sv(from), sv(to));
+            CHECK(node->size() == retained || node->size() == retained - 1);
+        }
+        // Fill selected leaves to capacity in the gap after their first interval
+        for (Tree::Node* node : {first, second})
+            for (unsigned rank = 0, children = node->size(); rank < (fillAll ? children : std::min(2U, children - 1)); ++rank) {
+                Tree::Node* leaf = node->at(rank).payload.link.child;
+                const std::string base = entryBytes(tree, leaf->at(0), true);
+                // Bounded, so that a leaf which never fills fails instead of looping
+                for (char suffix = 1; leaf->size() < Tree::Capacity && suffix < 64; ++suffix)
+                    tree.addRange(3, sv(base + suffix), sv(base + suffix + '\x01'));
+                CHECK(leaf->size() == Tree::Capacity && leaf->critical);
+            }
+        verify(tree);
+        CHECK(first->parent == second->parent);
+        CHECK(first->parent->order.rankOfSlot(second->parentSlot) == first->parent->order.rankOfSlot(first->parentSlot) + 1);
+        unsigned critical = 0;
+        for (Tree::Node* node : {first, second})
+            for (unsigned i = 0; i < node->size(); ++i) critical += node->at(i).payload.link.child->critical;
+        CHECK((first->size() + second->size() + critical <= Tree::Capacity) == !fillAll);
+        verify(tree);
+    }
+}
+
+void separatorExpiryAtAllLevels() {
+    Tree tree(1024, 0);
+    const unsigned count = std::max(6000U, Tree::Capacity * Tree::Capacity * Tree::Capacity + 1);
+    // Every fourth interval at CV 1, written first so that its records fill the oldest pages
+    for (unsigned i = 0; i < count; i += 4) tree.addRange(1, sv(key(2 * i, 300)), sv(key(2 * i + 1, 300)));
+    for (unsigned i = 0; i < count; ++i)
+        if (i % 4) tree.addRange(2, sv(key(2 * i, 300)), sv(key(2 * i + 1, 300)));
+    const unsigned height = tree.height();
+    CHECK(height >= 4);
+    std::vector<unsigned> expiring(height);
+    auto walk = [&](auto&& self, Tree::Node* node, unsigned depth) -> void {
+        if (node->leaf) return;
+        for (unsigned i = 0; i < node->size(); ++i) {
+            if (node->at(i).payload.link.firstCV == 1) ++expiring[depth];
+            self(self, node->at(i).payload.link.child, depth + 1);
+        }
+    };
+    walk(walk, tree.root_, 0);
+    for (unsigned depth = 0; depth + 1 < height; ++depth) CHECK(expiring[depth] > 0);
+    uint64_t reclaimed = 0;
+    while (tree.heap_.oldestPageNewestCV().present() && tree.heap_.oldestPageNewestCV().get() == 1) {
+        tree.validationMinRV_ = 1;
+        tree.heap_.reclaimOldest();
+        ++reclaimed;
+    }
+    CHECK(reclaimed > 0);
+    const auto refreshes = tree.stats().separatorRefreshes;
+    // Queries first, then writes at the left edge, where every level's first separator came from CV 1
+    for (unsigned i = 0; i < count; i += 3) {
+        CHECK(tree.hasConflict(1, sv(key(2 * i, 300)), sv(key(2 * i + 1, 300))) == (i % 4 != 0));
+        CHECK(tree.hasConflict(1, sv(key(2 * i, 300)), sv(key(2 * i + 9, 300))));
+    }
+    if constexpr (Tree::Stats::searchEnabled) CHECK(tree.stats().separatorRefreshes > refreshes);
+    verify(tree);
+    tree.addRange(3, sv(key(0, 300)), sv(key(1, 300)));
+    tree.addRange(3, sv(std::string()), sv(key(0, 300)));
+    CHECK(tree.hasConflict(2, sv(key(0, 300)), sv(key(1, 300))));
+    verify(tree);
+}
+
+void sharedFragmentEndpoints() {
+    // Keys of 20000 bytes: every range record fills most of a page, so each write has its own
+    Tree tree(24, 0);
+    const std::string pad(20000, 'p');
+    auto k = [&](char c) { return std::string(1, c) + pad; };
+    std::vector<Interval> writes;
+    auto write = [&](Version cv, char from, char to) {
+        tree.addRange(cv, sv(k(from)), sv(k(to)));
+        writes.emplace_back(k(from), k(to), cv);
+    };
+    write(10, 'a', 'z');
+    write(20, 'd', 'm');
+    // Replaces [d,m)@20 whole: the fragments of the first write keep their endpoints in its record
+    write(30, 'd', 'm');
+    CHECK(contents(tree) == (std::vector<Interval>{{k('a'), k('d'), 10}, {k('d'), k('m'), 30}, {k('m'), k('z'), 10}}));
+    const auto pageOf20 = tree.root_->at(0).end.pageID;
+    CHECK(tree.root_->at(2).begin.pageID == pageOf20 && tree.root_->at(1).begin.pageID != pageOf20);
+    write(40, 'p', 'q');
+    CHECK(contents(tree).size() == 5);
+    const std::string probes = "abcdefmnopqrxyz";
+    for (unsigned step = 0; tree.heap_.oldestPageNewestCV().present(); ++step) {
+        const Version boundary = tree.heap_.oldestPageNewestCV().get();
+        tree.validationMinRV_ = std::max(tree.validationMinRV_, boundary);
+        tree.heap_.reclaimOldest();
+        pruneModel(writes, tree.validationMinRV());
+        for (char a : probes)
+            for (char b : probes)
+                if (a < b)
+                    CHECK(tree.hasConflict(tree.validationMinRV(), sv(k(a)), sv(k(b))) ==
+                          referenceConflict(writes, tree.validationMinRV(), k(a), k(b)));
+        verify(tree);
+        if (step == 6) break;
+        // A write over expired fragments removes them without reading their keys
+        write(100 + step, 'b', 'c');
+    }
+}
+
+// Replaces the pool's reclaimer: counts reclamation by use, and flags any that happens while the
+// index is being modified, when no allocation is allowed
+struct Tripwire {
+    Tree* tree;
+    bool modifying = false;
+    unsigned violations = 0;
+    unsigned heapReclaims = 0, indexReclaims = 0;
+    // The version being written, and how often a reclaim for an index reservation reached it
+    Version writing = 0;
+    unsigned indexReachedWriting = 0;
+};
+void tripwireReclaim(void* context, PageUse use) {
+    auto* tripwire = static_cast<Tripwire*>(context);
+    if (tripwire->modifying) { ++tripwire->violations; return; }
+    ++(use == PageUse::Index ? tripwire->indexReclaims : tripwire->heapReclaims);
+    tripwire->tree->reclaim(use);
+    if (use == PageUse::Index && tripwire->writing && tripwire->tree->validationMinRV() >= tripwire->writing)
+        ++tripwire->indexReachedWriting;
+}
+
+// Shared K-byte prefixes force heap comparisons. After reservation-triggered reclamation,
+// purge expired destination entries before reading their reclaimed keys.
+void reclamationDuringReservationSharedPrefix() {
+    const std::string shared(Tree::InlineKeyBytes, 'p');
+    for (unsigned seed : {3, 4}) {
+        Tree tree(4, 0, Tree::MemoryConfig{});
+        Tripwire tripwire{&tree};
+        tree.pool_.setReclaimer(&tripwire, tripwireReclaim);
+        std::mt19937 random(seed);
+        std::vector<Interval> writes;
+        unsigned discardingBatches = 0, admittedAfterDiscard = 0;
+        Version cv = 0;
+        for (unsigned batch = 0; batch < 400; ++batch) {
+            cv += 1;
+            // Small keys force index reservations; long keys force heap reclamation into the incoming CV.
+            const bool wide = random() % 3 == 0;
+            const unsigned count = wide ? 60 + random() % 120 : 20 + random() % 60;
+            std::vector<std::string> storage;
+            storage.reserve(2 * count);
+            std::vector<Tree::Write> batchWrites;
+            for (unsigned i = 0; i < count; ++i) {
+                const unsigned start = random() % 50000;
+                storage.push_back(shared + key(start, wide ? 600 + random() % 600 : 4));
+                storage.push_back(shared + key(start + 1 + random() % 5, 4));
+                batchWrites.push_back({sv(storage[2 * i]), sv(storage[2 * i + 1]), ConflictKind::Range});
+                writes.emplace_back(storage[2 * i], storage[2 * i + 1], cv);
+            }
+            const auto indexReclaims = tripwire.indexReclaims;
+            const auto discarded = tree.stats().discardedWrites;
+            const auto reachedBefore = tripwire.indexReachedWriting;
+            tripwire.writing = cv;
+            tree.addWrites(cv, batchWrites.data(), batchWrites.size());
+            tripwire.writing = 0;
+            if (tree.stats().discardedWrites > discarded) {
+                CHECK(tree.validationMinRV() >= cv);
+                ++discardingBatches;
+            } else if (discardingBatches) ++admittedAfterDiscard;
+            (void)indexReclaims;
+            (void)reachedBefore;
+            const Version floor = tree.validationMinRV();
+            pruneModel(writes, floor);
+            for (unsigned q = 0; q < 10; ++q) {
+                const unsigned a = random() % 50000;
+                const std::string qb = shared + key(a, 4), qe = shared + key(a + 1 + random() % 10, 4);
+                const Version rv = floor + random() % (cv - floor + 1);
+                CHECK(tree.hasConflict(rv, sv(qb), sv(qe)) == referenceConflict(writes, rv, qb, qe));
+            }
+            if (batch % 20 == 0) verify(tree);
+        }
+        verify(tree);
+        std::printf("[seed %u: index %u heap %u reached %u discarding %u after %u discarded %llu] ", seed,
+                    tripwire.indexReclaims, tripwire.heapReclaims, tripwire.indexReachedWriting, discardingBatches,
+                    admittedAfterDiscard, (unsigned long long)tree.stats().discardedWrites);
+        CHECK(tripwire.violations == 0 && tripwire.indexReclaims > 0 && tripwire.heapReclaims == 0);
+        CHECK(tree.peakKeyBlockCount() > 0 && tree.stats().heapPagesReclaimed > 0);
+        CHECK(discardingBatches > 0 && admittedAfterDiscard > 0);
+        tree.pool_.setReclaimer(&tree, Tree::reclaimThunk);
+    }
+}
+
+void reclamationDuringReservation() {
+    for (unsigned seed : {3, 4, 5}) {
+        Tree tree(4, 0, Tree::MemoryConfig{});
+        tree.configureFictitiousLeaves({ 0, 0 });
+        Tripwire tripwire{&tree};
+        tree.pool_.setReclaimer(&tripwire, tripwireReclaim);
+        std::mt19937 random(seed);
+        std::vector<Interval> writes;
+        unsigned discardingBatches = 0, admittedAfterDiscard = 0;
+        Version cv = 0;
+        for (unsigned batch = 0; batch < 400; ++batch) {
+            cv += 1;
+            // Small keys force index reservations; long keys force heap reclamation into the incoming CV.
+            const bool wide = random() % 3 == 0;
+            const unsigned count = wide ? 60 + random() % 120 : 20 + random() % 60;
+            std::vector<std::string> storage;
+            storage.reserve(2 * count);
+            std::vector<Tree::Write> batchWrites;
+            for (unsigned i = 0; i < count; ++i) {
+                const unsigned start = random() % 50000;
+                storage.push_back(key(start, wide ? 600 + random() % 600 : 4));
+                storage.push_back(key(start + 1 + random() % 5, 4));
+                batchWrites.push_back({sv(storage[2 * i]), sv(storage[2 * i + 1]), ConflictKind::Range});
+                writes.emplace_back(storage[2 * i], storage[2 * i + 1], cv);
+            }
+            const auto indexReclaims = tripwire.indexReclaims;
+            const auto discarded = tree.stats().discardedWrites;
+            const auto reachedBefore = tripwire.indexReachedWriting;
+            tripwire.writing = cv;
+            tree.addWrites(cv, batchWrites.data(), batchWrites.size());
+            tripwire.writing = 0;
+            if (tree.stats().discardedWrites > discarded) {
+                CHECK(tree.validationMinRV() >= cv);
+                ++discardingBatches;
+            } else if (discardingBatches) ++admittedAfterDiscard;
+            (void)indexReclaims;
+            (void)reachedBefore;
+            const Version floor = tree.validationMinRV();
+            pruneModel(writes, floor);
+            for (unsigned q = 0; q < 10; ++q) {
+                const unsigned a = random() % 50000;
+                const std::string qb = key(a, 4), qe = key(a + 1 + random() % 10, 4);
+                const Version rv = floor + random() % (cv - floor + 1);
+                CHECK(tree.hasConflict(rv, sv(qb), sv(qe)) == referenceConflict(writes, rv, qb, qe));
+            }
+            if (batch % 20 == 0) verify(tree);
+        }
+        verify(tree);
+        std::printf("[seed %u: index %u heap %u reached %u discarding %u after %u discarded %llu] ", seed,
+                    tripwire.indexReclaims, tripwire.heapReclaims, tripwire.indexReachedWriting, discardingBatches,
+                    admittedAfterDiscard, (unsigned long long)tree.stats().discardedWrites);
+        CHECK(tripwire.violations == 0 && tripwire.indexReclaims > 0 && tripwire.heapReclaims == 0);
+        CHECK(tree.peakKeyBlockCount() > 0 && tree.stats().heapPagesReclaimed > 0);
+        CHECK(discardingBatches > 0 && admittedAfterDiscard > 0);
+        tree.pool_.setReclaimer(&tree, Tree::reclaimThunk);
+    }
+
+    // The same, built on purpose: a reclaim run by the index reservation itself reaches the
+    // version being written, the write is discarded and its reservation returned
+    Tree tree(64, 0);
+    tree.configureFictitiousLeaves({ 0, 0 });
+    Tripwire tripwire{&tree};
+    tree.pool_.setReclaimer(&tripwire, tripwireReclaim);
+    for (unsigned i = 0; i < 300; ++i) tree.addRange(2, sv(key(2 * i)), sv(key(2 * i + 1)));
+    // All candidates are at version 2, so this allocation must reach the incoming CV.
+    for (unsigned i = 0; i < 180; ++i) tree.addRange(2, sv(key(1000 + 2 * i, 1000)), sv(key(1001 + 2 * i)));
+    CHECK(tree.heap_.oldestPageNewestCV().get() == 2 && tree.keyBlockCount() >= 3);
+    // Fill the destination leaf: an actual split, not a speculative reserve,
+    // must trigger index allocation on the next write.
+    for (unsigned i = 0;; ++i) {
+        auto* last = tree.firstLeaf_;
+        while (last->navigation.leaf.next) last = last->navigation.leaf.next;
+        const auto* previous = last->navigation.leaf.previous;
+        if (last->size() == Tree::Capacity && (!previous || previous->critical)) break;
+        tree.addRange(2, sv(key(3000 + 2*i)), sv(key(3001 + 2*i)));
+    }
+    std::vector<Tree::Node*> held;
+    while (tree.free_) held.push_back(tree.allocateNode());
+    std::vector<PoolPage*> stash;
+    while (PoolPage* page = tree.pool_.tryAcquire(PageUse::Index)) stash.push_back(page);
+    const auto before = tree.stats();
+    const uint64_t indexPages = tree.budget().indexPages;
+    tripwire.writing = 2;
+    tree.addRange(2, sv(key(5000)), sv(key(5001)));
+    tripwire.writing = 0;
+    CHECK(tripwire.indexReachedWriting == 1 && tree.validationMinRV() == 2);
+    CHECK(tree.stats().discardedWrites == before.discardedWrites + 1);
+    CHECK(tree.stats().intervalInsertions == before.intervalInsertions);
+    // No page changes use and no reservation survives the discarded write.
+    CHECK(tree.budget().indexPages == indexPages && tree.freeNodes_ > 0);
+    for (Tree::Node* node : held) tree.recycleNode(node);
+    for (PoolPage* page : stash) tree.pool_.release(page, PageUse::Index);
+    verify(tree);
+    // Writes continue at the next version
+    tree.addRange(3, sv(key(5000)), sv(key(5001)));
+    CHECK(tree.hasConflict(2, sv(key(5000)), sv(key(5001))) && !tree.hasConflict(3, sv(key(5000)), sv(key(5001))));
+    CHECK(tree.hasConflict(2, sv(key(0)), sv(key(10000))) && !tree.hasConflict(3, sv(key(0)), sv(key(10000))));
+    verify(tree);
+    tree.pool_.setReclaimer(&tree, Tree::reclaimThunk);
+}
+
+// addRange's own steps, with the pool exhausted and the free list hidden between the reservation
+// and the end of the modification: any allocation there reaches the tripwire
+void guardedAddRange(Tree& tree, Tripwire& tripwire, Version cv, StringRef begin, StringRef end, unsigned& maxTaken) {
+    tree.lastWriteCV_ = cv;
+    if (cv <= tree.validationMinRV_) return;
+    const auto record = tree.heap_.appendRange(cv, begin, end);
+    CHECK(record.present());
+    Tree::Reservation reservation;
+    tree.reserve(reservation, 3);
+    if (cv <= tree.validationMinRV_) { tree.releaseReservation(reservation); return; }
+    Tree::Entry incoming;
+    incoming.cv = cv;
+    incoming.begin = {record.get().pageID, record.get().offset + static_cast<uint32_t>(sizeof(RangeConflictHeader)),
+                      static_cast<uint32_t>(begin.size())};
+    incoming.end = {record.get().pageID, incoming.begin.offset + incoming.begin.length, static_cast<uint32_t>(end.size())};
+    Tree::cacheKey(incoming.beginInline, begin);
+    Tree::KeyPrefix endBytes;
+    Tree::cacheKey(endBytes, end);
+    Tree::setEnd(incoming, incoming.end, endBytes);
+    std::vector<PoolPage*> stash;
+    while (PoolPage* page = tree.pool_.tryAcquire(PageUse::Index)) stash.push_back(page);
+    Tree::Node* hidden = tree.free_;
+    const uint64_t hiddenCount = tree.freeNodes_;
+    tree.free_ = nullptr;
+    tree.freeNodes_ = 0;
+    const auto takenBefore = tree.stats().nodesTaken;
+    tripwire.modifying = true;
+    tree.overwrite(incoming, reservation);
+    tripwire.modifying = false;
+    maxTaken = std::max(maxTaken, static_cast<unsigned>(tree.stats().nodesTaken - takenBefore));
+    tree.releaseReservation(reservation);
+    // Restore the hidden blocks without moving entries or invalidating their node positions
+    if (hidden) {
+        if (tree.free_) {
+            Tree::Node* tail = tree.free_;
+            while (auto* next = static_cast<Tree::Node*>(tree.pool_.detachedNext(tail))) tail = next;
+            tree.pool_.setDetachedNext(tail, hidden);
+        } else tree.free_ = hidden;
+    }
+    tree.freeNodes_ += hiddenCount;
+    for (PoolPage* page : stash) tree.pool_.release(page, PageUse::Index);
+}
+
+void exactReservationUsesOnlyDemand() {
+    if constexpr (!Tree::Stats::searchEnabled) return;
+    Tree tree(256, 0);
+    std::mt19937 random(12);
+    unsigned seen = 0;
+    for (unsigned n = 1; n <= 12000; ++n) {
+        const unsigned start = random() % 20000;
+        const unsigned length = random() % 20 == 0 ? 1 + random() % 2000 : 1 + random() % 4;
+        const auto before = tree.stats();
+        tree.addRange(n, sv(key(start)), sv(key(start + length)));
+        const auto reserved = tree.stats().nodesReserved - before.nodesReserved;
+        const auto taken = tree.stats().nodesTaken - before.nodesTaken;
+        CHECK(reserved == taken && taken <= 3);
+        seen |= 1U << taken;
+        if (n % 500 == 0) verify(tree);
+    }
+    // A full leaf under a critical root: the incoming interval splits the leaf,
+    // then its right survivor splits the root (sibling + new root).
+    Tree rootCase(64, 0);
+    for (unsigned i = 1; i <= Tree::Capacity * Tree::Capacity; ++i) {
+        rootCase.addRange(1, sv(key(10*i)), sv(key(10*i+8)));
+        auto* last = rootCase.firstLeaf_;
+        while (last->navigation.leaf.next) last = last->navigation.leaf.next;
+        if (rootCase.root_->leaf || !rootCase.root_->critical || last->size() != Tree::Capacity) continue;
+        const auto before = rootCase.stats();
+        rootCase.addRange(2, sv(key(10*i+2)), sv(key(10*i+4)));
+        const auto used = rootCase.stats().nodesTaken - before.nodesTaken;
+        CHECK(used == 3 && rootCase.stats().nodesReserved - before.nodesReserved == 3);
+        CHECK(rootCase.hasConflict(0, sv(key(10*i+4)), sv(key(10*i+8))));
+        CHECK(!rootCase.hasConflict(1, sv(key(10*i+4)), sv(key(10*i+8))));
+        seen |= 1U << used;
+        verify(rootCase);
+        break;
+    }
+    std::printf("[node-count cases mask=%u] ", seen);
+    CHECK(seen == 15); // Actual writes requiring 0, 1, 2 and 3 new nodes.
+    verify(tree);
+}
+
+void pendingSurvivorSurvivesAllocationReclaim() {
+    Tree tree(64, 0);
+    unsigned target = 0;
+    for (unsigned i = 1; i <= Tree::Capacity * Tree::Capacity; ++i) {
+        tree.addRange(5, sv(key(10*i)), sv(key(10*i+8)));
+        auto* last = tree.firstLeaf_;
+        while (last->navigation.leaf.next) last = last->navigation.leaf.next;
+        if (!tree.root_->leaf && tree.root_->critical && last->size() == Tree::Capacity) {
+            target = 10*i; break;
+        }
+    }
+    CHECK(target);
+    struct Context { Tree* tree; std::vector<Tree::Node*> held; unsigned calls = 0; } context{&tree, {}};
+    while (tree.freeNodes_ < 3) context.held.push_back(tree.allocateNode());
+    while (tree.freeNodes_ > 1) context.held.push_back(tree.allocateNode());
+    CHECK(context.held.size() >= 2);
+    std::vector<PoolPage*> pages;
+    while (auto* page = tree.pool_.tryAcquire(PageUse::Index)) pages.push_back(page);
+    tree.pool_.setReclaimer(&context, [](void* opaque, PageUse use) {
+        auto& c = *static_cast<Context*>(opaque);
+        CHECK(use == PageUse::Index);
+        ++c.calls;
+        if (c.tree->writeBatchActive_) c.tree->drainRetired();
+        c.tree->validationMinRV_ = 1;
+        for (unsigned i = 0; i < 2; ++i) {
+            CHECK(!c.held.empty());
+            c.tree->recycleNode(c.held.back()); c.held.pop_back();
+        }
+    });
+    // First insertion consumes the last free sibling; its right survivor then
+    // needs a root split. Reclamation intervenes with the survivor still local.
+    tree.addRange(10, sv(key(target+2)), sv(key(target+4)));
+    tree.pool_.setReclaimer(&tree, Tree::reclaimThunk);
+    CHECK(context.calls == 1 && tree.validationMinRV() == 1);
+    CHECK(tree.hasConflict(5, sv(key(target+2)), sv(key(target+4))));
+    CHECK(tree.hasConflict(4, sv(key(target+4)), sv(key(target+8))));
+    CHECK(!tree.hasConflict(5, sv(key(target+4)), sv(key(target+8))));
+    CHECK(tree.hasConflict(4, sv(key(target)), sv(key(target+2))));
+    for (auto* node : context.held) tree.recycleNode(node);
+    for (auto* page : pages) tree.pool_.release(page, PageUse::Index);
+    verify(tree);
+}
