diff --git a/fdbserver/resolver/BlockQueue.h b/fdbserver/resolver/BlockQueue.h
new file mode 100644
index 0000000000000000000000000000000000000000..c1daa94a479fdf48962ebfc4fc557a29787a5d69
--- /dev/null
+++ b/fdbserver/resolver/BlockQueue.h
@@ -0,0 +1,156 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <type_traits>
+
+namespace paged_btree {
+
+// Queues share reusable blocks, while their entries and cursor positions stay independent
+// Erasing leaves a hole and never moves another entry, so live positions remain stable
+// The owner synchronizes mutations and ensures that queued values remain valid until erased
+// This container does not own objects referenced by its values
+// All queue and position handles belong to this pool and expire when it is destroyed
+template <class T, unsigned BlockCapacity = 64>
+class BlockQueuePool {
+    static_assert(BlockCapacity > 0 && BlockCapacity <= 64);
+    static_assert(std::is_trivially_copyable_v<T> && std::is_nothrow_default_constructible_v<T>);
+public:
+    struct alignas(64) Block {
+        Block* previous = nullptr;
+        Block* next = nullptr;
+        Block* allNext = nullptr;
+        uint64_t live = 0;
+        unsigned used = 0;
+        std::array<T, BlockCapacity> entries{};
+    };
+    struct Queue {
+        Block* head = nullptr;
+        Block* tail = nullptr;
+        uint64_t count = 0;
+    };
+    struct Cursor {
+        Block* block = nullptr;
+        unsigned slot = 0;
+    };
+
+    BlockQueuePool() = default;
+    BlockQueuePool(const BlockQueuePool&) = delete;
+    BlockQueuePool& operator=(const BlockQueuePool&) = delete;
+    ~BlockQueuePool() {
+        while (all_) {
+            Block* next = all_->allNext;
+            delete all_;
+            all_ = next;
+        }
+    }
+
+    Cursor append(Queue& queue, T value) {
+        if (!queue.tail || queue.tail->used == BlockCapacity) {
+            Block* block = acquire();
+            block->previous = queue.tail;
+            if (queue.tail) queue.tail->next = block;
+            else queue.head = block;
+            queue.tail = block;
+        }
+        Block* block = queue.tail;
+        const unsigned slot = block->used++;
+        block->entries[slot] = value;
+        block->live |= uint64_t{1} << slot;
+        ++queue.count;
+        return {block, slot};
+    }
+
+    // The position must still be live in this queue
+    // An optional scan cursor is redirected before its empty block can be reused
+    void erase(Queue& queue, Cursor position, Cursor* scan = nullptr) {
+        Block* block = position.block;
+        block->live &= ~(uint64_t{1} << position.slot);
+        block->entries[position.slot] = T{};
+        --queue.count;
+        if (block->live) {
+            // Reuse trailing holes without changing the order of remaining queue entries
+            block->used = 64 - __builtin_clzll(block->live);
+            return;
+        }
+        Block* next = block->next;
+        if (block->previous) block->previous->next = next;
+        else queue.head = next;
+        if (next) next->previous = block->previous;
+        else queue.tail = block->previous;
+        if (scan && scan->block == block) *scan = {next ? next : queue.head, 0};
+        block->previous = nullptr;
+        block->next = free_;
+        free_ = block;
+    }
+
+    // Starts at the head for an empty cursor, returns at most one full turn of live entries
+    // The caller consumes each window before mutating entries that its values refer to
+    // The callback can prefetch referenced data without teaching this container its type
+    template <bool PrefetchBlocks, class Prepare>
+    unsigned readWindow(const Queue& queue, Cursor& cursor, T* values,
+                        unsigned limit, bool wrap, Prepare prepare) const {
+        if (!queue.count) { cursor = {}; return 0; }
+        if (!cursor.block) cursor = {queue.head, 0};
+        limit = std::min<uint64_t>(limit, queue.count);
+        unsigned count = 0;
+        while (cursor.block && count < limit) {
+            Block* block = cursor.block;
+            prefetchBlock<PrefetchBlocks>(block->next ? block->next : (wrap ? queue.head : nullptr));
+            uint64_t live = cursor.slot < BlockCapacity
+                ? block->live & (~uint64_t{0} << cursor.slot) : 0;
+            while (live && count < limit) {
+                const unsigned slot = __builtin_ctzll(live);
+                const T value = block->entries[slot];
+                values[count++] = value;
+                prepare(value);
+                cursor.slot = slot + 1;
+                live &= live - 1;
+            }
+            if (!live) cursor = {block->next ? block->next : (wrap ? queue.head : nullptr), 0};
+        }
+        return count;
+    }
+
+    template <bool Enabled>
+    static void prefetchBlock(Block* block) {
+        if constexpr (Enabled) {
+            if (block) for (size_t offset = 0; offset < sizeof(Block); offset += 64)
+                __builtin_prefetch(reinterpret_cast<const char*>(block) + offset, 0, 1);
+        }
+    }
+
+    uint64_t allocatedBlocks() const { return allocated_; }
+    uint64_t reusedBlocks() const { return reused_; }
+    uint64_t allocatedBytes() const { return allocated_ * sizeof(Block); }
+    // Diagnostic traversal only, including blocks retained for reuse
+    Block* allBlocks() const { return all_; }
+    Block* freeBlocks() const { return free_; }
+
+private:
+    Block* free_ = nullptr;
+    Block* all_ = nullptr;
+    uint64_t allocated_ = 0;
+    uint64_t reused_ = 0;
+
+    Block* acquire() {
+        Block* block = free_;
+        if (block) {
+            free_ = block->next;
+            ++reused_;
+        } else {
+            block = new Block;
+            block->allNext = all_;
+            all_ = block;
+            ++allocated_;
+        }
+        block->previous = block->next = nullptr;
+        block->live = 0;
+        block->used = 0;
+        return block;
+    }
+};
+
+} // namespace paged_btree
diff --git a/fdbserver/resolver/BlockReaderLcp.h b/fdbserver/resolver/BlockReaderLcp.h
new file mode 100644
index 0000000000000000000000000000000000000000..c037df521052b65a0ac75bf8e2e847fd589a65de
--- /dev/null
+++ b/fdbserver/resolver/BlockReaderLcp.h
@@ -0,0 +1,44 @@
+#pragma once
+#if defined(__SSE2__) || defined(__AVX2__)
+#include <immintrin.h>
+#endif
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+namespace block_reader_lcp {
+struct Result { int order; uint32_t lcp; };
+// Compares exactly n readable bytes. The caller handles unequal key lengths.
+// No load crosses the supplied extent. SIMD is selected by the build ISA flags.
+// Input lengths are bounded by FDB StringRef (int); the 32-bit LCP is sufficient.
+inline __attribute__((always_inline)) Result compare(const unsigned char* a,const unsigned char* b,size_t n) {
+ size_t offset=0;
+#if defined(__AVX2__)
+ while(n-offset>=32){
+  auto x=_mm256_loadu_si256(reinterpret_cast<const __m256i*>(a+offset));
+  auto y=_mm256_loadu_si256(reinterpret_cast<const __m256i*>(b+offset));
+  uint32_t different=~uint32_t(_mm256_movemask_epi8(_mm256_cmpeq_epi8(x,y)));
+  if(different){size_t p=offset+__builtin_ctz(different);return {int(a[p])-int(b[p]),uint32_t(p)};}
+  offset+=32;
+ }
+#endif
+#if defined(__SSE2__)
+ while(n-offset>=16){
+  auto x=_mm_loadu_si128(reinterpret_cast<const __m128i*>(a+offset));
+  auto y=_mm_loadu_si128(reinterpret_cast<const __m128i*>(b+offset));
+  uint32_t different=(~uint32_t(_mm_movemask_epi8(_mm_cmpeq_epi8(x,y))))&0xffff;
+  if(different){size_t p=offset+__builtin_ctz(different);return {int(a[p])-int(b[p]),uint32_t(p)};}
+  offset+=16;
+ }
+#endif
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+ if(n-offset>=8){
+  uint64_t x,y;std::memcpy(&x,a+offset,8);std::memcpy(&y,b+offset,8);
+  uint64_t different=x^y;
+  if(different){size_t p=offset+__builtin_ctzll(different)/8;return {int(a[p])-int(b[p]),uint32_t(p)};}
+  offset+=8;
+ }
+#endif
+ for(;offset<n;++offset)if(a[offset]!=b[offset])return {int(a[offset])-int(b[offset]),uint32_t(offset)};
+ return {0,uint32_t(n)};
+}
+} // namespace block_reader_lcp
diff --git a/fdbserver/resolver/By5Monotonic.h b/fdbserver/resolver/By5Monotonic.h
new file mode 100644
index 0000000000000000000000000000000000000000..54a476d55bdfdff1d22731caf18b8ac323e42243
--- /dev/null
+++ b/fdbserver/resolver/By5Monotonic.h
@@ -0,0 +1,66 @@
+#pragma once
+#include "By5Workload.h"
+#include <unordered_set>
+namespace by5 {
+inline Config monotonicConfig(uint32_t prefixes,uint64_t seconds,uint64_t measure,uint64_t seed){
+ Config c;c.pattern=1;c.prefixes=prefixes;c.longPpm=0;c.conflictPpm=0;c.seed=seed;c.domain=0xFFFFFFF0u;c.span=10;c.prefixBytes=12;
+ require(measure>0 && seconds>measure,"invalid monotonic durations");
+ c.warmupSeconds=seconds-measure;c.measureSeconds=measure;c.validate();return c;
+}
+inline uint32_t prefixOf(const Config& c,uint32_t rank){return uint32_t(uint64_t(rank)/c.prefixCapacity());}
+inline uint64_t prefixLimit(const Config& c,uint32_t p){
+ uint64_t end=std::min<uint64_t>(uint64_t(c.prefixBase(p))+c.prefixCapacity(),c.domain);return end-c.prefixBase(p);
+}
+class MonotonicGenerator {
+ Config cfg;Random rng;History oracle;uint64_t position=0;
+ std::vector<uint64_t> next;std::unordered_set<uint32_t> rejected;
+public:
+ static constexpr unsigned pointTries=64;
+ uint64_t emptyReads=0,clampedReads=0,pointReads=0,rangeReads=0,pointRetries=0,conflicts=0;
+ std::vector<uint64_t> assignedPerPrefix,acceptedPerPrefix,readsPerPrefix;
+ explicit MonotonicGenerator(Config c):cfg(c),rng{c.seed},next(c.prefixes,0),assignedPerPrefix(c.prefixes,0),acceptedPerPrefix(c.prefixes,0),readsPerPrefix(c.prefixes,0){
+  cfg.validate();require(cfg.pattern==1,"monotonic pattern required");
+ }
+ const Config& config()const{return cfg;}
+ size_t historySegments()const{return oracle.size();}
+ const std::vector<uint64_t>& inserted()const{return next;}
+ std::vector<Transaction> batch(uint64_t b){
+  require(position==b*cfg.batchSize,"nonconsecutive generation");
+  const Version now=commitVersion(cfg,b),rv=std::max<Version>(0,now-Version(cfg.shortAgeUs));
+  const std::vector<uint64_t> available=next;
+  std::vector<uint32_t> readable;
+  for(uint32_t p=0;p<cfg.prefixes;++p)if(available[p])readable.push_back(p);
+  std::vector<Transaction> out;out.reserve(cfg.batchSize);
+  for(uint64_t i=0;i<cfg.batchSize;++i){
+   const uint32_t wp=cfg.prefixes==1?0:uint32_t(rng.below(cfg.prefixes));
+   require(next[wp]<prefixLimit(cfg,wp),"prefix counter overflow");
+   const uint32_t wr=cfg.prefixBase(wp)+uint32_t(next[wp]++);++assignedPerPrefix[wp];
+   Range read{0,0};
+   if(!readable.empty()){
+    const uint32_t rp=readable.size()==1?readable[0]:readable[rng.below(readable.size())];
+    const uint64_t n=available[rp];uint64_t w=1+rng.below(cfg.span);
+    if(w>n){w=n;++clampedReads;}
+    const uint32_t base=cfg.prefixBase(rp);
+    if(w==1){
+     bool found=false;
+     for(unsigned tries=0;tries<pointTries;++tries){
+      const uint32_t r=base+uint32_t(rng.below(n));
+      if(!rejected.count(r)){read={r,r+1};found=true;break;}
+      ++pointRetries;
+     }
+     require(found,"no inserted key found for a point read");++pointReads;++readsPerPrefix[rp];
+    }else{
+     const uint32_t start=base+uint32_t(rng.below(n-w+1));
+     read={start,start+uint32_t(w)};++rangeReads;++readsPerPrefix[rp];
+    }
+   }
+   if(!hasRead(read))++emptyReads;
+   const bool conflict=readConflicts(oracle,read,rv);
+   if(conflict){rejected.insert(wr);++conflicts;}else{oracle.write({wr,wr+1},now);++acceptedPerPrefix[wp];}
+   out.push_back({read,{wr,wr+1},rv,0,conflict});
+   ++position;
+  }
+  return out;
+ }
+};
+}
