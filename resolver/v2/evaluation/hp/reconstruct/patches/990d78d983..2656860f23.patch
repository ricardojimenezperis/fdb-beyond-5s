+void theLargestRecordThatFitsIsAccepted() {
+	begin("theLargestRecordThatFitsIsAccepted");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+
+	const size_t largest = MAX_RECORD_BYTES - sizeof(PointConflictHeader);
+	const std::string key(largest, 'k');
+	const HeapRef r = appended(heap.appendPoint(1, asRef(key)),
+							   "a record that exactly fills the payload is accepted");
+
+	check(r.offset == FIRST_RECORD_OFFSET, "it starts at the first offset");
+	check(pointAt(heap, r, "it is readable").key.size() == static_cast<int>(largest),
+		  "and it reads back whole");
+	check(pool.budget().heapPages == 1, "it needed exactly one page");
+	checkBudget(pool, "budget invariant at the size boundary");
+	end();
+}
+
+// Fills the current page with equal records. Returns how many landed on
+// expectedPage, or -1 if the pool ran out before the page did.
+int fillOnePage(TemporalHeap& heap, Version cv, size_t keySize, PageID expectedPage) {
+	const std::string key(keySize, 'f');
+	int count = 0;
+	while (true) {
+		Optional<HeapRef> r = heap.appendPoint(cv, asRef(key));
+		if (!r.present()) {
+			return -1;
+		}
+		if (r.get().pageID != expectedPage) {
+			return count; // this one spilled onto the next page
+		}
+		++count;
+	}
+}
+
+void appendsSpillOntoAFreshPageInOrder() {
+	begin("appendsSpillOntoAFreshPageInOrder");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+
+	check(fillOnePage(heap, 1, 1000, 1) > 1, "many records fit in one page");
+	check(pool.budget().heapPages == 2, "the spilling record took a second page");
+	checkBudget(pool, "budget invariant after a spill");
+
+	const std::string key(1000, 'g');
+	const HeapRef r = appended(heap.appendPoint(2, asRef(key)), "a later record is appended");
+	check(r.pageID == 2, "later records use the new page");
+	end();
+}
