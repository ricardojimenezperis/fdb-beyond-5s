+// Grouped batches under index-only reclamation give exactly the scalar result, with one search per batch
+void stableHintGroupedMatchesScalarUnderIndexReclamation() {
+    if constexpr (!Tree::InlineOnlyKeys || Tree::InlineKeyBytes < 4) return;
+    for (unsigned seed : {5, 29}) {
+        Tree grouped(3, 0, Tree::MemoryConfig{}), scalar(3, 0, Tree::MemoryConfig{});
+        std::mt19937 random(seed), queriesRandom(seed + 1000);
+        std::vector<Interval> model;
+        unsigned batches = 0;
+        for (Version cv = 1; cv <= 300; ++cv) {
+            const unsigned count = 2 + random() % 60;
+            std::vector<std::string> keys; keys.reserve(2 * count);
+            std::vector<Tree::Write> writes;
+            for (unsigned i = 0; i < count; ++i) {
+                const unsigned b = random() % 20000;
+                keys.push_back(key(b, Tree::InlineKeyBytes)); keys.push_back(key(b + 1 + random() % 40, Tree::InlineKeyBytes));
+                writes.push_back({sv(keys[2 * i]), sv(keys[2 * i + 1]), random() % 4 ? ConflictKind::Range : ConflictKind::Point});
+            }
+            grouped.addWrites(cv, writes.data(), writes.size());
+            for (const auto& w : writes) {
+                if (w.kind == ConflictKind::Point) scalar.addPoint(cv, w.begin); else scalar.addRange(cv, w.begin, w.end);
+            }
+            ++batches;
+            for (const auto& w : writes) {
+                const std::string b(reinterpret_cast<const char*>(w.begin.begin()), w.begin.size());
+                model.emplace_back(b, w.kind == ConflictKind::Point ? b + '\0' : std::string(reinterpret_cast<const char*>(w.end.begin()), w.end.size()), cv);
+            }
+            for (unsigned q = 0; q < 20; ++q) {
+                const unsigned a = queriesRandom() % 20000;
+                const std::string qb = key(a, Tree::InlineKeyBytes), qe = key(a + 1 + queriesRandom() % 40, Tree::InlineKeyBytes);
+                for (Tree* tree : {&grouped, &scalar}) {
+                    const Version rv = tree->validationMinRV() + queriesRandom() % 30;
+                    CHECK(tree->hasConflict(rv, sv(qb), sv(qe)) == referenceConflict(model, rv, qb, qe));
+                }
+            }
+            if (cv % 50 == 0) { verify(grouped); verify(scalar); }
+        }
+        CHECK(grouped.stats().reclaimCalls > 0 && grouped.budget().heapPages == 0);
+        if constexpr (Tree::Stats::searchEnabled) CHECK(grouped.stats().writeSearchPasses == batches);
+        verify(grouped);
+    }
+}
