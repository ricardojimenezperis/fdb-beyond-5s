-inline void BNodeStore::insertLast(BNodeHeader* node) {
-	node->agePrevious = newestNode_;
-	node->ageNext = nullptr;
-	if (newestNode_ == nullptr) {
-		oldestNode_ = node;
-	} else {
-		newestNode_->ageNext = node;
-	}
-	newestNode_ = node;
