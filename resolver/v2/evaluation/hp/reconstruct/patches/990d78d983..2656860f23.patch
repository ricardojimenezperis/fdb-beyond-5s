+void redistributionFragments() {
+    constexpr unsigned C = Tree::Capacity;
+    for (unsigned direction = 0; direction < 2; ++direction) {
+        Version cv = 10000000;
+        auto tree = filledTree(600, false, cv);
+        const auto n = neighbourhood(*tree, true, true, shapeable);
+        CHECK(n.source);
+        shape(*tree, n.left, direction ? C : C - 4, 0, cv);
+        shape(*tree, n.right, direction ? C - 4 : C, 0, cv);
+        shape(*tree, n.source, C, 0, cv);
+        checkTree(*tree);
+        const unsigned rank = direction ? C - 1 : C - 2;
+        const Item old{ beginOf(*tree, n.source->at(rank)), endOf(*tree, n.source->at(rank)), n.source->at(rank).cv };
+        const uint64_t b = number(std::get<0>(old));
+        CHECK(number(std::get<1>(old)) == b + 3);
+        auto expected = snapshot(*tree);
+        expected.erase(std::find(expected.begin(), expected.end(), old));
+        const std::string k1 = key(b + 1), k2 = key(b + 2);
+        insertItem(expected, Item{ std::get<0>(old), k1, std::get<2>(old) });
+        insertItem(expected, Item{ k1, k2, cv + 1 });
+        insertItem(expected, Item{ k2, std::get<1>(old), std::get<2>(old) });
+        const auto s = tree->stats();
+        Tree::Write w{ sv(k1), sv(k2), ConflictKind::Range };
+        tree->addWrites(++cv, &w, 1);
+        CHECK(snapshot(*tree) == expected);
+        const auto& t = tree->stats();
+        CHECK(t.splits == s.splits && t.splitFragmentsInserted == s.splitFragmentsInserted + 1);
+        if (direction) CHECK(t.redistRightFree == s.redistRightFree + 1 && t.redistIncomingMoved == s.redistIncomingMoved + 1 && n.right->size() == C - 2);
+        else CHECK(t.redistLeftFree == s.redistLeftFree + 2 && n.left->size() == C - 2);
+        CHECK(tree->hasConflict(cv - 1, sv(k1), sv(k2)) && !tree->hasConflict(cv, sv(k1), sv(k2)));
+        checkTree(*tree);
+    }
+}
