+void inlineOnlyPressureKeepsHints() {
+    if constexpr (!Tree::InlineOnlyKeys || Tree::InlineKeyBytes < 4) return;
+    for (unsigned seed : {17, 81}) {
+        Tree tree(1, 0, Tree::MemoryConfig{});
+        std::mt19937 random(seed);
+        std::vector<Interval> writes;
+        for (Version cv = 1; cv <= 240; ++cv) {
+            std::vector<std::string> keys; keys.reserve(30);
+            std::vector<Tree::Write> batch;
+            for (unsigned i = 0; i < 30; ++i) {
+                keys.push_back(key(random() % 10000, Tree::InlineKeyBytes));
+                batch.push_back({sv(keys.back()), {}, ConflictKind::Point});
+                writes.emplace_back(keys.back(), keys.back() + '\0', cv);
+            }
+            tree.addWrites(cv, batch.data(), batch.size());
+            CHECK(tree.budget().heapPages == 0);
+            const Version floor = tree.validationMinRV();
+            CHECK(floor <= cv);
+            pruneModel(writes, floor);
+            for (unsigned i = 0; i < 12; ++i) {
+                const auto a = key(random() % 10000, Tree::InlineKeyBytes), b = a + '\0';
+                const Version rv = floor + random() % (cv - floor + 1);
+                CHECK(tree.hasConflict(rv, sv(a), sv(b)) == referenceConflict(writes, rv, a, b));
+            }
+            if (cv % 20 == 0) verify(tree);
+        }
+        CHECK(tree.validationMinRV() > 0 && tree.stats().reclaimCalls > 0);
+        // One grouped search per batch of more than one write, whatever the reclamation inside it
+        if constexpr (Tree::Stats::searchEnabled) CHECK(tree.stats().writeSearchPasses == 240);
+        bool refused = false;
+        try { tree.hasConflict(tree.validationMinRV() - 1, sv("a"), sv("b")); }
+        catch (const Error& error) { refused = error.code() == error_code_transaction_too_old; }
+        CHECK(refused);
+        verify(tree);
+    }
+}
