+void bitmapAnchorSweepScenario(bool& fused) {
+    Tree tree(256, 0);
+    tree.configureFictitiousLeaves({ 0, 0 });
+    // Longer than any inline width, so that only the heap record can order two keys
+    const std::string common(996, 'p');
+    auto k = [&](unsigned n) { return common + key(n); };
+    for (unsigned i = 0; i < 200; ++i) tree.addRange(1, sv(k(4 * i)), sv(k(4 * i + 2)));
+    // A live point after every fourth range keeps each leaf in the tree once CV 1 expires
+    for (unsigned i = 3; i < 200; i += 4) tree.addPoint(3, sv(k(4 * i + 3)));
+    CHECK(tree.height() >= 2);
+    tree.validationMinRV_ = 1;
+    CHECK(tree.heap_.oldestPageNewestCV().get() == 1);
+    auto liveAround = [&](Tree::Node* leaf, const std::string& point) {
+        unsigned before = 0, after = 0;
+        bool seen = false;
+        for (unsigned i = 0; i < leaf->size(); ++i) {
+            if (leaf->at(i).cv == 3) {
+                seen = seen || entryBytes(tree, leaf->at(i)) == point;
+                continue;
+            }
+            ++(seen ? after : before);
+        }
+        return seen && before && after;
+    };
+    unsigned chosen = 0;
+    Tree::Node* anchor = nullptr;
+    for (unsigned i = 3; i < 199 && !anchor; i += 4) {
+        Tree::Node* leaf = tree.findLeaf(sv(k(4 * i + 3)));
+        Tree::Node* next = leaf->navigation.leaf.next;
+        if (!next || !liveAround(leaf, k(4 * i + 3)) || entryBytes(tree, leaf->at(leaf->size() - 1)) < k(4 * i + 4)) continue;
+        bool nextExpired = false;
+        for (unsigned j = 0; j < next->size(); ++j) nextExpired |= next->at(j).cv == 1;
+        if (nextExpired) { anchor = leaf; chosen = i; }
+    }
+    CHECK(anchor);
+    const std::string livePoint = k(4 * chosen + 3), writePoint = k(4 * chosen + 5);
+    Tree::Node* emptied = anchor->navigation.leaf.next;
+    CHECK(emptied);
+    while (tree.heap_.oldestPageNewestCV().present() && tree.heap_.oldestPageNewestCV().get() == 1) tree.heap_.reclaimOldest();
+    auto expiredOnReclaimedPage = [&](Tree::Node* leaf, unsigned& before, unsigned& after) {
+        bool live = false;
+        for (unsigned i = 0; i < leaf->size(); ++i) {
+            const auto& entry = leaf->at(i);
+            if (entry.cv == 3) { live = true; continue; }
+            CHECK(entry.cv == 1 && tree.heap_.obsolete(entry.begin));
+            ++(live ? after : before);
+        }
+        return live;
+    };
+    unsigned before = 0, after = 0, emptiedBefore = 0, emptiedAfter = 0;
+    CHECK(expiredOnReclaimedPage(anchor, before, after) && before && after);
+    CHECK(expiredOnReclaimedPage(emptied, emptiedBefore, emptiedAfter) && emptiedBefore + emptiedAfter);
+    std::vector<std::string> emptiedLive;
+    for (unsigned i = 0; i < emptied->size(); ++i)
+        if (emptied->at(i).cv == 3) emptiedLive.push_back(entryBytes(tree, emptied->at(i)));
+
+    // A point write inside an expired range after the live point: no split, since the range is erased first.
+    // A fusion may then join the shrunken anchor to one same-parent neighbour, whose entries keep their order.
+    auto sameParentSize = [](Tree::Node* leaf, Tree::Node* neighbour) {
+        return neighbour && neighbour->parent == leaf->parent ? neighbour->size() : 0u;
+    };
+    const unsigned previousSize = sameParentSize(anchor, anchor->navigation.leaf.previous);
+    const unsigned nextSize = sameParentSize(anchor, emptied);
+    unsigned anchorLive = 0;
+    for (unsigned i = 0; i < anchor->size(); ++i) anchorLive += anchor->at(i).cv == 3;
+    auto expiredLeft = [&]() {
+        unsigned count = 0;
+        for (Tree::Node* leaf = tree.firstLeaf_; leaf; leaf = leaf->navigation.leaf.next) {
+            for (unsigned i = 0; i < leaf->size(); ++i) count += leaf->at(i).cv <= tree.validationMinRV();
+        }
+        return count;
+    };
+    const unsigned expiredAtStart = expiredLeft();
+    const uint64_t expiredCountAtStart = tree.stats().expiredIntervals;
+    auto stats = tree.stats();
+    tree.addPoint(4, sv(writePoint));
+    CHECK(tree.stats().splits == stats.splits);
+    const uint64_t firstWriteExpired = tree.stats().expiredIntervals - stats.expiredIntervals;
+    const unsigned expiredAfterFirst = expiredLeft();
+    CHECK(firstWriteExpired >= before + after);
+    CHECK(firstWriteExpired == expiredAtStart - expiredAfterFirst);
+    Tree::Node* holder = tree.findLeaf(sv(writePoint));
+    const unsigned kept = anchorLive + 1;
+    fused = tree.stats().merges != stats.merges;
+    unsigned at = 0;
+    while (at < holder->size() && !(holder->at(at).cv >= 3 && entryBytes(tree, holder->at(at)) == livePoint)) ++at;
+    CHECK(at + kept <= holder->size());
+    if (!fused) CHECK(holder == anchor && at == 0 && holder->size() == kept);
+    else {
+        CHECK(tree.stats().merges == stats.merges + 1);
+        if (at) CHECK(at <= previousSize && holder->size() == at + kept);
+        else CHECK(nextSize && holder->size() > kept && holder->size() <= kept + nextSize);
+    }
+    CHECK(holder->allocated);
+    for (unsigned i = at; i < at + kept; ++i) CHECK(holder->at(i).cv >= 3);
+    CHECK(entryBytes(tree, holder->at(at)) == livePoint && holder->at(at + 1).cv == 4 && entryBytes(tree, holder->at(at + 1)) == writePoint);
+    verify(tree);
+
+    // A range write from the leaf's first live key past its last one: every entry goes, one interval stays
+    const std::string begin = emptiedLive.front(), end = emptiedLive.back() + '\1';
+    const auto heldBefore = contents(tree);
+    stats = tree.stats();
+    tree.addRange(5, sv(begin), sv(end));
+    CHECK(tree.stats().merges <= stats.merges + 1);
+    std::vector<Interval> expectedAfter;
+    for (const auto& interval : heldBefore)
+        if (!(sv(std::get<0>(interval)) < sv(end) && sv(begin) < sv(std::get<1>(interval)))) expectedAfter.push_back(interval);
+    expectedAfter.emplace_back(begin, end, 5);
+    std::sort(expectedAfter.begin(), expectedAfter.end(), [](const Interval& a, const Interval& b) { return sv(std::get<0>(a)) < sv(std::get<0>(b)); });
+    CHECK(contents(tree) == expectedAfter);
+    const uint64_t secondWriteExpired = tree.stats().expiredIntervals - stats.expiredIntervals;
+    const unsigned expiredAfterSecond = expiredLeft();
+    CHECK(secondWriteExpired == expiredAfterFirst - expiredAfterSecond);
+    CHECK(firstWriteExpired + secondWriteExpired == tree.stats().expiredIntervals - expiredCountAtStart);
+    CHECK(firstWriteExpired + secondWriteExpired >= before + after + emptiedBefore + emptiedAfter);
+    CHECK(tree.stats().expiredIntervals - expiredCountAtStart == expiredAtStart - expiredAfterSecond);
+    CHECK(tree.stats().overwrittenIntervals == stats.overwrittenIntervals + emptiedLive.size());
+    verify(tree);
+
+    // Decisions for points and ranges: the live points, both writes, and expired history
+    auto point = [&](Version rv, const std::string& b) { return tree.hasConflict(rv, sv(b), sv(b + '\0')); };
+    const std::string rangeBegin = k(4 * chosen + 4), rangeEnd = k(4 * chosen + 6), expiredBegin = k(4 * (chosen - 3));
+    CHECK(point(2, livePoint) && !point(3, livePoint));
+    CHECK(point(3, writePoint) && !point(4, writePoint) && !point(3, rangeBegin) && !point(3, writePoint + '\0'));
+    CHECK(tree.hasConflict(3, sv(rangeBegin), sv(rangeEnd)) && !tree.hasConflict(4, sv(rangeBegin), sv(rangeEnd)));
+    for (const auto& live : emptiedLive) CHECK(point(4, live) && !point(5, live));
+    CHECK(tree.hasConflict(4, sv(begin), sv(end)) && !tree.hasConflict(5, sv(begin), sv(end)));
+    CHECK(!tree.hasConflict(1, sv(expiredBegin), sv(livePoint)) && !tree.hasConflict(2, sv(expiredBegin), sv(livePoint)));
+    CHECK(tree.hasConflict(4, sv(k(0)), sv(k(4 * 200))) && !tree.hasConflict(5, sv(k(0)), sv(k(4 * 200))));
+    verify(tree);
+}
