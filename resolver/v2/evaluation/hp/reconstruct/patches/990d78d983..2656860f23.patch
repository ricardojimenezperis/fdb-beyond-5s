+// heapLookupInline: defined here, unchanged, so that TemporalHeap::getKeyInline below can use it in line
+inline HistoryPage* HeapPageTable::find(PageID id) const {
+    if (id < firstID_ || id >= nextID_) {
+        return nullptr;
