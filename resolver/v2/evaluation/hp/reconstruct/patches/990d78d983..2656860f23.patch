+void splitMaxCVInternalHalvesAndRoot() {
+    Tree tree(1024, 0);
+    unsigned i = 0;
+    for (; i < 8*Tree::Capacity*Tree::Capacity; ++i) {
+        tree.addPoint(i+1, sv(key(4*i, 32)));
+        if (!tree.root_->leaf && tree.root_->critical) break;
+    }
+    CHECK(i < 8*Tree::Capacity*Tree::Capacity && !tree.root_->leaf);
