+void pendingHintPageStaysOwnedUntilBatchEnd() {
+    Tree tree(128, 0);
+    for (unsigned i = 0; i < 4000; ++i)
+        tree.addRange(1, sv(key(4 * i)), sv(key(4 * i + 2)));
+    for (unsigned i = 0; i < 1000; ++i)
+        tree.addRange(2, sv(key(20000 + 4 * i)), sv(key(20002 + 4 * i)));
+    Tree::Node* victim = nullptr;
+    for (auto* leaf = tree.firstLeaf_; leaf && !victim; leaf = leaf->navigation.leaf.next) {
+        if (leaf->maxCV != 1) continue;
+        bool entirelyOld = true;
+        auto* nodes = reinterpret_cast<std::byte*>(leaf->owner) + tree.nodeOffset();
+        for (size_t i = 0; i < tree.nodesPerPage(); ++i) {
+            const auto* node = reinterpret_cast<Tree::Node*>(nodes + i * sizeof(Tree::Node));
+            if (node->allocated && node->maxCV > 1) entirelyOld = false;
+        }
+        if (entirelyOld) victim = leaf;
+    }
+    CHECK(victim);
+    PendingRetirement context{&tree, victim->owner, {}, false, {}};
+    const std::string firstBegin = key(100000), firstEnd = key(100002);
+    const std::string secondBegin = entryBytes(tree, victim->at(0)) + std::string(30000, 'x');
+    const std::string secondEnd = entryBytes(tree, victim->at(0), true) + std::string(30000, 'x');
+    const std::string thirdBegin = key(100004), thirdEnd = key(100006);
+    const Tree::Write writes[] = {
+        {sv(firstBegin), sv(firstEnd), ConflictKind::Range},
+        {sv(secondBegin), sv(secondEnd), ConflictKind::Range},
+        {sv(thirdBegin), sv(thirdEnd), ConflictKind::Range}
+    };
+    const auto filler = tree.heap_.appendRange(2, sv(key(200000, 40000)), sv(key(200002)));
+    CHECK(filler.present());
+    Tree::Reservation reserve;
+    tree.reserve(reserve, 3);
+    tree.releaseReservation(reserve);
+    while (PoolPage* page = tree.pool_.tryAcquire(PageUse::Index)) context.held.push_back(page);
+    while (tree.freeNodes_) context.spare.push_back(tree.allocateNode());
+    tree.pool_.setReclaimer(&context, retirePendingHintPage);
+    tree.addWrites(3, writes, std::size(writes));
+    tree.pool_.setReclaimer(&tree, Tree::reclaimThunk);
+    for (auto* node : context.spare) tree.recycleNode(node);
+    CHECK(context.triggered && !tree.retired_ && !tree.writeBatchActive_);
+    CHECK(tree.writeHints_.empty());
+    unsigned victimBlocks = 0;
+    auto* victimNodes = reinterpret_cast<std::byte*>(context.victimPage) + tree.nodeOffset();
+    for (size_t i = 0; i < tree.nodesPerPage(); ++i) {
+        const auto* node = reinterpret_cast<const Tree::Node*>(victimNodes + i * sizeof(Tree::Node));
+        CHECK(!node->allocated);
+        victimBlocks += node->ageLinked && node->ageUse == PageUse::Heap;
+    }
+    CHECK(context.victimPage->live == victimBlocks);
+    if constexpr (Tree::InlineOnlyKeys && Tree::InlineKeyBytes >= 4) CHECK(victimBlocks == 0);
+    CHECK(tree.hasConflict(2, sv(secondBegin), sv(secondEnd)));
+    CHECK(tree.hasConflict(2, sv(firstBegin), sv(firstEnd)));
+    CHECK(tree.hasConflict(2, sv(thirdBegin), sv(thirdEnd)));
+    if constexpr (Tree::Stats::searchEnabled) CHECK(tree.stats().writeSearchPasses == 1);
+    for (PoolPage* page : context.held) tree.pool_.release(page, PageUse::Index);
+    verify(tree);
+}
