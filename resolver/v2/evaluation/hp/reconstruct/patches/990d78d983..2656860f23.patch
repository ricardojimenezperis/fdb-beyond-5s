+// An internal node whose children are built by hand: one leaf per CV, each with one point, the leaves linked in
+// key order. Heap records are appended in CV order, as a batch appends them.
+Tree::Node* bitmapParentOfLeaves(Tree& tree, const std::vector<Version>& cvs) {
+    auto take = [&](bool leaf) { Tree::Reservation r; tree.reserve(r, 1); return tree.take(r, leaf); };
+    std::vector<unsigned> order(cvs.size());
+    for (unsigned i = 0; i < order.size(); ++i) order[i] = i;
+    std::stable_sort(order.begin(), order.end(), [&](unsigned a, unsigned b) { return cvs[a] < cvs[b]; });
+    std::vector<Tree::Entry> entries(cvs.size());
+    for (unsigned i : order) entries[i] = tree.prepareWrite(cvs[i], sv(key(4 * i)), {}, true);
+    std::vector<Tree::Node*> leaves;
+    for (unsigned i = 0; i < cvs.size(); ++i) {
+        auto* leaf = take(true);
+        tree.insertSlot(leaf, 0, entries[i]);
+        tree.refresh(leaf);
+        if (!leaves.empty()) { leaves.back()->navigation.leaf.next = leaf; leaf->navigation.leaf.previous = leaves.back(); }
+        leaves.push_back(leaf);
+    }
+    tree.firstLeaf_ = leaves.front();
+    auto* parent = take(false);
+    for (unsigned i = 0; i < leaves.size(); ++i) {
+        Tree::Entry link; link.payload.link.child = leaves[i];
+        tree.insertSlot(parent, i, link);
+    }
+    tree.root_ = parent;
+    tree.refresh(parent);
+    return parent;
+}
