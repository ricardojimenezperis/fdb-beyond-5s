+// Keys first differ just beyond reference + K bytes, forcing the first heap byte to decide.
+void referencePrefixFirstUncoveredByteDecides() {
+    if constexpr (!Tree::NodePrefixEnabled) return;
+    Tree tree(64, 0);
+    auto k = [](unsigned n) {
+        return std::string(Tree::NodePrefixBytes, 'p') + std::string(Tree::InlineKeyBytes, 'q') + char(n) + "xxxx";
+    };
+    for (unsigned i = 0; i < 80; ++i) tree.addPoint(1, sv(k(2 * i)));
+    CHECK(!tree.root_->leaf && tree.root_->navigation.prefix.length == Tree::NodePrefixBytes);
+    unsigned compressed = 0;
+    auto inspect = [&](auto&& self, Tree::Node* node) -> void {
+        if (node->leaf) return;
+        for (unsigned i = 0; i < node->size(); ++i) {
+            const auto& entry = node->at(i);
+            const std::string full = entryBytes(tree, tree.plainSeparator(node, entry));
+            if (entry.end.length) ++compressed;
+            const size_t at = Tree::NodePrefixBytes + Tree::InlineKeyBytes;
+            for (int delta : {-1, 1}) {
+                std::string probe = full;
+                if (uint8_t(probe[at]) == (delta < 0 ? 0 : 255)) continue;
+                probe[at] = char(uint8_t(probe[at]) + delta);
+                const int result = tree.compareSeparator(node, entry, sv(probe));
+                CHECK((result > 0) == (delta < 0) && (result < 0) == (delta > 0));
+            }
+            self(self, entry.payload.link.child);
+        }
+    };
+    inspect(inspect, tree.root_);
+    CHECK(compressed > 0);
+    std::vector<std::string> storage; storage.reserve(320);
+    std::vector<Tree::Query> queries;
+    for (unsigned i = 1; i < 159; ++i) {
+        storage.push_back(k(i)); storage.push_back(storage.back() + '\0');
+        queries.push_back({0, sv(storage[storage.size() - 2]), sv(storage.back()), false});
+    }
+    for (unsigned q = 0; q < queries.size(); ++q)
+        CHECK(tree.hasConflict(0, queries[q].begin, queries[q].end) == ((q + 1) % 2 == 0));
+    checkSortedQueries(tree, queries);
+    verify(tree);
+}
