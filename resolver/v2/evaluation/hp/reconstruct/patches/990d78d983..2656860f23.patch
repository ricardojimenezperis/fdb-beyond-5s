+// ---- stableHints: write hints survive reclamation; each is validated where it is used ----
+
+// A tree of at least two levels, and the hint the grouped search would give to a leaf in its middle
+static Tree::Node* middleLeaf(Tree& tree) {
+    Tree::Node* leaf = tree.firstLeaf_;
+    for (unsigned i = 0; i < 3 && leaf->navigation.leaf.next; ++i) leaf = leaf->navigation.leaf.next;
+    return leaf;
+}
+static uint64_t staleHints(const Tree& tree) { return tree.stats().writeHintStale; }
+
+// Reusing a hinted leaf must reject its old incarnation before dereferencing its fields.
+// Check the rejection counter because key-range correction can mask a missing identity check.
+void stableHintLeafReusedAsLeaf() {
+    if constexpr (!Tree::InlineOnlyKeys || Tree::InlineKeyBytes < 4) return;
+    Tree tree(64, 0);
+    for (unsigned i = 0; i < 300; ++i) tree.addRange(1, sv(key(4 * i)), sv(key(4 * i + 2)));
+    Tree::Node* victim = middleLeaf(tree);
+    const Tree::LeafHint hint{victim, victim->incarnation};
+    const std::string begin = entryBytes(tree, victim->at(0));
+    while (victim->size()) tree.eraseSlot(victim, 0);
+    tree.removeEmpty(victim);
+    CHECK(!victim->allocated && victim->incarnation == hint.incarnation);
+    for (unsigned i = 0; i < 4000 && !victim->allocated; ++i) tree.addRange(2, sv(key(100000 + 4 * i)), sv(key(100002 + 4 * i)));
+    CHECK(victim->allocated && victim->leaf && victim->incarnation == hint.incarnation + 1);
+    CHECK(tree.findLeaf(sv(begin)) != victim);
+    const auto stale = staleHints(tree);
+    CHECK(tree.resolveWriteHint(sv(begin), hint) == tree.findLeaf(sv(begin)));
+    if constexpr (Tree::Stats::searchEnabled) CHECK(staleHints(tree) == stale + 1);
+    // A matching incarnation still requires a valid leaf range.
+    const std::string reusedBegin = entryBytes(tree, victim->at(0));
+    CHECK(tree.resolveWriteHint(sv(reusedBegin), Tree::LeafHint{victim, victim->incarnation}) == tree.findLeaf(sv(reusedBegin)));
+    tree.addRange(3, sv(begin), sv(key(4 * 300)));
+    CHECK(tree.hasConflict(2, sv(begin), sv(key(4 * 300))));
+    verify(tree);
+}
+
+// Freed, then taken as an internal node: rejected by the incarnation (and, without it, by the leaf flag)
+void stableHintLeafReusedAsInternal() {
+    Tree tree(64, 0);
+    for (unsigned i = 0; i < 300; ++i) tree.addRange(1, sv(key(4 * i)), sv(key(4 * i + 2)));
+    Tree::Node* victim = middleLeaf(tree);
+    const Tree::LeafHint hint{victim, victim->incarnation};
+    const std::string begin = entryBytes(tree, victim->at(0));
+    while (victim->size()) tree.eraseSlot(victim, 0);
+    tree.removeEmpty(victim);
+    Tree::Reservation reservation;
+    tree.reserve(reservation, 1);
+    CHECK(reservation.nodes[0] == victim);
+    Tree::Node* internal = tree.take(reservation, false);
+    CHECK(internal == victim && victim->allocated && !victim->leaf);
+    const auto stale = staleHints(tree);
+    CHECK(tree.resolveWriteHint(sv(begin), hint) == tree.findLeaf(sv(begin)));
+    if constexpr (Tree::Stats::searchEnabled) CHECK(staleHints(tree) == stale + 1);
+    tree.releaseNode(internal);
+    verify(tree);
+}
+
+// A leaf whose entries all expire, never freed: same incarnation, rejected by its maxCV, resolved by descent
+void stableHintExpiredLeafNotReused() {
+    Tree tree(64, 0);
+    for (unsigned i = 0; i < 300; ++i) tree.addRange(1 + (i >= 40), sv(key(4 * i)), sv(key(4 * i + 2)));
+    Tree::Node* victim = tree.firstLeaf_;
+    CHECK(victim->maxCV == 1);
+    const Tree::LeafHint hint{victim, victim->incarnation};
+    const std::string begin = entryBytes(tree, victim->at(0));
+    tree.validationMinRV_ = 1;
+    CHECK(victim->allocated && victim->incarnation == hint.incarnation);
+    const auto stale = staleHints(tree), restarts = tree.stats().writeHintRestarts;
+    CHECK(tree.resolveWriteHint(sv(begin), hint) == tree.findLeaf(sv(begin)));
+    if constexpr (Tree::Stats::searchEnabled) CHECK(staleHints(tree) == stale && tree.stats().writeHintRestarts == restarts + 1);
+    tree.addRange(3, sv(begin), sv(key(2)));
+    CHECK(tree.hasConflict(2, sv(begin), sv(key(2))));
+    verify(tree);
+}
