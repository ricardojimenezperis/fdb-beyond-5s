+void inlineSharedPrefixModel() {
+    const std::string shared(Tree::InlineKeyBytes + 3, '\x81');
+    for (unsigned seed : {11, 29, 71, 505, 2026}) {
+        Tree tree(4, 0);
+        std::vector<Interval> writes;
+        std::mt19937 random(seed);
+        Version cv = 0;
+        uint64_t queries = 0, conflicts = 0, sameVersionBatches = 0;
+        for (unsigned batch = 0; batch < 700; ++batch) {
+            if (random() % 4 || cv == 0) cv += 1 + random() % 3;
+            else ++sameVersionBatches;
+            const unsigned count = random() % 12;
+            std::vector<std::string> storage;
+            storage.reserve(2 * count);
+            std::vector<Tree::Write> batchWrites;
+            for (unsigned i = 0; i < count; ++i) {
+                std::string begin = (shared + randomKey(random)), end;
+                const bool point = random() % 2;
+                if (point) end = begin + '\0';
+                else {
+                    end = (shared + randomKey(random));
+                    if (sv(end) < sv(begin)) std::swap(begin, end);
+                    if (!(sv(begin) < sv(end))) end = begin + '\x01';
+                }
+                storage.push_back(begin);
+                storage.push_back(end);
+                batchWrites.push_back({sv(storage[2 * i]), sv(storage[2 * i + 1]),
+                                       point ? ConflictKind::Point : ConflictKind::Range});
+                writes.emplace_back(begin, end, cv);
+            }
+            const auto before = tree.stats();
+            tree.addWrites(cv, batchWrites.data(), batchWrites.size());
+            // One split at most per interval entered, whatever the overwrites produced
+            CHECK(tree.stats().splits - before.splits <= tree.stats().intervalInsertions - before.intervalInsertions);
+            if (random() % 3 == 0) tree.cleanup(random() % 8, random() % 6, random() % 4 == 0);
+
+            const Version floor = tree.validationMinRV();
+            pruneModel(writes, floor);
+            const unsigned queryCount = random() % 40;
+            std::vector<std::string> keys;
+            keys.reserve(2 * queryCount);
+            std::vector<Tree::Query> batchQueries;
+            for (unsigned i = 0; i < queryCount; ++i) {
+                keys.push_back((shared + randomKey(random)));
+                // Points, ranges, and empty or reversed reads, which conflict with nothing
+                const unsigned shape = random() % 8;
+                keys.push_back(shape < 3 ? keys.back() + '\0' : shape == 7 ? keys.back() : (shared + randomKey(random)));
+                if (shape >= 3 && shape < 6 && sv(keys[2 * i + 1]) < sv(keys[2 * i])) std::swap(keys[2 * i], keys[2 * i + 1]);
+                const Version rv = floor + random() % (cv - floor + 1);
+                batchQueries.push_back({rv, sv(keys[2 * i]), sv(keys[2 * i + 1]), random() % 2 == 0});
+            }
+            tree.hasConflicts(batchQueries.data(), batchQueries.size());
+            for (unsigned i = 0; i < queryCount; ++i) {
+                const bool expected = referenceConflict(writes, batchQueries[i].readVersion, keys[2 * i], keys[2 * i + 1]);
+                if (batchQueries[i].conflict != expected)
+                    throw std::runtime_error("seed " + std::to_string(seed) + " batch " + std::to_string(batch) +
+                                             " query " + std::to_string(i) + " rv " +
+                                             std::to_string(batchQueries[i].readVersion) + " floor " +
+                                             std::to_string(floor) + " [" + hex(keys[2 * i]) + ", " +
+                                             hex(keys[2 * i + 1]) + ") got " +
+                                             std::to_string(batchQueries[i].conflict) + " expected " +
+                                             std::to_string(expected));
+                ++queries;
+                conflicts += expected;
+            }
+            // A read below the boundary is refused before any result changes
+            if (floor > 0 && random() % 10 == 0) {
+                Tree::Query refused[] = {{floor, sv(""), sv("\xff"), true}, {floor - 1, sv(""), sv("\xff"), true}};
+                bool threw = false;
+                try { tree.hasConflicts(refused, 2); } catch (const Error& e) { threw = e.code() == error_code_transaction_too_old; }
+                CHECK(threw && refused[0].conflict && refused[1].conflict);
+            }
+            if (batch % 25 == 0) verify(tree);
+        }
+        verify(tree);
+        // The run must have reached what it is meant to exercise
+        CHECK(tree.heap_.lastReclaimedPageID() > 0 && tree.validationMinRV() > 0);
+        CHECK(sameVersionBatches > 0 && conflicts > 0 && conflicts < queries);
+        CHECK(tree.stats().internalMerges == 0 && tree.stats().splits > 0 && tree.stats().overwrittenIntervals > 0);
+    }
+}
