+void referencePrefixFrozenAcrossSplitsAndExceptions() {
+    if constexpr (!Tree::NodePrefixEnabled) return;
+    Tree tree(1024,0);
+    auto k = [](char group, unsigned n) {
+        return std::string(Tree::NodePrefixBytes,group) + key(n, std::max<size_t>(4,Tree::InlineKeyBytes));
+    };
+    for (unsigned i=0;i<1800;++i) tree.addPoint(1,sv(k('m',4*i)));
+    CHECK(tree.height() >= 3);
+    std::map<Tree::Node*,Tree::Node::ReferencePrefix> frozen;
+    auto collect = [&](auto&& self, Tree::Node* node) -> void {
+        if (node->leaf) return;
+        CHECK(node->navigation.prefix.initialized && node->navigation.prefix.length==Tree::NodePrefixBytes);
+        frozen.emplace(node,node->navigation.prefix);
+        for(unsigned i=0;i<node->size();++i) self(self,node->at(i).payload.link.child);
+    };
+    collect(collect,tree.root_);
+    const auto splits=tree.stats().internalSplits;
+    for(unsigned i=0;i<900;++i) tree.addPoint(2,sv(k('a',4*i)));
+    for(unsigned i=0;i<900;++i) tree.addPoint(3,sv(k('z',4*i)));
+    CHECK(tree.stats().internalSplits>splits);
+    for(const auto& [node,reference]:frozen) {
+        CHECK(node->allocated && !node->leaf);
+        CHECK(node->navigation.prefix.length==reference.length);
+        CHECK(node->navigation.prefix.bytes==reference.bytes);
+    }
+    unsigned compressed=0,plain=0;
+    auto inspect = [&](auto&& self, Tree::Node* node) -> void {
+        if(node->leaf) return;
+        for(unsigned i=0;i<node->size();++i) {
+            const auto& entry=node->at(i);
+            const auto decoded=tree.plainSeparator(node,entry);
+            const std::string full=entryBytes(tree,decoded);
+            if(entry.end.length) ++compressed; else ++plain;
+            const std::array<std::string,4> probes{full,full+'\0',full.substr(0,3),std::string(12,'b')};
+            for(const auto& probe:probes) {
+                const int expected=(sv(full)>sv(probe))-(sv(full)<sv(probe));
+                const auto loads=tree.stats().heapKeyLoads;
+                const int result=tree.compareSeparator(node,entry,sv(probe));
+                CHECK(((result>0)-(result<0))==expected);
+                if(entry.end.length && entry.begin.length<=tree.separatorInlineBytes(entry))
+                    CHECK(tree.stats().heapKeyLoads==loads);
+            }
+            self(self,entry.payload.link.child);
+        }
+    };
+    inspect(inspect,tree.root_);
+    CHECK(compressed>0 && plain>0);
+    std::vector<std::string> storage; storage.reserve(2400);
+    std::vector<Tree::Query> queries;
+    for(unsigned i=0;i<1200;++i) {
+        const char group="amz"[i%3];
+        storage.push_back(k(group,2*i)); storage.push_back(storage.back()+'\0');
+        queries.push_back({Version(i%4),sv(storage[2*i]),sv(storage[2*i+1]),false});
+    }
+    checkSortedQueries(tree,queries);
+    Tree::ReadPipelineConfig cfg;
+    tree.hasConflicts(queries.data(),queries.size(),cfg);
+    for(unsigned i=0;i<queries.size();++i) {
+        const Version written = "amz"[i%3]=='a' ? 2 : ("amz"[i%3]=='m' ? 1 : 3);
+        CHECK(queries[i].conflict == (!(i&1) && queries[i].readVersion < written));
+    }
+    verify(tree);
+    // Remove the initially matching region, then merge and reintroduce it. Old
+    // reference bytes need not match any current child, but must remain valid.
+    tree.validationMinRV_=1;
+    for(unsigned i=0;i<50;++i) tree.cleanup(100,100,true);
+    for(unsigned i=0;i<120;++i) tree.addPoint(4,sv(k('m',4*i)));
+    for(auto& q:queries) q.readVersion=std::max<Version>(1,q.readVersion);
+    checkSortedQueries(tree,queries);
+    tree.hasConflicts(queries.data(),queries.size(),cfg);
+    for(unsigned i=0;i<queries.size();++i) {
+        const char group="amz"[i%3];
+        const Version written = group=='a' ? 2 : (group=='m' ? (2*i<480 ? 4 : 1) : 3);
+        CHECK(queries[i].conflict == (!(i&1) && queries[i].readVersion < written));
+    }
+    verify(tree);
+}
