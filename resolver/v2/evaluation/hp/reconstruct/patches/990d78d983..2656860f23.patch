+				specialCounter(cc, "PagedBTreeCleanedIntervals", paged(&ConflictSetStats::cleanedIntervals));
+				specialCounter(cc, "PagedBTreeHeight", paged(&ConflictSetStats::btreeHeight));
+				specialCounter(cc, "PagedBTreeNodes", paged(&ConflictSetStats::btreeNodes));
+				specialCounter(cc, "PagedBTreeLeaves", paged(&ConflictSetStats::btreeLeaves));
+				specialCounter(cc, "PagedBTreeSplits", paged(&ConflictSetStats::btreeSplits));
+				specialCounter(cc, "PagedBTreeInternalSplits", paged(&ConflictSetStats::btreeInternalSplits));
+				specialCounter(cc, "PagedBTreeMerges", paged(&ConflictSetStats::btreeMerges));
+				specialCounter(cc, "PagedBTreeInternalMerges", paged(&ConflictSetStats::btreeInternalMerges));
+				specialCounter(cc, "PagedBTreeDiscardedWrites", paged(&ConflictSetStats::btreeDiscardedWrites));
+			} else {
+				specialCounter(cc, "PagedCleanedCells", paged(&ConflictSetStats::cleanedCells));
+			}
+			specialCounter(cc, "PagedTooOldWithinWindow", paged(&ConflictSetStats::tooOldWithinWindow));
+			specialCounter(cc, "PagedBoundaryPastWindow", paged(&ConflictSetStats::boundaryPastWindow));
+		}
+
 		logger = cc.traceCounters("ResolverMetrics", dbgid, SERVER_KNOBS->WORKER_LOGGING_INTERVAL, "ResolverMetrics");
 	}
 	~Resolver() { destroyConflictSet(conflictSet); }
