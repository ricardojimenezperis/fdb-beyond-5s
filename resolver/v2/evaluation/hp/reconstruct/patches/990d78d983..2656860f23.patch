+void checkPairs(Tree& tree) {
+    constexpr unsigned C = Tree::Capacity;
+    tree.flushPairs();
+    const unsigned merged = tree.fictitious_.pressureMergedLimit;
+    const unsigned source = C;
+    uint64_t positive = 0;
+    unsigned highest = 0;
+    for (const Tree::Node* x = tree.firstLeaf_; x; x = x->navigation.leaf.next) {
+        const Tree::Node* y = x->navigation.leaf.next;
+        bool fusible = false;
+        if (y && x->parent && y->parent == x->parent && x->size() && y->size())
+            for (unsigned a = 0; a <= x->fict.fictitious && !fusible; ++a)
+                for (unsigned b = 0; b <= y->fict.fictitious && !fusible; ++b) {
+                    const unsigned l = x->size() + x->fict.fictitious - a, r = y->size() + y->fict.fictitious - b;
+                    fusible = l + r <= merged && ((x->size() <= source && l <= source) || (y->size() <= source && r <= source));
+                }
+        const unsigned available = y ? (C - x->size() - x->fict.fictitious) + x->fict.fictitious
+                                      + (C - y->size() - y->fict.fictitious) + y->fict.fictitious : 0;
+        const unsigned priority = fusible ? 1 + available : 0;
+        CHECK(x->fict.pair.priority == priority && !x->fict.pairDirty);
+        positive += fusible;
+        highest = std::max(highest, priority);
+    }
+    uint64_t listed = 0;
+    for (unsigned n = 1; n <= 2 * C + 1; ++n) {
+        uint32_t previous = by5v5::absent;
+        for (uint32_t id = tree.pairIndex_.head(n); id != by5v5::absent; ++listed) {
+            const Tree::Node* x = static_cast<const Tree::Node*>(tree.pool_.nodeForAgeIndex(id));
+            CHECK(listed < positive && x->allocated && x->leaf && x->fict.pair.priority == n && x->fict.pair.previous == previous);
+            previous = id;
+            id = x->fict.pair.next;
+        }
+    }
+    CHECK(listed == positive && tree.pairIndexSize() == positive);
+    const uint32_t candidate = tree.pairIndex_.candidate();
+    CHECK(candidate == by5v5::absent ? !positive
+                                     : static_cast<const Tree::Node*>(tree.pool_.nodeForAgeIndex(candidate))->fict.pair.priority == highest);
+    for (const Tree::Node* x = tree.free_; x; x = static_cast<const Tree::Node*>(tree.pool_.detachedNext(x))) CHECK(!x->fict.pair.priority);
+    CHECK(tree.checkPairIndex());
+}
+
+uint64_t checkTree(Tree& tree) {
+    uint64_t fictitious = 0;
+    if (tree.root_) CHECK(checkNode(tree, tree.root_, fictitious) == tree.leafCount());
+    const auto& s = tree.stats();
+    CHECK(s.fictitiousCreated == fictitious + s.fictitiousReleased + s.fictitiousFusionConsumed + s.fictitiousRetired);
+    checkPairs(tree);
+    std::array<uint64_t, Tree::Capacity + 1> real, effective;
+    uint64_t present = 0;
+    tree.leafOccupancy(real, effective, present);
+    CHECK(present == fictitious);
+    checkRouting(tree);
+    return fictitious;
+}
