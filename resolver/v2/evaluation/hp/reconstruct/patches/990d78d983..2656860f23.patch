+void pointStoresOneKey() {
+    for (size_t length : {size_t{0}, size_t{1}, Tree::InlineKeyBytes ? Tree::InlineKeyBytes - 1 : 0,
+                          Tree::InlineKeyBytes, Tree::InlineKeyBytes + 1, size_t{128}}) {
+        for (bool explicitPoint : {false, true}) {
+            Tree tree(64, 0);
+            std::string k(length, '\x81');
+            if (length > 1) k[1] = '\0';
+            if (length > 2) k.back() = '\xff';
+            const std::string end = k + '\0';
+            if (explicitPoint) tree.addPoint(2, sv(k));
+            else tree.addRange(2, sv(k), sv(end));
+            CHECK(tree.root_ && tree.root_->leaf && tree.root_->size() == 1);
+            const auto& entry = tree.root_->at(0);
+            CHECK(Tree::endSharesStorage(entry));
+            CHECK(entry.begin.length == k.size() && entry.end.length == k.size() + 1);
+            CHECK(&Tree::endPrefix(entry) == &entry.beginInline);
+            CHECK(entryBytes(tree, entry) == k && entryBytes(tree, entry, true) == end);
+            if (Tree::InlineOnlyKeys && length <= Tree::InlineKeyBytes) {
+                CHECK(Tree::isInlineOnly(entry.begin) && Tree::isInlineOnly(entry.end));
+                CHECK(tree.budget().heapPages == 0);
+            } else {
+                const HeapRef record{entry.begin.pageID,
+                                     entry.begin.offset - static_cast<uint32_t>(sizeof(PointConflictHeader)),
+                                     static_cast<uint32_t>(sizeof(PointConflictHeader) + k.size())};
+                const auto point = tree.heap_.getPoint(record);
+                CHECK(point.present() && point.get().cv == 2 && bytes(point.get().key) == k);
+            }
+            verify(tree);
+            CHECK(tree.hasConflict(1, sv(k), sv(end)));
+            CHECK(!tree.hasConflict(2, sv(k), sv(end)));
+            CHECK(!tree.hasConflict(1, sv(end), sv(end + '\0')));
+            CHECK(!tree.hasConflict(1, sv(k), sv(k)));
+            // Adjacent points k and k+zero must remain distinct.
+            tree.addPoint(3, sv(end));
+            CHECK(contents(tree) == (std::vector<Interval>{{k, end, 2}, {end, end + '\0', 3}}));
+            CHECK(!tree.hasConflict(2, sv(k), sv(end)));
+            CHECK(tree.hasConflict(2, sv(end), sv(end + '\0')));
+            verify(tree);
+        }
+    }
+}
