+struct NodePage {
+    PagePool pool;
+    PoolPage* page = nullptr;
+    std::vector<ReclaimLink*> links;
+    explicit NodePage(unsigned count) : pool(4) {
+        pool.configureNodeAges(0, sizeof(ReclaimLink), count);
+        page = pool.acquire(PageUse::Index);
+        pool.registerNodePage(page);
+        for (unsigned i = 0; i < count; ++i) {
+            auto* link = new (reinterpret_cast<std::byte*>(page) + i * sizeof(ReclaimLink)) ReclaimLink;
+            link->ageIndex = pool.nodeAgeIndex(link);
+            links.push_back(link);
+        }
+    }
+    void unlinkAll() {
+        for (auto* link : links) pool.unlinkAge(link);
+    }
+};
