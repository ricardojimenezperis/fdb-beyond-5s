+void blockReaderHeapCandidates() {
+    Tree tree(64, 0);
+    const std::string prefix(Tree::InlineKeyBytes + 32, 'g');
+    const std::string begin = prefix + "m", end = prefix + "z";
+    const std::string queryBegin = prefix + "a", queryEnd = prefix + "b";
+    tree.addRange(7, sv(begin), sv(end));
+    for (unsigned group : {2u, 3u}) {
+        std::vector<Tree::Query> queries(64, {0, sv(queryBegin), sv(queryEnd), false});
+        Tree::ReadPipelineConfig cfg; cfg.sweepGroupSize = group;
+        tree.hasConflicts(queries.data(), queries.size(), cfg);
+        for (const auto& query : queries) CHECK(!query.conflict);
+        CHECK(tree.openQueries_.empty());
+        if constexpr (Tree::Stats::searchEnabled) {
+            const auto& st = tree.readPipelineStats();
+            CHECK(st.breadthHeapResolutions == 2);
+            CHECK(st.breadthHeapLines > 0);
+        }
+    }
+    verify(tree);
+}
