+    setvbuf(stdout, nullptr, _IONBF, 0);
+    std::printf("exception age order: C=%u K=%zu inlineOnly=%d\n", Tree::Capacity, Tree::InlineKeyBytes, int(Tree::InlineOnlyKeys));
+    const std::vector<std::pair<const char*, std::function<void()>>> cases = {
+        { "splitLowersBelowPredecessorBecomeExceptions", splitLowersBelowPredecessorBecomeExceptions },
+        { "raisesStayExceptionalOrReturnToTail", raisesStayExceptionalOrReturnToTail },
+        { "inheritanceAcrossCollections", inheritanceAcrossCollections },
+        { "equalAgesPreferMainThenIdentifier", equalAgesPreferMainThenIdentifier },
+        { "repeatedExceptionSplits", repeatedExceptionSplits },
+        { "detachedLinksAndBlockReuse", detachedLinksAndBlockReuse },
+        { "randomAgeOperationsA", randomAgeOperationsA },
+        { "randomAgeOperationsB", randomAgeOperationsB },
+        { "treeModelInlineSmall", treeModelInlineSmall },
+        { "treeModelInlineMedium", treeModelInlineMedium },
+        { "treeModelInlineLarge", treeModelInlineLarge },
+        { "treeModelHeapKeysSmall", treeModelHeapKeysSmall },
+        { "treeModelHeapKeysMedium", treeModelHeapKeysMedium },
+    };
+    unsigned passed = 0;
+    for (const auto& [name, run] : cases) {
+        std::printf("%s: ", name);
+        try {
+            run();
+            std::printf("OK\n");
+            ++passed;
+        } catch (const std::exception& e) {
+            std::printf("FAIL %s\n", e.what());
+        }
+    }
+    std::printf("%u/%zu OK\n", passed, cases.size());
+    return passed == cases.size() ? 0 : 1;
+}
