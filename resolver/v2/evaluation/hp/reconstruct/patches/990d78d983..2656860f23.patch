+    b->incarnation = 71;
+    p.lowerNodeAgeAfterSplit(b, 25);
+    CHECK(!inException(p, b) && b->maxCV == 25 && p.nextAge(a) == b && p.nextAge(b) == c);
+    p.lowerNodeAgeAfterSplit(b, 20);
+    CHECK(!inException(p, b) && p.nextAge(a) == b);
+    p.lowerNodeAgeAfterSplit(b, 5);
+    CHECK(inException(p, b) && b->maxCV == 5 && p.ageCV(b) == 5 && b->incarnation == 71);
+    CHECK(p.oldestAge() == b && p.nextAge(b) == a && p.nextAge(a) == c && !p.nextAge(c));
+    CHECK(p.previousAge(a) == b && !p.previousAge(b));
+    checkAges(p);
+    p.lowerNodeAgeAfterSplit(a, 15);
+    CHECK(!inException(p, a) && p.oldestAge() == b);
+    p.lowerNodeAgeAfterSplit(c, 10);
+    CHECK(inException(p, c) && p.oldestAge() == b && p.nextAge(b) == c && p.nextAge(c) == a);
+    checkAges(p);
+    n.unlinkAll();
+    CHECK(p.exceptionAgeCount() == 0 && !p.oldestAge());
+    checkAges(p);
