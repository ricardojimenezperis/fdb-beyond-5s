+void referencePrefixComparedOnce() {
+    if constexpr (!Tree::NodePrefixEnabled) return;
+    Tree tree(1024, 0);
+    auto k = [](char group, unsigned n) { return std::string(12, group) + key(n, 32); };
+    for (unsigned i=0; i<900; ++i) tree.addPoint(1, sv(k('m', 4*i)));
+    for (unsigned i=0; i<300; ++i) tree.addPoint(2, sv(k('a', 4*i)));
+    const std::array<std::string,5> probes{"", "mmm", k('a', 501), k('m', 501), k('z', 501)};
+    auto visit = [&](auto&& self, Tree::Node* node) -> void {
+        if (node->leaf) return;
+        for (const auto& probe : probes) {
+            Tree::PrefixMatch saved;
+            unsigned compressed = 0;
+            const auto before = tree.stats().nodePrefixChecks;
+            for (unsigned repeat=0; repeat<2; ++repeat) {
+                for (unsigned i=0; i<node->size(); ++i) {
+                    const auto& entry = node->at(i);
+                    if (entry.end.length) ++compressed;
+                    const auto plain = tree.plainSeparator(node, entry);
+                    const auto full = entryBytes(tree, plain);
+                    const int expected = (sv(full)>sv(probe))-(sv(full)<sv(probe));
+                    const int actual = tree.compareSeparator(node, entry, sv(probe), nullptr, &saved);
+                    CHECK((actual>0)-(actual<0) == expected);
+                }
+            }
+            if constexpr (Tree::Stats::searchEnabled)
+                CHECK(tree.stats().nodePrefixChecks - before == unsigned(compressed != 0));
+        }
+        for (unsigned i=0; i<node->size(); ++i) self(self, node->at(i).payload.link.child);
+    };
+    visit(visit, tree.root_);
+    const auto begin = k('m', 100000), end = k('m', 100001);
+    Tree::Query query{0, sv(begin), sv(end), false};
+    Tree::ReadPipelineConfig config;
+    const auto checks = tree.stats().nodePrefixChecks;
+    const auto reuses = tree.stats().nodePrefixReuses;
+    tree.hasConflicts(&query, 1, config);
+    CHECK(!query.conflict);
+    if constexpr (Tree::Stats::searchEnabled) {
+        CHECK(tree.stats().nodePrefixChecks - checks <= 2 * tree.height());
+        CHECK(tree.stats().nodePrefixReuses > reuses);
+    }
+    verify(tree);
+}
