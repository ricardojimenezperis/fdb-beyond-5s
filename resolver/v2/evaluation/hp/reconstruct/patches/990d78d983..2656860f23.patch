+void randomModel(uint64_t pages, unsigned seed, bool heapKeys, bool points = false, unsigned batchWrites = 48, Version batches = 1600, unsigned pressureLimit = Tree::Capacity, int reserve = -1, bool requireFusion = true) {
+    setThreadLocalDeterministicRandomSeed(seed);
+    Tree tree(pages, 0, memoryFor(pages, heapKeys));
+    const unsigned units = reserve < 0 ? Tree::FictitiousLeafConfig{}.splitReserve : unsigned(reserve);
+    tree.configureFictitiousLeaves(reserveConfig(units, pressureLimit, seed));
+    constexpr unsigned domain = 16384;
+    std::vector<std::string> keys(domain + 1);
+    const unsigned extra = heapKeys ? Tree::InlineKeyBytes + 8 : points && Tree::InlineKeyBytes >= 8 ? Tree::InlineKeyBytes - 8 : 0;
+    for (unsigned i = 0; i <= domain; ++i) keys[i] = key(i, extra);
+    std::vector<Version> oracle(domain, 0);
+    std::mt19937 random(seed);
+    uint64_t checks = 0;
+    for (Version batch = 1; batch <= batches; ++batch) {
+        std::vector<Tree::Write> writes(batchWrites);
+        std::vector<std::pair<unsigned, unsigned>> ranges(batchWrites);
+        for (unsigned w = 0; w < writes.size(); ++w) {
+            const unsigned a = random() % (domain - 32), b = a + 1 + random() % 8;
+            const bool point = points && random() % 2;
+            ranges[w] = { a, point ? a + 1 : b };
+            writes[w] = point ? Tree::Write{ sv(keys[a]), {}, ConflictKind::Point } : Tree::Write{ sv(keys[a]), sv(keys[b]), ConflictKind::Range };
+        }
+        tree.addWrites(batch, writes.data(), writes.size());
+        CHECK(tree.validationMinRV() < batch);
+        checkTree(tree);
+        for (auto [a, b] : ranges)
+            for (unsigned p = a; p < b; ++p) oracle[p] = batch;
+        for (unsigned q = 0; q < 32; ++q) {
+            const unsigned a = random() % (domain - 64), b = a + 1 + random() % 64;
+            const Version floor = tree.validationMinRV();
+            const Version readVersion = floor + Version(random() % uint64_t(batch - floor + 1));
+            bool expected = false;
+            for (unsigned p = a; p < b; ++p) expected |= oracle[p] > readVersion;
+            CHECK(tree.hasConflict(readVersion, sv(keys[a]), sv(keys[b])) == expected);
+            ++checks;
+        }
+    }
+    const auto& s = tree.stats();
+    std::printf("[pages=%llu heapKeys=%d points=%d floor=%lld created=%llu released=%llu redistributed=%llu/%llu/%llu/%llu cross=%llu slack=%llu fusionConsumed=%llu retired=%llu present=%llu splits=%llu pressure=%llu local=%llu global=%llu available=%llu fallbacks=%llu inspectedMax=%llu ages=%llu checks=%llu] ",
+                (unsigned long long)pages, int(heapKeys), int(points), (long long)tree.validationMinRV(), (unsigned long long)s.fictitiousCreated,
+                (unsigned long long)s.fictitiousReleased, (unsigned long long)s.redistLeftFree, (unsigned long long)s.redistLeftFictitious,
+                (unsigned long long)s.redistRightFree, (unsigned long long)s.redistRightFictitious, (unsigned long long)s.redistCrossParent,
+                (unsigned long long)s.redistRejectedSlack, (unsigned long long)s.fictitiousFusionConsumed, (unsigned long long)s.fictitiousRetired,
+                (unsigned long long)checkTree(tree), (unsigned long long)s.fictitiousSplits, (unsigned long long)s.pressureEvents,
+                (unsigned long long)s.pressureLocalFusions, (unsigned long long)s.pressureGlobalFusions, (unsigned long long)s.pressureNodesMadeAvailable,
+                (unsigned long long)s.pressureFallbacks, (unsigned long long)s.pressureCandidatesMax, (unsigned long long)s.reclaimAgeCandidates,
+                (unsigned long long)checks);
+    if (pages <= 8 && batchWrites > 1) {
+        CHECK(s.pressureEvents > 0);
+        if (units && requireFusion) CHECK(s.pressureLocalFusions + s.pressureGlobalFusions > 0);
+    }
+    if (pages <= 4) CHECK(tree.validationMinRV() > 0);
+    CHECK(s.redistLeftFree + s.redistLeftFictitious > 0 && s.redistRightFree + s.redistRightFictitious > 0);
+    CHECK(!s.pairIndexStale && !s.pairIndexBlocked);
+    std::printf("[index=%llu updates=%llu flushes=%llu dirtyMax=%llu empty=%llu inspected=%llu] ", (unsigned long long)tree.pairIndexSize(),
+                (unsigned long long)s.pairIndexUpdates, (unsigned long long)s.pairIndexFlushes, (unsigned long long)s.pairIndexDirtyMax,
+                (unsigned long long)s.pairIndexEmpty, (unsigned long long)s.pressureCandidatesInspected);
+}
