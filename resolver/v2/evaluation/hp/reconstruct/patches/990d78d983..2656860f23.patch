+// Check layout, occupancy, per-level summaries and reclaimed-history counters.
+void reportAccessors() {
+    const Tree::Layout layout = Tree::layout();
+    CHECK(layout.permutationBytes == sizeof(paged_btree::KeyPermutation) && layout.entryBytes == sizeof(Tree::Entry));
+    CHECK(layout.nodeBytes == sizeof(Tree::Node) && layout.nodeAlignment == alignof(Tree::Node));
+    CHECK(layout.nodesPerPage == Tree::nodesPerPage() && layout.nodesPerPage * layout.nodeBytes <= 65536);
+    {
+        Tree tree(64, 0);
+        CHECK(tree.levels().empty() && tree.reclaimedHistoryPages() == 0);
+        for (bool leaves : {false, true})
+            for (unsigned count = 0; count <= Tree::Capacity; ++count) CHECK(tree.occupancy(leaves, count) == 0);
+        std::vector<std::string> keys;
+        for (unsigned i = 0; i < 2000; ++i) keys.push_back(key(i * 3));
+        for (unsigned i = 0; i < keys.size(); ++i) tree.addPoint(2 + i / 100, sv(keys[i]));
+        const auto levels = tree.levels();
+        CHECK(levels.size() == tree.height());
+        uint64_t nodes = 0;
+        for (const auto& level : levels) { nodes += level.nodes; CHECK(level.liveEntries == level.entries); }
+        CHECK(nodes == tree.nodeCount() && levels.back().nodes == tree.leafCount());
+        uint64_t leaves = 0, internal = 0;
+        for (unsigned count = 0; count <= Tree::Capacity; ++count) {
+            leaves += tree.occupancy(true, count);
+            internal += tree.occupancy(false, count);
+        }
+        CHECK(leaves == tree.leafCount() && internal == tree.nodeCount() - tree.leafCount());
+        // Entries at or below the boundary are counted but not live: versions 2 to 21 hold 100 points
+        // each, so a boundary at 11 leaves the 1,000 of versions 12 to 21
+        CHECK(levels.back().entries == keys.size());
+        tree.validationMinRV_ = 11;
+        const auto expired = tree.levels();
+        CHECK(expired.back().entries == keys.size() && expired.back().liveEntries == 1000);
+        verify(tree);
+    }
+    {
+        // Long keys in a small pool: history pages are reclaimed, oldest first
+        Tree tree(6, 0);
+        for (unsigned i = 0; i < 4000 && !tree.stats().heapPagesReclaimed; ++i) {
+            const std::string begin = key(i, 600), end = key(i + 1, 4);
+            tree.addRange(2 + i, sv(begin), sv(end));
+        }
+        CHECK(tree.stats().heapPagesReclaimed > 0);
+        CHECK(tree.reclaimedHistoryPages() == tree.stats().heapPagesReclaimed);
+        verify(tree);
+    }
+}
