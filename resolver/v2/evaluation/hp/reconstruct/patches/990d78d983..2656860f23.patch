+    try { tree.hasConflict(4, sv(""), sv("")); } catch (...) { threw = true; }
+    CHECK(threw);
+    Tree::Query queries[] = {{5, sv(keys[0]), sv(keys[1]), false}, {4, sv(keys[0]), sv(keys[1]), true}};
