+void sortedEndpointBoundariesAndCrossings() {
+    Tree tree(512, 0);
+    // Force at least three levels, holes, long shared prefixes and virtual point ends.
+    const std::string prefix(12, '\x81');
+    auto k = [&](unsigned n) { return prefix + key(n); };
+
+    for (unsigned i = 0; i < 1800; ++i) tree.addPoint(1, sv(k(4*i)));
+    tree.addRange(9, sv(k(7100)), sv(k(7110)));
+    CHECK(tree.height() >= 3);
+    std::vector<std::string> storage; storage.reserve(20000);
+    std::vector<Tree::Query> queries;
+    auto add = [&](Version rv, std::string begin, std::string end) {
+        storage.push_back(std::move(begin)); storage.push_back(std::move(end));
+        queries.push_back({rv, sv(storage[storage.size()-2]), sv(storage.back()), true});
+    };
+    add(5, k(0), k(7199)); // both endpoints outside many visited children
+    add(5, k(0), k(7000)); // same crossing, but no newer record
+    add(9, k(0), k(7199));
+    add(0, "", k(0)); // end exactly at the first stored key: no conflict
+    add(0, k(7200), k(9000));
+    add(0, k(2), k(2)); add(0, k(3), k(2)); // empty/reversed
+    for (auto* leaf = tree.firstLeaf_; leaf; leaf = leaf->navigation.leaf.next) {
+        const auto begin = entryBytes(tree, leaf->at(0));
+        add(0, begin, begin + '\0');
+        add(0, begin + '\0', begin + '\0' + '\0'); // excludes point's virtual end
+        add(1, k(0), begin); // equality at a separator belongs only to the left
+        add(0, begin, k(7199));
+    }
+    std::reverse(queries.begin(), queries.end());
+    checkSortedQueries(tree, queries);
+    // At each skipped old subtree, carry the open interval toward the hot tail.
+    checkSortedQueries(tree, {{5, sv(k(0)), sv(k(7199)), false}});
+    if constexpr (Tree::Stats::searchEnabled) {
+        CHECK(tree.readPipelineStats().sortedNodesSkipped + tree.readPipelineStats().sortedOldChildrenSkipped > 0);
+        CHECK(tree.readPipelineStats().maxOpenQueries > 0);
+    }
+    verify(tree);
+}
