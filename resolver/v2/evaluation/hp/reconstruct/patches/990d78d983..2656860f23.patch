+
+class TemporalHeap {
+public:
+    // The pool must outlive the heap.
+    // Independent heaps retain their own allocation order.
+    explicit TemporalHeap(PagePool& pool, bool blockStorage = false);
+    struct BlockStorage {
+        void* context = nullptr;
+        size_t bytes = 0;
+        HistoryPage* (*acquire)(void*) = nullptr;
+        void (*release)(void*, HistoryPage*) = nullptr;
+        void (*raise)(void*, HistoryPage*, Version) = nullptr;
+        HistoryPage* (*find)(void*, PageID) = nullptr;
+    };
+    void configureBlocks(BlockStorage storage);
+    void clear();
+    size_t maximumRecordBytes() const;
+    size_t contiguousRecordBytes() const;
+    static bool fragmented(const HeapRef& ref) { return (ref.offset & FragmentOffset) != 0; }
+    Optional<StringRef> getKey(const HeapRef& ref, std::vector<uint8_t>& scratch) const;
+    Optional<PointConflictView> getPoint(const HeapRef& ref, std::vector<uint8_t>& scratch) const;
+    Optional<RangeConflictView> getRange(const HeapRef& ref, std::vector<uint8_t>& scratch) const;
+    struct FragmentCursor {
+        PageID head = 0, next = 0;
+        const uint8_t* data = nullptr;
+        size_t start = 0;
+    };
+    StringRef fragment(const HeapRef& ref, size_t offset, FragmentCursor& cursor) const;
+    int compareKey(const HeapRef& ref, StringRef rhs, size_t skip = 0) const;
+    size_t storageBytes() const { return blocks_.context ? blocks_.bytes : HISTORY_PAGE_BYTES; }
+
+    // Returns all owned pages to the pool.
+    // Invalidates every reference and view into this heap.
+    ~TemporalHeap();
+
+    TemporalHeap(const TemporalHeap&) = delete;
+    TemporalHeap& operator=(const TemporalHeap&) = delete;
+    TemporalHeap(TemporalHeap&&) = delete;
+    TemporalHeap& operator=(TemporalHeap&&) = delete;
+
+    // Appends a complete record. Returns absent if the pool is exhausted.
+    // Records must fit in one page; commit versions must not decrease.
+    Optional<HeapRef> appendPoint(Version cv, StringRef key);
+    // Store key once, followed by one reserved zero byte. The returned reference
+    // still describes the ordinary point record (getPoint remains compatible).
+    // Key views may also include that byte to represent [key, key + zero).
+    Optional<HeapRef> appendPointWithSuccessor(Version cv, StringRef key);
+    Optional<HeapRef> appendRange(Version cv, StringRef begin, StringRef end);
+
+    // Returns absent if the referenced page has been reclaimed.
+    // The reference must identify a record of the corresponding kind.
+    // Views remain valid until their page is reclaimed or the heap is destroyed.
+    Optional<PointConflictView> getPoint(const HeapRef& ref) const;
+    Optional<RangeConflictView> getRange(const HeapRef& ref) const;
+    // Returns the referenced key bytes, or absent if its page was reclaimed.
+    // The reference identifies key bytes, not a complete record.
+    Optional<StringRef> getKey(const HeapRef& key) const;
+    // getKey's body, forced in line where a caller asks for it (the B+'s key resolution); getKey itself
+    // stays out of line, so the skip list's call sites are unchanged
+    Optional<StringRef> getKeyInline(const HeapRef& key) const;
+
+    // Where a record's bytes start, or null if its page was reclaimed; for prefetching only,
+    // since nothing about the bytes is checked
+    const void* recordAddress(const HeapRef& ref) const;
+
+    bool obsolete(const HeapRef& ref) const {
+        return blocks_.context ? findPage(ref.pageID) == nullptr : ref.pageID <= lastReclaimedPageID_;
+    }
+
+    // Version bound to install before reclaimOldest(); absent if the heap is empty.
+    Optional<Version> oldestPageNewestCV() const;
+
+    // Reclaims the oldest page and returns its newestCV, which a linked page always
+    // carries. Returns absent only when there was no page to reclaim.
+    Optional<Version> reclaimOldest();
+
+    PageID lastReclaimedPageID() const {
+        return lastReclaimedPageID_;
+    }
+
+    Optional<Version> reclaimedThroughCV() const {
+        return reclaimedThroughCV_;
+    }
+
+private:
+    static constexpr uint32_t FragmentOffset = uint32_t{1} << 31;
+    Optional<HeapRef> appendFragmented(const uint8_t* data, size_t bytes, Version cv);
+    void copyFragmented(const HeapRef& ref, uint8_t* data) const;
+    void linkPage(HistoryPage* page, Version cv);
+    Optional<HeapRef> appendPointRecord(Version cv, StringRef key, bool withSuccessor);
+
+    // Acquires, initializes and links a page. Returns nullptr if exhausted.
+    HistoryPage* acquirePage();
+
+    // Resolves a logical page ID to its current physical page.
+    HistoryPage* findPage(PageID id) const;
+
+    // Reserves space for one record of `bytes`, on the newest page or on a fresh
+    // one, and updates the page's accounting and its version bound. The reserved
+    // span is padded to the common record alignment; the returned length is the
+    // caller's own. Returns absent if a required page cannot be acquired.
+    Optional<HeapRef> allocateRecord(uint32_t bytes, Version cv);
+
+    // Unlinks the page, removes its lookup entry and returns it to the pool.
+    void releasePage(HistoryPage* page);
+
+    PagePool& pool_;
+    BlockStorage blocks_{};
+
+    HistoryPage* oldest_ = nullptr;
+    HistoryPage* newest_ = nullptr;
+
+    PageID nextPageID_ = 1;
+    PageID lastReclaimedPageID_ = 0;
+
+    Optional<Version> reclaimedThroughCV_;
+
+    // Logical page ID -> physical page.
+    HeapPageTable pages_;
+};
+
+// heapLookupInline: defined here so that the B+'s key resolution (PagedBTreeConflictSet::key) compiles the
+// lookup in line, without the calls into PagedTemporalSkipList.cpp; the bodies, with their range, presence and
+// bounds checks, are getKey's, unchanged. Forcing key() itself into its callers was measured and rejected.
+inline HistoryPage* TemporalHeap::findPage(PageID id) const {
+    return blocks_.context ? blocks_.find(blocks_.context, id) : pages_.find(id);
+}
+
+__attribute__((always_inline)) inline Optional<StringRef> TemporalHeap::getKeyInline(const HeapRef& key) const {
+    const HistoryPage* page = findPage(key.pageID);
+    if (page == nullptr) {
+        return {};
+    }
+
+    ASSERT(!fragmented(key));
+    // References come from allocateRecord. These checks keep the read inside the
+    // page; they do not prove the bytes were written.
+    ASSERT(key.offset <= storageBytes());
+    ASSERT(key.length <= storageBytes() - key.offset);
+
+    const auto* bytes =
+        reinterpret_cast<const uint8_t*>(page) + key.offset;
+
+    return StringRef(bytes, static_cast<int>(key.length));
+}
+
+// ---------- Summaries ----------
+
+struct EndpointRef {
+    HeapRef key;       // bytes of an interval's exclusive end
+    Version sourceCV;  // CV of the record containing that end
+};
+
+enum class MaxEndState : uint8_t {
+    Empty,       // the span contains no live intervals
+    Valid,       // value is a conservative upper bound
+    NeedsRepair  // cannot be used to discard the span
+};
+
+struct MaxEndSummary {
+    MaxEndState state = MaxEndState::Empty;
+    Optional<EndpointRef> value;
+};
+
+struct SpanSummary {
+    Optional<Version> maxCV; // conservative maximum over the span
+    MaxEndSummary maxEnd;   // used only by the range index
+};
+
+// ---------- Individual level entries ----------
+
+struct SkipEntry {
+    // Detached, free cell. A zero page ID is never a live heap reference.
+    SkipEntry() = default;
+    SkipEntry(ConflictKind kind, Level level, const HeapRef& record, Version recordCV);
+
+    // Links refer directly to this cell. Its address remains stable until it is
+    // detached from the index and cleanup list and all incoming links are repaired.
+    SkipEntry(const SkipEntry&) = delete;
+    SkipEntry& operator=(const SkipEntry&) = delete;
+    SkipEntry(SkipEntry&&) = delete;
+    SkipEntry& operator=(SkipEntry&&) = delete;
+
+    ConflictKind kind = ConflictKind::Point;
+    bool linkedInLevel = false;   // true if the cell is linked into a SkipLevel
+    Level level = 0;
+    HeapRef record{};
+    Version recordCV = 0;
+
+    // Neighbours in key order at this level. Equal keys retain insertion order.
+    SkipEntry* previous = nullptr;
+    SkipEntry* next = nullptr;
+
+    // Copies of this record at adjacent levels.
+    SkipEntry* down = nullptr;
+    SkipEntry* up = nullptr;
+
+    // Next cell in the global cleanup queue, in append order.
+    // CVs need not be monotonic; cells are removed only from the head.
+    // After removal this link may be stale; append overwrites it before reuse.
+    SkipEntry* newerForCleanup = nullptr;
+
+    // Covers this entry's key-order span, inclusive, to the next entry, exclusive.
+    // Before removal, transfer this summary to the predecessor or level prefix.
+    // An expired cell can still summarize live records at lower levels.
+    SpanSummary summary;
+
+    // Returns the point key or interval begin from record. The caller must check
+    // expiry and ensure the record's heap page is still live before calling.
+    StringRef beginWriteKey(const TemporalHeap& heap) const;
+    // Returns an interval's exclusive end from a range record, under the same
+    // conditions as beginWriteKey
+    StringRef endKeyOf(const TemporalHeap& heap) const;
+};
+
+class SkipLevel {
+public:
+    SkipEntry* first_ = nullptr;
+    SkipEntry* last_ = nullptr;
+
+    bool empty() const { return first_ == nullptr; }
+
+    SpanSummary& prefixSummary() { return prefixSummary_; }
+    const SpanSummary& prefixSummary() const { return prefixSummary_; }
+
+    // Links an entry not currently linked into any level or free list.
+    // Its previous/next may be stale; both are overwritten without being read.
+    // A null predecessor inserts at the beginning.
+    // A non-null predecessor must belong to this level and differ from entry.
+    // Updates horizontal links only; the caller maintains summaries.
+    void insertAfter(SkipEntry* predecessor, SkipEntry* entry);
+
+    // Unlinks an entry belonging to this level without releasing its storage.
+    // Its forward summary must already have been transferred.
+    // Leaves the entry's previous/next unchanged; they are no longer valid links.
+    // Reinsertion or recycling must overwrite them before use.
+    // Vertical and cleanup links remain unchanged.
+    void unlink(SkipEntry* entry);
+
+private:
+    // Span before the first entry of this level.
+    SpanSummary prefixSummary_;
+};
+
+// ---------- Global temporal cleanup queue ----------
+
+// Shared by both indexes and all levels. Entries leave only through the head.
+// Approximate CV order may delay cleanup of expired entries behind a live head.
+class CleanupList {
+public:
+    bool empty() const { return oldest_ == nullptr; }
+
+    // Returns the head's CV, not necessarily the minimum CV in the queue.
+    // Requires a nonempty queue.
+    Version oldestCV() const {
+        ASSERT(oldest_ != nullptr);
+        return oldest_->recordCV;
+    }
+
+    // Appends a cell not currently linked into any cleanup queue.
+    // CVs need not be monotonic. Overwrites newerForCleanup without reading it.
+    void append(SkipEntry* entry);
+
+    // Removes and returns the head. Requires a nonempty queue.
+    // Does not check expiry or release storage. Leaves newerForCleanup unchanged;
+    // it is no longer a valid queue link and must be overwritten before reuse.
+    // Horizontal and vertical links remain unchanged.
+    SkipEntry* popOldest();
+
+private:
+    SkipEntry* oldest_ = nullptr;
+    SkipEntry* newest_ = nullptr;
+};
+
+
+// ---------- Index storage ----------
+
+// Packs individual, immovable cells into shared pool pages. All levels and both
+// indexes use the same cell layout and free list, without per-level arenas.
+class IndexPageAllocator {
+public:
+    // The pool must outlive this allocator.
+    explicit IndexPageAllocator(PagePool& pool);
+
+    // Destroys all cells and returns owned pages. Invalidates every cell pointer.
+    ~IndexPageAllocator();
+
+    IndexPageAllocator(const IndexPageAllocator&) = delete;
+    IndexPageAllocator& operator=(const IndexPageAllocator&) = delete;
+    IndexPageAllocator(IndexPageAllocator&&) = delete;
+    IndexPageAllocator& operator=(IndexPageAllocator&&) = delete;
+
+    // Returns an initialized, detached cell. The record must have a nonzero ID.
+    // Requests storage through PagePool::acquire, including its reclamation path.
+    // Throws std::bad_alloc if neither a cell nor a page can be obtained.
+    // Future reclamation must preserve the record being inserted; reserve cells
+    // before retaining search predecessors that reclamation could invalidate.
+    SkipEntry* acquire(ConflictKind kind,
+                        Level level,
+                        const HeapRef& record,
+                        Version recordCV);
+
+    // Returns a cell acquired from this allocator to its free list in O(1).
+    // It must be fully detached and its summary already transferred.
+    // Links may be stale. During synchronous destruction of a complete tower,
+    // upper cells may still carry down links to recycled cells; never follow them.
+    // No other live structure may retain a reference to the cell.
+    // Keeps the backing page for reuse, even if this was its last live cell.
+    void release(SkipEntry* entry);
+
+    // Scans owned pages and returns those with no live cells to the pool.
+    // Removes their free cells before returning storage; returns the page count.
+    // Separate from release(): costs one page scan plus work per returned cell.
+    uint64_t releaseEmptyPages();
+
+private:
+    struct IndexPage;
+
+    PagePool& pool_;
+    IndexPage* firstPage_ = nullptr;
+
+    // Free cells use previous/next; record.pageID == 0 marks their free state.
+    // Vertical and temporal links may be stale; they are not followed while free.
+    // Reuse resets all data and summaries.
+    SkipEntry* firstFree_ = nullptr;
+
+    // Gets cells from a new page or from reclamation triggered by the pool.
+    // Returns false if neither source provides storage.
+    bool acquirePage();
+
+    // Removes an empty page's free cells and returns the page to the pool.
+    void releasePage(IndexPage* page);
+
+    static IndexPage* pageOf(const SkipEntry* entry);
+
+    // Prepends a free cell, overwriting both horizontal links.
+    // The cell must no longer belong to any level or free list.
+    void linkFree(SkipEntry* entry);
+
+    // Removes a free cell without clearing its previous/next fields.
+    // The caller must overwrite those fields before reusing them.
+    void unlinkFree(SkipEntry* entry);
+};
+
+// ---------- Search path ----------
+
+struct SearchStep {
+    Level level;
+
+    // Insertion predecessor at this level; nullptr means insert at its head.
+    SkipEntry* predecessor = nullptr;
+};
+
+// Saves the position found at each level so insertion need not search again.
+// Steps run from the highest level to level zero.
+// Structural changes or reclamation may invalidate the saved predecessors.
+struct SearchPath {
+    std::vector<SearchStep> steps;
+};
+
+// ---------- Temporal skip list ----------
+
+class TemporalSkipList {
+public:
+    // Same height limit as FoundationDB's resolver skip list.
+    static constexpr int MaxLevels = 26;
+
+    // The heap must outlive this skip list.
+    explicit TemporalSkipList(ConflictKind kind, const TemporalHeap& heap)
+        : kind_(kind), heap_(heap) {}
+
+    // Work done by the range search, for measurement only; totals since construction.
+    // A span is what one iteration of the search decides: a level's prefix, or the span
+    // a cell owns at its level. Each examined span has exactly one outcome, so for each
+    // kind the six outcome counts add up to the spans examined at every level
+    struct RangeSearchStats {
+        static constexpr bool enabled = PAGED_RESOLVER_SEARCH_STATS;
+        static constexpr int Prefix = 0, Cell = 1;
+        uint64_t queries = 0;
+        uint64_t spans[MaxLevels][2] = {};
+        uint64_t prunedByMaxCV[2] = {};
+        uint64_t emptyEnd[2] = {};
+        uint64_t validPrunes[2] = {};
+        uint64_t validExplores[2] = {};
+        uint64_t needsRepair[2] = {};
+        uint64_t becameNeedsRepair[2] = {};
+        uint64_t descents[2] = {};
+        // Explored cells, by whether their own record was read or had expired
+        uint64_t recordsLevelZero = 0, recordsAbove = 0;
+        uint64_t expiredCellsLevelZero = 0, expiredCellsAbove = 0;
+    };
+    const RangeSearchStats& rangeSearchStats() const {
+        return rangeStats_;
+    }
+    // Summaries transferred by removing cells from their levels, for measurement and tests
+    uint64_t summaryTransfers() const {
+        return summaryTransfers_;
+    }
+
+    // One point read of a batch and, once answered, whether a write conflicts with it
+    struct PointQuery {
+        Version readVersion = 0;
+        StringRef begin, end;
+        bool conflict = false;
+    };
+
+    // Answers each query as hasPointConflict does, sixteen searches at a time. A search
+    // advances one step at a time and, before yielding, prefetches what its next step reads:
+    // a cell, then the heap record that holds the cell's key.
+    //
+    // Only for the synchronous query phase of a batch. Between two steps of a search, the
+    // others may unlink expired towers, and nothing else may change: no insertion, no cell
+    // recycled, no heap page reclaimed, no change of validationMinRV. See PointSearch
+    void hasPointConflicts(PointQuery* queries, size_t count, Version validationMinRV);
+
+    // A write whose record is in the heap and whose tower's cells are acquired but not linked.
+    // findInsertionPaths fills its predecessor at every level; link then publishes it
+    struct PreparedWrite {
+        HeapRef record{};
+        Version cv = 0;
+        Level levels = 0;
+        SkipEntry* cells[MaxLevels] = {};
+        SkipEntry* predecessors[MaxLevels] = {};
+    };
+
+    // Draws the tower's height and acquires its cells, bottom first. Acquiring a cell may run
+    // reclamation, so no path may be held across this call
+    void prepare(PreparedWrite& write, const HeapRef& record, Version cv, IndexPageAllocator& allocator);
+
+    // Finds each prepared write's predecessor at every level, as findInsertionPath does, sixteen
+    // searches interleaved and prefetching. Only once every write of the group is prepared, and
+    // under the same rules as hasPointConflicts: nothing allocated, recycled or reclaimed, and
+    // validationMinRV fixed, until the group is linked. The writes' records must still be live
+    void findInsertionPaths(PreparedWrite* writes, size_t count, Version validationMinRV);
+
+    // Links a prepared write after its predecessors and queues its cells, splitting the spans it
+    // lands in. A group's writes are linked in decreasing key order: those linked before a write all
+    // have greater keys, so none comes between it and its predecessors. Returns the cells linked
+    uint64_t linkTower(PreparedWrite& write, CleanupList& cleanup);
+
+    // Grows, with a linked write, the summary of the span that contains it at each level above its
+    // tower. owners[level] names the cell owning that span, or null for the level's prefix; only
+    // levels from write.levels up are read. Once a whole group is linked, that owner is the
+    // nearest smaller write of the group with a cell at the level, if it has the same predecessor
+    // there, and otherwise the predecessor itself
+    void growAbove(const PreparedWrite& write, SkipEntry* const* owners, Version validationMinRV);
+
+    // linkTower, then growAbove into the predecessors: a single write, where they are the owners
+    uint64_t link(PreparedWrite& write, Version validationMinRV, CleanupList& cleanup);
+
+    // Links a group of prepared writes, in increasing key order in the array, whose paths are
+    // found: towers in decreasing order, then the growth above each tower in increasing order into
+    // the span that owns it with the whole group in place. Returns the cells linked
+    uint64_t linkGroup(PreparedWrite* writes, size_t count, Version validationMinRV, CleanupList& cleanup);
+
+    // Finds upper-bound insertion predecessors, from highest level to zero.
+    // Removes expired towers before reading keys, transferring their summaries.
+    // Removed cells remain in the cleanup queue until recycled.
+    SearchPath findInsertionPath(StringRef key, Version validationMinRV);
+
+    // Inserts a tower of random height for a record already in the heap, after
+    // any entries with an equal key, and appends its cells to the cleanup queue.
+    // Updates the summaries of the spans it splits and of those above it.
+    // Bind validationMinRV to the owner's current threshold: allocating cells
+    // may advance it. Search reads it only after all cells have been acquired.
+    // Returns the number of cells inserted.
+    uint64_t insert(const HeapRef& record,
+                Version recordCV,
+                const Version& validationMinRV,
+                IndexPageAllocator& allocator,
+                CleanupList& cleanup);
+
+	// One query, through the same search as hasPointConflicts, run to its end
+	bool hasPointConflict(Version readVersion, StringRef begin, StringRef end, 
+			Version validationMinRV);
+	bool hasRangeConflict(Version readVersion, StringRef begin, StringRef end, 
+			Version validationMinRV);
+	bool empty() const {
+        return levels_[0].empty();
+    }
+
+    // Transfers and unlinks a cell still linked in its level; otherwise a no-op.
+    // Does not release the cell or follow vertical links.
+    void detach(SkipEntry* entry, Version validationMinRV);
+
+private:
+    ConflictKind kind_;
+    const TemporalHeap& heap_;
+    std::array<SkipLevel, MaxLevels> levels_;
+    RangeSearchStats rangeStats_;
+    uint64_t summaryTransfers_ = 0;
+
+    // A point search between two of its steps. What it holds stays valid across the steps of
+    // other searches because, during the query phase:
+    // - previous is live, and stays live while validationMinRV is fixed, so no search unlinks it
+    // - current may be unlinked by another search; unlinking keeps its next, previous, up and down,
+    //   and no cell is recycled, so following next from it still leads, in key order, through
+    //   cells that are unlinked or live to a live one or the end. Its expiry is checked before its
+    //   key is read, and unlinking it again transfers nothing, since unlinkExpiredTower skips
+    //   cells no longer linked
+    // - no page is reclaimed, so a record prefetched at one step is still readable at the next
+    struct PointSearch {
+        PointQuery* query = nullptr;
+        SkipEntry* previous = nullptr;
+        SkipEntry* current = nullptr;
+        int level = MaxLevels - 1;
+        // Descending ends at level zero's first live key at or past the read's begin; the scan
+        // then walks from there toward its end
+        bool scanning = false;
+        // current's cell has been read and its record prefetched; the key comes next
+        bool recordPending = false;
+    };
+    // A search for a prepared write's predecessors: the last live cell at each level whose key
+    // is at or below the write's, so that equal keys precede it. Its fields stay valid across other
+    // searches' steps for the reasons given for PointSearch
+    struct PathSearch {
+        PreparedWrite* write = nullptr;
+        StringRef key;
+        SkipEntry* previous = nullptr;
+        SkipEntry* current = nullptr;
+        int level = MaxLevels - 1;
+        bool recordPending = false;
+    };
+    void startPathSearch(PathSearch& search, PreparedWrite& write);
+    // Takes one step; returns true when every level has its predecessor
+    bool stepPathSearch(PathSearch& search, Version validationMinRV);
+
+    void startPointSearch(PointSearch& search, PointQuery& query);
+    // Takes one step; returns true when the query has its answer
+    bool stepPointSearch(PointSearch& search, Version validationMinRV);
+    void prefetchCell(const SkipEntry* entry) const;
+
+    // Returns the highest level for a new entry, from 0 to MaxLevels - 1.
+    // Each promotion has probability 1/2.
+    int randomLevel() const;
+    // Removes an expired tower from all its levels without releasing storage.
+    // Saved search predecessors remain valid because they belong to live towers.
+    void unlinkExpiredTower(SkipEntry* entry, Version validationMinRV);
+    // Merges the cell's forward summary into its physical predecessor or prefix.
+    void transferSummary(SkipEntry* entry, Version validationMinRV);
+    // Splits the preceding span when inserting entry.
+    // Preserves conservative bounds and incorporates the new record.
+    // Called before linking entry into its level.
+    void splitSummary(SkipEntry* predecessor, SkipEntry* entry);
+    // Searches level's spans from current, or from its prefix when current is null,
+    // up to stop, descending wherever a summary cannot rule a span out
+    bool hasRangeConflictRec(
+        Version readVersion, StringRef readBegin, StringRef readEnd,
+        Version validationMinRV, int level,
+        SkipEntry* current, SkipEntry* stop);
+    // Rebuilds maxEnd for the complete span owned by entry,
+    // or the level prefix when entry is nullptr.
+    // May combine usable lower-level summaries; the result can remain
+    // conservative if those summaries are themselves conservative.
+    // Publishes the result only after covering the complete span.
+    void repairMaxEnd(Level level, SkipEntry* entry, Version validationMinRV);
+};
+
+// ---------- Resolver state ----------
+
+class TemporalConflictSet {
+public:
+    // Captures and validates the cleanup knobs; they stay fixed for this object's life.
+    TemporalConflictSet(uint64_t limitPages, Version initialValidationMinRV);
+
+    TemporalConflictSet(const TemporalConflictSet&) = delete;
+    TemporalConflictSet& operator=(const TemporalConflictSet&) = delete;
+    TemporalConflictSet(TemporalConflictSet&&) = delete;
+    TemporalConflictSet& operator=(TemporalConflictSet&&) = delete;
+
+    Version validationMinRV() const {
+        return validationMinRV_;
+    }
+
+    const PageBudget& budget() const {
+        return pool_.budget();
+    }
+
+    // History pages reclaimed under pool pressure so far, for the Resolver's metrics
+    PageID reclaimedHistoryPages() const {
+        return heap_.lastReclaimedPageID();
+    }
+
+    // The range index's search counters, for measurement
+    const TemporalSkipList::RangeSearchStats& rangeSearchStats() const {
+        return ranges_.rangeSearchStats();
+    }
+
+    // Records a point write in the heap and point index.
+    void addPoint(Version cv, StringRef key);
+
+    // Records a write to the half-open interval [begin, end).
+    // Requires begin < end.
+    void addRange(Version cv, StringRef begin, StringRef end);
+
+    // Checks both indexes for writes overlapping [begin, end)
+    // whose CV exceeds readVersion.
+    // Throws transaction_too_old if readVersion < validationMinRV_.
+    // May repair summaries, so this operation is not const.
+    bool hasConflict(Version readVersion, StringRef begin, StringRef end);
+
+    // One write of a batch: a point, [begin, keyAfter(begin)), or a range [begin, end)
+    struct Write {
+        bool point = false;
+        StringRef begin, end;
+    };
+
+    // Records a batch's writes at version cv. Within each index their begins must be strictly
+    // increasing, as the Resolver's combined write ranges are. Works in groups of sixteen: it
+    // prepares a group's records and cells in increasing key order, which is where reclamation
+    // may run; then, with nothing allocated until the group is linked, finds their paths
+    // interleaved and links them in decreasing key order.
+    //
+    // If preparing a group moves validationMinRV to cv or past it, every read admitted from then
+    // on has readVersion >= validationMinRV >= cv, so no write at cv can conflict with it. The
+    // group's cells are released unlinked and uncounted, and the batch's remaining writes are
+    // dropped. This is decided before any prepared record is read. Throws std::bad_alloc when an
+    // undersized pool cannot make room, as addPoint does
+    void addWrites(Version cv, const Write* writes, size_t count);
+
+    // The two halves of hasConflict, for reads already admitted, with readVersion at or above
+    // validationMinRV(): the range index for one read, and the point index for a batch of
+    // reads, searched together with prefetching. Neither throws
+    bool hasRangeConflict(Version readVersion, StringRef begin, StringRef end);
+    void hasPointConflicts(TemporalSkipList::PointQuery* queries, size_t count);
+
+    // Computes an adaptive cell budget using the cleanup knobs captured at construction,
+    // cells inserted since the previous pass, free pages and cleanup lag.
+    // Resets the insertion counter for the next pass.
+    // Removes expired towers from the temporal queue's head.
+    // Stops when the queue is empty, its head's CV exceeds validationMinRV_,
+    // or the budget is reached. Always finishes a started tower.
+    // Transfers summaries before unlinking cells still in an index,
+    // and recycles every cell, including those already unlinked.
+    // Returns the number of cells recycled.
+    uint64_t cleanup();
+
+private:
+    // Shares tower removal between batch cleanup and allocation pressure.
+    // Finishes every started tower; does not reset the insertion counter.
+    uint64_t cleanupExpired(uint64_t maxCells);
+
+    // Runs only after pool exhaustion, without the per-batch work limit.
+    // Frees a page or (for Index) cells; leaves allocation failure to the caller
+    // if an undersized pool cannot make progress. Never allocates from the pool.
+    void reclaimForAllocation(PageUse use);
+
+    Version validationMinRV_; // Initialised at recruitment.
+
+    // Cells inserted across both indexes since the previous cleanup pass.
+    // Counts every tower level, including cells allocated from recycled space.
+    uint64_t insertedNodes_ = 0;
+
+    // PAGED_RESOLVER_CLEANUP_* knob values, captured once at construction.
+    const double nodesPerInsertedNode_;
+    const int minNodes_;
+    const double lowFreePageRatio_;
+    const int64_t lagVersions_;
+    const double boostFactor_;
+    const int maxNodes_;
+
+    // Declaration order keeps the pool alive until all consumers are destroyed.
+    PagePool pool_;
+    TemporalHeap heap_;
+    IndexPageAllocator indexAllocator_;
+
+    TemporalSkipList points_;
+    TemporalSkipList ranges_;
+
+    CleanupList cleanup_;
+};
diff --git a/fdbserver/resolver/PagedTemporalSkipListTests.cpp b/fdbserver/resolver/PagedTemporalSkipListTests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b8aaa64ebd34d679b2e209564896d0a2264fb212
--- /dev/null
+++ b/fdbserver/resolver/PagedTemporalSkipListTests.cpp
@@ -0,0 +1,4611 @@
+// Standalone battery for SkipEntry, SkipLevel, TemporalSkipList, CleanupList,
+// HeapPageTable and TemporalHeap, runnable before the structure reaches the fork. One property per case, and the
+// page budget checked after every transition that should move it.
+//
+// Caller contract violations are outside this battery's scope.
+// These include wrong record kinds, oversized records, invalid ranges,
+// out-of-order erasure and double release.
+
+// The reclamation cases reach private state of the conflict set. This translation
+// unit alone includes the header with private widened to public; everything the header
+// itself includes is included first, so only the header's own declarations change.
+// The implementation file is compiled unchanged.
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <cstdarg>
+#include <set>
+#include <thread>
+#include <vector>
+
+#include "flow/Error.h"
+#include "flow/Optional.h"
+#include "fdbclient/FDBTypes.h"
+#include "fdbclient/KnobValue.h"
+#include "fdbserver/core/Knobs.h"
+
+#define private public
+#include "PagedTemporalSkipList.h"
+#undef private
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <deque>
+#include <new>
+#include <memory>
+#include <random>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+namespace {
+
+int failures = 0;
+std::vector<std::string> caseMessages;
+const char* caseName = "";
+
+// Returns the condition, so a case can stop at a gate instead of reading an
+// absent Optional and aborting the whole battery.
+bool check(bool condition, const char* what) {
+	if (!condition) {
+		caseMessages.push_back(what);
+		++failures;
+	}
+	return condition;
+}
+
+// The name goes out before the case runs, so an assertion that aborts the process
+// still shows which case it was in.
+void begin(const char* name) {
+	caseName = name;
+	caseMessages.clear();
+	printf("%-60s", caseName);
+}
+
+void end() {
+	printf("%s\n", caseMessages.empty() ? "OK" : "FAIL");
+	for (const std::string& m : caseMessages) {
+		printf("        %s\n", m.c_str());
+	}
+}
+
+// Presence gates. Each records a failure and yields a harmless value, so a
+// regression is reported as a failed case and the rest of the battery still runs.
+HeapRef appended(const Optional<HeapRef>& r, const char* what) {
+	if (!check(r.present(), what)) {
+		return HeapRef{ 0, 0, 0 }; // page 0 is never registered: reads come back absent
+	}
+	return r.get();
+}
+
+PointConflictView pointAt(const TemporalHeap& heap, const HeapRef& r, const char* what) {
+	Optional<PointConflictView> v = heap.getPoint(r);
+	if (!check(v.present(), what)) {
+		return PointConflictView{ 0, StringRef() };
+	}
+	return v.get();
+}
+
+RangeConflictView rangeAt(const TemporalHeap& heap, const HeapRef& r, const char* what) {
+	Optional<RangeConflictView> v = heap.getRange(r);
+	if (!check(v.present(), what)) {
+		return RangeConflictView{ 0, StringRef(), StringRef() };
+	}
+	return v.get();
+}
+
+Version versionOf(const Optional<Version>& v, const char* what) {
+	if (!check(v.present(), what)) {
+		return -1;
+	}
+	return v.get();
+}
+
+void checkBudget(const PagePool& pool, const char* where) {
+	const PageBudget& b = pool.budget();
+	check(b.freePages + b.heapPages + b.indexPages == b.limitPages, where);
+}
+
+StringRef asRef(const std::string& s) {
+	return StringRef(reinterpret_cast<const uint8_t*>(s.data()),
+					 static_cast<int>(s.size()));
+}
+
+// Mirrors the layout the implementation computes in its anonymous namespace,
+// which is not visible from here. This is a copy of the formula, not a check of
+// it: if the formula itself is wrong, both sides are wrong together. What it
+// buys is a boundary case that knows the exact payload size.
+constexpr size_t RECORD_ALIGNMENT =
+	alignof(PointConflictHeader) > alignof(RangeConflictHeader)
+		? alignof(PointConflictHeader)
+		: alignof(RangeConflictHeader);
+
+constexpr size_t alignUp(size_t bytes) {
+	return (bytes + RECORD_ALIGNMENT - 1) & ~(RECORD_ALIGNMENT - 1);
+}
+
+constexpr size_t FIRST_RECORD_OFFSET = alignUp(sizeof(HistoryPage));
+constexpr size_t MAX_RECORD_BYTES = HISTORY_PAGE_BYTES - FIRST_RECORD_OFFSET;
+
+// ---------- SkipEntry ----------
+
+// A cell carries a reference to the record, not the key bytes, so every case needs a
+// heap holding the record it names.
+HeapRef pointRecord(TemporalHeap& heap, Version cv, const std::string& key) {
+	return appended(heap.appendPoint(cv, asRef(key)), "the point record is appended");
+}
+
+HeapRef rangeRecord(TemporalHeap& heap, Version cv, const std::string& from, const std::string& to) {
+	return appended(heap.appendRange(cv, asRef(from), asRef(to)), "the range record is appended");
+}
+
+bool sameRecord(const HeapRef& a, const HeapRef& b) {
+	return a.pageID == b.pageID && a.offset == b.offset && a.length == b.length;
+}
+
+void aCellKeepsWhatItWasGivenAndNothingElse() {
+	begin("aCellKeepsWhatItWasGivenAndNothingElse");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+	const HeapRef record = pointRecord(heap, 42, "a key");
+
+	const SkipEntry entry(ConflictKind::Point, 3, record, 42);
+
+	check(entry.kind == ConflictKind::Point, "it keeps its kind");
+	check(!entry.linkedInLevel, "it belongs to no level yet");
+	check(entry.level == 3, "and its level");
+	check(sameRecord(entry.record, record), "and the record it names");
+	check(entry.recordCV == 42, "and the version, which is stored outside the heap");
+
+	// A freshly built cell is detached: nothing may point out of it until it is linked.
+	check(entry.previous == nullptr && entry.next == nullptr, "no key-order neighbours");
+	check(entry.up == nullptr && entry.down == nullptr, "no copies at adjacent levels");
+	check(entry.newerForCleanup == nullptr, "and no place in the cleanup queue");
+	check(!entry.summary.maxCV.present(), "its span summary bounds nothing yet");
+	check(entry.summary.maxEnd.state == MaxEndState::Empty, "and holds no endpoint");
+	check(!entry.summary.maxEnd.value.present(), "with no endpoint reference");
+	end();
+}
+
+void cellsCannotBeCopiedOrMoved() {
+	begin("cellsCannotBeCopiedOrMoved");
+
+	// Links point straight at a cell, so its address has to stay put while it is
+	// referenced. The contract is enforced by the type, and checked here so that
+	// deleting the wrong constructor does not go unnoticed.
+	check(!std::is_copy_constructible_v<SkipEntry>, "a cell cannot be copy-constructed");
+	check(!std::is_copy_assignable_v<SkipEntry>, "nor copy-assigned");
+	check(!std::is_move_constructible_v<SkipEntry>, "nor move-constructed");
+	check(!std::is_move_assignable_v<SkipEntry>, "nor move-assigned");
+	end();
+}
+
+void aPointCellOrdersByItsKey() {
+	begin("aPointCellOrdersByItsKey");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+
+	// An ordinary key, an empty one, and one that is nothing but zero bytes: the key
+	// comes back by length, never by a terminator.
+	const std::string ordinary = "the key";
+	const std::string zeros(6, '\0');
+	const SkipEntry plain(ConflictKind::Point, 0, pointRecord(heap, 1, ordinary), 1);
+	const SkipEntry empty(ConflictKind::Point, 0, pointRecord(heap, 2, std::string()), 2);
+	const SkipEntry allZeros(ConflictKind::Point, 0, pointRecord(heap, 3, zeros), 3);
+
+	check(plain.beginWriteKey(heap) == asRef(ordinary), "the key reads back whole");
+	check(empty.beginWriteKey(heap).size() == 0, "an empty key reads back empty");
+	check(allZeros.beginWriteKey(heap) == asRef(zeros), "and a key of zero bytes keeps its length");
+	end();
+}
+
+void aRangeCellReadsItsEnd() {
+	begin("aRangeCellReadsItsEnd");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+
+	// Keys of different lengths, so reading the wrong field or length shows
+	const std::string from = "b", to = "yz";
+	const SkipEntry entry(ConflictKind::Range, 0, rangeRecord(heap, 1, from, to), 1);
+	check(entry.endKeyOf(heap) == asRef(to), "an interval's end reads back whole");
+	check(!(entry.endKeyOf(heap) == entry.beginWriteKey(heap)), "and is not its begin");
+
+	// Zero bytes inside and at the end of the key keep their length
+	const std::string zeros("a\0b\0", 4);
+	const SkipEntry withZeros(ConflictKind::Range, 0, rangeRecord(heap, 2, "a", zeros), 2);
+	check(withZeros.endKeyOf(heap) == asRef(zeros) && withZeros.endKeyOf(heap).size() == 4,
+	      "an end with zero bytes reads back exactly");
+
+	// An empty begin leaves the end where it was
+	const SkipEntry atTheStart(ConflictKind::Range, 0, rangeRecord(heap, 3, std::string(), to), 3);
+	check(atTheStart.endKeyOf(heap) == asRef(to), "an empty begin does not shift the end");
+
+	// The bytes are the record's own, not a copy
+	const uint8_t* first = entry.endKeyOf(heap).begin();
+	check(first == entry.endKeyOf(heap).begin() && first != reinterpret_cast<const uint8_t*>(to.data()),
+	      "two reads return the same address, which is not the caller's buffer");
+	end();
+}
+
+void aRangeCellOrdersByItsBeginKey() {
+	begin("aRangeCellOrdersByItsBeginKey");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+
+	// The end sorts before the begin of the next interval, so a cell reading the wrong
+	// endpoint would order the index differently.
+	const std::string from = "b", to = "y";
+	const SkipEntry entry(ConflictKind::Range, 0, rangeRecord(heap, 1, from, to), 1);
+
+	check(entry.beginWriteKey(heap) == asRef(from), "an interval orders by its begin");
+	check(!(entry.beginWriteKey(heap) == asRef(to)), "and not by its end");
+
+	// An empty begin is legal for a range record, and it is the smallest key.
+	const SkipEntry atTheStart(ConflictKind::Range, 0, rangeRecord(heap, 2, std::string(), to), 2);
+	check(atTheStart.beginWriteKey(heap).size() == 0, "an interval can begin at the empty key");
+	check(atTheStart.beginWriteKey(heap) < entry.beginWriteKey(heap), "which sorts before every other");
+	end();
+}
+
+void theKeyIsReadFromTheHeapNotCopied() {
+	begin("theKeyIsReadFromTheHeapNotCopied");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+
+	const std::string key = "shared bytes";
+	const HeapRef record = pointRecord(heap, 7, key);
+	const SkipEntry entry(ConflictKind::Point, 0, record, 7);
+
+	const uint8_t* first = entry.beginWriteKey(heap).begin();
+	const uint8_t* second = entry.beginWriteKey(heap).begin();
+	check(first == second, "two reads return the same address, so nothing is copied");
+	check(first != reinterpret_cast<const uint8_t*>(key.data()),
+	      "and it is the heap's own copy, not the caller's buffer");
+
+	// The cell reads exactly what the heap reports for the same reference.
+	Optional<PointConflictView> view = heap.getPoint(record);
+	if (check(view.present(), "the heap still holds the record")) {
+		check(view.get().key.begin() == first, "at the same address the heap reports");
+		check(view.get().cv == entry.recordCV, "with the version the cell carries");
+	}
+	end();
+}
+
+void promotedCopiesShareOneRecord() {
+	begin("promotedCopiesShareOneRecord");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+
+	// A promotion is another cell for the same write: same record, same CV, no new heap
+	// bytes and no second logical write.
+	const std::string key = "promoted";
+	const HeapRef record = pointRecord(heap, 11, key);
+	const SkipEntry atZero(ConflictKind::Point, 0, record, 11);
+	const SkipEntry atOne(ConflictKind::Point, 1, record, 11);
+
+	check(atZero.level == 0 && atOne.level == 1, "the copies differ only in their level");
+	check(sameRecord(atZero.record, atOne.record), "they name the same record");
+	check(atZero.recordCV == atOne.recordCV, "and carry the same version");
+	check(atZero.beginWriteKey(heap) == atOne.beginWriteKey(heap), "so they order by the same key");
+	check(atZero.beginWriteKey(heap).begin() == atOne.beginWriteKey(heap).begin(),
+	      "read from the same bytes, which were not duplicated");
+	check(pool.budget().heapPages == 1, "and the second copy took no heap page");
+	end();
+}
+
+void aDefaultCellIsFreeAndDetached() {
+	begin("aDefaultCellIsFreeAndDetached");
+	const SkipEntry cell;
+
+	// Page ID zero is never registered, so a default cell names no live record.
+	check(cell.record.pageID == 0 && cell.record.offset == 0 && cell.record.length == 0,
+	      "it names no record");
+	check(cell.kind == ConflictKind::Point && cell.level == 0 && cell.recordCV == 0,
+	      "and its other fields are initialized, not left indeterminate");
+	check(!cell.linkedInLevel, "it belongs to no level");
+	check(cell.previous == nullptr && cell.next == nullptr, "no key-order neighbours");
+	check(cell.up == nullptr && cell.down == nullptr, "no copies at adjacent levels");
+	check(cell.newerForCleanup == nullptr, "and no place in the cleanup queue");
+	check(!cell.summary.maxCV.present() && cell.summary.maxEnd.state == MaxEndState::Empty &&
+	          !cell.summary.maxEnd.value.present(),
+	      "and an empty span summary");
+	end();
+}
+
+// ---------- SkipLevel ----------
+
+// Cells for the level cases. The allocator is not written yet, so they live in their
+// own heap objects, which is enough: a level only links cells, it never allocates
+// them. Each cell is tagged with its index in recordCV, so a case can tell that
+// linking a cell rewrote nothing but its horizontal links.
+std::vector<std::unique_ptr<SkipEntry>> makeCells(int count) {
+	std::vector<std::unique_ptr<SkipEntry>> cells;
+	for (int i = 0; i < count; ++i) {
+		cells.push_back(std::make_unique<SkipEntry>());
+		cells.back()->recordCV = i;
+	}
+	return cells;
+}
+
+// The level agrees with the model: the same cells in the same order walking forward
+// from first_ and walking back from last_, with both ends terminated and empty()
+// consistent with them.
+bool levelAgrees(const SkipLevel& level, const std::vector<SkipEntry*>& model, const char* what) {
+	bool agrees = level.empty() == model.empty();
+	agrees = agrees && level.first_ == (model.empty() ? nullptr : model.front());
+	agrees = agrees && level.last_ == (model.empty() ? nullptr : model.back());
+
+	size_t forward = 0;
+	for (SkipEntry* e = level.first_; agrees && e != nullptr; e = e->next) {
+		agrees = forward < model.size() && e == model[forward];
+		++forward;
+	}
+	agrees = agrees && forward == model.size();
+
+	size_t backward = 0;
+	for (SkipEntry* e = level.last_; agrees && e != nullptr; e = e->previous) {
+		agrees = backward < model.size() && e == model[model.size() - 1 - backward];
+		++backward;
+	}
+	agrees = agrees && backward == model.size();
+
+	// Every cell the level holds is marked as linked.
+	for (SkipEntry* e : model) {
+		agrees = agrees && e->linkedInLevel;
+	}
+	return check(agrees, what);
+}
+
+// Inserts after the model's cell at position `after`, or at the head when it is -1.
+void insertAt(SkipLevel& level, std::vector<SkipEntry*>& model, int after, SkipEntry* entry) {
+	level.insertAfter(after < 0 ? nullptr : model[after], entry);
+	model.insert(model.begin() + (after + 1), entry);
+}
+
+void unlinkAt(SkipLevel& level, std::vector<SkipEntry*>& model, int position) {
+	level.unlink(model[position]);
+	model.erase(model.begin() + position);
+}
+
+void anEmptyLevelHasNoEnds() {
+	begin("anEmptyLevelHasNoEnds");
+	const SkipLevel level;
+	check(level.empty(), "a new level is empty");
+	check(level.first_ == nullptr && level.last_ == nullptr, "and has neither end");
+	check(!level.prefixSummary().maxCV.present() && level.prefixSummary().maxEnd.state == MaxEndState::Empty,
+	      "and its prefix summarizes nothing");
+	end();
+}
+
+void theFirstInsertionMakesBothEnds() {
+	begin("theFirstInsertionMakesBothEnds");
+	auto cells = makeCells(1);
+	SkipLevel level;
+	level.insertAfter(nullptr, cells[0].get());
+
+	check(!level.empty(), "the level is no longer empty");
+	check(level.first_ == cells[0].get() && level.last_ == cells[0].get(),
+	      "the one cell is both ends");
+	check(cells[0]->previous == nullptr && cells[0]->next == nullptr, "and has no neighbours");
+	end();
+}
+
+void insertionsAtTheHeadTheTailAndTheMiddle() {
+	begin("insertionsAtTheHeadTheTailAndTheMiddle");
+	auto cells = makeCells(6);
+	SkipLevel level;
+	std::vector<SkipEntry*> model;
+
+	insertAt(level, model, -1, cells[0].get());
+	insertAt(level, model, 0, cells[1].get()); // after the only cell: a new tail
+	levelAgrees(level, model, "a tail after a singleton");
+	insertAt(level, model, -1, cells[2].get()); // a new head
+	levelAgrees(level, model, "a new head");
+	insertAt(level, model, 0, cells[3].get()); // between the head and its successor
+	levelAgrees(level, model, "a cell after the head");
+	insertAt(level, model, static_cast<int>(model.size()) - 1, cells[4].get()); // after the tail
+	levelAgrees(level, model, "a cell after the tail");
+	insertAt(level, model, 2, cells[5].get()); // strictly inside
+	levelAgrees(level, model, "a cell strictly inside");
+	check(model.size() == 6, "every insertion was counted");
+	end();
+}
+
+void insertionOverwritesStaleLinks() {
+	begin("insertionOverwritesStaleLinks");
+	auto cells = makeCells(5);
+	SkipLevel level;
+	std::vector<SkipEntry*> model;
+	insertAt(level, model, -1, cells[0].get());
+	insertAt(level, model, 0, cells[1].get());
+
+	// A recycled cell arrives with links left over from its previous life, here to two
+	// cells that are in no level at all. Insertion must overwrite them, and must not
+	// write through them.
+	SkipEntry* recycled = cells[2].get();
+	recycled->previous = cells[3].get();
+	recycled->next = cells[4].get();
+
+	insertAt(level, model, 0, recycled);
+	levelAgrees(level, model, "the recycled cell is linked by its new neighbours");
+	check(cells[3]->previous == nullptr && cells[3]->next == nullptr &&
+	          cells[4]->previous == nullptr && cells[4]->next == nullptr,
+	      "and the cells its stale links named were not touched");
+	end();
+}
+
+void linkingSetsTheMarkAndUnlinkingClearsIt() {
+	begin("linkingSetsTheMarkAndUnlinkingClearsIt");
+	auto cells = makeCells(3);
+	SkipLevel level;
+
+	// Each step checks the mark before the next insertion, which asserts on it: a wrong
+	// mark is reported here instead of aborting in insertAfter.
+	level.insertAfter(nullptr, cells[0].get());
+	if (!check(cells[0]->linkedInLevel, "an inserted cell is marked as linked")) {
+		return end();
+	}
+	level.insertAfter(cells[0].get(), cells[1].get());
+	check(cells[1]->linkedInLevel, "so is one inserted after it");
+	check(!cells[2]->linkedInLevel, "a cell never inserted is not");
+
+	level.unlink(cells[0].get());
+	if (!check(!cells[0]->linkedInLevel, "unlinking clears the mark")) {
+		return end();
+	}
+	check(cells[1]->linkedInLevel, "and leaves its neighbour's alone");
+
+	// The mark is what lets the same cell be inserted again.
+	level.insertAfter(cells[1].get(), cells[0].get());
+	check(cells[0]->linkedInLevel, "a cell unlinked and inserted again is marked again");
+	end();
+}
+
+void unlinkingTheOnlyCellEmptiesTheLevel() {
+	begin("unlinkingTheOnlyCellEmptiesTheLevel");
+	auto cells = makeCells(1);
+	SkipLevel level;
+	std::vector<SkipEntry*> model;
+	insertAt(level, model, -1, cells[0].get());
+
+	unlinkAt(level, model, 0);
+	levelAgrees(level, model, "the level is empty again");
+	check(level.empty(), "and says so");
+	end();
+}
+
+void unlinkingTheHeadTheTailAndTheMiddle() {
+	begin("unlinkingTheHeadTheTailAndTheMiddle");
+	auto cells = makeCells(5);
+	SkipLevel level;
+	std::vector<SkipEntry*> model;
+	for (int i = 0; i < 5; ++i) {
+		insertAt(level, model, i - 1, cells[i].get());
+	}
+
+	unlinkAt(level, model, 2);
+	levelAgrees(level, model, "after unlinking a middle cell");
+	unlinkAt(level, model, 0);
+	levelAgrees(level, model, "after unlinking the head");
+	unlinkAt(level, model, static_cast<int>(model.size()) - 1);
+	levelAgrees(level, model, "after unlinking the tail");
+	check(model.size() == 2, "two cells remain");
+	end();
+}
+
+void anUnlinkedCellKeepsItsOwnLinks() {
+	begin("anUnlinkedCellKeepsItsOwnLinks");
+	auto cells = makeCells(3);
+	SkipLevel level;
+	std::vector<SkipEntry*> model;
+	for (int i = 0; i < 3; ++i) {
+		insertAt(level, model, i - 1, cells[i].get());
+	}
+
+	// The contract leaves them alone: they are no longer valid, and whoever reuses the
+	// cell overwrites them. What matters is that the level no longer reaches the cell.
+	unlinkAt(level, model, 1);
+	check(cells[1]->previous == cells[0].get() && cells[1]->next == cells[2].get(),
+	      "the unlinked cell's links are left as they were");
+	levelAgrees(level, model, "while the level skips over it");
+	end();
+}
+
+void linkingTouchesOnlyHorizontalLinks() {
+	begin("linkingTouchesOnlyHorizontalLinks");
+	auto cells = makeCells(3);
+	auto others = makeCells(6);
+	SkipLevel level;
+	std::vector<SkipEntry*> model;
+
+	// Give every cell vertical, cleanup and summary state that a level has no business
+	// changing, and a prefix summary the caller maintains.
+	for (int i = 0; i < 3; ++i) {
+		cells[i]->up = others[i].get();
+		cells[i]->down = others[i + 3].get();
+		cells[i]->newerForCleanup = others[(i + 4) % 6].get();
+		cells[i]->summary.maxCV = 100 + i;
+	}
+	level.prefixSummary().maxCV = 7;
+
+	insertAt(level, model, -1, cells[0].get());
+	insertAt(level, model, 0, cells[1].get());
+	insertAt(level, model, 0, cells[2].get());
+	unlinkAt(level, model, 1);
+
+	bool untouched = level.prefixSummary().maxCV.present() && level.prefixSummary().maxCV.get() == 7;
+	for (int i = 0; i < 3; ++i) {
+		untouched = untouched && cells[i]->up == others[i].get() &&
+		            cells[i]->down == others[i + 3].get() &&
+		            cells[i]->newerForCleanup == others[(i + 4) % 6].get() &&
+		            cells[i]->summary.maxCV.present() && cells[i]->summary.maxCV.get() == 100 + i &&
+		            cells[i]->recordCV == i;
+	}
+	check(untouched, "vertical links, cleanup links, summaries and data are as they were");
+	levelAgrees(level, model, "while the horizontal links moved");
+	end();
+}
+
+void randomEditsAgreeWithTheModel() {
+	begin("randomEditsAgreeWithTheModel");
+	constexpr int CELLS = 48;
+	constexpr int STEPS = 20000;
+	auto cells = makeCells(CELLS);
+	SkipLevel level;
+	std::vector<SkipEntry*> model;
+	std::vector<SkipEntry*> spare;
+	for (auto& c : cells) {
+		spare.push_back(c.get());
+	}
+
+	// A fixed seed, so a failure reproduces. Spare cells are reinserted with the links
+	// of their previous position still in them, as a recycled cell would be.
+	std::mt19937 random(20260927);
+	int insertions = 0, removals = 0;
+	bool agrees = true;
+	for (int step = 0; step < STEPS && agrees; ++step) {
+		const bool insert = model.empty() || (!spare.empty() && random() % 2 == 0);
+		if (insert) {
+			const size_t pick = random() % spare.size();
+			SkipEntry* entry = spare[pick];
+			spare.erase(spare.begin() + pick);
+			const int after = static_cast<int>(random() % (model.size() + 1)) - 1;
+			insertAt(level, model, after, entry);
+			++insertions;
+		} else {
+			const int position = static_cast<int>(random() % model.size());
+			spare.push_back(model[position]);
+			unlinkAt(level, model, position);
+			++removals;
+		}
+		agrees = levelAgrees(level, model, "the level agrees with the model after every edit");
+	}
+
+	bool tagsIntact = true;
+	for (int i = 0; i < CELLS; ++i) {
+		tagsIntact = tagsIntact && cells[i]->recordCV == i;
+	}
+	check(tagsIntact, "no cell was overwritten beyond its links");
+	bool spareUnmarked = true;
+	for (SkipEntry* e : spare) {
+		spareUnmarked = spareUnmarked && !e->linkedInLevel;
+	}
+	check(spareUnmarked, "and every cell outside the level is marked as unlinked");
+	check(insertions > STEPS / 3 && removals > STEPS / 3, "both operations were exercised");
+	end();
+}
+
+// ---------- TemporalSkipList ----------
+
+// Only an empty list is reachable from here: its levels are private and no insertion
+// exists yet, so a search can only be run over an empty list.
+
+void aNewSkipListIsEmpty() {
+	begin("aNewSkipListIsEmpty");
+	PagePool pool(1);
+	TemporalHeap heap(pool);
+	const TemporalSkipList points(ConflictKind::Point, heap);
+	const TemporalSkipList ranges(ConflictKind::Range, heap);
+	check(points.empty() && ranges.empty(), "a new list of either kind is empty");
+	check(pool.budget().heapPages == 0, "and building it takes no heap page");
+	end();
+}
+
+void searchingAnEmptyListStaysAtTheHeads() {
+	begin("searchingAnEmptyListStaysAtTheHeads");
+	PagePool pool(1);
+	TemporalHeap heap(pool);
+
+	for (ConflictKind kind : { ConflictKind::Point, ConflictKind::Range }) {
+		TemporalSkipList list(kind, heap);
+		const std::string key = "any key";
+		for (Version validationMinRV : { Version(0), Version(100) }) {
+			const SearchPath path = list.findInsertionPath(asRef(key), validationMinRV);
+
+			// One step per level, from the highest down to zero, each inserting at the head.
+			bool shape = path.steps.size() == size_t(TemporalSkipList::MaxLevels);
+			for (size_t i = 0; shape && i < path.steps.size(); ++i) {
+				shape = path.steps[i].level == Level(TemporalSkipList::MaxLevels - 1 - i) &&
+				        path.steps[i].predecessor == nullptr;
+			}
+			check(shape, "one step per level, highest first, all at the head");
+		}
+		check(list.empty(), "and searching leaves the list empty");
+	}
+	end();
+}
+
+// ---------- IndexPageAllocator ----------
+
+bool sameRef(const HeapRef& a, const HeapRef& b) {
+	return a.pageID == b.pageID && a.offset == b.offset && a.length == b.length;
+}
+
+uintptr_t pageBase(const void* p) {
+	return reinterpret_cast<uintptr_t>(p) & ~(uintptr_t(HISTORY_PAGE_BYTES) - 1);
+}
+
+// Acquires cells until the allocator takes a second page, and returns those of the
+// first. The page layout is private, so this is how a case learns how many cells a
+// page holds; the last cell returned belongs to the second page.
+std::vector<SkipEntry*> fillOneIndexPage(IndexPageAllocator& allocator,
+                                         const PagePool& pool,
+                                         const HeapRef& record,
+                                         SkipEntry*& firstOfNext) {
+	std::vector<SkipEntry*> cells;
+	const uint64_t before = pool.budget().indexPages;
+	while (true) {
+		SkipEntry* cell = allocator.acquire(ConflictKind::Point, 0, record, 1);
+		if (pool.budget().indexPages > before + 1) {
+			firstOfNext = cell;
+			return cells;
+		}
+		cells.push_back(cell);
+	}
+}
+
+void anAcquiredCellIsInitializedAndDetached() {
+	begin("anAcquiredCellIsInitializedAndDetached");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+	IndexPageAllocator allocator(pool);
+	const HeapRef record = rangeRecord(heap, 9, "b", "y");
+
+	SkipEntry* cell = allocator.acquire(ConflictKind::Range, 3, record, 9);
+	check(cell != nullptr, "a cell is handed out");
+	check(cell->kind == ConflictKind::Range && cell->level == 3 && sameRef(cell->record, record) &&
+	          cell->recordCV == 9,
+	      "carrying what it was given");
+	check(!cell->linkedInLevel && cell->previous == nullptr && cell->next == nullptr && cell->up == nullptr &&
+	          cell->down == nullptr && cell->newerForCleanup == nullptr,
+	      "detached, with every link null");
+	check(!cell->summary.maxCV.present() && cell->summary.maxEnd.state == MaxEndState::Empty &&
+	          !cell->summary.maxEnd.value.present(),
+	      "and an empty summary");
+	check(pool.budget().indexPages == 1, "the first cell took one index page");
+	checkBudget(pool, "budget invariant after the first cell");
+	end();
+}
+
+void aRecycledCellIsReinitialized() {
+	begin("aRecycledCellIsReinitialized");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+	IndexPageAllocator allocator(pool);
+	auto others = makeCells(5);
+	const HeapRef first = pointRecord(heap, 1, "first");
+	const HeapRef second = rangeRecord(heap, 2, "a", "z");
+
+	// Leave every field of the released cell dirty, as a cell leaving an index would be.
+	SkipEntry* cell = allocator.acquire(ConflictKind::Point, 5, first, 1);
+	cell->previous = others[0].get();
+	cell->next = others[1].get();
+	cell->up = others[2].get();
+	cell->down = others[3].get();
+	cell->newerForCleanup = others[4].get();
+	cell->summary.maxCV = 77;
+	cell->summary.maxEnd.state = MaxEndState::NeedsRepair;
+	allocator.release(cell);
+
+	SkipEntry* again = allocator.acquire(ConflictKind::Range, 2, second, 2);
+	check(again == cell, "the last released cell is the next handed out");
+	check(again->kind == ConflictKind::Range && again->level == 2 && sameRef(again->record, second) &&
+	          again->recordCV == 2,
+	      "with the new data");
+	check(again->previous == nullptr && again->next == nullptr && again->up == nullptr && again->down == nullptr &&
+	          again->newerForCleanup == nullptr && !again->linkedInLevel,
+	      "and none of the old links");
+	check(!again->summary.maxCV.present() && again->summary.maxEnd.state == MaxEndState::Empty,
+	      "nor the old summary");
+	end();
+}
+
+void cellsFillAPageWithoutOverlapping() {
+	begin("cellsFillAPageWithoutOverlapping");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+	IndexPageAllocator allocator(pool);
+	const HeapRef record = pointRecord(heap, 1, "k");
+
+	SkipEntry* firstOfNext = nullptr;
+	std::vector<SkipEntry*> cells = fillOneIndexPage(allocator, pool, record, firstOfNext);
+	check(cells.size() > 1, "a page holds more than one cell");
+	check(pool.budget().indexPages == 2, "one cell more than a page holds takes a second page");
+
+	std::vector<uintptr_t> addresses;
+	bool samePage = true, aligned = true;
+	for (SkipEntry* c : cells) {
+		addresses.push_back(reinterpret_cast<uintptr_t>(c));
+		samePage = samePage && pageBase(c) == pageBase(cells.front());
+		aligned = aligned && reinterpret_cast<uintptr_t>(c) % alignof(SkipEntry) == 0;
+	}
+	std::sort(addresses.begin(), addresses.end());
+	bool apart = true;
+	for (size_t i = 1; i < addresses.size(); ++i) {
+		apart = apart && addresses[i] - addresses[i - 1] >= sizeof(SkipEntry);
+	}
+	const bool inside = addresses.back() + sizeof(SkipEntry) <= pageBase(cells.front()) + HISTORY_PAGE_BYTES;
+	check(samePage && inside, "every cell of the first page lies inside it");
+	check(aligned, "every cell is aligned for its type");
+	check(apart, "and no two cells overlap");
+	check(pageBase(firstOfNext) != pageBase(cells.front()), "the next cell lies on the new page");
+	// The header precedes the cells, so none may start at the page's first byte.
+	check(addresses.front() > pageBase(cells.front()), "and the page header is left alone");
+	checkBudget(pool, "budget invariant after two index pages");
+	end();
+}
+
+void releasedCellsAreReusedBeforeANewPage() {
+	begin("releasedCellsAreReusedBeforeANewPage");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+	IndexPageAllocator allocator(pool);
+	const HeapRef record = pointRecord(heap, 1, "k");
+
+	SkipEntry* firstOfNext = nullptr;
+	std::vector<SkipEntry*> cells = fillOneIndexPage(allocator, pool, record, firstOfNext);
+	const size_t perPage = cells.size();
+
+	// Releasing never returns the page: the cells wait on the free list.
+	for (SkipEntry* c : cells) {
+		allocator.release(c);
+	}
+	check(pool.budget().indexPages == 2, "releasing cells keeps their page");
+
+	// The second page's free cells and the released ones are all reused before a third.
+	std::vector<SkipEntry*> again;
+	for (size_t i = 0; i < 2 * perPage - 1; ++i) {
+		again.push_back(allocator.acquire(ConflictKind::Range, 1, record, 1));
+	}
+	check(pool.budget().indexPages == 2, "every free cell is reused before a new page is taken");
+	std::sort(cells.begin(), cells.end());
+	std::sort(again.begin(), again.end());
+	check(std::includes(again.begin(), again.end(), cells.begin(), cells.end()),
+	      "and the released addresses are among them");
+	allocator.acquire(ConflictKind::Point, 0, record, 1);
+	check(pool.budget().indexPages == 3, "only then is a third page taken");
+	end();
+}
+
+void releaseEmptyPagesReturnsOnlyEmptyPages() {
+	begin("releaseEmptyPagesReturnsOnlyEmptyPages");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+	IndexPageAllocator allocator(pool);
+	const HeapRef record = pointRecord(heap, 1, "k");
+
+	check(allocator.releaseEmptyPages() == 0, "an allocator with no page returns none");
+
+	SkipEntry* keeper = nullptr;
+	std::vector<SkipEntry*> first = fillOneIndexPage(allocator, pool, record, keeper);
+	const size_t perPage = first.size();
+	for (SkipEntry* c : first) {
+		allocator.release(c);
+	}
+	// The first page is now empty; the second holds one live cell, the keeper.
+	check(allocator.releaseEmptyPages() == 1, "exactly the empty page is returned");
+	check(pool.budget().indexPages == 1, "and the pool gets it back");
+	checkBudget(pool, "budget invariant after returning a page");
+	check(allocator.releaseEmptyPages() == 0, "a page with a live cell stays");
+
+	// The returned page's cells must be gone from the free list: the next perPage - 1
+	// cells all come from the keeper's page, and only then is a new page taken.
+	bool onKeeperPage = true;
+	for (size_t i = 0; i + 1 < perPage; ++i) {
+		SkipEntry* c = allocator.acquire(ConflictKind::Point, 0, record, 1);
+		onKeeperPage = onKeeperPage && pageBase(c) == pageBase(keeper);
+	}
+	check(onKeeperPage, "the free list names no cell of the returned page");
+	check(pool.budget().indexPages == 1, "the keeper's page served them all");
+	allocator.acquire(ConflictKind::Point, 0, record, 1);
+	check(pool.budget().indexPages == 2, "and then a new page is taken");
+	end();
+}
+
+void releaseEmptyPagesReturnsTheNewestPageToo() {
+	begin("releaseEmptyPagesReturnsTheNewestPageToo");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+	IndexPageAllocator allocator(pool);
+	const HeapRef record = pointRecord(heap, 1, "k");
+
+	// Pages are listed newest first. Here the newest empties and the older one keeps a
+	// cell, so the list's head is what goes.
+	SkipEntry* firstOfNext = nullptr;
+	std::vector<SkipEntry*> older = fillOneIndexPage(allocator, pool, record, firstOfNext);
+	allocator.release(firstOfNext);
+	for (size_t i = 1; i < older.size(); ++i) {
+		allocator.release(older[i]);
+	}
+	check(allocator.releaseEmptyPages() == 1, "the empty newest page is returned");
+	check(pool.budget().indexPages == 1, "and only it");
+
+	// The older page is now the only one; empty it and it goes too.
+	allocator.release(older[0]);
+	check(allocator.releaseEmptyPages() == 1, "then the last page, once empty");
+	check(pool.budget().indexPages == 0, "leaving the allocator with none");
+	check(allocator.acquire(ConflictKind::Point, 0, record, 1) != nullptr, "and it can start again");
+	checkBudget(pool, "budget invariant after returning every page");
+	end();
+}
+
+void releaseFindsFreeCellsAnywhere() {
+	begin("releaseFindsFreeCellsAnywhere");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+	IndexPageAllocator allocator(pool);
+	const HeapRef record = pointRecord(heap, 1, "k");
+
+	SkipEntry* keeper = nullptr;
+	std::vector<SkipEntry*> first = fillOneIndexPage(allocator, pool, record, keeper);
+	const size_t perPage = first.size();
+	// A few more from the keeper's page, released between the first page's cells, so
+	// the page to return has cells at the head, in the middle and at the tail of the list.
+	std::vector<SkipEntry*> second;
+	for (int i = 0; i < 3; ++i) {
+		second.push_back(allocator.acquire(ConflictKind::Point, 0, record, 1));
+	}
+	std::mt19937 random(23);
+	std::shuffle(first.begin(), first.end(), random);
+	allocator.release(second[0]);
+	for (size_t i = 0; i < first.size(); ++i) {
+		allocator.release(first[i]);
+		if (i == first.size() / 2) {
+			allocator.release(second[1]);
+		}
+	}
+	allocator.release(second[2]);
+
+	check(allocator.releaseEmptyPages() == 1, "the empty page is returned");
+	bool onKeeperPage = true;
+	for (size_t i = 0; i + 1 < perPage; ++i) {
+		SkipEntry* c = allocator.acquire(ConflictKind::Point, 0, record, 1);
+		onKeeperPage = onKeeperPage && pageBase(c) == pageBase(keeper);
+	}
+	check(onKeeperPage, "and the free list keeps every cell of the other page, and none of its own");
+	check(pool.budget().indexPages == 1, "without taking a new page");
+	end();
+}
+
+void anExhaustedPoolMakesAcquireThrow() {
+	begin("anExhaustedPoolMakesAcquireThrow");
+	PagePool pool(1);
+	TemporalHeap heap(pool);
+	IndexPageAllocator allocator(pool);
+	const HeapRef record = pointRecord(heap, 1, "k"); // the heap takes the only page
+
+	bool threw = false;
+	try {
+		allocator.acquire(ConflictKind::Point, 0, record, 1);
+	} catch (const std::bad_alloc&) {
+		threw = true;
+	}
+	check(threw, "with no cell and no page, acquire throws bad_alloc");
+	check(pool.budget().indexPages == 0, "and takes nothing");
+	checkBudget(pool, "budget invariant after the failed acquire");
+	end();
+}
+
+void destroyingTheAllocatorReturnsEveryPage() {
+	begin("destroyingTheAllocatorReturnsEveryPage");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+	const HeapRef record = pointRecord(heap, 1, "k");
+	{
+		IndexPageAllocator allocator(pool);
+		SkipEntry* next = nullptr;
+		fillOneIndexPage(allocator, pool, record, next); // two pages, cells still live
+		check(pool.budget().indexPages == 2, "the allocator holds two pages");
+	}
+	check(pool.budget().indexPages == 0, "destruction returns both, live cells or not");
+	checkBudget(pool, "budget invariant after destruction");
+	IndexPageAllocator another(pool);
+	check(another.acquire(ConflictKind::Point, 0, record, 1) != nullptr, "and a new allocator can use them");
+	end();
+}
+
+// ---------- TemporalSkipList insertion ----------
+
+std::string largestKey() {
+	return std::string(8, '\xff');
+}
+
+// Reads every level back through the search: with a key larger than any inserted,
+// the predecessor at each level is that level's last cell, and walking back from it
+// visits the whole level. The default boundary, 0, removes nothing, since versions
+// start at 1; a higher one lets the search take out the expired towers it meets
+// before it reads their keys.
+std::vector<std::vector<SkipEntry*>> levelsOf(TemporalSkipList& list, Version validationMinRV = 0) {
+	const std::string top = largestKey();
+	const SearchPath path = list.findInsertionPath(asRef(top), validationMinRV);
+	std::vector<std::vector<SkipEntry*>> levels(TemporalSkipList::MaxLevels);
+	for (const SearchStep& step : path.steps) {
+		for (SkipEntry* e = step.predecessor; e != nullptr; e = e->previous) {
+			levels[step.level].push_back(e);
+		}
+		std::reverse(levels[step.level].begin(), levels[step.level].end());
+	}
+	return levels;
+}
+
+// A write as the model sees it: the key its cell orders by, the end for a range, its
+// version, and the order in which it was inserted.
+struct Written {
+	HeapRef record;
+	std::string key;
+	std::string end;
+	Version cv;
+	int sequence;
+};
+
+// The level-zero order the index must have: by key, equal keys in insertion order.
+std::vector<const Written*> expectedOrder(const std::vector<Written>& writes) {
+	std::vector<const Written*> order;
+	for (const Written& w : writes) {
+		order.push_back(&w);
+	}
+	std::stable_sort(order.begin(), order.end(), [](const Written* a, const Written* b) { return a->key < b->key; });
+	return order;
+}
+
+StringRef endOf(const TemporalHeap& heap, const SkipEntry* e) {
+	return rangeAt(heap, e->record, "a range cell's record is readable").end;
+}
+
+// Every level is in key order, every cell above zero sits on the copy of the same
+// record below it, each level is a subsequence of the one below, and every cell is
+// marked, knows its level, and has no copy above the top of its tower.
+//
+// Keys are read only for live cells, those above validationMinRV: an expired cell the
+// search has not met yet may name a record whose page is gone.
+bool towersAreSound(const TemporalSkipList& list,
+                    const TemporalHeap& heap,
+                    const std::vector<std::vector<SkipEntry*>>& levels,
+                    Version validationMinRV = 0) {
+	bool sound = true;
+	for (int L = 0; L < TemporalSkipList::MaxLevels; ++L) {
+		size_t below = 0;
+		Optional<StringRef> lastLiveKey;
+		for (size_t i = 0; sound && i < levels[L].size(); ++i) {
+			SkipEntry* e = levels[L][i];
+			sound = e->linkedInLevel && e->level == L;
+			if (sound && e->recordCV > validationMinRV) {
+				const StringRef key = e->beginWriteKey(heap);
+				sound = !lastLiveKey.present() || !(key < lastLiveKey.get());
+				lastLiveKey = key;
+			}
+			if (sound && L > 0) {
+				sound = e->down != nullptr && e->down->up == e && sameRef(e->down->record, e->record) &&
+				        e->down->recordCV == e->recordCV;
+				while (sound && below < levels[L - 1].size() && levels[L - 1][below] != e->down) {
+					++below;
+				}
+				sound = sound && below < levels[L - 1].size();
+			}
+			if (sound && (L + 1 == TemporalSkipList::MaxLevels)) {
+				sound = e->up == nullptr;
+			}
+		}
+	}
+	return sound;
+}
+
+// Each span's summary bounds the live writes it covers: a cell at level L covers the
+// level-zero cells from its own tower up to, not including, the next tower at L.
+// maxCV must be at least every live version in the span. For ranges, a Valid maxEnd
+// must be readable and at least every live end in the span; NeedsRepair is allowed,
+// Empty is not, since the span holds its own record. A Valid maxEnd whose source is
+// at or below validationMinRV is not a usable bound, as the design says, and its bytes
+// may be gone; it is not read. With `exact`, a level-zero
+// summary must also be exactly its own record's: that holds while nothing has been
+// removed, since removal folds the removed cell's summary into its predecessor and
+// leaves a conservative bound. Level prefixes are private and not checked.
+bool summariesBoundTheirSpans(ConflictKind kind,
+                              const TemporalHeap& heap,
+                              const std::vector<std::vector<SkipEntry*>>& levels,
+                              Version validationMinRV,
+                              bool exact) {
+	bool bounded = true;
+	const std::vector<SkipEntry*>& zero = levels[0];
+	for (int L = 0; bounded && L < TemporalSkipList::MaxLevels; ++L) {
+		for (size_t i = 0; bounded && i < levels[L].size(); ++i) {
+			SkipEntry* e = levels[L][i];
+			SkipEntry* base = e;
+			while (base->down != nullptr) {
+				base = base->down;
+			}
+			SkipEntry* stop = nullptr;
+			if (i + 1 < levels[L].size()) {
+				stop = levels[L][i + 1];
+				while (stop->down != nullptr) {
+					stop = stop->down;
+				}
+			}
+			const SpanSummary& s = e->summary;
+			bounded = s.maxCV.present();
+			Optional<StringRef> maxEnd;
+			if (bounded && kind == ConflictKind::Range) {
+				bounded = s.maxEnd.state != MaxEndState::Empty;
+				if (bounded && s.maxEnd.state == MaxEndState::Valid) {
+					bounded = s.maxEnd.value.present();
+					if (bounded && s.maxEnd.value.get().sourceCV > validationMinRV) {
+						maxEnd = heap.getKey(s.maxEnd.value.get().key);
+						bounded = maxEnd.present();
+					}
+				}
+			}
+			for (SkipEntry* c = base; bounded && c != stop; c = c->next) {
+				if (c->recordCV <= validationMinRV) {
+					continue;
+				}
+				bounded = s.maxCV.get() >= c->recordCV;
+				if (bounded && maxEnd.present()) {
+					bounded = !(maxEnd.get() < endOf(heap, c));
+				}
+			}
+			if (bounded && exact && L == 0) {
+				bounded = s.maxCV.get() == e->recordCV;
+				if (bounded && maxEnd.present()) {
+					bounded = maxEnd.get() == endOf(heap, e);
+				}
+			}
+		}
+	}
+	(void)zero;
+	return bounded;
+}
+
+// One index with everything it needs, as TemporalConflictSet will hold it.
+struct Index {
+	PagePool pool;
+	TemporalHeap heap;
+	IndexPageAllocator allocator;
+	CleanupList cleanup;
+	TemporalSkipList list;
+	std::vector<Written> writes;
+	std::vector<std::vector<SkipEntry*>> towers; // each insert's cells, bottom first
+
+	explicit Index(ConflictKind kind, uint64_t pages = 64)
+	  : pool(pages), heap(pool), allocator(pool), list(kind, heap) {}
+
+	// Inserts one write; the tower is recovered from the queue's new cells.
+	void add(const std::string& key, const std::string& end, Version cv, Version validationMinRV = 0) {
+		const HeapRef record = end.empty() ? pointRecord(heap, cv, key) : rangeRecord(heap, cv, key, end);
+		writes.push_back({ record, key, end, cv, static_cast<int>(writes.size()) });
+		list.insert(record, cv, validationMinRV, allocator, cleanup);
+	}
+};
+
+std::string randomKey(std::mt19937& random, int alphabet, int maxLength) {
+	std::string key;
+	const int length = 1 + static_cast<int>(random() % maxLength);
+	for (int i = 0; i < length; ++i) {
+		key.push_back(static_cast<char>('a' + random() % alphabet));
+	}
+	return key;
+}
+
+void aFirstInsertionMakesOneTower() {
+	begin("aFirstInsertionMakesOneTower");
+	Index index(ConflictKind::Point);
+	index.add("only", "", 5);
+
+	const auto levels = levelsOf(index.list);
+	check(!index.list.empty(), "the list is no longer empty");
+	if (!check(levels[0].size() == 1, "level zero holds the one cell")) {
+		return end();
+	}
+	SkipEntry* bottom = levels[0][0];
+	check(sameRef(bottom->record, index.writes[0].record) && bottom->recordCV == 5, "naming the write");
+	int height = 0;
+	for (SkipEntry* e = bottom; e != nullptr; e = e->up) {
+		++height;
+	}
+	bool oneTower = true;
+	for (int L = 0; L < TemporalSkipList::MaxLevels; ++L) {
+		oneTower = oneTower && levels[L].size() == (L < height ? 1u : 0u);
+	}
+	check(oneTower, "every level up to the tower's height holds its one copy, and none above");
+	check(towersAreSound(index.list, index.heap, levels), "and the tower is sound");
+
+	// The queue holds exactly the tower, bottom first.
+	bool queued = true;
+	for (SkipEntry* e = bottom; e != nullptr; e = e->up) {
+		queued = queued && !index.cleanup.empty() && index.cleanup.popOldest() == e;
+	}
+	check(queued && index.cleanup.empty(), "and the cleanup queue holds its cells, bottom first");
+	end();
+}
+
+void insertionsKeepKeyOrder() {
+	begin("insertionsKeepKeyOrder");
+	Index index(ConflictKind::Point);
+	std::mt19937 random(20260927);
+	for (int i = 0; i < 600; ++i) {
+		index.add(randomKey(random, 4, 3), "", i + 1);
+	}
+
+	const auto levels = levelsOf(index.list);
+	const auto expected = expectedOrder(index.writes);
+	bool ordered = levels[0].size() == expected.size();
+	for (size_t i = 0; ordered && i < expected.size(); ++i) {
+		ordered = sameRef(levels[0][i]->record, expected[i]->record);
+	}
+	check(ordered, "level zero holds every write, by key, equal keys in insertion order");
+	check(towersAreSound(index.list, index.heap, levels), "and every tower is sound");
+	check(levels[1].size() > 0 && levels[1].size() < levels[0].size(), "some towers were promoted, not all");
+	end();
+}
+
+void equalKeysKeepInsertionOrder() {
+	begin("equalKeysKeepInsertionOrder");
+	Index index(ConflictKind::Point);
+	for (int i = 0; i < 40; ++i) {
+		index.add(i % 2 == 0 ? "same" : "other", "", i + 1);
+	}
+	const auto levels = levelsOf(index.list);
+	bool ordered = levels[0].size() == 40;
+	for (size_t i = 1; ordered && i < levels[0].size(); ++i) {
+		const bool sameKey = levels[0][i]->beginWriteKey(index.heap) == levels[0][i - 1]->beginWriteKey(index.heap);
+		ordered = !sameKey || levels[0][i]->recordCV > levels[0][i - 1]->recordCV;
+	}
+	check(ordered, "cells with the same key follow each other in the order they were inserted");
+	end();
+}
+
+void theQueueHoldsEveryCellInInsertionOrder() {
+	begin("theQueueHoldsEveryCellInInsertionOrder");
+	Index index(ConflictKind::Point);
+	std::mt19937 random(7);
+	for (int i = 0; i < 300; ++i) {
+		index.add(randomKey(random, 5, 3), "", i + 1);
+	}
+
+	// Each write's tower, bottom first, in the order the writes were made.
+	std::vector<const SkipEntry*> expected;
+	const auto levels = levelsOf(index.list);
+	std::vector<const SkipEntry*> bottomOf(index.writes.size(), nullptr);
+	for (SkipEntry* e : levels[0]) {
+		bottomOf[e->recordCV - 1] = e;
+	}
+	for (const SkipEntry* b : bottomOf) {
+		for (const SkipEntry* e = b; e != nullptr; e = e->up) {
+			expected.push_back(e);
+		}
+	}
+	bool inOrder = !expected.empty();
+	for (const SkipEntry* e : expected) {
+		inOrder = inOrder && !index.cleanup.empty() && index.cleanup.popOldest() == e;
+	}
+	check(inOrder, "the queue holds every cell of every tower, write by write, bottom first");
+	check(index.cleanup.empty(), "and nothing else");
+	end();
+}
