+void searchesWaitingAtDifferentLevelsSurviveUnlinking() {
+	begin("searchesWaitingAtDifferentLevelsSurviveUnlinking");
+	onFreshThread([] {
+		TemporalConflictSet set(8, 0);
+		LevelMirror mirror;
+		writePoint(set, mirror, 3, 1, "m");
+		writePoint(set, mirror, 3, 10, "a");
+		writePoint(set, mirror, 2, 11, "z");
+		writePoint(set, mirror, 1, 12, "n");
+		writePoint(set, mirror, 1, 13, "p");
+		set.validationMinRV_ = 5;
+		TemporalSkipList& points = set.points_;
+		SkipEntry* bottom = cellAt(points, 0, 1);
+		SkipEntry* top = cellAt(points, 2, 1);
+		if (!check(bottom != nullptr && top != nullptr && levelVersions(points, 2) == (std::vector<Version>{ 10, 1 }) &&
+		               levelVersions(points, 1) == (std::vector<Version>{ 10, 1, 11 }) &&
+		               levelVersions(points, 0) == (std::vector<Version>{ 10, 1, 12, 13, 11 }),
+		           "the expired tower m reaches level 2, between a and the rest")) {
+			return;
+		}
+
+		// One search waits on m's top cell while descending; another waits on m's bottom cell
+		// while scanning, having started left of every key
+		PointQuery high{ 5, "n"_sr, "o"_sr }, low{ 11, "0"_sr, "zz"_sr }, b{ 20, "b"_sr, "c"_sr };
+		PointSearch waitingHigh, waitingLow, unlinking;
+		points.startPointSearch(waitingHigh, high);
+		points.startPointSearch(waitingLow, low);
+		check(stepUntilWaitingOn(points, waitingHigh, top, false, 5) && waitingHigh.level == 2,
+		      "one search waits on the expired tower at level 2");
+		check(stepUntilWaitingOn(points, waitingLow, bottom, false, 5) && waitingLow.level == 0 && waitingLow.scanning,
+		      "another waits on it at level 0");
+		check(!towerUnlinked(bottom), "the tower is still linked");
+		const uint64_t transfers = points.summaryTransfers();
+
+		points.startPointSearch(unlinking, b);
+		check(runToEnd(points, unlinking, 5) && !b.conflict, "a third search meets the tower at its top and unlinks it");
+		check(towerUnlinked(bottom) && points.summaryTransfers() == transfers + 3, "all three cells, one transfer each");
+
+		check(runToEnd(points, waitingHigh, 5) && high.conflict, "the search waiting at level 2 finds n");
+		check(runToEnd(points, waitingLow, 5) && low.conflict, "the one waiting at level 0 finds n too");
+		check(points.summaryTransfers() == transfers + 3, "and neither transfers anything again");
+		check(indexesAreSound(set), "the index is sound");
+	});
+	end();
+}
