+void rightFragmentRefreshesAncestorMinimum() {
+    Tree tree(256, 0);
+    for (unsigned i = 0; i < 1500; ++i)
+        tree.addRange(1, sv(key(4 * i)), sv(key(4 * i + 2)));
+    CHECK(tree.height() >= 3 && tree.root_->size() >= 2);
+    Tree::Node* right = tree.root_->at(1).payload.link.child;
+    while (!right->leaf) right = right->at(0).payload.link.child;
+    Tree::Node* left = right->navigation.leaf.previous;
+    CHECK(left && left->parent != right->parent);
+    if (left->critical) {
+        tree.eraseSlot(left, left->size() - 1);
+        tree.refreshUp(left);
+    }
+    CHECK(!left->critical);
+    const unsigned rightSlot = right->order.slotAt(0);
+    const auto oldRight = right->slots[rightSlot];
+    std::string begin = entryBytes(tree, left->at(left->size() - 1)) + '\x01';
+    std::string end = entryBytes(tree, oldRight) + '\x01';
+    const auto before = tree.stats();
+    tree.addRange(2, sv(begin), sv(end));
+    CHECK(right->allocated);
+    CHECK(right->order.slotAt(0) == rightSlot);
+    CHECK(entryBytes(tree, right->slots[rightSlot]) == end);
+    CHECK(right->slots[rightSlot].cv == oldRight.cv && sameRef(right->slots[rightSlot].end, oldRight.end));
+    CHECK(tree.stats().intervalInsertions == before.intervalInsertions + 1);
+    if constexpr (Tree::Stats::searchEnabled) CHECK(tree.stats().writeRootSearches == before.writeRootSearches + 1);
+    const auto fresh = entryAt(tree, begin);
+    CHECK(sameRef(right->slots[rightSlot].begin, fresh.end));
+    CHECK(tree.hasConflict(1, sv(begin), sv(end)));
+    CHECK(!tree.hasConflict(1, sv(end), sv(entryBytes(tree, oldRight, true))));
+    verify(tree);
+}
