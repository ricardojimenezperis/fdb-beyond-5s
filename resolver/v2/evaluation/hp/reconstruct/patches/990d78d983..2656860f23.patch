+void blockReaderOrderedModel() {
+    Tree tree(512, 0);
+    const std::string prefix(Tree::InlineKeyBytes + 80, 'k');
+    auto k = [&](unsigned n) { return prefix + key(n); };
+    for (unsigned i = 0; i < 1200; ++i) {
+        if (i % 3) tree.addRange(3 + i / 300, sv(k(8*i)), sv(k(8*i+5)));
+        else tree.addPoint(3 + i / 300, sv(k(8*i)));
+    }
+    std::vector<std::string> storage; storage.reserve(10000);
+    std::vector<Tree::Query> original;
+    auto add = [&](Version rv, std::string begin, std::string end) {
+        storage.push_back(std::move(begin)); storage.push_back(std::move(end));
+        original.push_back({rv, sv(storage[storage.size()-2]), sv(storage.back()), false});
+    };
+    for (unsigned i = 0; i < 1800; ++i) {
+        const unsigned b = (i*19) % 9600;
+        add(i % 8, k(b), k(b + (i%7 ? 1 : 1700)));
+    }
+    for (unsigned i = 1; i < 1200; i += 17) {
+        add(0, k(8*i+5), k(8*i+6));
+        add(0, k(8*i+2), k(8*i+5));
+    }
+    add(100, "", k(12000)); add(4, k(0), k(12000));
+    add(0, k(16), k(16)); add(0, k(20), k(16));
+    const auto stored = contents(tree);
+    std::vector<bool> expected;
+    for (const auto& q : original) expected.push_back(referenceConflict(stored, q.readVersion, bytes(q.begin), bytes(q.end)));
+    for (unsigned group : {2u, 3u}) {
+        for (size_t budget : {size_t(4096), size_t(65536), size_t(1024*1024)}) {
+            auto queries = original;
+            Tree::ReadPipelineConfig cfg; cfg.sweepGroupSize = group;
+            cfg.l2Bytes = budget; cfg.l2ReserveBytes = 0;
+            tree.hasConflicts(queries.data(), queries.size(), cfg);
+            for (size_t q = 0; q < queries.size(); ++q) CHECK(queries[q].conflict == expected[q]);
+            CHECK(tree.openQueries_.empty());
+            for (const auto& block : tree.readBlocks_) for (const auto& state : block.nodes) CHECK(state.heap == 0);
+            if constexpr (Tree::Stats::searchEnabled) {
+                const auto& st = tree.readPipelineStats();
+                CHECK(st.groupSweepComparisons == st.endpointBoundaryComparisons);
+            }
+        }
+    }
+    verify(tree);
+}
+void blockReaderLongSuffixes() {
+    Tree tree(128, 0);
+    const std::string prefix(Tree::InlineKeyBytes + 160, 'p');
+    std::vector<std::string> begins, ends;
+    for (unsigned i = 0; i < 80; ++i) {
+        begins.push_back(prefix + std::to_string(10000 + 4 * i));
+        ends.push_back(prefix + std::to_string(10002 + 4 * i));
+        if (i < 64) tree.addRange(7, sv(begins.back()), sv(ends.back()));
+    }
+    for (unsigned group : {2u, 3u}) {
+        for (unsigned repeat = 0; repeat < 2; ++repeat) {
+            std::vector<Tree::Query> queries;
+            for (unsigned q = 0; q < 320; ++q)
+                queries.push_back({q % 3 ? 0 : 8, sv(begins[q % 80]), sv(ends[q % 80]), false});
+            Tree::ReadPipelineConfig cfg; cfg.sweepGroupSize = group;
+            cfg.l2Bytes = 8192; cfg.l2ReserveBytes = 0;
+            tree.hasConflicts(queries.data(), queries.size(), cfg);
+            for (size_t q = 0; q < queries.size(); ++q)
+                CHECK(queries[q].conflict == (q % 80 < 64 && q % 3 != 0));
+            for (const auto& buffer : tree.readBlocks_) for (const auto& state : buffer.nodes) CHECK(state.heap == 0);
+            if constexpr (Tree::Stats::searchEnabled) {
+                const auto& st = tree.readPipelineStats();
+                CHECK(st.breadthHeapResolutions > 0);
+                CHECK(st.breadthQueryLines == 0);
+                CHECK(st.breadthHeapLines == 2 * st.breadthHeapResolutions);
+            }
+        }
+    }
+    verify(tree);
+}
