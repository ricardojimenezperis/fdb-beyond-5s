+// A write as the model sees it: a point is the range [key, key)
+struct ModelWrite {
+	bool isRange;
+	std::string from, to;
+	Version cv;
+};
+
+// The answer from the writes alone, without summaries, paths or the code under test
+bool modelConflict(const std::vector<ModelWrite>& writes, Version readVersion, const std::string& from,
+                   const std::string& to, int kinds) {
+	if (!(from < to)) {
+		return false;
+	}
+	for (const ModelWrite& w : writes) {
+		if (w.cv <= readVersion) {
+			continue;
+		}
+		if (!w.isRange && (kinds & 1) && from <= w.from && w.from < to) {
+			return true;
+		}
+		if (w.isRange && (kinds & 2) && w.from < to && w.to > from) {
+			return true;
+		}
+	}
+	return false;
+}
+
+constexpr int POINTS = 1, RANGES = 2, BOTH = 3;
+
+void answersSurviveRepairMarksSearchesAndCleanup() {
+	begin("answersSurviveRepairMarksSearchesAndCleanup");
+	onFreshThread([] {
+		std::mt19937 random(71);
+		TemporalConflictSet set(16, 0);
+		std::vector<ModelWrite> writes;
+		for (Version cv = 1; cv <= 400; ++cv) {
+			std::string a = randomKey(random, 6, 4);
+			std::string b = a + randomKey(random, 6, 1);
+			if (random() % 2 == 0) {
+				set.addPoint(cv, asRef(a));
+				writes.push_back({ false, a, a, cv });
+			} else {
+				if (a == b) {
+					b += "a";
+				}
+				if (b < a) {
+					std::swap(a, b);
+				}
+				set.addRange(cv, asRef(a), asRef(b));
+				writes.push_back({ true, a, b, cv });
+			}
+		}
+		struct Query {
+			Version rv;
+			std::string from, to;
+		};
+		std::vector<Query> queries;
+		for (int i = 0; i < 300; ++i) {
+			// Mostly narrow reads, some wide, so both answers occur
+			std::string a = randomKey(random, 6, 4);
+			std::string b = random() % 6 == 0 ? randomKey(random, 6, 4) : a + randomKey(random, 6, 1);
+			if (b < a) {
+				std::swap(a, b);
+			}
+			const Version rv = 340 + Version(random() % 60);
+			queries.push_back({ rv, a, b });
+		}
+		int positives = 0;
+		for (const Query& q : queries) {
+			positives += modelConflict(writes, q.rv, q.from, q.to, BOTH);
+		}
+		check(positives > 60 && positives < 240, "the queries include both answers, each at least a fifth");
+
+
+		auto round = [&](const char* when) {
+			int wrong = 0;
+			for (const Query& q : queries) {
+				const bool expected = modelConflict(writes, q.rv, q.from, q.to, BOTH);
+				wrong += !answers(ownerConflict(set, q.rv, q.from, q.to), expected);
+				wrong += rangeConflict(set, q.rv, q.from, q.to) != modelConflict(writes, q.rv, q.from, q.to, RANGES);
+			}
+			check(wrong == 0, when);
+		};
+		round("the first answers agree with the model");
+		round("repeated, they agree again");
+
+		int marked = 0;
+		for (int L = 0; L < TemporalSkipList::MaxLevels; ++L) {
+			markForRepair(set.ranges_.levels_[L].prefixSummary());
+			for (SkipEntry* e = set.ranges_.levels_[L].first_; e != nullptr; e = e->next) {
+				if (random() % 3 == 0) {
+					markForRepair(e->summary);
+					++marked;
+				}
+			}
+		}
+		check(marked > 50, "many summaries were marked for repair");
+		round("after marking summaries for repair they agree");
+
+		// Point searches unlink expired towers; every query stays at or above the boundary
+		set.validationMinRV_ = 150;
+		const size_t linkedBefore = levelCells(set.points_, 0).size();
+		for (const Query& q : queries) {
+			pointConflict(set, q.rv, q.from, q.to);
+		}
+		check(levelCells(set.points_, 0).size() < linkedBefore, "the point searches unlinked expired towers");
+		round("after point searches unlinked towers they agree");
+
+		set.cleanup();
+		set.cleanup();
+		check(set.cleanup_.oldestCV() > 1, "cleanup recycled expired towers");
+		round("after cleanup they agree");
+		check(indexesAreSound(set) && accountingHolds(set, cellsPerIndexPage()), "and the structures stay sound");
+	});
+	end();
+}
+
+void conflictsAgreeWithAModelUnderReclamation() {
+	begin("conflictsAgreeWithAModelUnderReclamation");
+	std::vector<std::string> stats;
+	for (uint32_t seed : { 1u, 2u, 3u, 4u }) {
+		onFreshThread([seed, &stats] {
+			std::mt19937 random(seed);
+			const size_t perPage = cellsPerIndexPage();
+			TemporalConflictSet set(8, 0);
+			std::vector<ModelWrite> writes;
+			std::vector<std::string> log;
+			int queries = 0, positives = 0, tooOld = 0, wrong = 0;
+			auto key = [&] {
+				const std::string prefix = randomKey(random, 6, 3);
+				return paddedKey(prefix, random() % 700);
+			};
+			// Narrow unless wide: a key and the same key with one more character
+			auto after = [&](const std::string& from) {
+				const std::string tail = randomKey(random, 6, 1);
+				return random() % 4 == 0 ? key() : from + tail;
+			};
+			Version cv = 0;
+			for (int op = 0; op < 6000 && wrong == 0; ++op) {
+				const uint32_t dice = random() % 100;
+				if (dice < 45) {
+					++cv;
+					std::string a = key();
+					std::string b = after(a);
+					if (dice < 25) {
+						set.addPoint(cv, asRef(a));
+						writes.push_back({ false, a, a, cv });
+						log.push_back(printed("%d point %lld [%s]", op, (long long)cv, a.c_str()));
+					} else {
+						if (a == b) {
+							b += "a";
+						}
+						if (b < a) {
+							std::swap(a, b);
+						}
+						set.addRange(cv, asRef(a), asRef(b));
+						writes.push_back({ true, a, b, cv });
+						log.push_back(printed("%d range %lld [%s, %s)", op, (long long)cv, a.c_str(), b.c_str()));
+					}
+				} else if (dice < 50) {
+					set.cleanup();
+					log.push_back(printed("%d cleanup", op));
+				} else {
+					const Version boundary = set.validationMinRV();
+					std::string a = key();
+					std::string b = dice < 53 ? a : after(a);
+					if (b < a) {
+						std::swap(a, b);
+					}
+					if (dice < 56 && boundary > 0) {
+						++tooOld;
+						const bool rejected = !ownerConflict(set, boundary - 1, a, b).present();
+						log.push_back(printed("%d too old %lld", op, (long long)(boundary - 1)));
+						if (!rejected) {
+							++wrong;
+							caseMessages.push_back(printed("seed %u op %d: a read below the boundary was admitted", seed, op));
+						}
+						continue;
+					}
+					// Near the newest writes, where conflicts are neither certain nor rare
+					const Version window = std::min<Version>(cv - boundary, 200);
+					const Version rv = cv - Version(random() % (window + 1));
+					const bool expected = modelConflict(writes, rv, a, b, BOTH);
+					const int kinds = dice < 70 ? POINTS : dice < 85 ? RANGES : BOTH;
+					bool actual;
+					if (kinds == POINTS) {
+						actual = pointConflict(set, rv, a, b);
+					} else if (kinds == RANGES) {
+						actual = rangeConflict(set, rv, a, b);
+					} else {
+						const Optional<bool> answer = ownerConflict(set, rv, a, b);
+						actual = answer.present() && answer.get();
+					}
+					const bool expectedHere = kinds == BOTH ? expected : modelConflict(writes, rv, a, b, kinds);
+					++queries;
+					positives += expectedHere;
+					log.push_back(printed("%d query kinds=%d rv=%lld boundary=%lld [%s, %s) -> %d", op, kinds,
+					                     (long long)rv, (long long)boundary, a.c_str(), b.c_str(), actual));
+					if (actual != expectedHere) {
+						++wrong;
+						caseMessages.push_back(printed("seed %u op %d: expected %d, got %d; last operations:", seed, op,
+						                              expectedHere, actual));
+						for (size_t i = log.size() > 12 ? log.size() - 12 : 0; i < log.size(); ++i) {
+							caseMessages.push_back("  " + log[i]);
+						}
+					}
+				}
+			}
+			check(wrong == 0, "every answer agrees with the model");
+			check(set.heap_.lastReclaimedPageID() >= 5, "through at least five reclamations of history");
+			check(queries > 2000 && positives * 5 > queries && (queries - positives) * 5 > queries,
+			      "with both answers, each at least a fifth of the admitted queries");
+			check(tooOld > 50, "and reads below the boundary rejected");
+			check(indexesAreSound(set) && accountingHolds(set, perPage), "the structures stay sound and accounted");
+			stats.push_back(printed("\tseed %u: %d admitted queries, %d conflicts, %d too old, %llu pages reclaimed", seed,
+			                        queries, positives, tooOld, (unsigned long long)set.heap_.lastReclaimedPageID()));
+		});
+	}
+	end();
+	for (const std::string& line : stats) {
+		printf("%s\n", line.c_str());
+	}
+}
+
+// ---------- Interleaved point searches ----------
+//
+// hasPointConflicts runs several point searches at once, one step each in turn, and a step
+// may unlink expired towers another search is waiting on. These cases stop a search at a
+// chosen point, let another search unlink what it is waiting on, and resume it. Heights are
+// steered, and every count of summary transfers is exact: a cell's summary moves once, when
+// it leaves its level, however many searches find its tower expired
+
+using PointSearch = TemporalSkipList::PointSearch;
+using PointQuery = TemporalSkipList::PointQuery;
+
+// Steps a search until it waits on `cell`: with the cell not yet read, or, when `record` is
+// set, with the cell read and its record next. False if the search finishes first
+bool stepUntilWaitingOn(TemporalSkipList& list, PointSearch& s, const SkipEntry* cell, bool record, Version boundary) {
+	for (int i = 0; i < 100000; ++i) {
+		if (s.current == cell && s.recordPending == record) {
+			return true;
+		}
+		if (list.stepPointSearch(s, boundary)) {
+			return false;
+		}
+	}
+	return false;
+}
+
+bool runToEnd(TemporalSkipList& list, PointSearch& s, Version boundary) {
+	for (int i = 0; i < 100000; ++i) {
+		if (list.stepPointSearch(s, boundary)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+SkipEntry* cellAt(const TemporalSkipList& list, int level, Version cv) {
+	for (SkipEntry* e = list.levels_[level].first_; e != nullptr; e = e->next) {
+		if (e->recordCV == cv) {
+			return e;
+		}
+	}
+	return nullptr;
+}
+
+bool towerUnlinked(SkipEntry* bottom) {
+	for (SkipEntry* e = bottom; e != nullptr; e = e->up) {
+		if (e->linkedInLevel) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void aSearchPausedOnAnExpiredCellResumesAfterAnotherUnlinksIt() {
+	begin("aSearchPausedOnAnExpiredCellResumesAfterAnotherUnlinksIt");
+	onFreshThread([] {
+		TemporalConflictSet set(8, 0);
+		LevelMirror mirror;
+		writePoint(set, mirror, 1, 1, "b");
+		writePoint(set, mirror, 1, 10, "a");
+		writePoint(set, mirror, 1, 11, "c");
+		writePoint(set, mirror, 1, 12, "d");
+		set.validationMinRV_ = 5;
+		TemporalSkipList& points = set.points_;
+		SkipEntry* expired = cellAt(points, 0, 1);
+		if (!check(expired != nullptr && levelVersions(points, 0) == (std::vector<Version>{ 10, 1, 11, 12 }),
+		           "level zero holds a, the expired b, c and d")) {
+			return;
+		}
+
+		PointQuery a{ 5, "b"_sr, "d"_sr }, b{ 20, "a"_sr, "z"_sr };
+		PointSearch waiting, unlinking;
+		points.startPointSearch(waiting, a);
+		check(stepUntilWaitingOn(points, waiting, expired, false, 5), "the first search waits to read the expired cell");
+		const uint64_t transfers = points.summaryTransfers();
+
+		points.startPointSearch(unlinking, b);
+		check(runToEnd(points, unlinking, 5) && !b.conflict, "a second search runs to its end, finding nothing");
+		check(towerUnlinked(expired) && points.summaryTransfers() == transfers + 1,
+		      "and unlinks the expired tower, transferring its one summary");
+
+		check(runToEnd(points, waiting, 5) && a.conflict, "the first search resumes and finds c");
+		check(points.summaryTransfers() == transfers + 1, "without transferring the unlinked cell's summary again");
+		check(levelVersions(points, 0) == (std::vector<Version>{ 10, 11, 12 }) && indexesAreSound(set),
+		      "the index is sound");
+	});
+	end();
+}
