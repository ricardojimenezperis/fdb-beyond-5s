+struct AgeSnapshot {
+    std::map<uint32_t, Version> main, exceptions;
+};
+
+AgeSnapshot checkAges(const PagePool& pool) {
+    AgeSnapshot snapshot;
+    uint32_t previous = NoAge;
+    Version last = std::numeric_limits<Version>::lowest();
+    for (uint32_t id = pool.oldestAge_; id != NoAge; id = pool.ageEntry(id).next) {
+        const auto& entry = pool.ageEntry(id);
+        CHECK(entry.previous == previous && entry.previous != id && entry.maxCV >= last);
+        CHECK(!pool.ageException(id));
+        const ReclaimLink* link = pool.ageObject(id);
+        CHECK(link && link->ageLinked && link->ageIndex == id && link->maxCV == entry.maxCV);
+        CHECK(snapshot.main.emplace(id, entry.maxCV).second);
+        last = entry.maxCV;
+        previous = id;
+    }
+    CHECK(previous == pool.newestAge_);
+    for (size_t position = 0; position < pool.exceptionAges_.size(); ++position) {
+        const uint32_t id = pool.exceptionAges_[position];
+        const auto& entry = pool.ageEntry(id);
+        CHECK(pool.ageException(id) && entry.next == position);
+        if (position) CHECK(!pool.exceptionLess(id, pool.exceptionAges_[(position - 1) / 2]));
+        const ReclaimLink* link = pool.ageObject(id);
+        CHECK(link && link->ageLinked && link->ageIndex == id && link->maxCV == entry.maxCV);
+        CHECK(!snapshot.main.count(id) && snapshot.exceptions.emplace(id, entry.maxCV).second);
+    }
+    CHECK(pool.exceptionAgeCount() == snapshot.exceptions.size());
+    CHECK(pool.exceptionAgeStats().peak >= snapshot.exceptions.size());
+    CHECK(pool.exceptionAgeMetadataBytes() == pool.exceptionAges_.capacity() * sizeof(uint32_t) +
+                                                  sizeof(pool.exceptionAges_) + sizeof(pool.exceptionStats_));
+    std::set<uint32_t> visited;
+    pool.forEachAge([&](const ReclaimLink* link) { CHECK(link->ageLinked && visited.insert(link->ageIndex).second); });
+    CHECK(visited.size() == snapshot.main.size() + snapshot.exceptions.size());
+    for (uint32_t id : visited) CHECK(snapshot.main.count(id) + snapshot.exceptions.count(id) == 1);
+    const ReclaimLink* oldest = pool.oldestAge();
+    CHECK(bool(oldest) == !visited.empty());
+    if (oldest) {
+        Version minimum = std::numeric_limits<Version>::max();
+        for (const auto& [id, cv] : snapshot.main) minimum = std::min(minimum, cv);
+        for (const auto& [id, cv] : snapshot.exceptions) minimum = std::min(minimum, cv);
+        CHECK(pool.oldestAgeCV() == minimum && oldest->maxCV == minimum);
+        const uint32_t head = pool.oldestAge_;
+        if (head != NoAge && pool.ageEntry(head).maxCV == minimum) CHECK(oldest->ageIndex == head);
+        else CHECK(pool.ageException(oldest->ageIndex) && oldest->ageIndex == pool.exceptionAges_.front());
+    }
+    if (visited.size() <= 160) {
+        std::set<uint32_t> walked;
+        const ReclaimLink* before = nullptr;
+        for (const ReclaimLink* link = pool.oldestAge(); link; link = pool.nextAge(link)) {
+            CHECK(walked.insert(link->ageIndex).second && pool.previousAge(link) == before);
+            if (before) CHECK(before->maxCV <= link->maxCV);
+            before = link;
+        }
+        CHECK(walked == visited);
+    }
+    return snapshot;
+}
+
+bool inException(const PagePool& pool, const ReclaimLink* link) {
+    return link->ageLinked && pool.ageException(link->ageIndex);
+}
