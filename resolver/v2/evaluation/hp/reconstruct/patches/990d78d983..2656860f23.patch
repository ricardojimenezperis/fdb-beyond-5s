+    tree.refreshUp(leaf);
+    const auto restarts = tree.stats().writeHintRestarts;
+    CHECK(tree.findLeaf(sv(begin)) != leaf);
+    CHECK(tree.resolveWriteHint(sv(begin), hint) == tree.findLeaf(sv(begin)));
+    // Rejected by the moved minimum, not by identity: the leaf is the same incarnation
+    if constexpr (Tree::Stats::searchEnabled) CHECK(tree.stats().writeHintRestarts == restarts + 1 && tree.stats().writeHintStale == 0);
+    verify(tree);
