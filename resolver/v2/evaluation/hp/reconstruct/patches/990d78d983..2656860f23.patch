+void inlineOnlyConservativeHead() {
+    if constexpr (!Tree::InlineOnlyKeys || Tree::InlineKeyBytes < 1) return;
+    Tree tree(16, 0);
+    tree.addRange(10, sv("a"), sv("z"));
+    tree.addPoint(20, sv("m"));
+    auto* leaf = tree.root_;
+    CHECK(leaf->leaf && leaf->size() == 3);
+    // Remove the left survivor: the circular head is now CV20, followed by
+    // the right survivor at CV10. Key order and physical order differ.
+    tree.eraseSlot(leaf, 0); tree.refreshUp(leaf);
+    if constexpr (PAGED_BTREE_BITMAP_CLEANUP == 0) CHECK(leaf->slots[leaf->reclaimHead].cv == 20);
+    tree.validationMinRV_ = 15;
+    purgeExpired(tree, leaf);
+    if constexpr (PAGED_BTREE_BITMAP_CLEANUP == 0) {
+        CHECK(leaf->size() == 2 && leaf->slots[leaf->reclaimHead].cv == 20);
+    } else {
+        CHECK(leaf->size() == 1 && leaf->at(0).cv == 20);
+    }
+    CHECK(contents(tree).size() == 1);
+    CHECK(tree.hasConflict(15, sv("m"), sv(std::string("m\0", 2))));
+    CHECK(!tree.hasConflict(15, sv("n"), sv("z")));
+    verify(tree);
+    tree.validationMinRV_ = 20;
+    purgeExpired(tree, leaf);
+    CHECK(!tree.root_ && tree.leafCount_ == 0);
+    tree.releaseEmptyPages();
+    CHECK(tree.freeNodes_ + tree.keyBlockCount() == tree.budget().indexPages * tree.nodesPerPage() && tree.budget().heapPages == 0);
+    verify(tree);
+}
