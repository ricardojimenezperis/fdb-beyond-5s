+void groupedUnsortedOverwritesReuseScratch() {
+    Tree grouped(128, 0), scalar(128, 0);
+    std::mt19937 random(1983);
+    for (Version cv = 1; cv <= 40; ++cv) {
+        const unsigned count = cv == 1 ? 400 : 17 + random() % 100;
+        std::vector<std::string> keys;
+        keys.reserve(2 * count);
+        std::vector<Tree::Write> writes;
+        for (unsigned i = 0; i < count; ++i) {
+            const unsigned begin = random() % 4000;
+            keys.push_back(key(begin));
+            keys.push_back(key(begin + 1 + random() % 300));
+            writes.push_back({sv(keys[2 * i]), sv(keys[2 * i + 1]),
+                              random() % 3 ? ConflictKind::Range : ConflictKind::Point});
+        }
+        const auto* pendingStorage = grouped.writePending_.data();
+        const auto* hintStorage = grouped.writeHints_.data();
+        const auto* orderStorage = grouped.writeOrder_.data();
+        grouped.addWrites(cv, writes.data(), writes.size());
+        for (const auto& write : writes) {
+            if (write.kind == ConflictKind::Point) scalar.addPoint(cv, write.begin);
+            else scalar.addRange(cv, write.begin, write.end);
+        }
+        CHECK(contents(grouped) == contents(scalar));
+        if (cv > 1) {
+            CHECK(grouped.writePending_.data() == pendingStorage);
+            CHECK(grouped.writeHints_.data() == hintStorage);
+            CHECK(grouped.writeOrder_.data() == orderStorage);
+        }
+        verify(grouped);
+    }
+}
