+void reclaimedRangesAreUnreadable() {
+	begin("reclaimedRangesAreUnreadable");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+
+	const std::string from(500, 'a'), to(500, 'b');
+	const HeapRef onFirst = appended(heap.appendRange(1, asRef(from), asRef(to)),
+	                                 "a range on the first page");
+	while (true) {
+		Optional<HeapRef> r = heap.appendRange(1, asRef(from), asRef(to));
+		if (!check(r.present(), "the heap keeps accepting ranges")) {
+			end();
+			return;
+		}
+		if (r.get().pageID != onFirst.pageID) {
+			break; // this one spilled onto the second page
+		}
+	}
+	const HeapRef onSecond = appended(heap.appendRange(2, asRef(from), asRef(to)),
+	                                  "a range on the second page");
+
+	heap.reclaimOldest();
+
+	check(heap.obsolete(onFirst), "the reclaimed range is obsolete");
+	check(!heap.getRange(onFirst).present(), "and it cannot be read");
+	check(heap.getRange(onSecond).present(), "while the surviving one still reads");
+	end();
+}
