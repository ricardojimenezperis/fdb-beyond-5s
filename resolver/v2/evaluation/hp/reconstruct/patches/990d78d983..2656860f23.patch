+void bitmapAnchorSweepBeforeComparisons() {
+    bool sawFused = false, sawUnfused = false;
+    for (uint64_t seed = 1; seed <= 16; ++seed) {
+        setThreadLocalDeterministicRandomSeed(seed);
+        bool fused = false;
+        bitmapAnchorSweepScenario(fused);
+        (fused ? sawFused : sawUnfused) = true;
+    }
+    CHECK(sawFused && sawUnfused);
+}
