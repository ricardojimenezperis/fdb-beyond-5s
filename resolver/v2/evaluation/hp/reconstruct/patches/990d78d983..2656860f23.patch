+void splitMaxCVLeafHalvesAndRoot() {
+    for (bool newestOnLeft : {false, true}) {
+        Tree tree(64, 0);
+        const unsigned newest = newestOnLeft ? 0 : Tree::Capacity-1;
+        for (unsigned i=0; i<Tree::Capacity; ++i)
+            if (i != newest) tree.addPoint(1, sv(key(4*i, 32)));
+        tree.addPoint(20, sv(key(4*newest, 32)));
+        CHECK(tree.root_->leaf && tree.root_->size() == Tree::Capacity);
+        checkSplitMaxima(tree, tree.root_);
+    }
+}
