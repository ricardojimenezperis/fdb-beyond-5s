+void checkSortedQueries(Tree& tree, std::vector<Tree::Query> queries) {
+    const auto original = queries;
+    const auto stored = contents(tree);
+    std::vector<bool> expected;
+    for (const auto& q : queries) expected.push_back(referenceConflict(stored, q.readVersion, bytes(q.begin), bytes(q.end)));
+    for (unsigned group : {2u, 3u})
+    for (unsigned levels : {0u, 2u, 3u}) {
+        Tree::ReadPipelineConfig cfg; cfg.sweepGroupSize = group;
+        cfg.breadthBoundaryLevels = levels;
+        tree.hasConflicts(queries.data(), queries.size(), cfg);
+        for (size_t i = 0; i < queries.size(); ++i) {
+            const auto& q = queries[i];
+            CHECK(q.conflict == expected[i]);
+            CHECK(q.begin == original[i].begin && q.end == original[i].end && q.readVersion == original[i].readVersion);
+            if (q.begin < q.end) {
+                CHECK(q.endIndex < tree.sortedEndpoints_.size());
+                const auto& end = tree.sortedEndpoints_[q.endIndex];
+                CHECK(end.end && end.query == i && end.key == q.end);
+            } else CHECK(q.endIndex == UINT32_MAX);
+        }
+        for (size_t i = 1; i < tree.sortedEndpoints_.size(); ++i) {
+            const auto& a = tree.sortedEndpoints_[i-1]; const auto& b = tree.sortedEndpoints_[i];
+            CHECK(!(b.key < a.key));
+            if (a.key == b.key) CHECK(a.end || !b.end);
+        }
+        CHECK(tree.openQueries_.empty());
+        for (const auto& block : tree.readBlocks_) for (const auto& state : block.nodes) CHECK(state.heap == 0);
+        if constexpr (Tree::Stats::searchEnabled) CHECK(tree.readPipelineStats().breadthLevels <= tree.height());
+    }
+}
