+void unusableSummariesAreExploredNotTrusted() {
+	begin("unusableSummariesAreExploredNotTrusted");
+	onFreshThread([] {
+		LevelMirror mirror;
+		// NeedsRepair on a tower's span
+		TemporalConflictSet set(8, 0);
+		writeRange(set, mirror, 2, 1, "b", "c");
+		writeRange(set, mirror, 1, 200, "m", "p");
+		if (!check(set.ranges_.levels_[1].first_ != nullptr, "the tower was built as steered")) {
+			return;
+		}
+		markForRepair(set.ranges_.levels_[1].first_->summary);
+		check(rangeConflict(set, 100, "n", "o"), "a span marked for repair is explored and its conflict found");
+		check(!rangeConflict(set, 100, "q", "z") && !rangeConflict(set, 100, "a", "b"), "and nothing is invented");
+
+		// NeedsRepair on a level's prefix
+		TemporalConflictSet prefix(8, 0);
+		writeRange(prefix, mirror, 2, 1, "m", "n");
+		writeRange(prefix, mirror, 1, 200, "c", "d");
+		markForRepair(prefix.ranges_.levels_[1].prefixSummary());
+		check(rangeConflict(prefix, 100, "c", "e"), "a prefix marked for repair is explored and its conflict found");
+		check(!rangeConflict(prefix, 100, "d", "e"), "and nothing is invented there either");
+
+		// Valid, but its source expired while its page is live: the bound may not be read
+		TemporalConflictSet expired(8, 0);
+		writeRange(expired, mirror, 2, 1, "b", "c");
+		writeRange(expired, mirror, 1, 4, "d", "y");
+		writeRange(expired, mirror, 1, 200, "p", "q");
+		SkipEntry* t1 = expired.ranges_.levels_[1].first_;
+		if (!check(t1 != nullptr, "the expiring tower was built as steered")) {
+			return;
+		}
+		check(t1->summary.maxEnd.state == MaxEndState::Valid && t1->summary.maxEnd.value.get().sourceCV == 4,
+		      "the span's greatest end comes from a write that is about to expire");
+		expired.validationMinRV_ = 10;
+		check(rangeConflict(expired, 100, "p", "z"), "with that write expired, the span is still explored");
+		check(!rangeConflict(expired, 100, "r", "z") && !rangeConflict(expired, 100, "e", "f"),
+		      "and neither the expired write nor the stale bound makes a conflict");
+
+		// Valid, but its source's page has been reclaimed
+		TemporalConflictSet reclaimed(16, 0);
+		writeRange(reclaimed, mirror, 2, 1, "b", "z");
+		Version cv = 1;
+		while (reclaimed.budget().heapPages < 2 && cv < 1000) {
+			++cv;
+			writePoint(reclaimed, mirror, 1, cv, paddedKey("~" + std::to_string(cv), 1000));
+		}
+		writeRange(reclaimed, mirror, 1, ++cv, "p", "q");
+		SkipEntry* top = reclaimed.ranges_.levels_[1].first_;
+		if (!check(top != nullptr && levelVersions(reclaimed.ranges_, 1) == std::vector<Version>{ 1 } &&
+		               levelVersions(reclaimed.ranges_, 0) == (std::vector<Version>{ 1, cv }),
+		           "the tall range alone reaches level 1, the later one only level 0")) {
+			return;
+		}
+		check(top->summary.maxEnd.state == MaxEndState::Valid && top->summary.maxEnd.value.get().sourceCV == 1,
+		      "the span's greatest end is the first write's, on the oldest heap page");
+		const Optional<Version> newest = reclaimed.heap_.oldestPageNewestCV();
+		if (!check(newest.present() && newest.get() < cv, "the later range is on a newer page")) {
+			return;
+		}
+		reclaimed.validationMinRV_ = newest.get();
+		reclaimed.heap_.reclaimOldest();
+		check(reclaimed.heap_.obsolete(top->record), "the page holding the bound is gone");
+		check(rangeConflict(reclaimed, newest.get(), "p", "z"), "the span is explored and the live range found");
+		check(!rangeConflict(reclaimed, newest.get(), "q", "z"), "and nothing is read from the reclaimed page");
+	});
+	end();
+}
