+    std::vector<BreadthFrame> breadthCurrent_, breadthNext_;
+    ReadPipelineStats readPipelineStats_{};
+    unsigned readerGroupSize_ = 3;
+
+    static size_t nodeOffset();
+    static size_t nodesPerPage();
