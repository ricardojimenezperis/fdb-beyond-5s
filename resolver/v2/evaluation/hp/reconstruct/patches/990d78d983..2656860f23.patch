+void keyBlocksShareNodePages() {
+    Tree tree(4, 0);
+    std::vector<Tree::Node*> nodes;
+    for (size_t i = 0; i < tree.nodesPerPage(); ++i) nodes.push_back(tree.allocateNode());
+    auto* oldPage = nodes.front()->owner;
+    for (auto* node : nodes) tree.recycleNode(node);
+    CHECK(!tree.pool_.tryAcquire(PageUse::Heap));
+    tree.reclaim(PageUse::Heap);
+    CHECK(tree.budget().indexPages == 1 && tree.freeNodes_ == tree.nodesPerPage());
+    CHECK(!tree.pool_.tryAcquire(PageUse::Heap));
+    auto* reused = tree.allocateNode();
+    CHECK(reused->owner == oldPage);
+    tree.recycleNode(reused);
+    auto* block = Tree::acquireKeyBlock(&tree);
+    CHECK(block && Tree::keyBlockOwner(block)->owner == oldPage && tree.keyBlockCount() == 1);
+    CHECK(tree.budget().indexPages == 1 && tree.budget().heapPages == 0 && tree.freeNodes_ == tree.nodesPerPage() - 1);
+    Tree::raiseKeyBlock(&tree, block, 1);
+    CHECK(Tree::findKeyBlock(&tree, block->id) == block);
+    const PageID id = block->id;
+    Tree::releaseKeyBlock(&tree, block);
+    CHECK(!tree.keyBlockCount() && !Tree::findKeyBlock(&tree, id) && tree.freeNodes_ == tree.nodesPerPage());
+    verify(tree);
+}
