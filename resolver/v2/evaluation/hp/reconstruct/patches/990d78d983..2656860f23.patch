+void bitmapFirstFreeSlot() {
+    Tree tree(64, 0);
+    tree.addPoint(1, sv(key(0))); tree.addPoint(1, sv(key(4))); tree.addPoint(1, sv(key(8)));
+    auto* leaf = tree.root_;
+    tree.eraseSlot(leaf, 1);
+    const unsigned expected = __builtin_ctz((~leaf->occupied) & Tree::SlotMask);
+    tree.insertSlot(leaf, 1, tree.prepareWrite(2, sv(key(4)), {}, true));
+    if constexpr (PAGED_BTREE_BITMAP_CLEANUP >= 2) CHECK(leaf->order.slotAt(1) == expected);
+    tree.refreshUp(leaf); verify(tree);
+}
