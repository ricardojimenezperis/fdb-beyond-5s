+void groupedDestinationsMatchScalar() {
+    Tree tree(256, 0);
+    for (unsigned i = 0; i < 4000; ++i)
+        tree.addRange(1, sv(key(4 * i + 2)), sv(key(4 * i + 3)));
+    const auto before = contents(tree);
+    for (unsigned count : {1, 15, 16, 17, 400, 1200}) {
+        std::vector<std::string> keys;
+        keys.reserve(count);
+        std::vector<Tree::Write> writes;
+        for (unsigned i = 0; i < count; ++i) {
+            keys.push_back(key(i * 17000 / count));
+            writes.push_back({sv(keys.back()), {}, ConflictKind::Point});
+        }
+        if (count == 17) std::reverse(writes.begin(), writes.end());
+        if (count == 400) writes[1].begin = writes[0].begin;
+        const auto stats = tree.stats();
+        searchBatch(tree, writes);
+        for (unsigned i = 0; i < count; ++i) {
+            CHECK(tree.writeHints_[i].node == tree.findLeaf(writes[i].begin));
+            CHECK(tree.writeHints_[i].node->allocated);
+        }
+        if constexpr (Tree::Stats::searchEnabled) {
+            CHECK(tree.stats().writeSearchPasses == stats.writeSearchPasses + 1);
+            CHECK(tree.stats().writeSearchNodes - stats.writeSearchNodes <= count * tree.height());
+            if (count >= 400) CHECK(tree.stats().writeSearchMaxActive == Tree::WriteSearchWidth);
+        }
+    }
+    CHECK(contents(tree) == before);
+    verify(tree);
