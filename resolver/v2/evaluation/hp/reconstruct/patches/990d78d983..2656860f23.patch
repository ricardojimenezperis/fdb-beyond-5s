+void referencePrefixShortZeroAndShorterQueries() {
+    if constexpr (!Tree::NodePrefixEnabled) return;
+    for(unsigned length:{0U,3U,12U}) {
+        Tree tree(64,0);
+        auto k = [&](unsigned n) { return std::string(length,'p')+char(n)+std::string(8,'x'); };
+        for(unsigned i=0;i<80;++i) tree.addPoint(1,sv(k(2*i)));
