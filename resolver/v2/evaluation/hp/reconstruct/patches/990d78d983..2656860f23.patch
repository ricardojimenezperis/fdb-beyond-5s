+// Inside an active write batch, an internal node whose expired children are interleaved with live ones. With the
+// bitmap every expired child is reclaimed and waits retired until the batch ends; the circular head stops at the
+// first live child. Either way the live entries keep deciding reads and the tree stays valid.
+void bitmapCleanupBatchInterleavedChildren() {
+    Tree tree(64, 0);
+    const std::vector<Version> cvs{1, 3, 1, 3, 1, 3};
+    auto* parent = bitmapParentOfLeaves(tree, cvs);
+    tree.validationMinRV_ = 1;
+    std::vector<Tree::Node*> expired;
+    for (unsigned i = 0; i < cvs.size(); ++i) if (cvs[i] <= 1) expired.push_back(parent->at(i).payload.link.child);
+    {
+        Tree::WriteBatchScope batch(tree);
+        const bool changed = tree.purgeInsertionHead(parent);
+        CHECK(changed);
+        if constexpr (PAGED_BTREE_BITMAP_CLEANUP != 0) {
+            CHECK(parent->allocated && parent->size() == 3);
+            for (unsigned i = 0; i < parent->size(); ++i) CHECK(parent->at(i).cv == 3);
+            const auto retired = retiredItems(tree);
+            CHECK(retired.size() == expired.size());
+            for (auto* node : expired) {
+                CHECK(!node->allocated);
+                CHECK(std::find(retired.begin(), retired.end(), node) != retired.end());
+                for (auto* free : freeItems(tree)) CHECK(free != node);
+            }
+        } else {
+            CHECK(parent->allocated && parent->size() == 5);
+        }
+    }
+    CHECK(!tree.retired_ && !tree.writeBatchActive_);
+    for (unsigned i = 0; i < cvs.size(); ++i) {
+        CHECK(tree.hasConflict(2, sv(key(4 * i)), sv(key(4 * i + 1))) == (cvs[i] > 2));
+        CHECK(!tree.hasConflict(3, sv(key(4 * i)), sv(key(4 * i + 1))));
+    }
+    verify(tree);
+}
