+void blockReaderNodeWorkReuse() {
+    Tree tree(128, 0);
+    const std::string prefix(Tree::InlineKeyBytes + 160, 'r');
+    std::vector<std::string> keys;
+    for (unsigned i = 0; i < 64; ++i) keys.push_back(prefix + std::to_string(10000 + i));
+    const unsigned ranges = std::min(8u, Tree::Capacity);
+    for (unsigned i = 0; i < ranges; ++i) tree.addRange(7, sv(keys[4*i]), sv(keys[4*i+2]));
+    CHECK(tree.root_->leaf);
+    for (unsigned group : {2u, 3u}) {
+        std::vector<Tree::Query> queries;
+        for (unsigned i = 0; i < 256; ++i)
+            queries.push_back({0, sv(keys[i % (4 * ranges)]), sv(keys[i % (4 * ranges) + 1]), false});
+        Tree::ReadPipelineConfig cfg; cfg.sweepGroupSize = group;
+        tree.hasConflicts(queries.data(), queries.size(), cfg);
+        for (unsigned i = 0; i < queries.size(); ++i) CHECK(queries[i].conflict == (i%4 < 2));
+        if constexpr (Tree::Stats::searchEnabled) {
+            const auto& st = tree.readPipelineStats();
+            CHECK(st.blockEntriesFiltered == tree.root_->size());
+            CHECK(st.breadthHeapResolutions <= 2 * tree.root_->size());
+            CHECK(st.blockAddressReuses > 0);
+        }
+    }
+    verify(tree);
+}
