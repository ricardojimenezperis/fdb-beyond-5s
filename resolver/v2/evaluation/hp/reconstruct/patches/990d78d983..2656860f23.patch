+void groupedWritesKeepHintsThroughReclamation() {
+    Tree tree(12, 0);
+    unsigned initial = 0;
+    for (; initial < 2000 && tree.budget().freePages; ++initial)
+        tree.addRange(initial + 1, sv(key(4 * initial, 1000)), sv(key(4 * initial + 1)));
+    CHECK(!tree.budget().freePages && tree.height() > 1);
+    const Version cv = initial + 100;
+    std::vector<std::string> keys;
+    keys.reserve(160);
+    std::vector<Tree::Write> writes;
+    for (unsigned i = 0; i < 80; ++i) {
+        keys.push_back(key(100000 + 4 * i, 3000));
+        keys.push_back(key(100001 + 4 * i));
+        writes.push_back({sv(keys[2 * i]), sv(keys[2 * i + 1]), ConflictKind::Range});
+    }
+    const auto reclaimed = tree.heap_.lastReclaimedPageID();
+    const auto passes = tree.stats().writeSearchPasses;
+    tree.addWrites(cv, writes.data(), writes.size());
+    CHECK(tree.heap_.lastReclaimedPageID() > reclaimed && tree.validationMinRV() < cv);
+    // stableHints: heap reclamation inside the batch does not repeat the grouped search
+    if constexpr (Tree::Stats::searchEnabled) CHECK(tree.stats().writeSearchPasses == passes + 1);
+    for (const auto& write : writes) CHECK(tree.hasConflict(cv - 1, write.begin, write.end));
