+unsigned checkNode(const Tree& tree, const Tree::Node* node, uint64_t& fictitious) {
+    CHECK(node->allocated && node->size() <= Tree::Capacity);
+    CHECK(node->ageLinked && tree.pool_.ageCV(node) == node->maxCV);
+    if (node->leaf) {
+        for (unsigned rank = 0; rank < node->size(); ++rank) CHECK(node->at(rank).cv <= node->maxCV);
+        CHECK(node->size() + node->fict.fictitious <= Tree::Capacity);
+        CHECK(node->critical == (node->size() + node->fict.fictitious == Tree::Capacity));
+        fictitious += node->fict.fictitious;
+        return 1;
+    }
+    CHECK(!node->fict.fictitious);
+    unsigned criticalChildren = 0, leaves = 0;
+    for (unsigned rank = 0; rank < node->size(); ++rank) {
+        const Tree::Node* child = node->at(rank).payload.link.child;
+        CHECK(child->parent == node && node->slots[child->parentSlot].payload.link.child == child);
+        CHECK(node->at(rank).cv == child->maxCV && child->maxCV <= node->maxCV);
+        leaves += checkNode(tree, child, fictitious);
+        criticalChildren += child->critical;
+    }
+    CHECK(node->criticalChildren == criticalChildren);
+    CHECK(Tree::Capacity - node->size() >= criticalChildren);
+    CHECK(node->critical == (Tree::Capacity - node->size() == criticalChildren));
+    return leaves;
+}
