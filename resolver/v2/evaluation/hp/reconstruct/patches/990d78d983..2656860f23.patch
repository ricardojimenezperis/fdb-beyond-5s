+// The same emptied anchor, with the insertion restarted by reserve(): no free node and no free index page,
+// so the split of the critical root reclaims. The reclaimer here returns held nodes without moving the floor.
+struct HeldNodes { Tree* tree; std::vector<Tree::Node*> held; unsigned calls = 0; };
+void emptiedAnchorAfterReserveRestart() {
+    Tree tree(64, 0);
+    tree.configureFictitiousLeaves({ 0, 0 });
+    std::vector<std::string> keys;
+    const auto leaves = criticalRootOfPoints(tree, keys, -1);
+    for (unsigned i = 0; i < leaves.size(); ++i) {
+        if (i == 2) continue;
+        for (unsigned j = 1; j <= Tree::Capacity / 2; ++j) {
+            const std::string extra = keys[i] + char(j);
+            tree.insertSlot(leaves[i], j, tree.prepareWrite(2, sv(extra), {}, true));
+        }
+        tree.refreshUp(leaves[i]);
+    }
+    verify(tree);
+    tree.validationMinRV_ = 1;
+    HeldNodes context{&tree, {}};
+    while (tree.freeNodes_ < 2) context.held.push_back(tree.allocateNode());
+    while (tree.freeNodes_) context.held.push_back(tree.allocateNode());
+    std::vector<PoolPage*> pages;
+    while (auto* page = tree.pool_.tryAcquire(PageUse::Index)) pages.push_back(page);
+    tree.pool_.setReclaimer(&context, [](void* opaque, PageUse use) {
+        auto& c = *static_cast<HeldNodes*>(opaque);
+        CHECK(use == PageUse::Index && c.held.size() >= 2);
+        ++c.calls;
+        for (unsigned i = 0; i < 2; ++i) { c.tree->recycleNode(c.held.back()); c.held.pop_back(); }
+    });
+    Tree::Node* anchor = leaves[2];
+    tree.addPoint(2, sv(keys[2]));
+    tree.pool_.setReclaimer(&tree, Tree::reclaimThunk);
+    std::printf("[reclaims %u, anchor %s, empty leaves %u] ", context.calls, anchor->allocated ? (anchor->size() ? "holds entries" : "kept empty") : "removed", emptyLeaves(tree));
+    CHECK(context.calls == 1);
+    CHECK(emptyLeaves(tree) == 0);
+    checkPointsAgainstModel(tree, keys, -1);
+    for (auto* node : context.held) tree.recycleNode(node);
+    for (auto* page : pages) tree.pool_.release(page, PageUse::Index);
+    verify(tree);
+}
