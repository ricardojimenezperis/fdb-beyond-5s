+void batchedPointSearchesAgreeWithAModel() {
+	begin("batchedPointSearchesAgreeWithAModel");
+	for (size_t count : { size_t(1), size_t(15), size_t(16), size_t(17), size_t(400) }) {
+		onFreshThread([count] {
+			std::mt19937 random(97 + count);
+			TemporalConflictSet set(16, 0);
+			std::vector<ModelWrite> writes;
+			for (Version cv = 1; cv <= 1500; ++cv) {
+				const std::string key = randomKey(random, 6, 4);
+				set.addPoint(cv, asRef(key));
+				writes.push_back({ false, key, key, cv });
+			}
+			// Half the history has expired, so the searches unlink towers as they go
+			set.validationMinRV_ = 750;
+			std::vector<std::string> keys;
+			std::vector<Version> readVersions;
+			std::vector<bool> expected;
+			keys.reserve(2 * count);
+			for (size_t i = 0; i < count; ++i) {
+				std::string from = randomKey(random, 6, 4);
+				std::string to = random() % 4 == 0 ? randomKey(random, 6, 4) : from + randomKey(random, 6, 1);
+				if (to < from) {
+					std::swap(from, to);
+				}
+				keys.push_back(from);
+				keys.push_back(to);
+				readVersions.push_back(750 + Version(random() % 750));
+				expected.push_back(modelConflict(writes, readVersions.back(), from, to, POINTS));
+			}
+			// Built once every key is in place, since queries hold references into keys
+			std::vector<PointQuery> queries;
+			for (size_t i = 0; i < count; ++i) {
+				queries.push_back(PointQuery{ readVersions[i], asRef(keys[2 * i]), asRef(keys[2 * i + 1]) });
+			}
+			const size_t linkedBefore = levelCells(set.points_, 0).size();
+			set.points_.hasPointConflicts(queries.data(), queries.size(), set.validationMinRV_);
+			int wrong = 0, positives = 0;
+			for (size_t i = 0; i < count; ++i) {
+				wrong += queries[i].conflict != expected[i];
+				positives += expected[i];
+			}
+			check(wrong == 0, "every batched answer agrees with the model");
+			check(count < 16 || (positives > 0 && size_t(positives) < count), "with both answers among them");
+			check(count < 16 || levelCells(set.points_, 0).size() < linkedBefore, "the searches unlinked expired towers");
+			check(indexesAreSound(set), "and the index is sound");
+		});
+	}
+	end();
+}
+
+// ---------- Grouped insertion ----------
+//
+// A batch's writes are prepared (record and cells, where reclamation may run), then their paths
+// are found interleaved with nothing allocated, then they are linked in decreasing key order. The
+// structural cases drive TemporalSkipList's steps directly with steered heights; the owner-level
+// cases go through addWrites
+
+using PreparedWrite = TemporalSkipList::PreparedWrite;
+using PathSearch = TemporalSkipList::PathSearch;
+
+// Prepares a point write with an exact height, as addWrites would, but one write at a time
+void preparePoint(TemporalConflictSet& set, LevelMirror& mirror, PreparedWrite& write, int height, Version cv,
+                  const char* key) {
+	const HeapRef record = set.heap_.appendPoint(cv, StringRef(reinterpret_cast<const uint8_t*>(key), strlen(key))).get();
+	steerExactHeight(set, mirror, height);
+	mirror.next();
+	set.points_.prepare(write, record, cv, set.indexAllocator_);
+}
+
+// Every level's cells, by key, as the level holds them
+std::vector<std::string> levelKeys(const TemporalConflictSet& set, int level) {
+	std::vector<std::string> keys;
+	for (SkipEntry* e = set.points_.levels_[level].first_; e != nullptr; e = e->next) {
+		keys.push_back(e->recordCV > set.validationMinRV_ ? e->beginWriteKey(set.heap_).toString() : "(expired)");
+	}
+	return keys;
+}
+
+void preparedWritesSharingPredecessorsLinkInOrder() {
+	begin("preparedWritesSharingPredecessorsLinkInOrder");
+	onFreshThread([] {
+		TemporalConflictSet set(8, 0);
+		LevelMirror mirror;
+		writePoint(set, mirror, 3, 1, "a");
+		writePoint(set, mirror, 3, 2, "z");
+
+		// b, c, d and e all fall between a and z: at level 2, b and e share a as predecessor
+		PreparedWrite group[4];
+		preparePoint(set, mirror, group[0], 3, 10, "b");
+		preparePoint(set, mirror, group[1], 1, 10, "c");
+		preparePoint(set, mirror, group[2], 2, 10, "d");
+		preparePoint(set, mirror, group[3], 3, 10, "e");
+		set.points_.findInsertionPaths(group, 4, set.validationMinRV_);
+		SkipEntry* a2 = cellAt(set.points_, 2, 1);
+		check(group[0].predecessors[2] == a2 && group[3].predecessors[2] == a2 && group[1].predecessors[0] ==
+		                                                                               cellAt(set.points_, 0, 1),
+		      "the paths were found against the index before the group: every write's predecessor is a");
+		const uint64_t cells = set.points_.linkGroup(group, 4, set.validationMinRV_, set.cleanup_);
+		check(cells == 3 + 1 + 2 + 3, "every cell of the four towers is linked");
+		check(levelKeys(set, 0) == (std::vector<std::string>{ "a", "b", "c", "d", "e", "z" }), "level 0 is in key order");
+		check(levelKeys(set, 1) == (std::vector<std::string>{ "a", "b", "d", "e", "z" }), "so is level 1");
+		check(levelKeys(set, 2) == (std::vector<std::string>{ "a", "b", "e", "z" }), "and level 2");
+		check(indexesAreSound(set) && accountingHolds(set, cellsPerIndexPage()), "the index is sound and accounted");
+		bool conflicts = true;
+		for (const char* k : { "b", "c", "d", "e" }) {
+			conflicts = conflicts && pointConflict(set, 5, k, std::string(k) + "\x01");
+		}
+		check(conflicts && !pointConflict(set, 5, "a", "a\x01"), "each new write is found, and only them");
+	});
+	end();
+}
