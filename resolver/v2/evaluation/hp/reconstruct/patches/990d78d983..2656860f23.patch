+void indexNodesRecycleWithoutPageTransfer() {
+    Tree tree(8, 0);
+    std::vector<Tree::Node*> nodes;
+    for (size_t i = 0; i < 2 * tree.nodesPerPage(); ++i) nodes.push_back(tree.allocateNode());
+    CHECK(tree.budget().indexPages == 2 && tree.freeNodes_ == 0 && tree.pages_->next);
+    Tree::NodePage* older = tree.pages_->next;
+    for (auto* node : nodes) if (node->owner == older) tree.recycleNode(node);
+    tree.releaseEmptyPages();
+    CHECK(tree.budget().indexPages == 2 && tree.freeNodes_ == tree.nodesPerPage());
+    for (auto* node : nodes) if (node->owner != older) tree.recycleNode(node);
+    tree.releaseEmptyPages();
+    CHECK(tree.budget().indexPages == 2 && tree.freeNodes_ == 2 * tree.nodesPerPage());
+    std::vector<Tree::Node*> reused;
+    for (size_t i = 0; i < nodes.size(); ++i) {
+        auto* node = tree.allocateNode();
+        CHECK(std::find(nodes.begin(), nodes.end(), node) != nodes.end());
+        CHECK(std::find(reused.begin(), reused.end(), node) == reused.end());
+        reused.push_back(node);
+    }
+    CHECK(tree.budget().indexPages == 2 && !tree.freeNodes_);
+    for (auto* node : reused) tree.recycleNode(node);
+    verify(tree);
+}
