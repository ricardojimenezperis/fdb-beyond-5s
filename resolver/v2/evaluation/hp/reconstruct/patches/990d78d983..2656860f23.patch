+void referencePrefixReuseAcrossLevels() {
+    if constexpr (!Tree::NodePrefixEnabled) return;
+    Tree tree(1024, 0);
+    for (unsigned i=0; i<1800; ++i)
+        tree.addPoint(1, sv(std::string(12,'m') + key(4*i, 32)));
+    CHECK(tree.height() >= 3);
+    const Tree::Node* encodedAt = nullptr;
+    const auto first = tree.minimum(tree.root_->at(0).payload.link.child, &encodedAt);
+    CHECK(encodedAt && !encodedAt->leaf && first.end.length == 12);
+    Tree::Entry fresh;
+    const auto loads = tree.stats().heapKeyLoads;
+    const auto reuses = tree.stats().separatorEncodedReuses;
+    tree.assignSeparator(tree.root_, fresh, first, encodedAt);
+    CHECK(fresh.end.length == first.end.length);
+    if constexpr (Tree::InlineKeyBytes) CHECK(!std::memcmp(fresh.beginInline.data(), first.beginInline.data(), Tree::InlineKeyBytes));
+    if constexpr (Tree::Stats::searchEnabled) {
+        CHECK(tree.stats().heapKeyLoads == loads);
+        CHECK(tree.stats().separatorEncodedReuses == reuses + 1);
+    }
+    // A different reference length must re-encode, not copy incompatible suffixes.
+    Tree::Node different = *tree.root_;
+    different.navigation.prefix.length = 3;
+    Tree::Entry changed;
+    tree.assignSeparator(&different, changed, first, encodedAt);
+    CHECK(changed.end.length == 3);
+    const auto expected = tree.plainSeparator(encodedAt, first);
+    const auto actual = tree.plainSeparator(&different, changed);
+    if constexpr (Tree::InlineKeyBytes) CHECK(!std::memcmp(expected.beginInline.data(), actual.beginInline.data(), Tree::InlineKeyBytes));
+    const auto full = entryBytes(tree, expected);
+    for (const auto& probe : {full, full + '\0', full.substr(0,2), std::string(12,'z')}) {
+        const int order = tree.compareSeparator(&different, changed, sv(probe));
+        CHECK((order>0)-(order<0) == (sv(full)>sv(probe))-(sv(full)<sv(probe)));
+    }
+    verify(tree);
+}
