+unsigned emptyLeaves(const Tree& tree) {
+    unsigned empty = 0;
+    for (auto* leaf = tree.firstLeaf_; leaf; leaf = leaf->navigation.leaf.next) empty += leaf->size() == 0;
+    return empty;
+}
+
+// A full, critical root over one point per leaf; the leaf at expiredLeaf holds an expired point (CV 1)
+std::vector<Tree::Node*> criticalRootOfPoints(Tree& tree, std::vector<std::string>& keys, int expiredLeaf) {
+    auto take = [&](bool leaf) {
+        Tree::Reservation reservation;
+        tree.reserve(reservation, 1);
+        return tree.take(reservation, leaf);
+    };
+    std::vector<Tree::Node*> leaves;
+    for (unsigned i = 0; i < Tree::Capacity; ++i) {
+        keys.push_back(key(4 * i + 4));
+        leaves.push_back(take(true));
+        const auto entry = tree.prepareWrite(int(i) == expiredLeaf ? 1 : 2, sv(keys[i]), {}, true);
+        tree.insertSlot(leaves[i], 0, entry);
+        tree.refresh(leaves[i]);
+        if (i) { leaves[i - 1]->navigation.leaf.next = leaves[i]; leaves[i]->navigation.leaf.previous = leaves[i - 1]; }
+    }
+    tree.firstLeaf_ = leaves[0];
+    Tree::Node* root = take(false);
+    for (unsigned i = 0; i < Tree::Capacity; ++i) {
+        Tree::Entry link;
+        link.payload.link.child = leaves[i];
+        tree.insertSlot(root, i, link);
+    }
+    tree.refresh(root);
+    tree.root_ = root;
+    verify(tree);
+    CHECK(root->size() == Tree::Capacity && root->critical);
+    return leaves;
+}
+
+void checkPointsAgainstModel(Tree& tree, const std::vector<std::string>& keys, int expiredLeaf) {
+    for (unsigned i = 0; i < keys.size(); ++i) {
+        const std::string end = keys[i] + '\0';
+        CHECK(tree.hasConflict(1, sv(keys[i]), sv(end)) == (int(i) != expiredLeaf));
+        CHECK(!tree.hasConflict(2, sv(keys[i]), sv(end)));
+    }
+}
+
+// Overwriting the only live entry of a leaf at its own CV empties the anchor. Local cleanup of the critical
+// root then restarts the insertion, which lands in another leaf: the emptied anchor must not stay in the tree.
+void emptiedAnchorAfterLocalCleanupRestart() {
+    Tree tree(64, 0);
+    std::vector<std::string> keys;
+    const auto leaves = criticalRootOfPoints(tree, keys, 0);
+    tree.validationMinRV_ = 1;
+    Tree::Node* anchor = leaves[2];
+    const auto expiredBefore = tree.stats().expiredIntervals;
+    tree.addPoint(2, sv(keys[2]));
+    CHECK(tree.stats().expiredIntervals > expiredBefore);
+    std::printf("[anchor %s, empty leaves %u] ", anchor->allocated ? (anchor->size() ? "holds entries" : "kept empty") : "removed", emptyLeaves(tree));
+    CHECK(emptyLeaves(tree) == 0);
+    checkPointsAgainstModel(tree, keys, 0);
+    verify(tree);
+}
