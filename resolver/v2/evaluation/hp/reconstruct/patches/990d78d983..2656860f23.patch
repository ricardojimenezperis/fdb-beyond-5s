+    bool promotionSafe(const Node* node) const;
+    bool redistribute(InsertCursor& cursor, const Entry& interval);
+    struct FusionCandidate {
+        Node* node = nullptr;
+        uint32_t incarnation = 0;
+        unsigned before = 0;
+    };
+    void maybeProbFusion(const FusionCandidate& candidate);
+    bool fuseLeafNeighbour(Node* node, bool previous, unsigned mergedLimit = 0);
+    Version validationMinRV_;
+    Version lastWriteCV_ = NoVersion;
+    PagePool pool_;
+    TemporalHeap heap_;
+    uint64_t keyBlocks_ = 0, peakKeyBlocks_ = 0;
+    static Node* keyBlockOwner(HistoryPage* block);
+    static HistoryPage* acquireKeyBlock(void* context);
+    static void releaseKeyBlock(void* context, HistoryPage* block);
+    static void raiseKeyBlock(void* context, HistoryPage* block, Version cv);
+    static HistoryPage* findKeyBlock(void* context, PageID id);
+    size_t heapRecordBytes(const Write& write) const;
+    NodePage* pages_ = nullptr;
+    NodePage* emptyPages_ = nullptr;
+    Node* free_ = nullptr;
+    uint64_t freeNodes_ = 0;
+    Node* root_ = nullptr;
+    Node* firstLeaf_ = nullptr;
