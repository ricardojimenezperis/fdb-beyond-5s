+void indexReclamationUsesAgeList() {
+    for (bool inBatch : {false, true}) {
+        Tree tree(64, 0);
+        for (unsigned i = 0; i < 300; ++i)
+            tree.addRange(1, sv(key(4*i)), sv(key(4*i+2)));
+        // Raise the current key page and rightmost path; other nodes remain at 1.
+        tree.addRange(2, sv(key(2000)), sv(key(2002)));
+        while (tree.pool_.oldestAge() && tree.pool_.oldestAge()->ageUse == PageUse::Heap) {
+            tree.validationMinRV_ = std::max(tree.validationMinRV_, tree.pool_.oldestAgeCV());
+            tree.heap_.reclaimOldest();
+        }
+        std::vector<Tree::Node*> held;
+        while (tree.freeNodes_) held.push_back(tree.allocateNode());
+        std::vector<PoolPage*> pages;
+        while (auto* page = tree.pool_.tryAcquire(PageUse::Index)) pages.push_back(page);
+        auto* oldest = tree.pool_.oldestAge();
+        CHECK(oldest && oldest->ageUse == PageUse::Index && oldest->maxCV == 1);
+        auto* victim = static_cast<Tree::Node*>(oldest);
+        auto* owner = victim->owner;
+        const auto pageLive = owner->live;
+        const auto visits = tree.stats().reclaimLeavesVisited;
+        const Tree::LeafHint kept{tree.firstLeaf_, tree.firstLeaf_->incarnation};
+        tree.writeHints_.assign(3, kept);
+        tree.writeBatchActive_ = inBatch;
+        tree.reclaim(PageUse::Index);
+        CHECK(tree.validationMinRV() == 1);
+        CHECK(tree.freeNodes_ > 0 && !tree.pool_.hasAvailable(PageUse::Index));
+        CHECK(owner->live < pageLive && owner->live > 0);
+        CHECK(tree.stats().reclaimLeavesVisited == visits);
+        // The hints are kept as they were; one whose leaf was reclaimed is now stale by its incarnation
+        CHECK(tree.writeHints_.size() == 3 && tree.writeHints_[2].node == kept.node && tree.writeHints_[2].incarnation == kept.incarnation);
+        CHECK(!tree.reclaiming_ && !tree.retired_);
+        CHECK(tree.writeBatchActive_ == inBatch);
+        CHECK(tree.hasConflict(1, sv(key(2000)), sv(key(2002))));
+        tree.finishWriteBatch();
+        for (auto* node : held) tree.recycleNode(node);
+        for (auto* page : pages) tree.pool_.release(page, PageUse::Index);
+        verify(tree);
+    }
+}
