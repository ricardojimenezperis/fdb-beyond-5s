+	const HeapRef endRef{ record.pageID, record.offset + record.length - 1, 1 };
+	check(heap.getKey(endRef).present(), "readable while its page lives");
+	heap.reclaimOldest();
+	check(!heap.getKey(endRef).present(), "absent once the page is reclaimed");
+	end();
+}
+
+void destroyingTheHeapReturnsEveryPage() {
+	begin("destroyingTheHeapReturnsEveryPage");
+	PagePool pool(8);
+
+	{
+		TemporalHeap heap(pool);
+		for (Version cv = 1; cv <= 3; ++cv) {
+			fillOnePage(heap, cv, 1000, static_cast<PageID>(cv));
+		}
+		check(pool.budget().heapPages >= 3, "the heap holds several pages");
+	}
+
+	check(pool.budget().heapPages == 0, "destruction returned all of them");
+	check(pool.budget().freePages == pool.budget().limitPages, "the pool is whole again");
+	checkBudget(pool, "budget invariant after destruction");
+
+	// The recovered capacity is usable by a second heap over the same pool.
+	TemporalHeap again(pool);
+	const std::string key(10, 'r');
+	check(again.appendPoint(1, asRef(key)).present(),
+		  "a new heap can use the recovered pages");
+	check(again.lastReclaimedPageID() == 0, "and it starts its own ID sequence");
+	end();
+}
+
+} // namespace
+
+// ---------- Reclamation ----------
+//
+// These cases reach the conflict set's private state through the widened access this
+// file gives itself when including the header (see the top of the file); production
+// code gains no accessor. Promotion heights come from a thread_local generator that
+// starts at zero in every thread, so each case that depends on heights runs on a new
+// thread and mirrors the generator to know, and steer, the height of each insertion.
+
+// Mirrors TemporalSkipList::randomLevel's generator from a thread's initial state.
+struct LevelMirror {
+	uint32_t seed = 0;
+	int next() {
+		seed = seed * 1664525u + 1013904223u;
+		const uint32_t bits = seed >> (32 - (TemporalSkipList::MaxLevels - 1));
+		return __builtin_ctz(~bits);
+	}
+	int peek() const {
+		LevelMirror copy = *this;
+		return copy.next();
+	}
+};
+
+// Runs a case body on a fresh thread, so the promotion generator starts from zero, and
+// reports anything it throws as a failure of the running case rather than a crash.
+template <class Body>
+void onFreshThread(Body body) {
+	std::string thrown;
+	std::thread worker([&] {
+		try {
+			body();
+		} catch (Error& e) {
+			thrown = std::string("an FDB error escaped the case: ") + e.name();
+		} catch (std::exception& e) {
+			thrown = std::string("an exception escaped the case: ") + e.what();
+		}
+	});
+	worker.join();
+	if (!thrown.empty()) {
+		check(false, "the case ran to completion");
+		caseMessages.push_back(thrown);
+	}
+}
+
+// Consumes generator values until the next insertion gets at least `height` cells.
+void steerNextHeight(TemporalConflictSet& set, LevelMirror& mirror, int height) {
+	while (mirror.peek() + 1 < height) {
+		set.points_.randomLevel();
+		mirror.next();
+	}
+}
+
+// Consumes generator values until the next insertion gets exactly `height` cells.
+void steerExactHeight(TemporalConflictSet& set, LevelMirror& mirror, int height) {
+	while (mirror.peek() + 1 != height) {
+		set.points_.randomLevel();
+		mirror.next();
+	}
+}
+
+std::vector<SkipEntry*> queueCells(const TemporalConflictSet& set) {
+	std::vector<SkipEntry*> cells;
+	for (SkipEntry* e = set.cleanup_.oldest_; e != nullptr; e = e->newerForCleanup) {
+		cells.push_back(e);
+		if (e == set.cleanup_.newest_) {
+			break;
+		}
+	}
+	return cells;
+}
+
+size_t freeCells(const IndexPageAllocator& allocator) {
+	size_t count = 0;
+	for (SkipEntry* e = allocator.firstFree_; e != nullptr; e = e->next) {
+		++count;
+	}
+	return count;
+}
+
+// Cells an index page holds, learned from the allocator itself: the page layout is
+// defined in the implementation file and is not visible here.
+size_t cellsPerIndexPage() {
+	PagePool pool(2);
+	TemporalHeap heap(pool);
+	IndexPageAllocator allocator(pool);
+	const HeapRef record = pointRecord(heap, 1, "k");
+	allocator.acquire(ConflictKind::Point, 0, record, 1);
+	return freeCells(allocator) + 1;
+}
+
+int towerHeight(const SkipEntry* bottom) {
+	int height = 0;
+	for (const SkipEntry* e = bottom; e != nullptr; e = e->up) {
+		++height;
+	}
+	return height;
+}
+
+// The level-zero cell of the most recently queued tower.
+SkipEntry* newestTowerBottom(const TemporalConflictSet& set) {
+	SkipEntry* e = set.cleanup_.newest_;
+	while (e != nullptr && e->down != nullptr) {
+		e = e->down;
+	}
+	return e;
+}
+
+SkipEntry* findLinked(const TemporalSkipList& list, Version cv) {
+	for (SkipEntry* e = list.levels_[0].first_; e != nullptr; e = e->next) {
+		if (e->recordCV == cv) {
+			return e;
+		}
+	}
+	return nullptr;
+}
+
+// A key of `length` bytes starting with a printable prefix, so keys sort by the prefix.
+std::string paddedKey(const std::string& prefix, size_t length) {
+	std::string key = prefix;
+	key.resize(std::max(length, prefix.size()), '.');
+	return key;
+}
+
+// Horizontal and vertical links of both indexes, key order among live cells, and a
+// readable record for every cell above the boundary. Cells at or below the boundary
+// may name reclaimed records, so their keys are not read.
+bool indexesAreSound(const TemporalConflictSet& set) {
+	for (const TemporalSkipList* list : { &set.points_, &set.ranges_ }) {
+		for (int L = 0; L < TemporalSkipList::MaxLevels; ++L) {
+			const SkipLevel& level = list->levels_[L];
+			SkipEntry* previous = nullptr;
+			Optional<std::string> lastLiveKey;
+			for (SkipEntry* e = level.first_; e != nullptr; e = e->next) {
+				if (!e->linkedInLevel || e->level != L || e->previous != previous || e->kind != list->kind_) {
+					return false;
+				}
+				if (L > 0 && (e->down == nullptr || e->down->up != e || !e->down->linkedInLevel ||
+				              !sameRecord(e->down->record, e->record))) {
+					return false;
+				}
+				if (e->recordCV > set.validationMinRV_) {
+					Optional<Version> cv;
+					if (list->kind_ == ConflictKind::Point) {
+						Optional<PointConflictView> view = set.heap_.getPoint(e->record);
+						if (view.present()) {
+							cv = view.get().cv;
+						}
+					} else {
+						Optional<RangeConflictView> view = set.heap_.getRange(e->record);
+						if (view.present()) {
+							cv = view.get().cv;
+						}
+					}
+					if (!cv.present() || cv.get() != e->recordCV) {
+						return false;
+					}
+					const std::string key = e->beginWriteKey(set.heap_).toString();
+					if (lastLiveKey.present() && key < lastLiveKey.get()) {
+						return false;
+					}
+					lastLiveKey = key;
+				}
+				previous = e;
+			}
+			if (level.last_ != previous) {
+				return false;
+			}
+		}
+	}
+	return true;
+}
+
+// Pages add up, and every allocated cell is either free, in the cleanup queue, or one
+// of `held` cells the case took for itself.
+bool accountingHolds(const TemporalConflictSet& set, size_t perPage, size_t held = 0) {
+	const PageBudget& b = set.pool_.budget();
+	if (b.freePages + b.heapPages + b.indexPages != b.limitPages) {
+		return false;
+	}
+	const size_t allocated = perPage * b.indexPages;
+	return allocated == freeCells(set.indexAllocator_) + queueCells(set).size() + held;
+}
+
+// Takes every free cell, so the next index allocation must go through reclamation.
+std::vector<SkipEntry*> drainFreeCells(TemporalConflictSet& set, const HeapRef& anyRecord) {
+	std::vector<SkipEntry*> held;
+	while (set.indexAllocator_.firstFree_ != nullptr) {
+		held.push_back(set.indexAllocator_.acquire(ConflictKind::Point, 0, anyRecord, 1));
+	}
+	return held;
+}
+
+// Restores a knob on scope exit, so a case's configuration does not leak into others.
+template <class T>
+struct KnobOverride {
+	std::string name;
+	T saved;
+	KnobOverride(const std::string& name, T saved, T value) : name(name), saved(saved) {
+		setServerKnob(name, KnobValueRef::create(T{ value }));
+	}
+	~KnobOverride() { setServerKnob(name, KnobValueRef::create(T{ saved })); }
+};
+using IntKnobOverride = KnobOverride<int>;
+
+void availablePagesDoNotInvokeReclamation() {
+	begin("availablePagesDoNotInvokeReclamation");
+	PagePool pool(3);
+	int calls = 0;
+	pool.setReclaimer(&calls, [](void* context, PageUse) { ++*static_cast<int*>(context); });
+	PoolPage* a = pool.acquire(PageUse::Heap);
+	PoolPage* b = pool.acquire(PageUse::Index);
+	check(a != nullptr && b != nullptr && a != b, "free pages are handed out");
+	check(calls == 0, "without invoking the reclaimer");
+	check(pool.budget().heapPages == 1 && pool.budget().indexPages == 1 && pool.budget().freePages == 1,
+	      "and the counters move as for tryAcquire");
+
+	// The conflict set installs its own reclaimer; writes that fit leave the boundary alone.
+	TemporalConflictSet set(8, 100);
+	for (int i = 1; i <= 50; ++i) {
+		set.addPoint(100 + i, asRef(paddedKey(std::to_string(i), 40)));
+	}
+	check(set.validationMinRV() == 100, "normal allocation does not move the boundary");
+	check(set.heap_.lastReclaimedPageID() == 0, "nor reclaim any history");
+	check(set.insertedNodes_ == queueCells(set).size(), "every inserted cell is queued and counted");
+	end();
+}
+
+void exhaustedPoolReclaimsAndRetries() {
+	begin("exhaustedPoolReclaimsAndRetries");
+	struct Context {
+		PagePool* pool;
+		PoolPage* held;
+		int calls = 0;
+		Optional<PageUse> seen = Optional<PageUse>();
+	};
+	PagePool pool(2);
+	PoolPage* first = pool.acquire(PageUse::Heap);
+	pool.acquire(PageUse::Heap);
+	Context context{ &pool, first };
+	pool.setReclaimer(&context, [](void* raw, PageUse use) {
+		auto* c = static_cast<Context*>(raw);
+		++c->calls;
+		c->seen = use;
+		if (c->held != nullptr) {
+			c->pool->release(c->held, PageUse::Heap);
+			c->held = nullptr;
+		}
+	});
+
+	PoolPage* got = pool.acquire(PageUse::Index);
+	check(got == first, "the same call returns the page the reclaimer freed");
+	check(context.calls == 1, "after exactly one reclamation");
+	check(context.seen.present() && context.seen.get() == PageUse::Index, "which was told the use requested");
+	check(pool.budget().heapPages == 1 && pool.budget().indexPages == 1 && pool.budget().freePages == 0,
+	      "and the page moved from heap to index accounting");
+
+	check(pool.acquire(PageUse::Heap) == nullptr, "a reclaimer that frees nothing leaves the call failing");
+	check(context.calls == 2, "after trying once more");
+	end();
+}
+
+void indexAllocationReusesCellsWithoutAFreePage() {
+	begin("indexAllocationReusesCellsWithoutAFreePage");
+	onFreshThread([] {
+		const size_t perPage = cellsPerIndexPage();
+		TemporalConflictSet set(2, 0);
+		for (int i = 1; i <= 20; ++i) {
+			set.addPoint(i, asRef(paddedKey(std::to_string(1000 + i), 16)));
+		}
+		std::vector<SkipEntry*> held = drainFreeCells(set, set.points_.levels_[0].first_->record);
+		const PageBudget before = set.budget();
+		check(before.freePages == 0 && set.indexAllocator_.firstFree_ == nullptr,
+		      "no free page and no free cell remain");
+
+		set.validationMinRV_ = 10; // the first ten writes expire
+		const size_t queuedBefore = queueCells(set).size();
+		set.addPoint(21, asRef(paddedKey("new", 16)));
+
+		const PageBudget after = set.budget();
+		check(after.heapPages == before.heapPages && after.indexPages == before.indexPages &&
+		          after.freePages == 0,
+		      "the insertion succeeded without any page changing hands");
+		check(set.heap_.lastReclaimedPageID() == 0 && set.validationMinRV() == 10,
+		      "and without reclaiming history or moving the boundary");
+		SkipEntry* added = findLinked(set.points_, 21);
+		check(added != nullptr, "the new write is in the index");
+		check(queueCells(set).size() < queuedBefore + (added != nullptr ? towerHeight(added) : 0),
+		      "because expired towers were recycled into cells");
+		check(set.cleanup_.oldestCV() > 1, "starting with the oldest");
+		check(indexesAreSound(set), "the indexes stay sound");
+		check(accountingHolds(set, perPage, held.size()), "and every cell is accounted for");
+	});
+	end();
+}
+
+// Fills a pool of three pages as heap page, first index page, second index page, and
+// returns the version of the last write; the heap page keeps room for more writes.
+Version fillTwoIndexPages(TemporalConflictSet& set, std::mt19937& random, bool withRanges) {
+	Version cv = 0;
+	while (set.budget().indexPages < 2 && cv < 5000) {
+		++cv;
+		const std::string key = paddedKey(randomKey(random, 20, 4), 100);
+		if (withRanges && cv % 3 == 0) {
+			set.addRange(cv, asRef(key), asRef(key + "~"));
+		} else {
+			set.addPoint(cv, asRef(key));
+		}
+	}
+	return cv;
+}
+
+// A key long enough that its record cannot fit on the newest heap page.
+std::string keyThatNeedsANewHeapPage(const TemporalConflictSet& set) {
+	const uint32_t remaining = HISTORY_PAGE_BYTES - set.heap_.newest_->usedBytes;
+	return paddedKey("zz", remaining);
+}
+
+void heapAllocationReusesAnEmptyIndexPage() {
+	begin("heapAllocationReusesAnEmptyIndexPage");
+	onFreshThread([] {
+		const size_t perPage = cellsPerIndexPage();
+		std::mt19937 random(41);
+		TemporalConflictSet set(3, 0);
+		const Version last = fillTwoIndexPages(set, random, false);
+		check(set.budget().heapPages == 1 && set.budget().indexPages == 2 && set.budget().freePages == 0,
+		      "the pool is full: one heap page and two index pages");
+
+		set.validationMinRV_ = last; // every write so far expires
+		set.addPoint(last + 1, asRef(keyThatNeedsANewHeapPage(set)));
+
+		check(set.heap_.lastReclaimedPageID() == 0, "no page of history was discarded");
+		check(set.budget().heapPages == 2, "the heap got a second page");
+		check(set.budget().indexPages == 1, "from an index page emptied by cleanup, the other serving the new tower");
+		SkipEntry* added = findLinked(set.points_, last + 1);
+		check(added != nullptr && queueCells(set).size() == size_t(towerHeight(added)),
+		      "only the new write's tower remains queued");
+		check(set.validationMinRV() == last, "the boundary did not move");
+		check(indexesAreSound(set) && accountingHolds(set, perPage), "the structures stay sound and accounted");
+	});
+	end();
+}
+
+void historyReclamationAdvancesValidationBoundary() {
+	begin("historyReclamationAdvancesValidationBoundary");
+	onFreshThread([] {
+		// Driven directly, with no insertion after it, so the boundary is read before any
+		// search could read a reclaimed key: without the advance, an insertion would abort
+		// on that read before the case could look.
+		TemporalConflictSet direct(8, 0);
+		for (Version cv = 1; direct.budget().heapPages < 2 && cv <= 1000; ++cv) {
+			direct.addPoint(cv, asRef(paddedKey(std::to_string(cv), 1000)));
+		}
+		const Optional<Version> firstNewest = direct.heap_.oldestPageNewestCV();
+		direct.reclaimForAllocation(PageUse::Heap);
+		check(direct.heap_.lastReclaimedPageID() == 1, "a direct heap reclamation discards the oldest page");
+		check(firstNewest.present() && direct.validationMinRV() == firstNewest.get(),
+		      "and has moved the boundary exactly to its newest version when it returns");
+	});
+	onFreshThread([] {
+		const size_t perPage = cellsPerIndexPage();
+		TemporalConflictSet set(3, 0);
+		struct Written {
+			HeapRef record;
+			Version cv;
+		};
+		std::vector<Written> written;
+		int reclamations = 0;
+		bool covered = true, monotone = true;
+		for (Version cv = 1; cv <= 300; ++cv) {
+			const PageID reclaimedBefore = set.heap_.lastReclaimedPageID();
+			const Optional<Version> oldestNewest = set.heap_.oldestPageNewestCV();
+			const Version boundaryBefore = set.validationMinRV();
+			set.addPoint(cv, asRef(paddedKey(std::to_string(1000000 + cv * 7919 % 100000), 1000)));
+			if (set.heap_.lastReclaimedPageID() > reclaimedBefore) {
+				++reclamations;
+				covered = covered && oldestNewest.present() && set.validationMinRV() >= oldestNewest.get();
+			}
+			monotone = monotone && set.validationMinRV() >= boundaryBefore;
+			SkipEntry* bottom = newestTowerBottom(set);
+			if (bottom != nullptr && bottom->recordCV == cv) {
+				written.push_back({ bottom->record, cv });
+			}
+		}
+		check(reclamations >= 2, "history pages were reclaimed several times");
+		check(covered, "each time the boundary covered the reclaimed page's newest version");
+		check(monotone, "and it never went back");
+		check(set.heap_.reclaimedThroughCV().present() &&
+		          set.validationMinRV() >= set.heap_.reclaimedThroughCV().get(),
+		      "it covers everything reclaimed");
+
+		bool reclaimedUnreadable = true, retainedReadable = true;
+		for (const Written& w : written) {
+			if (w.record.pageID <= set.heap_.lastReclaimedPageID()) {
+				reclaimedUnreadable = reclaimedUnreadable && set.heap_.obsolete(w.record) &&
+				                      !set.heap_.getPoint(w.record).present();
+			} else {
+				Optional<PointConflictView> view = set.heap_.getPoint(w.record);
+				retainedReadable = retainedReadable && view.present() && view.get().cv == w.cv;
+			}
+		}
+		check(written.size() == 300, "every write was followed");
+		check(reclaimedUnreadable, "references into reclaimed pages no longer resolve");
+		check(retainedReadable, "retained records stay readable");
+
+		// Driven directly, with no insertion after it, so the boundary is read before any
+		// search could read a reclaimed key. A heap request may be met by an emptied index
+		// page instead, so it is repeated until history goes.
+		const PageID reclaimedBefore = set.heap_.lastReclaimedPageID();
+		Optional<Version> newest;
+		for (int attempt = 0; attempt < 4 && set.heap_.lastReclaimedPageID() == reclaimedBefore; ++attempt) {
+			newest = set.heap_.oldestPageNewestCV();
+			set.reclaimForAllocation(PageUse::Heap);
+		}
+		check(set.heap_.lastReclaimedPageID() == reclaimedBefore + 1, "a direct heap reclamation discards one page");
+		check(newest.present() && set.validationMinRV() >= newest.get(),
+		      "and has already moved the boundary over it when it returns");
+		check(indexesAreSound(set) && accountingHolds(set, perPage), "the structures stay sound and accounted");
+	});
+	end();
+}
+
+void insertionUsesBoundaryAdvancedDuringCellAllocation() {
+	begin("insertionUsesBoundaryAdvancedDuringCellAllocation");
+	onFreshThread([] {
+		const size_t perPage = cellsPerIndexPage();
+		std::mt19937 random(43);
+		TemporalConflictSet set(3, 0);
+		Version cv = 0;
+		// 1000-byte records: 64 fill the first heap page, the 65th starts the second.
+		while (set.budget().heapPages < 2 && cv < 1000) {
+			++cv;
+			set.addPoint(cv, asRef(paddedKey(randomKey(random, 20, 4), 1000)));
+		}
+		std::vector<SkipEntry*> held = drainFreeCells(set, set.points_.levels_[0].first_->record);
+		const uint32_t used = set.heap_.newest_->usedBytes;
+		check(set.budget().freePages == 0 && used + 1024 <= HISTORY_PAGE_BYTES,
+		      "the pool is full, no cell is free, and the newest heap page has room");
+		check(set.validationMinRV() == 0 && set.heap_.lastReclaimedPageID() == 0, "nothing has expired yet");
+
+		++cv;
+		const std::string key = paddedKey(randomKey(random, 20, 4), 1000);
+		set.addPoint(cv, asRef(key));
+
+		// The record fit on the newest heap page, so the reclamation happened while the
+		// insertion acquired its cells, not while appending the record.
+		check(set.heap_.lastReclaimedPageID() == 1, "the oldest heap page was reclaimed during cell allocation");
+		check(set.validationMinRV() > 0 && set.validationMinRV() < cv, "the boundary advanced below the new write");
+		check(set.budget().heapPages == 1 && set.budget().indexPages == 2,
+		      "the reclaimed page now serves the index");
+		SkipEntry* added = findLinked(set.points_, cv);
+		check(added != nullptr && added->beginWriteKey(set.heap_) == asRef(key), "the new write is in the index");
+		check(indexesAreSound(set), "the index is in key order among live cells, all readable");
+		check(accountingHolds(set, perPage, held.size()), "and every cell is accounted for");
+	});
+	end();
+}
+
+void urgentReclamationExceedsBatchBudget() {
+	begin("urgentReclamationExceedsBatchBudget");
+	const IntKnobOverride minNodes("paged_resolver_cleanup_min_nodes", SERVER_KNOBS->PAGED_RESOLVER_CLEANUP_MIN_NODES, 1);
+	const IntKnobOverride maxNodes("paged_resolver_cleanup_max_nodes", SERVER_KNOBS->PAGED_RESOLVER_CLEANUP_MAX_NODES, 1);
+	onFreshThread([] {
+		const size_t perPage = cellsPerIndexPage();
+		std::mt19937 random(47);
+		TemporalConflictSet set(3, 0);
+		check(set.minNodes_ == 1 && set.maxNodes_ == 1, "the batch budget is one cell");
+		const Version last = fillTwoIndexPages(set, random, false);
+		set.validationMinRV_ = last;
+
+		const size_t firstTower = size_t(towerHeight(set.cleanup_.oldest_));
+		check(set.cleanup() == firstTower, "a batch pass cleans one tower");
+		const size_t garbage = queueCells(set).size();
+		check(garbage > size_t(set.maxNodes_), "more expired cells remain than a batch pass may clean");
+
+		set.addPoint(last + 1, asRef(keyThatNeedsANewHeapPage(set)));
+		SkipEntry* added = findLinked(set.points_, last + 1);
+		check(added != nullptr, "the allocation succeeded through urgent reclamation");
+		check(queueCells(set).size() == size_t(added != nullptr ? towerHeight(added) : 0),
+		      "which cleaned every expired cell, far past the one-cell batch budget");
+		check(set.heap_.lastReclaimedPageID() == 0, "without discarding history");
+		check(indexesAreSound(set) && accountingHolds(set, perPage), "the structures stay sound and accounted");
+	});
+	end();
+}
+
+void urgentReclamationPreservesInsertionAccounting() {
+	begin("urgentReclamationPreservesInsertionAccounting");
+	onFreshThread([] {
+		std::mt19937 random(53);
+		TemporalConflictSet set(3, 0);
+		const Version last = fillTwoIndexPages(set, random, true);
+		check(set.insertedNodes_ == queueCells(set).size(), "points and ranges count every cell they insert");
+		const uint64_t before = set.insertedNodes_;
+
+		set.validationMinRV_ = last;
+		set.addPoint(last + 1, asRef(keyThatNeedsANewHeapPage(set)));
+		SkipEntry* added = findLinked(set.points_, last + 1);
+		check(added != nullptr && queueCells(set).size() == size_t(towerHeight(added)),
+		      "urgent reclamation ran during the insertion");
+		check(added != nullptr && set.insertedNodes_ == before + uint64_t(towerHeight(added)),
+		      "and the counter kept everything inserted since the last batch pass");
+
+		set.cleanup();
+		check(set.insertedNodes_ == 0, "only the batch pass consumes and resets it");
+	});
+	end();
+}
+
+void batchCleanupFinishesTheStartedTower() {
+	begin("batchCleanupFinishesTheStartedTower");
+	const IntKnobOverride minNodes("paged_resolver_cleanup_min_nodes", SERVER_KNOBS->PAGED_RESOLVER_CLEANUP_MIN_NODES, 1);
+	const IntKnobOverride maxNodes("paged_resolver_cleanup_max_nodes", SERVER_KNOBS->PAGED_RESOLVER_CLEANUP_MAX_NODES, 1);
+	onFreshThread([] {
+		const size_t perPage = cellsPerIndexPage();
+		TemporalConflictSet set(8, 0);
+		LevelMirror mirror;
+		steerNextHeight(set, mirror, 3);
+		const int expected = mirror.next() + 1;
+		set.addPoint(1, asRef("b"));
+		SkipEntry* first = newestTowerBottom(set);
+		check(towerHeight(first) == expected && expected >= 3, "the first tower is at least three cells tall, as steered");
+		std::vector<SkipEntry*> firstCells;
+		for (SkipEntry* e = first; e != nullptr; e = e->up) {
+			firstCells.push_back(e);
+		}
+		mirror.next();
+		set.addPoint(2, asRef("a"));
+		SkipEntry* second = newestTowerBottom(set);
+		mirror.next();
+		set.addPoint(3, asRef("c"));
+
+		set.validationMinRV_ = 3;
+		const uint64_t cleaned = set.cleanup();
+		check(cleaned == uint64_t(expected), "a one-cell budget still recycles the whole first tower");
+		bool recycled = true;
+		for (SkipEntry* e : firstCells) {
+			recycled = recycled && e->record.pageID == 0 && !e->linkedInLevel;
+		}
+		check(recycled, "every cell of it is free");
+		check(set.cleanup_.oldest_ == second, "and the next tower was not started");
+		check(second->linkedInLevel && findLinked(set.points_, 3) != nullptr, "the remaining towers stay linked");
+		check(indexesAreSound(set) && accountingHolds(set, perPage), "the structures stay sound and accounted");
+	});
+	end();
+}
+
+void cleanupAcceptsPreviouslyDetachedTowers() {
+	begin("cleanupAcceptsPreviouslyDetachedTowers");
+	onFreshThread([] {
+		const size_t perPage = cellsPerIndexPage();
+		std::mt19937 random(59);
+		TemporalConflictSet set(8, 0);
+		for (Version cv = 1; cv <= 40; ++cv) {
+			set.addPoint(cv, asRef(randomKey(random, 6, 3)));
+		}
+		SkipEntry* expired = set.cleanup_.oldest_;
+		const int height = towerHeight(expired);
+		set.validationMinRV_ = 1;
+		// A search reaches only the cells on its path; one for the expired tower's own key
+		// meets the tower at its top level.
+		const std::string key = expired->beginWriteKey(set.heap_).toString();
+		set.points_.findInsertionPath(asRef(key), 1);
+
+		bool detached = true;
+		for (SkipEntry* e = expired; e != nullptr; e = e->up) {
+			detached = detached && !e->linkedInLevel;
+		}
+		if (!check(detached, "the search detached the expired tower")) {
+			return;
+		}
+
+		struct Snapshot {
+			SkipEntry *previous, *next, *up, *down;
+			Optional<Version> maxCV;
+		};
+		std::vector<std::pair<SkipEntry*, Snapshot>> kept;
+		std::vector<Optional<Version>> prefixes;
+		for (int L = 0; L < TemporalSkipList::MaxLevels; ++L) {
+			prefixes.push_back(set.points_.levels_[L].prefixSummary().maxCV);
+			for (SkipEntry* e = set.points_.levels_[L].first_; e != nullptr; e = e->next) {
+				kept.push_back({ e, { e->previous, e->next, e->up, e->down, e->summary.maxCV } });
+			}
+		}
+
+		check(set.cleanup() == uint64_t(height), "the detached tower is recycled");
+		bool unchanged = true;
+		for (auto& [e, s] : kept) {
+			unchanged = unchanged && e->linkedInLevel && e->previous == s.previous && e->next == s.next &&
+			            e->up == s.up && e->down == s.down && e->summary.maxCV == s.maxCV;
+		}
+		for (int L = 0; L < TemporalSkipList::MaxLevels; ++L) {
+			unchanged = unchanged && set.points_.levels_[L].prefixSummary().maxCV == prefixes[L];
+		}
+		check(unchanged, "without transferring its summaries again or touching the kept towers");
+		check(set.cleanup_.oldestCV() == 2, "and the queue resumes at the next write");
+		check(indexesAreSound(set) && accountingHolds(set, perPage), "the structures stay sound and accounted");
+	});
+
+	// A detached tower keeps its stale links. If its level-zero predecessor is recycled
+	// and reused before the tower leaves the queue, a second transfer would land on a
+	// write that has nothing to do with it. Ranges show it: merging into a live end marks
+	// the target for repair, which the new write's own span must never be.
+	const IntKnobOverride minNodes("paged_resolver_cleanup_min_nodes", SERVER_KNOBS->PAGED_RESOLVER_CLEANUP_MIN_NODES, 1);
+	const IntKnobOverride maxNodes("paged_resolver_cleanup_max_nodes", SERVER_KNOBS->PAGED_RESOLVER_CLEANUP_MAX_NODES, 1);
+	onFreshThread([] {
+		TemporalConflictSet set(8, 0);
+		LevelMirror mirror;
+		steerExactHeight(set, mirror, 1);
+		mirror.next();
+		const HeapRef p = set.heap_.appendRange(5, asRef("p"), asRef("p~")).get();
+		set.ranges_.insert(p, 5, set.validationMinRV_, set.indexAllocator_, set.cleanup_);
+		SkipEntry* predecessor = set.ranges_.levels_[0].first_;
+		mirror.next();
+		const HeapRef t = set.heap_.appendRange(1, asRef("t"), asRef("t~")).get();
+		set.ranges_.insert(t, 1, set.validationMinRV_, set.indexAllocator_, set.cleanup_);
+		SkipEntry* tower = predecessor != nullptr ? predecessor->next : nullptr;
+		if (!check(tower != nullptr && tower->recordCV == 1 && tower->previous == predecessor &&
+		               towerHeight(predecessor) == 1,
+		           "a one-cell range tower precedes, at level zero, a tower queued after it")) {
+			return;
+		}
+
+		set.validationMinRV_ = 1;
+		set.ranges_.findInsertionPath(asRef("t"), 1);
+		check(!tower->linkedInLevel, "the search detached the later tower");
+
+		set.validationMinRV_ = 5;
+		check(set.cleanup() == 1, "a one-cell pass recycles the predecessor alone");
+		mirror.next();
+		set.addRange(6, asRef("a"), asRef("a~"));
+		SkipEntry* reused = findLinked(set.ranges_, 6);
+		if (!check(reused == predecessor, "the next write reuses the predecessor's cell")) {
+			return;
+		}
+		const MaxEndState stateBefore = reused->summary.maxEnd.state;
+		const Optional<Version> maxCVBefore = reused->summary.maxCV;
+
+		check(set.cleanup() == uint64_t(towerHeight(tower)), "the detached tower is recycled");
+		check(reused->summary.maxEnd.state == stateBefore && stateBefore == MaxEndState::Valid &&
+		          reused->summary.maxCV == maxCVBefore,
+		      "without merging anything into the write that reused its old predecessor");
+	});
+	end();
+}
+
+void cleanupStopsAtALiveHead() {
+	begin("cleanupStopsAtALiveHead");
+	onFreshThread([] {
+		TemporalConflictSet empty(4, 0);
+		check(empty.cleanup() == 0, "an empty queue yields no work");
+
+		TemporalConflictSet live(4, 5);
+		live.addPoint(10, asRef("a"));
+		live.addPoint(11, asRef("b"));
+		const size_t queued = queueCells(live).size();
+		check(live.cleanup() == 0 && queueCells(live).size() == queued, "a live head yields no work");
+
+		// A live head with an expired tower behind it. Writes reach the queue in version
+		// order through addPoint, so this places a lower recordCV behind a higher one
+		// directly, as approximate queue order allows.
+		TemporalConflictSet mixed(4, 0);
+		const HeapRef head = mixed.heap_.appendPoint(10, asRef("h")).get();
+		mixed.points_.insert(head, 10, mixed.validationMinRV_, mixed.indexAllocator_, mixed.cleanup_);
+		const HeapRef behind = mixed.heap_.appendPoint(10, asRef("g")).get();
+		mixed.points_.insert(behind, 3, mixed.validationMinRV_, mixed.indexAllocator_, mixed.cleanup_);
+		mixed.validationMinRV_ = 5;
+		const size_t before = queueCells(mixed).size();
+		check(mixed.cleanup() == 0, "a live head stops cleanup even with an expired tower behind it");
+		check(queueCells(mixed).size() == before && findLinked(mixed.points_, 3) != nullptr,
+		      "the expired tower is neither skipped to nor removed");
+
+		mixed.validationMinRV_ = 10;
+		check(mixed.cleanup() == before && queueCells(mixed).empty(), "once the head expires, both go");
+	});
+	end();
+}
+
+void undersizedPoolFailsWithoutRecyclingTheCurrentRecord() {
+	begin("undersizedPoolFailsWithoutRecyclingTheCurrentRecord");
+	onFreshThread([] {
+		bool failed = false;
+		{
+			TemporalConflictSet set(2, 0);
+			for (Version cv = 1; cv <= 10; ++cv) {
+				set.addPoint(cv, asRef(paddedKey(std::to_string(cv), 16)));
+			}
+			const HeapRef earlier = set.points_.levels_[0].first_->record;
+			drainFreeCells(set, earlier);
+			// Driven directly first: with nothing expired and one heap page, an index
+			// request must leave that page alone.
+			set.reclaimForAllocation(PageUse::Index);
+			check(set.heap_.lastReclaimedPageID() == 0 && set.validationMinRV() == 0,
+			      "a direct index reclamation does not take the last heap page");
+			try {
+				set.addPoint(11, asRef("fits on the only heap page"));
+			} catch (std::bad_alloc&) {
+				failed = true;
+			}
+			check(failed, "with no expired tower and one heap page, allocation fails");
+			check(set.heap_.lastReclaimedPageID() == 0 && set.budget().heapPages == 1,
+			      "without reclaiming the page that holds the record being inserted");
+			check(set.validationMinRV() == 0, "and without moving the boundary");
+			check(set.heap_.getPoint(earlier).present(), "earlier records on that page stay readable");
+		}
+		check(failed, "the set is destroyed after the failure without further use");
+	});
+	end();
+}
+
+void sustainedReclamationKeepsTheStructuresSound() {
+	begin("sustainedReclamationKeepsTheStructuresSound");
+	onFreshThread([] {
+		const size_t perPage = cellsPerIndexPage();
+		std::mt19937 random(61);
+		TemporalConflictSet set(8, 0);
+		bool sound = true, accounted = true, monotone = true;
+		Version boundary = set.validationMinRV();
+		for (Version cv = 1; cv <= 6000 && sound && accounted; ++cv) {
+			const std::string key = paddedKey(randomKey(random, 16, 4), 20 + random() % 400);
+			if (random() % 3 == 0) {
+				set.addRange(cv, asRef(key), asRef(key + randomKey(random, 4, 3)));
+			} else {
+				set.addPoint(cv, asRef(key));
+			}
+			if (cv % 16 == 0) {
+				set.cleanup();
+			}
+			monotone = monotone && set.validationMinRV() >= boundary;
+			boundary = set.validationMinRV();
+			if (cv % 250 == 0) {
+				sound = indexesAreSound(set);
+				accounted = accountingHolds(set, perPage);
+			}
+		}
+		check(sound, "links, key order and live records hold throughout");
+		check(accounted, "pages and cells add up throughout");
+		check(monotone, "the boundary never goes back");
+		check(set.heap_.lastReclaimedPageID() >= 5, "through several cycles of history reclamation");
+		check(set.budget().indexPages > 0 && set.budget().heapPages > 0, "with both uses sharing the pool");
+	});
+	end();
+}
+
+// The batch budget: max(minimum, ceil(inserted * ratio)), multiplied once by the boost
+// factor when free pages are scarce or the queue lags, capped at the maximum. Every tower
+// here is steered to height one, so a pass cleans exactly its budget while enough
+// expired cells remain, and its return value is the budget itself.
+struct BudgetKnobs {
+	KnobOverride<double> perInserted;
+	KnobOverride<int> minNodes;
+	KnobOverride<double> lowFreeRatio;
+	KnobOverride<int64_t> lagVersions;
+	KnobOverride<double> boost;
+	KnobOverride<int> maxNodes;
+	BudgetKnobs(double lowFree, int64_t lag, int max)
+	  : perInserted("paged_resolver_cleanup_nodes_per_inserted_node",
+	                SERVER_KNOBS->PAGED_RESOLVER_CLEANUP_NODES_PER_INSERTED_NODE, 0.5),
+	    minNodes("paged_resolver_cleanup_min_nodes", SERVER_KNOBS->PAGED_RESOLVER_CLEANUP_MIN_NODES, 4),
+	    lowFreeRatio("paged_resolver_cleanup_low_free_page_ratio",
+	                 SERVER_KNOBS->PAGED_RESOLVER_CLEANUP_LOW_FREE_PAGE_RATIO, lowFree),
+	    lagVersions("paged_resolver_cleanup_lag_versions", SERVER_KNOBS->PAGED_RESOLVER_CLEANUP_LAG_VERSIONS, lag),
+	    boost("paged_resolver_cleanup_boost_factor", SERVER_KNOBS->PAGED_RESOLVER_CLEANUP_BOOST_FACTOR, 3.0),
+	    maxNodes("paged_resolver_cleanup_max_nodes", SERVER_KNOBS->PAGED_RESOLVER_CLEANUP_MAX_NODES, max) {}
+};
+
+// Builds a set of eight pages holding `writes` one-cell towers at versions 1..writes,
+// sets the boundary, and runs one pass with `inserted` as the counter. Returns what the
+// pass cleaned, or nothing if the set could not be built as intended.
+struct BudgetRun {
+	Optional<uint64_t> cleaned;
+	double freeRatio = 0;
+	uint64_t counterAfter = 1;
+};
+BudgetRun runBudgetPass(int writes, Version boundary, uint64_t inserted) {
+	BudgetRun run;
+	onFreshThread([&] {
+		TemporalConflictSet set(8, 0);
+		LevelMirror mirror;
+		for (Version cv = 1; cv <= writes; ++cv) {
+			steerExactHeight(set, mirror, 1);
+			mirror.next();
+			set.addPoint(cv, asRef(paddedKey(std::to_string(1000 + cv), 8)));
+		}
+		if (queueCells(set).size() != size_t(writes)) {
+			return;
+		}
+		set.validationMinRV_ = boundary;
+		set.insertedNodes_ = inserted;
+		const PageBudget& b = set.budget();
+		run.freeRatio = double(b.freePages) / double(b.limitPages);
+		run.cleaned = set.cleanup();
+		run.counterAfter = set.insertedNodes_;
+	});
+	return run;
+}
+
+bool budgetIs(const BudgetRun& run, uint64_t expected) {
+	return run.cleaned.present() && run.cleaned.get() == expected && run.counterAfter == 0;
+}
+
+void theBudgetFollowsInsertionsWithoutABoost() {
+	begin("theBudgetFollowsInsertionsWithoutABoost");
+	// No boost: the ratio is zero and the lag unreachable.
+	const BudgetKnobs knobs(0.0, 1000000, 1000);
+	check(budgetIs(runBudgetPass(200, 200, 9), 5), "ceil(9 * 0.5) = 5 cells");
+	check(budgetIs(runBudgetPass(200, 200, 2), 4), "the minimum of 4 when insertions ask for less");
+	check(budgetIs(runBudgetPass(200, 200, 0), 4), "and when nothing was inserted");
+	check(budgetIs(runBudgetPass(200, 3, 100), 3), "never more than the expired cells");
+	end();
+}
+
+void scarceFreePagesBoostTheBudget() {
+	begin("scarceFreePagesBoostTheBudget");
+	// 200 short writes take one heap page and one index page of eight: 6/8 = 0.75 free.
+	{
+		const BudgetKnobs knobs(0.76, 1000000, 1000);
+		const BudgetRun run = runBudgetPass(200, 200, 9);
+		check(run.freeRatio == 0.75, "the pool is at the expected free-page ratio");
+		check(budgetIs(run, 15), "a ratio below the knob multiplies ceil(9 * 0.5) = 5 by 3");
+	}
+	{
+		const BudgetKnobs knobs(0.75, 1000000, 1000);
+		check(budgetIs(runBudgetPass(200, 200, 9), 5), "a ratio equal to the knob is not scarce");
+	}
+	{
+		const BudgetKnobs knobs(0.76, 1000000, 1000);
+		check(budgetIs(runBudgetPass(200, 200, 2), 12), "the boost applies to the minimum too");
+	}
+	end();
+}
+
+void aLaggingQueueBoostsTheBudget() {
+	begin("aLaggingQueueBoostsTheBudget");
+	// The head is at version 1; the boundary at 101 is 100 versions past it.
+	{
+		const BudgetKnobs knobs(0.0, 100, 1000);
+		check(budgetIs(runBudgetPass(200, 101, 9), 15), "a lag equal to the knob boosts");
+	}
+	{
+		const BudgetKnobs knobs(0.0, 101, 1000);
+		check(budgetIs(runBudgetPass(200, 101, 9), 5), "a lag one short of it does not");
+	}
+	{
+		// A head newer than the boundary: nothing has expired, so nothing is cleaned,
+		// whatever the unsigned distance would have said.
+		const BudgetKnobs knobs(0.0, 0, 1000);
+		check(budgetIs(runBudgetPass(200, 0, 9), 0), "a head that has not expired is not lagging and yields no work");
+	}
+	end();
+}
+
+void bothConditionsBoostTheBudgetOnce() {
+	begin("bothConditionsBoostTheBudgetOnce");
+	const BudgetKnobs knobs(0.76, 100, 1000);
+	const BudgetRun run = runBudgetPass(200, 101, 9);
+	check(run.freeRatio == 0.75, "free pages are scarce");
+	check(budgetIs(run, 15), "and the queue lags, yet 5 is multiplied by 3 once, not twice (45)");
+	end();
+}
+
+void theBoostedBudgetSaturatesAtTheMaximum() {
+	begin("theBoostedBudgetSaturatesAtTheMaximum");
+	{
+		const BudgetKnobs knobs(0.76, 100, 12);
+		check(budgetIs(runBudgetPass(200, 101, 9), 12), "a boosted 15 is capped at 12");
+	}
+	{
+		const BudgetKnobs knobs(0.0, 1000000, 12);
+		check(budgetIs(runBudgetPass(200, 200, 100), 12), "an unboosted 50 is capped at 12");
+	}
+	{
+		const BudgetKnobs knobs(0.76, 100, 15);
+		check(budgetIs(runBudgetPass(200, 101, 9), 15), "a cap equal to the boosted budget does not cut it");
+	}
+	end();
+}
+
+// ---------- Conflict detection ----------
+//
+// Reads are [begin, end), and a write conflicts when its version is above the read
+// version and it overlaps the read. Heights are steered, so every structure a case
+// names is the one it builds
+
+std::string printed(const char* form, ...) {
+	char buffer[1024];
+	va_list args;
+	va_start(args, form);
+	vsnprintf(buffer, sizeof buffer, form, args);
+	va_end(args);
+	return buffer;
+}
+
+void writeRange(TemporalConflictSet& set, LevelMirror& mirror, int height, Version cv, const std::string& from,
+                const std::string& to) {
+	steerExactHeight(set, mirror, height);
+	mirror.next();
+	set.addRange(cv, asRef(from), asRef(to));
+}
+
+void writePoint(TemporalConflictSet& set, LevelMirror& mirror, int height, Version cv, const std::string& key) {
+	steerExactHeight(set, mirror, height);
+	mirror.next();
+	set.addPoint(cv, asRef(key));
+}
+
+// The owner's answer, or nothing when it rejects the read version as too old
+Optional<bool> ownerConflict(TemporalConflictSet& set, Version readVersion, const std::string& from,
+                             const std::string& to) {
+	try {
+		return set.hasConflict(readVersion, asRef(from), asRef(to));
+	} catch (Error& e) {
+		if (e.code() == error_code_transaction_too_old) {
+			return Optional<bool>();
+		}
+		throw;
+	}
+}
+
+bool answers(const Optional<bool>& answer, bool expected) {
+	return answer.present() && answer.get() == expected;
+}
+
+bool rangeConflict(TemporalConflictSet& set, Version readVersion, const std::string& from, const std::string& to) {
+	return set.ranges_.hasRangeConflict(readVersion, asRef(from), asRef(to), set.validationMinRV_);
+}
+
+bool pointConflict(TemporalConflictSet& set, Version readVersion, const std::string& from, const std::string& to) {
+	return set.points_.hasPointConflict(readVersion, asRef(from), asRef(to), set.validationMinRV_);
+}
+
+// Every cell of every level with its links and mark, in level order
+using LinkRow = std::array<const void*, 6>;
+std::vector<LinkRow> linksOf(const TemporalSkipList& list) {
+	std::vector<LinkRow> rows;
+	for (int L = 0; L < TemporalSkipList::MaxLevels; ++L) {
+		for (SkipEntry* e = list.levels_[L].first_; e != nullptr; e = e->next) {
+			rows.push_back({ e, e->previous, e->next, e->up, e->down, e->linkedInLevel ? e : nullptr });
+		}
+	}
+	return rows;
+}
+
+// The cells of level `level`, in order
+std::vector<SkipEntry*> levelCells(const TemporalSkipList& list, int level) {
+	std::vector<SkipEntry*> cells;
+	for (SkipEntry* e = list.levels_[level].first_; e != nullptr; e = e->next) {
+		cells.push_back(e);
+	}
+	return cells;
+}
+
+std::vector<Version> levelVersions(const TemporalSkipList& list, int level) {
+	std::vector<Version> versions;
+	for (SkipEntry* e : levelCells(list, level)) {
+		versions.push_back(e->recordCV);
+	}
+	return versions;
+}
+
+void markForRepair(SpanSummary& summary) {
+	summary.maxEnd.state = MaxEndState::NeedsRepair;
+	summary.maxEnd.value = Optional<EndpointRef>();
+}
+
+void readsBelowTheBoundaryAreTooOld() {
+	begin("readsBelowTheBoundaryAreTooOld");
+	onFreshThread([] {
+		TemporalConflictSet empty(4, 100);
+		check(!ownerConflict(empty, 99, "a", "z").present(), "an empty set rejects a read version below the boundary");
+		check(answers(ownerConflict(empty, 100, "a", "z"), false), "and accepts one equal to it");
+
+		TemporalConflictSet set(4, 100);
+		set.addPoint(150, asRef("k"));
+		set.addRange(160, asRef("m"), asRef("p"));
+		check(!ownerConflict(set, 99, "x", "y").present(), "a read below the boundary is rejected where nothing could conflict");
+		check(!ownerConflict(set, 99, "k", "l").present() && !ownerConflict(set, 99, "n", "o").present(),
+		      "and where something would");
+		check(answers(ownerConflict(set, 100, "x", "y"), false), "a read at the boundary is admitted");
+
+		// The boundary admits equality, and so does the conflict condition, the other way
+		check(answers(ownerConflict(set, 150, "k", "l"), false), "a point written at the read version does not conflict");
+		check(answers(ownerConflict(set, 149, "k", "l"), true), "one written after it does");
+		check(answers(ownerConflict(set, 160, "n", "o"), false), "a range written at the read version does not");
+		check(answers(ownerConflict(set, 159, "n", "o"), true), "one written after it does");
+	});
+	end();
+}
+
+void pointConflictsRespectHalfOpenReads() {
+	begin("pointConflictsRespectHalfOpenReads");
+	onFreshThread([] {
+		TemporalConflictSet set(8, 0);
+		set.addPoint(10, asRef("b"));
+		set.addPoint(20, asRef("d"));
+		set.addPoint(30, asRef("f"));
+		check(pointConflict(set, 5, "d", "e"), "a point at the read's begin conflicts");
+		check(!pointConflict(set, 5, "c", "d"), "a point at its end does not");
+		check(!pointConflict(set, 5, "g", "z"), "nor do points before it, reaching the end of the list");
+		check(!pointConflict(set, 5, "a", "b"), "nor points after it");
+		check(!pointConflict(set, 5, "d", "d") && !pointConflict(set, 5, "e", "c"), "an empty read conflicts with nothing");
+		check(pointConflict(set, 25, "a", "z") && !pointConflict(set, 30, "a", "z"),
+		      "old points followed by a newer one conflict, and only through the newer one");
+
+		TemporalConflictSet same(8, 0);
+		same.addPoint(10, asRef("k"));
+		same.addPoint(20, asRef("k"));
+		check(pointConflict(same, 15, "k", "l"), "of two writes to one key, the newer conflicts");
+		check(!pointConflict(same, 20, "k", "l"), "and neither does once both are at or below the read version");
+
+		TemporalConflictSet mixed(8, 0);
+		mixed.addPoint(10, asRef("b"));
+		mixed.addPoint(20, asRef("c"));
+		check(pointConflict(mixed, 15, "a", "z"), "an old node followed by a conflicting one conflicts");
+		check(!pointConflict(mixed, 15, "a", "c"), "and not when the conflicting one is at the read's end");
+	});
+	end();
+}
+
+void rangeOverlapIsHalfOpen() {
+	begin("rangeOverlapIsHalfOpen");
+	onFreshThread([] {
+		TemporalConflictSet set(8, 0);
+		set.addRange(20, asRef("d"), asRef("h"));
+		check(rangeConflict(set, 10, "d", "h"), "equal ranges conflict");
+		check(rangeConflict(set, 10, "c", "i"), "a write inside the read conflicts");
+		check(rangeConflict(set, 10, "e", "f"), "a read inside the write conflicts");
+		check(rangeConflict(set, 10, "b", "e"), "an overlap on the write's left conflicts");
+		check(rangeConflict(set, 10, "g", "j"), "an overlap on its right conflicts");
+		check(!rangeConflict(set, 10, "a", "c") && !rangeConflict(set, 10, "i", "k"), "separate ranges do not");
+		check(!rangeConflict(set, 10, "h", "k"), "a read that begins where the write ends does not");
+		check(!rangeConflict(set, 10, "a", "d"), "a read that ends where the write begins does not");
+		check(!rangeConflict(set, 10, "e", "e") && !rangeConflict(set, 10, "f", "e"), "an empty read does not");
+		check(!rangeConflict(set, 20, "d", "h"), "a write at the read version does not");
+		check(answers(ownerConflict(set, 10, "g", "j"), true) && answers(ownerConflict(set, 10, "h", "k"), false),
+		      "the owner answers the same");
+	});
+
+	// A newer write later in the tower's span keeps the summary from deciding, so the
+	// tower's own record is compared, at level 1, under the same half-open rules
+	onFreshThread([] {
+		TemporalConflictSet upper(8, 0);
+		LevelMirror mirror;
+		writeRange(upper, mirror, 2, 20, "d", "h");
+		writeRange(upper, mirror, 1, 30, "x", "y");
+		SkipEntry* tower = upper.ranges_.levels_[1].first_;
+		if (!check(tower != nullptr && tower->summary.maxCV.present() && tower->summary.maxCV.get() == 30,
+		           "the tower's span holds the newer write")) {
+			return;
+		}
+		check(!rangeConflict(upper, 20, "e", "f"), "a write at the read version does not conflict there either");
+		check(rangeConflict(upper, 19, "e", "f"), "one after it does");
+		check(!rangeConflict(upper, 10, "h", "k"), "nor does a read that begins where the write ends");
+		check(!rangeConflict(upper, 10, "a", "d"), "nor one that ends where it begins");
+	});
+	end();
+}
