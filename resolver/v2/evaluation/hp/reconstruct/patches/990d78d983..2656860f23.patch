+#define main inheritedBTreeTestsMain
+#include "btree/tests/BTreeTests.cpp"
+#undef main
+int main() {
+    setThreadLocalDeterministicRandomSeed(1);
+    for(bool unified:{true}) {
+        Tree::MemoryConfig config;
+        Tree tree(8,0,config);
+        uint32_t rng=123;
+        for(unsigned batch=1;batch<=600;++batch) {
+            std::vector<std::string> keys;keys.reserve(32);
+            std::vector<Tree::Write> writes;
+            for(unsigned i=0;i<32;++i) {
+                rng=rng*1664525u+1013904223u;
+                unsigned rank=rng%4000;
+                std::string k(batch%3==0?16:128,'q');
+                size_t offset=batch%2?k.size()-4:0;
+                for(unsigned j=0;j<4;++j)k[offset+j]=char(rank>>(24-8*j));
+                keys.push_back(k);writes.push_back({sv(keys.back()),{},ConflictKind::Point});
+            }
+            tree.addWrites(batch,writes.data(),writes.size());
+            uint64_t h=14695981039346656037ull;
+            auto byte=[&](unsigned char b){h^=b;h*=1099511628211ull;};
+            for(auto& [b,e,v]:contents(tree)) {
+                for(unsigned char x:b)byte(x);
+                for(unsigned char x:e)byte(x);
+                for(unsigned j=0;j<8;++j)byte(uint64_t(v)>>(j*8));
+                std::printf("I %zu %zu %lld ",b.size(),e.size(),(long long)v);
+                for(unsigned char x:b)std::printf("%02x",x);
+                std::putchar(' ');
+                for(unsigned char x:e)std::printf("%02x",x);
+                std::putchar('\n');
+            }
+            auto st=tree.stats();
+            std::printf("B %d %u %lld %llu %llu %llu %llu %llu %llu %llu\n",unified,batch,(long long)tree.validationMinRV(),
+                (unsigned long long)tree.nodeCount(),(unsigned long long)tree.leafCount(),(unsigned long long)tree.keyBlockCount(),
+                (unsigned long long)tree.freeNodeCount(),(unsigned long long)st.splits,(unsigned long long)st.pressureNodesMadeAvailable,
+                (unsigned long long)h);
+        }
+    }
+}
diff --git a/fdbserver/resolver/btree/tests/WriteTwoPassTests.cpp b/fdbserver/resolver/btree/tests/WriteTwoPassTests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c360f9c6c250da07ace105b255e339dc295e92e4
--- /dev/null
+++ b/fdbserver/resolver/btree/tests/WriteTwoPassTests.cpp
@@ -0,0 +1,113 @@
+#define main inheritedBTreeTestsMain
+#include "btree/tests/BTreeTests.cpp"
+#undef main
+
+std::string writeKey(unsigned n, size_t bytes, bool shared) {
+    std::string s(bytes, 'q');
+    size_t offset = shared ? bytes - 4 : 0;
+    for (unsigned i = 0; i < 4; ++i) s[offset + i] = char(n >> (24 - 8 * i));
+    return s;
+}
+void selectiveWriteSearch(bool unified, size_t bytes, bool shared, bool exact = false) {
+    Tree::MemoryConfig config;
+    Tree tree(512, 0, config);
+    for (unsigned i = 0; i < 512; ++i) {
+        auto k = writeKey(i * 4 + 2, bytes, shared);
+        tree.addPoint(1, sv(k));
+    }
+    CHECK(tree.height() > 1);
+    for (unsigned count : {1, 2, 17, 93, 511}) {
+        std::vector<std::string> strings;
+        strings.reserve(count);
+        std::vector<Tree::Write> writes;
+        for (unsigned i = 0; i < count; ++i) {
+            strings.push_back(writeKey(4 * (i * 525 / count) + (exact ? 2 : 1), bytes, shared));
+            writes.push_back({sv(strings.back()), {}, ConflictKind::Point});
+        }
+        if (count > 2) writes[1] = writes[0];
+        std::reverse(writes.begin(), writes.end());
+        auto before = tree.stats();
+        searchBatch(tree, writes);
+        auto after = tree.stats();
+        for (const auto& w : writes) CHECK(tree.findLeaf(w.begin) != nullptr);
+        for (size_t i = 0; i < writes.size(); ++i)
+            CHECK(tree.writeHints_[i].node == tree.findLeaf(writes[i].begin));
+        if constexpr (Tree::Stats::searchEnabled) {
+            const auto loads = after.keyComparisonFallbacks - before.keyComparisonFallbacks;
+            const auto requests = after.writeSeparatorPrefetches - before.writeSeparatorPrefetches;
+            const auto pauses = after.writeSeparatorPrepareNodes - before.writeSeparatorPrepareNodes;
+            CHECK(pauses == after.writeSeparatorFinishNodes - before.writeSeparatorFinishNodes);
+            if (!shared && !exact && Tree::InlineKeyBytes >= 4) {
+                CHECK(loads == 0);
+                CHECK(requests == 0);
+                CHECK(pauses == 0);
+            }
+            if (shared && bytes > Tree::InlineKeyBytes + Tree::NodePrefixBytes + 4) {
+                CHECK(loads > 0);
+                if constexpr (PAGED_BTREE_WRITE_PREFETCH) CHECK(requests > 0 && pauses > 0);
+                else CHECK(requests == 0 && pauses == 0);
+            }
+        }
+    }
+}
+void pressureWriteSearch(bool unified) {
+    Tree::MemoryConfig config;
+    Tree grouped(8,0,config);
+    uint32_t rng = 123;
+    for (unsigned batch = 1; batch <= 300; ++batch) {
+        std::vector<std::string> keys;
+        std::vector<Tree::Write> writes;
+        keys.reserve(32);
+        for (unsigned i=0; i<32; ++i) {
+            rng = rng * 1664525u + 1013904223u;
+            keys.push_back(writeKey(rng % 4000, 128, batch % 2));
+            writes.push_back({sv(keys.back()),{},ConflictKind::Point});
+        }
+        searchBatch(grouped,writes);
+        for(size_t i=0;i<writes.size();++i)
+            CHECK(grouped.writeHints_[i].node==(grouped.root_ ? grouped.findLeaf(writes[i].begin) : nullptr));
+        grouped.addWrites(batch,writes.data(),writes.size());
+    }
+    CHECK(grouped.validationMinRV()>0);
+}
+void collectBeforeFinish(bool unified) {
+    if constexpr (!PAGED_BTREE_WRITE_PREFETCH || !Tree::Stats::searchEnabled) return;
+    Tree::MemoryConfig config;
+    Tree tree(512,0,config);
+    std::vector<std::string> keys; keys.reserve(4096);
+    for(unsigned i=0;i<4096;++i) {
+        keys.push_back(writeKey(4*i+2,256,true));
+        tree.addPoint(1,sv(keys.back()));
+        if(!tree.root_->leaf && tree.root_->size()>=4) break;
+    }
+    CHECK(tree.height()==2);
+    std::array<unsigned,Tree::Capacity> ranks;
+    unsigned live=tree.liveRanks(tree.root_,ranks);
+    CHECK(live>=4);
+    std::vector<Tree::Write> writes;
+    for(auto& k:keys) writes.push_back({sv(k),{},ConflictKind::Point});
+    auto before=tree.stats();
+    searchBatch(tree,writes);
+    auto after=tree.stats();
+    CHECK(after.writeSeparatorPrepareNodes-before.writeSeparatorPrepareNodes==1);
+    CHECK(after.writeSeparatorFinishNodes-before.writeSeparatorFinishNodes==1);
+    CHECK(after.writeSeparatorPrefetches-before.writeSeparatorPrefetches==live-1);
+    for(size_t i=0;i<writes.size();++i)
+        CHECK(tree.writeHints_[i].node==tree.findLeaf(writes[i].begin));
+}
+int main() {
+    setThreadLocalDeterministicRandomSeed(1);
+    try {
+        for (bool unified : {true}) {
+            for (auto bytes : {size_t(16),size_t(128),size_t(10240)})
+                for (bool shared : {false,true})
+                    for (bool exact : {false,true}) selectiveWriteSearch(unified,bytes,shared,exact);
+            pressureWriteSearch(unified);
+            collectBeforeFinish(unified);
+        }
+        groupedDestinationsMatchScalar();
+        groupedWritesMatchScalarAfterSplits();
+        std::puts("WriteTwoPassR2Tests PASS: grouped preparation before one finish per node; unified pool, inline/distinct/shared/fragmented keys, duplicate and unsorted queries, pressure, scalar destinations and writes");
+        return 0;
+    } catch (const std::exception& e) { std::fprintf(stderr,"FAIL %s\n",e.what()); return 1; }
+}
