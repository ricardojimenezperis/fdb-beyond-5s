+void aPathSearchPausedWhileAnotherUnlinksItsCell() {
+	begin("aPathSearchPausedWhileAnotherUnlinksItsCell");
+	onFreshThread([] {
+		TemporalConflictSet set(8, 0);
+		LevelMirror mirror;
+		writePoint(set, mirror, 1, 1, "b");
+		writePoint(set, mirror, 2, 2, "c");
+		writePoint(set, mirror, 1, 10, "a");
+		writePoint(set, mirror, 1, 11, "zz");
+		PreparedWrite group[2];
+		preparePoint(set, mirror, group[0], 1, 20, "p");
+		preparePoint(set, mirror, group[1], 1, 20, "q");
+		set.validationMinRV_ = 5;
+		SkipEntry* expired = cellAt(set.points_, 0, 1);
+		SkipEntry* cTop = cellAt(set.points_, 1, 2);
+		if (!check(expired != nullptr && cTop != nullptr &&
+		               levelVersions(set.points_, 0) == (std::vector<Version>{ 10, 1, 2, 11 }),
+		           "two expired towers, b and c, lie between a and zz, c reaching level 1")) {
+			return;
+		}
+
+		PathSearch waiting, unlinking;
+		set.points_.startPathSearch(waiting, group[0]);
+		bool paused = false;
+		for (int i = 0; i < 1000 && !paused; ++i) {
+			paused = waiting.current == expired && !waiting.recordPending;
+			if (!paused && set.points_.stepPathSearch(waiting, 5)) {
+				break;
+			}
+		}
+		check(paused && waiting.level == 0, "the path search for p waits to read b at level 0");
+		// On its way down, p's search met c at level 1 and unlinked that tower
+		check(!cTop->linkedInLevel && !cTop->down->linkedInLevel && expired->linkedInLevel,
+		      "having unlinked c's tower on its way down, but not b");
+		const uint64_t transfers = set.points_.summaryTransfers();
+		set.points_.startPathSearch(unlinking, group[1]);
+		while (!set.points_.stepPathSearch(unlinking, 5)) {
+		}
+		check(towerUnlinked(expired) && set.points_.summaryTransfers() == transfers + 1,
+		      "the search for q unlinks b, the cell p waits on: one transfer");
+		while (!set.points_.stepPathSearch(waiting, 5)) {
+		}
+		check(set.points_.summaryTransfers() == transfers + 1, "the search for p resumes and transfers nothing again");
+		SkipEntry* a0 = cellAt(set.points_, 0, 10);
+		check(group[0].predecessors[0] == a0 && group[1].predecessors[0] == a0 && group[0].predecessors[1] == nullptr,
+		      "both find a as their predecessor at level 0, and the prefix above");
+
+		set.points_.linkGroup(group, 2, 5, set.cleanup_);
+		check(levelVersions(set.points_, 0) == (std::vector<Version>{ 10, 20, 20, 11 }) && levelKeys(set, 0)[1] == "p",
+		      "linked in decreasing order, p and q sit between a and zz in order");
+		check(indexesAreSound(set), "the index is sound");
+	});
+	end();
+}
+
+// Prepares a range write with an exact height
+void prepareRange(TemporalConflictSet& set, LevelMirror& mirror, PreparedWrite& write, int height, Version cv,
+                  const char* from, const char* to) {
+	const StringRef b(reinterpret_cast<const uint8_t*>(from), strlen(from));
+	const StringRef e(reinterpret_cast<const uint8_t*>(to), strlen(to));
+	const HeapRef record = set.heap_.appendRange(cv, b, e).get();
+	steerExactHeight(set, mirror, height);
+	mirror.next();
+	set.ranges_.prepare(write, record, cv, set.indexAllocator_);
+}
+
+Optional<std::string> maxEndOf(const TemporalConflictSet& set, const SpanSummary& summary) {
+	if (summary.maxEnd.state != MaxEndState::Valid) {
+		return Optional<std::string>();
+	}
+	const Optional<StringRef> end = set.heap_.getKey(summary.maxEnd.value.get().key);
+	return end.present() ? Optional<std::string>(end.get().toString()) : Optional<std::string>();
+}
+
+void groupGrowthGoesToTheSpanThatOwnsEachWrite() {
+	begin("groupGrowthGoesToTheSpanThatOwnsEachWrite");
+	onFreshThread([] {
+		TemporalConflictSet set(8, 0);
+		LevelMirror mirror;
+		writeRange(set, mirror, 2, 1, "a", "a1");
+		// b reaches level 1 and d does not: once both are linked, d lies in b's span at level 1
+		PreparedWrite group[2];
+		prepareRange(set, mirror, group[0], 2, 10, "b", "c");
+		prepareRange(set, mirror, group[1], 1, 10, "d", "z");
+		set.ranges_.findInsertionPaths(group, 2, set.validationMinRV_);
+		SkipEntry* a1 = set.ranges_.levels_[1].first_;
+		if (!check(a1 != nullptr && group[1].predecessors[1] == a1 && group[0].predecessors[1] == a1,
+		           "both writes were found after a at level 1")) {
+			return;
+		}
+		set.ranges_.linkGroup(group, 2, set.validationMinRV_, set.cleanup_);
+		SkipEntry* b1 = group[0].cells[1];
+		check(a1->next == b1 && b1->next == nullptr, "level 1 holds a, then b");
+		check(maxEndOf(set, b1->summary) == Optional<std::string>(std::string("z")),
+		      "d's end grew b's span, which contains d");
+		check(maxEndOf(set, a1->summary) == Optional<std::string>(std::string("a1")),
+		      "and not a's, which ends at b");
+		check(rangeConflict(set, 5, "y", "zz") && !rangeConflict(set, 5, "a2", "a3"), "the answers follow");
+		check(indexesAreSound(set), "the index is sound");
+	});
+	end();
+}
+
+// Sorted, distinct 1000-byte point writes: each group of sixteen fills a quarter of a heap page
+std::vector<std::string> largeKeys(int count, const char* prefix) {
+	std::vector<std::string> keys;
+	for (int i = 0; i < count; ++i) {
+		keys.push_back(paddedKey(printed("%s%05d", prefix, i), 1000));
+	}
+	return keys;
+}
+
+std::vector<TemporalConflictSet::Write> pointWrites(const std::vector<std::string>& keys) {
+	std::vector<TemporalConflictSet::Write> writes;
+	for (const std::string& k : keys) {
+		writes.push_back({ true, asRef(k), StringRef() });
+	}
+	return writes;
+}
+
+void aGroupWhoseReclamationReachesItsVersionIsDropped() {
+	begin("aGroupWhoseReclamationReachesItsVersionIsDropped");
+	onFreshThread([] {
+		const size_t perPage = cellsPerIndexPage();
+		TemporalConflictSet set(4, 0);
+		const std::vector<std::string> keys = largeKeys(300, "k");
+		const std::vector<TemporalConflictSet::Write> writes = pointWrites(keys);
+		set.addWrites(1, writes.data(), writes.size());
+
+		// The batch alone outgrows the pool, so its own oldest page is reclaimed
+		const size_t linked = levelCells(set.points_, 0).size();
+		check(set.heap_.lastReclaimedPageID() >= 1 && set.validationMinRV() == 1,
+		      "reclamation reached the batch's own version");
+		check(linked > 0 && linked < 300 && linked % 16 == 0,
+		      "whole groups were linked before it, and the group that reached it was not");
+		check(queueCells(set).size() == set.insertedNodes_, "only linked cells were counted and queued");
+		check(accountingHolds(set, perPage), "the dropped group's cells went back to the free list");
+		check(set.points_.summaryTransfers() == 0, "without transferring any summary");
+		check(answers(ownerConflict(set, 1, keys[0], keys[0] + "\x01"), false) &&
+		          answers(ownerConflict(set, 1, keys[299], keys[299] + "\x01"), false),
+		      "no admitted read conflicts with any write of the batch, linked or dropped");
+		check(!ownerConflict(set, 0, keys[0], keys[0] + "\x01").present(), "and older reads are too old");
+		check(indexesAreSound(set), "the index is sound");
+	});
+	end();
+}
+
+void reclamationBelowTheBatchVersionKeepsEveryGroup() {
+	begin("reclamationBelowTheBatchVersionKeepsEveryGroup");
+	onFreshThread([] {
+		const size_t perPage = cellsPerIndexPage();
+		TemporalConflictSet set(5, 0);
+		const std::vector<std::string> older = largeKeys(180, "a");
+		const std::vector<TemporalConflictSet::Write> olderWrites = pointWrites(older);
+		set.addWrites(1, olderWrites.data(), olderWrites.size());
+		const PageID reclaimedBefore = set.heap_.lastReclaimedPageID();
+
+		// A second batch whose groups need pages the first one holds
+		const std::vector<std::string> newer = largeKeys(100, "b");
+		const std::vector<TemporalConflictSet::Write> newerWrites = pointWrites(newer);
+		set.addWrites(2, newerWrites.data(), newerWrites.size());
+		const std::string reclaimed = printed("groups of the second batch reclaimed pages of the first (%llu to %llu), and the "
+		                                      "boundary stayed below it (%lld)",
+		                                      (unsigned long long)reclaimedBefore,
+		                                      (unsigned long long)set.heap_.lastReclaimedPageID(),
+		                                      (long long)set.validationMinRV());
+		check(set.heap_.lastReclaimedPageID() > reclaimedBefore && set.validationMinRV() == 1, reclaimed.c_str());
+		int found = 0;
+		for (const std::string& k : newer) {
+			found += answers(ownerConflict(set, 1, k, k + "\x01"), true);
+		}
+		check(found == 100, "every write of the second batch was linked and conflicts above the boundary");
+		check(accountingHolds(set, perPage) && indexesAreSound(set), "the index is sound and accounted");
+	});
+	end();
+}
+
+void groupedBatchesAgreeWithAModelUnderReclamation() {
+	begin("groupedBatchesAgreeWithAModelUnderReclamation");
+	std::vector<std::string> stats;
+	for (uint32_t seed : { 11u, 12u, 13u }) {
+		onFreshThread([seed, &stats] {
+			std::mt19937 random(seed);
+			const size_t perPage = cellsPerIndexPage();
+			TemporalConflictSet set(8, 0);
+			std::vector<ModelWrite> writes;
+			int queries = 0, positives = 0, wrong = 0, dropped = 0;
+			for (Version cv = 1; cv <= 400 && wrong == 0; ++cv) {
+				// A batch of distinct sorted begins, each a point or a narrow range
+				std::set<std::string> begins;
+				const int size = 1 + int(random() % 60);
+				while (int(begins.size()) < size) {
+					const std::string prefix = randomKey(random, 6, 3);
+					begins.insert(paddedKey(prefix, random() % 500));
+				}
+				std::vector<std::string> ends;
+				std::vector<TemporalConflictSet::Write> batch;
+				ends.reserve(begins.size());
+				for (const std::string& b : begins) {
+					const bool point = random() % 2 == 0;
+					ends.push_back(point ? std::string() : b + randomKey(random, 6, 1));
+					batch.push_back({ point, asRef(b), point ? StringRef() : asRef(ends.back()) });
+				}
+				const PageID reclaimedBefore = set.heap_.lastReclaimedPageID();
+				set.addWrites(cv, batch.data(), batch.size());
+				const bool reached = set.validationMinRV() >= cv;
+				dropped += reached;
+				size_t i = 0;
+				for (const std::string& b : begins) {
+					writes.push_back({ !batch[i].point ? true : false, b, batch[i].point ? b : ends[i], cv });
+					++i;
+				}
+				(void)reclaimedBefore;
+				for (int q = 0; q < 20; ++q) {
+					std::string from = paddedKey(randomKey(random, 6, 3), random() % 500);
+					std::string to = random() % 4 == 0 ? paddedKey(randomKey(random, 6, 3), 0) : from + randomKey(random, 6, 1);
+					if (to < from) {
+						std::swap(from, to);
+					}
+					const Version boundary = set.validationMinRV();
+					const Version rv = boundary + Version(random() % (cv - boundary + 1));
+					const Optional<bool> answer = ownerConflict(set, rv, from, to);
+					const bool expected = modelConflict(writes, rv, from, to, BOTH);
+					++queries;
+					positives += expected;
+					if (!answer.present() || answer.get() != expected) {
+						++wrong;
+						caseMessages.push_back(printed("seed %u batch %lld: expected %d for [%s, %s) at %lld", seed,
+						                               (long long)cv, expected, from.c_str(), to.c_str(), (long long)rv));
+					}
+				}
+			}
+			check(wrong == 0, "every answer agrees with the model");
+			check(set.heap_.lastReclaimedPageID() >= 5, "through at least five reclamations");
+			check(positives * 10 > queries && (queries - positives) * 10 > queries, "with both answers");
+			check(indexesAreSound(set) && accountingHolds(set, perPage), "the index is sound and accounted");
+			stats.push_back(printed("\tseed %u: %d queries, %d conflicts, %llu pages reclaimed, %d batches dropped", seed,
+			                        queries, positives, (unsigned long long)set.heap_.lastReclaimedPageID(), dropped));
+		});
+	}
+	end();
+	for (const std::string& line : stats) {
+		printf("%s\n", line.c_str());
+	}
+}
+
+int main() {
+	// Unbuffered, so an assertion that aborts the process loses none of the report.
+	setvbuf(stdout, nullptr, _IONBF, 0);
+
