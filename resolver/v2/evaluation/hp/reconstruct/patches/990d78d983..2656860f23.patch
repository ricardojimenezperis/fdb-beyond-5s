+		pages[i].id = i + 1; // insert() requires consecutive IDs from 1
+		table.insert(&pages[i]);
+	}
+
+	for (PageID i = 0; i < 3; ++i) {
+		check(table.find(i + 1) == &pages[i], "each ID finds its own page");
