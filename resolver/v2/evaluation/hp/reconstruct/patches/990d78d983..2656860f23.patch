+void checkSplitMaxima(Tree& tree, Tree::Node* node) {
+    CHECK(node == tree.root_ && node->critical);
+    const auto beforeContents = contents(tree);
+    std::vector<ReclaimLink*> before;
+    for (auto* l = tree.pool_.oldestAge(); l; l = tree.pool_.nextAge(l)) before.push_back(l);
+    const auto leftIncarnation = node->incarnation;
+    const unsigned cut = node->size()/2;
+    Version leftExpected = std::numeric_limits<Version>::lowest();
+    Version rightExpected = leftExpected;
+    for (unsigned r = 0; r < node->size(); ++r) {
+        const auto& e = node->at(r);
+        const Version cv = node->leaf ? e.cv : e.payload.link.child->maxCV;
+        auto& maximum = r < cut ? leftExpected : rightExpected;
+        maximum = std::max(maximum, cv);
+    }
+    CHECK(leftExpected != rightExpected);
+    Tree::Reservation reservation;
+    tree.reserve(reservation, 2);
+    auto* right = tree.split(node, reservation);
+    tree.releaseReservation(reservation);
+    CHECK(node->maxCV == leftExpected && tree.pool_.ageCV(node) == leftExpected);
+    CHECK(right->maxCV == rightExpected && tree.pool_.ageCV(right) == rightExpected);
+    CHECK(node->incarnation == leftIncarnation);
+    CHECK(tree.root_ != node && tree.root_->size() == 2);
+    CHECK(tree.root_->maxCV == std::max(leftExpected, rightExpected));
+    CHECK(tree.pool_.ageCV(tree.root_) == tree.root_->maxCV);
+    CHECK(tree.root_->at(0).cv == leftExpected && tree.root_->at(1).cv == rightExpected);
+    std::vector<ReclaimLink*> after;
+    const ReclaimLink* previous = nullptr;
+    for (auto* l = tree.pool_.oldestAge(); l; l = tree.pool_.nextAge(l)) {
+        CHECK(!previous || previous->maxCV <= l->maxCV);
+        CHECK(tree.pool_.ageCV(l) == l->maxCV);
+        previous = l;
+        if (l != right && l != tree.root_) after.push_back(l);
+    }
+    std::sort(before.begin(), before.end());
+    std::sort(after.begin(), after.end());
+    CHECK(after == before);
+    Version minimum = std::numeric_limits<Version>::max();
+    tree.pool_.forEachAge([&](const ReclaimLink* l) { minimum = std::min(minimum, l->maxCV); });
+    CHECK(tree.pool_.oldestAgeCV() == minimum);
+    CHECK(contents(tree) == beforeContents);
+    verify(tree);
+}
