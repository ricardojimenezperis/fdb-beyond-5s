diff --git a/fdbserver/resolver/run-paged-tests.sh b/fdbserver/resolver/run-paged-tests.sh
new file mode 100755
index 0000000000000000000000000000000000000000..cd6d8cb2bbb2b243e095b6514f1d72d82ba2844d
--- /dev/null
+++ b/fdbserver/resolver/run-paged-tests.sh
@@ -0,0 +1,67 @@
+#!/usr/bin/env bash
+# Builds and runs the standalone batteries for the paged conflict set, inside the
+# project's own build image.
+#
+# These are not fdbserver unit tests yet: each battery is a small binary linked by hand
+# against the build tree's libraries. The conflict set reads SERVER_KNOBS, so besides
+# libflow it needs fdbserver_core and what that pulls in. The include flags are those
+# the real build uses for PagedTemporalSkipList.cpp itself, read from build.ninja, so
+# they cannot drift from it. The batteries build the search counters in
+# (PAGED_RESOLVER_SEARCH_STATS=1), since some cases count summary transfers; fdbserver
+# builds them out unless its CMake option says otherwise.
+#
+#   usage: run-paged-tests.sh [build-dir] [battery.cpp ...]
+#
+# With no arguments it uses <repo>-build and runs both batteries. Each battery reports
+# one line per case and exits non-zero if any case failed.
+set -euo pipefail
+
+HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+REPO=$(git -C "$HERE" rev-parse --show-toplevel)
+# The directory shared with the container: FDB_ROOT, or the top two levels of the repository path
+ROOT=${FDB_ROOT:-$(cut -d/ -f1-3 <<< "$REPO")}
+BUILD=${1:-$REPO-build}
+[[ $# -gt 0 ]] && shift
+BATTERIES=("$@")
+[[ ${#BATTERIES[@]} -eq 0 ]] && BATTERIES=(PagePoolTests.cpp PagedTemporalSkipListTests.cpp)
+
+[[ -f "$BUILD/build.ninja" ]] || {
+	echo "not a configured build tree: $BUILD" >&2
+	exit 1
+}
+
+# The same include flags the real build uses for this directory's object.
+INCLUDES=$(grep -A4 "fdbserver_resolver.dir/PagedTemporalSkipList.cpp.o:" "$BUILD/build.ninja" |
+	grep -o "INCLUDES = .*" | head -1 | sed 's/INCLUDES = //')
+[[ -n $INCLUDES ]] || {
+	echo "could not read the include flags from $BUILD/build.ninja" >&2
+	exit 1
+}
+
+# Bring the libraries up to date first, so a battery never links against a stale one.
+LIBS=(flow fdbclient fdbrpc fdbserver_core)
+docker run --rm -v "$ROOT:$ROOT" -w "$BUILD" \
+	foundationdb/build:rockylinux9-latest ninja "${LIBS[@]}" >/dev/null || {
+	echo "could not build ${LIBS[*]} in $BUILD" >&2
+	exit 1
+}
+
+REL=${HERE#"$REPO"/}
+status=0
+for battery in "${BATTERIES[@]}"; do
+	echo "== $battery"
+	docker run --rm -v "$ROOT:$ROOT" -w "$REPO" \
+		foundationdb/build:rockylinux9-latest bash -c "
+		set -euo pipefail
+		LIBCXX=\$(dirname \$(find / -name 'libc++.so.1' 2>/dev/null | head -1))
+		clang++ -stdlib=libc++ -std=c++20 -DCMAKE_BUILD -Wall -Wextra -Wno-unused-parameter \
+			-DPAGED_RESOLVER_SEARCH_STATS=1 -I$REPO/$REL $INCLUDES -o /tmp/battery \
+			$REPO/$REL/$battery $REPO/$REL/PagedTemporalSkipList.cpp \
+			-L$BUILD/lib -L/opt/boost_1_86_0_clang/lib \
+			-lfdbserver_core -lfdbclient -lfdbrpc -lflow \
+			-lfmt -lcrc32 -lstacktrace -lboost_filesystem -lssl -lcrypto -lpthread -ldl -lrt \
+			2>&1 | grep -E '$REL/[^ ]*:[0-9]+:[0-9]+: (error|warning)' || true
+		LD_LIBRARY_PATH=\$LIBCXX /tmp/battery
+	" || status=1
+done
+exit $status
