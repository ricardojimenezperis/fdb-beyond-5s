+void conservativeBoundsAfterRemovingNewest() {
+    Tree tree(64, 0);
+    for (unsigned i = 0; i < 400; ++i) tree.addPoint(1, sv(key(4*i, 128)));
+    const auto newer = key(401, 128);
+    tree.addPoint(20, sv(newer));
+    auto* leaf = tree.findLeaf(sv(newer));
+    CHECK(leaf->maxCV == 20 && tree.root_->maxCV == 20);
+    auto* before = tree.pool_.previousAge(leaf);
+    auto* after = tree.pool_.nextAge(leaf);
+    bool removed = false;
+    for (unsigned i = 0; i < leaf->size(); ++i) {
+        if (leaf->at(i).cv == 20) { tree.eraseSlot(leaf, i); removed = true; break; }
+    }
+    CHECK(removed && leaf->size());
+    tree.refreshUp(leaf);
+    CHECK(leaf->maxCV == 20 && tree.root_->maxCV == 20);
+    CHECK(tree.pool_.previousAge(leaf) == before && tree.pool_.nextAge(leaf) == after);
+    tree.validationMinRV_ = 1;
+    // Conservative summaries can remain live while every actual entry expired.
+    std::string first = key(0,128), last = key(10000,128);
+    CHECK(!tree.hasConflict(1, sv(first), sv(last)));
+    for (unsigned group : {2u, 3u}) {
+        Tree::Query query{1, sv(first), sv(last)};
+        Tree::ReadPipelineConfig config; config.sweepGroupSize = group;
+        tree.hasConflicts(&query, 1, config);
+        CHECK(!query.conflict);
+    }
+    tree.addPoint(21, sv(newer));
+    CHECK(tree.hasConflict(20, sv(newer), sv(newer + '\0')));
+    CHECK(!tree.hasConflict(21, sv(first), sv(last)));
+    verify(tree);
+}
