+void internalHeadReclaimsBeforeReservation() {
+    Tree tree(64, 0);
+    tree.configureFictitiousLeaves({ 0, 0 });
+    bool ready = false;
+    for (unsigned i = 1; i < Tree::Capacity * Tree::Capacity; ++i) {
+        tree.addRange(i <= 2*Tree::Capacity ? 1 : 10, sv(key(10*i)), sv(key(10*i+4)));
+        if (!tree.root_->leaf && tree.root_->critical && tree.root_->size() > 4) {
+            ready = true; break;
+        }
+    }
+    CHECK(ready && tree.root_->maxCV == 10);
+    CHECK(tree.root_->slots[tree.root_->reclaimHead].cv == 1);
+    tree.validationMinRV_ = 1;
+    std::vector<Tree::Node*> held;
+    while (tree.freeNodes_) held.push_back(tree.allocateNode());
+    std::vector<PoolPage*> pages;
+    while (auto* page = tree.pool_.tryAcquire(PageUse::Index)) pages.push_back(page);
+    Tree::Node* target = nullptr;
+    for (unsigned rank = 0; rank < tree.root_->size() && !target; ++rank) {
+        Tree::Node* child = tree.root_->at(rank).payload.link.child;
+        if (!child->critical && child->maxCV == 10) target = child;
+    }
+    CHECK(target && target->leaf);
+    const std::string base = entryBytes(tree, target->at(0), true);
+    const std::string begin = base + '\x01', end = base + '\x02';
+    const auto before = tree.stats();
+    tree.addRange(11, sv(begin), sv(end));
+    CHECK(tree.validationMinRV() == 1);
+    CHECK(tree.stats().localHeadChildrenReclaimed > before.localHeadChildrenReclaimed);
+    CHECK(tree.stats().reclaimCalls == before.reclaimCalls);
+    CHECK(tree.stats().nodesTaken == before.nodesTaken && tree.stats().nodesReserved == before.nodesReserved);
+    CHECK(tree.hasConflict(10, sv(begin), sv(end)));
+    CHECK(!tree.hasConflict(11, sv(begin), sv(end)));
+    for (auto* node : held) tree.recycleNode(node);
+    for (auto* page : pages) tree.pool_.release(page, PageUse::Index);
+    verify(tree);
+}
