+void blockReaderEndpointCuts() {
+    Tree tree(512, 0);
+    const std::string prefix(Tree::InlineKeyBytes + 80, 'c');
+    std::vector<std::string> keys;
+    keys.reserve(4098);
+    for (unsigned i = 0; i < 4098; ++i) keys.push_back(prefix + key(i));
+    for (unsigned i = 0; i < 512; ++i) tree.addRange(7, sv(keys[8*i]), sv(keys[8*i+3]));
+    CHECK(!tree.root_->leaf);
+    std::vector<Tree::Query> original;
+    for (unsigned i = 0; i < 4096; ++i)
+        original.push_back({0, sv(keys[i]), sv(keys[i+1]), false});
+    const auto stored = contents(tree);
+    std::vector<bool> expected;
+    for (const auto& q : original) expected.push_back(referenceConflict(stored, q.readVersion, bytes(q.begin), bytes(q.end)));
+    for (unsigned group : {2u, 3u}) {
+        Tree::ReadPipelineStats linear;
+        for (unsigned levels : {0u, 1u, 2u, Tree::MaxHeight}) {
+            auto queries = original;
+            Tree::ReadPipelineConfig cfg; cfg.sweepGroupSize = group;
+            cfg.breadthBoundaryLevels = levels; cfg.l2Bytes = 8192; cfg.l2ReserveBytes = 0;
+            tree.hasConflicts(queries.data(), queries.size(), cfg);
+            for (size_t q = 0; q < queries.size(); ++q) CHECK(queries[q].conflict == expected[q]);
+            for (const auto& buffer : tree.readBlocks_) for (const auto& state : buffer.nodes) CHECK(state.heap == 0);
+            if constexpr (Tree::Stats::searchEnabled) {
+                const auto& st = tree.readPipelineStats();
+                if (levels == 0) linear = st;
+                else {
+                    CHECK(st.sortedInternalComparisonsByDepth[0] < linear.sortedInternalComparisonsByDepth[0]);
+                    CHECK(st.sortedInternalComparisonsByDepth[0] <= (tree.root_->size()-1) * 14);
+                    for (unsigned d = levels; d < Tree::MaxHeight; ++d)
+                        CHECK(st.sortedInternalComparisonsByDepth[d] == linear.sortedInternalComparisonsByDepth[d]);
+                    CHECK(st.sortedLeafBeginComparisons == linear.sortedLeafBeginComparisons);
+                    CHECK(st.sortedLeafEndComparisons == linear.sortedLeafEndComparisons);
+                }
+            }
+        }
+    }
+    verify(tree);
+}
