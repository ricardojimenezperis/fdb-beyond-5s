+void noAllocationDuringModification() {
+    Tree tree(64, 0);
+    Tripwire tripwire{&tree};
+    tree.pool_.setReclaimer(&tripwire, tripwireReclaim);
+    std::mt19937 random(12);
+    std::vector<Interval> writes;
+    unsigned maxTaken = 0;
+    for (unsigned n = 1; n <= 12000; ++n) {
+        const unsigned start = random() % 20000;
+        const unsigned length = random() % 20 == 0 ? 1 + random() % 2000 : 1 + random() % 4;
+        const std::string begin = key(start), end = key(start + length);
+        guardedAddRange(tree, tripwire, n, sv(begin), sv(end), maxTaken);
+        writes.emplace_back(begin, end, n);
+        // Now and then everything expires, so the next write finds an expired root and starts over
+        if (n % 3001 == 0) { tree.validationMinRV_ = n; writes.clear(); }
+        if (n % 500 == 0) { tree.cleanup(16, 8, n % 1000 == 0); verify(tree); }
+        CHECK(tripwire.violations == 0);
+    }
+    verify(tree);
+    // A test-only reserve of three prevents allocation while exercising all write shapes
+    std::printf("[most nodes one write took: %u] ", maxTaken);
+    if constexpr (Tree::Stats::searchEnabled) CHECK(maxTaken >= 2 && maxTaken <= 3);
+    for (unsigned q = 0; q < 2000; ++q) {
+        const unsigned a = random() % 20000;
+        const std::string qb = key(a), qe = key(a + 1 + random() % 30);
+        const Version rv = tree.validationMinRV() + random() % 3000;
+        CHECK(tree.hasConflict(rv, sv(qb), sv(qe)) == referenceConflict(writes, rv, qb, qe));
+    }
+    tree.pool_.setReclaimer(&tree, Tree::reclaimThunk);
+}
