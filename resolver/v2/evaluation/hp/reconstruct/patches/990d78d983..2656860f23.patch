+void inlineOnlyImplicitZeroFragments() {
+    if constexpr (!Tree::InlineOnlyKeys) return;
+    Tree tree(16, 0);
+    const std::string k(Tree::InlineKeyBytes, 'm'), successor = k + '\0', last = k + '\xff';
+    tree.addRange(10, sv(""), sv(last));
+    tree.addPoint(20, sv(k));
+    std::vector<Interval> expected;
+    if (!k.empty()) expected.emplace_back("", k, 10);
+    expected.emplace_back(k, successor, 20);
+    expected.emplace_back(successor, last, 10);
+    CHECK(contents(tree) == expected);
+    const auto right = entryAt(tree, successor);
+    CHECK(Tree::implicitZero(right.begin));
+    CHECK(entryBytes(tree, right) == successor);
+    for (unsigned group : {2u, 3u}) {
+        Tree::ReadPipelineConfig config; config.sweepGroupSize = group;
+        Tree::Query queries[] = {{15, sv(k), sv(successor), false},
+                                 {15, sv(successor), sv(last), true},
+                                 {5, sv(successor), sv(last), false}};
+        tree.hasConflicts(queries, 3, config);
+        CHECK(queries[0].conflict && !queries[1].conflict && queries[2].conflict);
+    }
+    // The virtual endpoint can become a separator or a surviving fragment.
+    tree.addRange(30, sv(successor + '\0'), sv(last));
+    CHECK(tree.hasConflict(20, sv(successor + '\0'), sv(last)));
+    CHECK(!tree.hasConflict(20, sv(k), sv(successor)));
+    verify(tree);
+}
