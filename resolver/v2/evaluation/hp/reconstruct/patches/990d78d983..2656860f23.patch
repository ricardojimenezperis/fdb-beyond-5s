+void checkRouting(Tree& tree) {
+    for (Tree::Node* leaf = tree.firstLeaf_; leaf; leaf = leaf->navigation.leaf.next)
+        for (unsigned rank = 0; rank < leaf->size(); ++rank) {
+            if (leaf->at(rank).cv <= tree.validationMinRV()) continue;
+            const std::string begin = beginOf(tree, leaf->at(rank));
+            CHECK(tree.findLeaf(sv(begin)) == leaf);
+        }
+}
