+void conservativeSummariesAloneDoNotConflict() {
+	begin("conservativeSummariesAloneDoNotConflict");
+	onFreshThread([] {
+		LevelMirror mirror;
+		// T1's span takes its maxCV from A1 and its maxEnd from A2, two different writes
+		TemporalConflictSet set(8, 0);
+		writeRange(set, mirror, 2, 1, "b", "c");
+		writeRange(set, mirror, 1, 4, "d", "y");
+		writeRange(set, mirror, 1, 200, "c", "d");
+		SkipEntry* t1 = set.ranges_.levels_[1].first_;
+		if (!check(t1 != nullptr, "the tower was built as steered")) {
+			return;
+		}
+		const Optional<StringRef> maxEnd = t1->summary.maxEnd.state == MaxEndState::Valid
+		                                       ? set.heap_.getKey(t1->summary.maxEnd.value.get().key)
+		                                       : Optional<StringRef>();
+		check(t1->summary.maxCV.present() && t1->summary.maxCV.get() == 200 && maxEnd.present() &&
+		          maxEnd.get() == asRef("y"),
+		      "the span's maxCV and maxEnd come from different writes");
+		check(!rangeConflict(set, 100, "k", "z"), "together they do not make a conflict");
+		check(rangeConflict(set, 3, "k", "z"), "while the long write does conflict below its own version");
+
+		// Discarded by version: every write is at or below the read version
+		TemporalConflictSet old(8, 0);
+		writeRange(old, mirror, 2, 1, "b", "c");
+		writeRange(old, mirror, 1, 50, "d", "y");
+		check(!rangeConflict(old, 100, "a", "z"), "a span whose writes are all old is discarded by version");
+
+		// Discarded by end: new writes that end at or before the read's begin
+		TemporalConflictSet early(8, 0);
+		writeRange(early, mirror, 2, 200, "b", "c");
+		writeRange(early, mirror, 1, 201, "c", "e");
+		check(!rangeConflict(early, 100, "e", "z"), "a span whose greatest end is the read's begin is discarded by end");
+		check(rangeConflict(early, 100, "d", "z"), "one reaching past it is not");
+	});
+	end();
+}
