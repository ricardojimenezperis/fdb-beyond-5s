+void wideOverwriteAcrossLeaves() {
+    Tree tree(256, 0);
+    for (unsigned i = 0; i < 3000; ++i) tree.addRange(1 + i, sv(key(4 * i)), sv(key(4 * i + 2)));
+    const auto leaves = tree.leafCount_;
+    const Tree::Entry first = entryAt(tree, key(400)), last = entryAt(tree, key(11600));
+    const auto before = tree.stats();
+    // Shortens interval 100 from the right and interval 2900 from the left, covering all between
+    tree.addRange(5000, sv(key(401)), sv(key(11601)));
+    CHECK(tree.stats().overwrittenIntervals - before.overwrittenIntervals == 2801);
+    CHECK(tree.stats().intervalInsertions - before.intervalInsertions == 1);
+    CHECK(tree.stats().leftFragmentsTrimmed - before.leftFragmentsTrimmed == 1);
+    CHECK(tree.stats().rightFragmentsTrimmed - before.rightFragmentsTrimmed == 1);
+    CHECK(tree.leafCount_ < leaves);
+    const Tree::Entry left = entryAt(tree, key(400)), middle = entryAt(tree, key(401)), right = entryAt(tree, key(11601));
+    CHECK(left.cv == 101 && middle.cv == 5000 && right.cv == 2901);
+    // The fragments reuse the old and new records' bytes; nothing was copied
+    CHECK(sameRef(left.begin, first.begin) && sameRef(left.end, middle.begin));
+    CHECK(sameRef(right.begin, middle.end) && sameRef(right.end, last.end));
+    auto live = contents(tree);
+    CHECK(live.size() == 100 + 3 + 99);
+    // The diagnostic walk agrees with the tree's own counts
+    const auto levels = tree.levels();
+    uint64_t nodes = 0, liveEntries = 0;
+    for (const auto& level : levels) { nodes += level.nodes; CHECK(level.entries >= level.liveEntries); }
+    CHECK(levels.size() == tree.height() && nodes == tree.nodeCount() && levels.back().nodes == tree.leafCount());
+    liveEntries = levels.back().liveEntries;
+    CHECK(liveEntries == live.size() && levels.front().nodes == 1);
+    // Splits one interval in two, inside interval 50
+    tree.addRange(5001, sv(key(200) + '\x01'), sv(key(201)));
+    const Tree::Entry inner = entryAt(tree, key(200) + '\x01');
+    CHECK(entryAt(tree, key(200)).cv == 51 && inner.cv == 5001 && entryAt(tree, key(201)).cv == 51);
+    CHECK(sameRef(entryAt(tree, key(200)).end, inner.begin) && sameRef(entryAt(tree, key(201)).begin, inner.end));
+    CHECK(tree.hasConflict(5000, sv(key(200)), sv(key(202))));
+    CHECK(!tree.hasConflict(5001, sv(key(200)), sv(key(202))));
+    CHECK(!tree.hasConflict(51, sv(key(200)), sv(key(200) + '\x01')));
+    verify(tree);
+}
