+void sortedEndpointModelUnderPressure() {
+    for (unsigned seed : {17,81,2026}) {
+        Tree tree(4,0);
+        std::mt19937 rng(seed);
+        std::vector<Interval> model;
+        const std::string prefix(12,'\x81');
+        auto k = [&](unsigned n, unsigned length) { return prefix + key(n,length); };
+        for (Version cv=1; cv<=180; ++cv) {
+            for (unsigned w=0; w<20; ++w) {
+                const unsigned n=rng()%8000;
+                const auto begin=k(n, (w%3) ? 4 : 512);
+                if (w%2) {
+                    tree.addPoint(cv,sv(begin)); model.emplace_back(begin,begin+'\0',cv);
+                } else {
+                    const auto end=k(n+1+rng()%8,4);
+                    tree.addRange(cv,sv(begin),sv(end)); model.emplace_back(begin,end,cv);
+                }
+            }
+            const Version floor=tree.validationMinRV();
+            pruneModel(model,floor);
+            std::vector<std::string> storage; storage.reserve(128);
+            std::vector<Tree::Query> queries;
+            std::vector<bool> expected;
+            for (unsigned i=0; i<64; ++i) {
+                std::string begin,end;
+                if (!model.empty() && i%3==0) {
+                    const auto& chosen=model[rng()%model.size()];
+                    begin=std::get<0>(chosen); end=std::get<1>(chosen);
+                } else {
+                    const unsigned n=rng()%8000;
+                    begin=k(n,4); end=k(n+(i%7==0 ? 0 : 1+rng()%3000),4);
+                }
+                const Version rv=floor+rng()%(cv-floor+1);
+                expected.push_back(referenceConflict(model,rv,begin,end));
+                storage.push_back(std::move(begin)); storage.push_back(std::move(end));
+                queries.push_back({rv,sv(storage[2*i]),sv(storage[2*i+1]),true});
+            }
+            Tree::ReadPipelineConfig cfg; cfg.sweepGroupSize = 2 + unsigned(cv % 2);
+            tree.hasConflicts(queries.data(),queries.size(),cfg);
+            for (size_t i=0; i<queries.size(); ++i) CHECK(queries[i].conflict==expected[i]);
+            if (cv%30==0) { checkSortedQueries(tree,queries); verify(tree); }
+        }
+        CHECK(tree.validationMinRV()>0);
+    }
+}
