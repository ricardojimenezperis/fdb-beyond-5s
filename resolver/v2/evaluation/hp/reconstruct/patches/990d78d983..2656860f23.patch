+// Invalid configuration must throw before query flags change. Legal boundary values
+// match the model; either cache budget must fit two windows.
+void readerConfigValidation() {
+    Tree tree(256, 0);
+    std::vector<std::string> keys;
+    for (unsigned i = 0; i < 3000; ++i) keys.push_back(key(i * 4, 24));
+    for (const auto& k : keys) tree.addPoint(2, sv(k));
+    std::vector<std::string> storage; storage.reserve(keys.size() * 4);
+    std::vector<Tree::Query> qs; std::vector<bool> expected;
+    for (unsigned i = 0; i < keys.size(); i += 7) {
+        storage.push_back(keys[i]); storage.push_back(keys[i] + '\0');
+        qs.push_back({1, sv(storage[storage.size() - 2]), sv(storage.back()), false}); expected.push_back(true);
+        storage.push_back(keys[i] + '\0'); storage.push_back(key(i * 4 + 1, 24));
+        qs.push_back({1, sv(storage[storage.size() - 2]), sv(storage.back()), false}); expected.push_back(false);
+    }
+    const size_t limit = std::numeric_limits<size_t>::max() / 1024;
+    using Config = Tree::ReadPipelineConfig;
+    const std::vector<std::function<void(Config&)>> invalid = {
+        [](Config& c) { c.lineBytes = 0; }, [](Config& c) { c.lineBytes = 48; }, [](Config& c) { c.lineBytes = 8192; },
+        [](Config& c) { c.sweepGroupSize = 0; }, [](Config& c) { c.sweepGroupSize = 1; }, [](Config& c) { c.sweepGroupSize = 4; },
+        [](Config& c) { c.breadthBoundaryLevels = Tree::MaxHeight + 1; },
+        [&](Config& c) { c.l2Bytes = limit + 1; }, [](Config& c) { c.l2ReserveBytes = c.l2Bytes; },
+    };
+    for (const auto& change : invalid) {
+        Config cfg; change(cfg);
+        for (auto& q : qs) q.conflict = true;
+        bool threw = false;
+        try { tree.hasConflicts(qs.data(), qs.size(), cfg); } catch (const std::invalid_argument&) { threw = true; }
+        CHECK(threw);
+        for (const auto& q : qs) CHECK(q.conflict);
+    }
+    for (unsigned group : {0u, 1u, 4u}) {
+        bool threw = false;
+        try { tree.configureReader(group); } catch (const std::invalid_argument&) { threw = true; }
+        CHECK(threw && tree.readerConfig().sweepGroupSize == 3);
+    }
+    const std::vector<std::function<void(Config&)>> valid = {
+        [](Config& c) { c.lineBytes = 4096; c.l2Bytes = 16 * 1024 * 1024; },
+        [](Config& c) { c.l2Bytes = 4096; c.l2ReserveBytes = 0; },
+        [](Config& c) { c.breadthBoundaryLevels = 0; }, [](Config& c) { c.breadthBoundaryLevels = Tree::MaxHeight; },
+    };
+    for (unsigned group : {2u, 3u}) {
+        tree.configureReader(group);
+        CHECK(tree.readerConfig().sweepGroupSize == group);
+        for (auto& q : qs) q.conflict = !q.conflict;
+        tree.hasConflicts(qs.data(), qs.size());
+        for (size_t i = 0; i < qs.size(); ++i) CHECK(qs[i].conflict == expected[i]);
+        for (const auto& change : valid) {
+            Config cfg; cfg.sweepGroupSize = group; change(cfg);
+            tree.hasConflicts(qs.data(), qs.size(), cfg);
+            for (size_t i = 0; i < qs.size(); ++i) CHECK(qs[i].conflict == expected[i]);
+        }
+    }
+    verify(tree);
+}
