+void stableHintSaturatedNodeRefusedAsKeyBlock() {
+    Tree tree(64, 0);
+    for (unsigned i = 0; i < 300; ++i) tree.addRange(1, sv(key(4 * i)), sv(key(4 * i + 2)));
+    Tree::Reservation reservation;
