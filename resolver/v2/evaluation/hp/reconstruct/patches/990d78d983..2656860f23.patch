+// A split moves the hinted key to a new right leaf: the hint is still the same incarnation, and the
+// bounded right move of the range check lands on the right leaf
+void stableHintSplitMovesBoundary() {
+    Tree tree(64, 0);
+    tree.configureFictitiousLeaves({ 0, 0 });
+    for (unsigned i = 0; i < 300; ++i) tree.addRange(1, sv(key(8 * i)), sv(key(8 * i + 2)));
+    Tree::Node* leaf = middleLeaf(tree);
+    for (Tree::Node* x : {leaf->navigation.leaf.previous, leaf->navigation.leaf.next}) {
+        CHECK(x);
+        for (unsigned j = 1; x->size() < Tree::Capacity; ++j)
+            tree.addPoint(1, sv(entryBytes(tree, x->at(x->size() - 1), true) + char(j)));
+        CHECK(x->critical);
+    }
+    const Tree::LeafHint hint{leaf, leaf->incarnation};
+    const std::string last = entryBytes(tree, leaf->at(leaf->size() - 1));
+    for (unsigned j = 0; leaf->size() < Tree::Capacity; ++j) {
+        if (Tree::Capacity - leaf->size() == 1) {
+            const std::string gap = entryBytes(tree, leaf->at(leaf->size() - 1), true) + '\x01';
+            tree.addPoint(1, sv(gap));
+            continue;
+        }
+        tree.addRange(1, sv(entryBytes(tree, leaf->at(0)) + std::string(1, char(j + 1))), sv(entryBytes(tree, leaf->at(0)) + std::string(1, char(j + 1)) + '\0'));
+    }
+    Tree::Node* next = leaf->navigation.leaf.next;
+    tree.addRange(1, sv(entryBytes(tree, leaf->at(0)) + "\x7f"), sv(entryBytes(tree, leaf->at(0)) + "\x7f\x01"));
+    CHECK(leaf->allocated && leaf->incarnation == hint.incarnation && leaf->navigation.leaf.next != next);
+    Tree::Node* destination = tree.findLeaf(sv(last));
+    CHECK(destination != leaf);
+    CHECK(tree.resolveWriteHint(sv(last), hint) == destination);
+    verify(tree);
+}
