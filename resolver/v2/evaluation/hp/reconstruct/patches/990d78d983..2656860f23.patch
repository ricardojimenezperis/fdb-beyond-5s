+
+void theRingReusesSlotsWithoutConfusingIDs() {
+	begin("theRingReusesSlotsWithoutConfusingIDs");
+	const size_t capacity = 4;
+	HeapPageTable table(capacity);
+
+	HistoryPage first[capacity];
+	for (PageID i = 0; i < capacity; ++i) {
+		first[i].id = i + 1;
+		table.insert(&first[i]);
+	}
+	for (PageID i = 0; i < capacity; ++i) {
+		table.erase(i + 1);
+	}
+
+	// IDs 5..8 land on the same slots as 1..4: id % capacity is equal.
+	HistoryPage second[capacity];
+	for (PageID i = 0; i < capacity; ++i) {
+		second[i].id = capacity + i + 1;
+		table.insert(&second[i]);
+	}
+
+	for (PageID i = 0; i < capacity; ++i) {
+		check(table.find(capacity + i + 1) == &second[i],
+			  "a wrapped ID finds its own page");
+		check(table.find(i + 1) == nullptr,
+			  "the retired ID that shares the slot is absent");
+	}
+	end();
+}
+
+// heapPageMask: the table rounds its slots up to a power of two, but its capacity, as given, still limits
+// the live pages. Tested on the table itself: through a pool, the pool would run out of pages first and
+// the table's own limit would never be reached
+void theGivenCapacityLimitsLivePagesNotTheRoundedSlots() {
+	begin("theGivenCapacityLimitsLivePagesNotTheRoundedSlots");
+	for (size_t capacity : { size_t(1), size_t(3), size_t(4), size_t(5), size_t(8), size_t(544), size_t(1000) }) {
+		HeapPageTable table(capacity);
+		const size_t slots = table.slots_.size();
+		check(slots >= capacity && (slots & (slots - 1)) == 0 && slots < 2 * capacity + (capacity == 1),
+		      "the slots are the capacity rounded up to a power of two");
+		std::vector<HistoryPage> pages(capacity + 1);
+		for (size_t i = 0; i < capacity; ++i) {
+			pages[i].id = i + 1;
+			table.insert(&pages[i]);
+		}
+		pages[capacity].id = capacity + 1;
+		bool rejected = false;
+		try {
+			table.insert(&pages[capacity]);
+		} catch (Error&) {
+			rejected = true;
+		}
+		check(rejected, "one page more than the capacity is rejected, even with slots to spare");
+		bool found = true;
+		for (size_t i = 0; i < capacity; ++i) found = found && table.find(i + 1) == &pages[i];
+		check(found, "and the pages already registered are all found");
+		check(table.find(capacity + 1) == nullptr, "the rejected ID is not registered");
+	}
+	end();
+}
+
+// heapPageMask: a window of `capacity` live pages slides over several turns of the rounded size M. At each
+// step every live ID finds its own page, the IDs just retired and not yet issued are absent, and an ID
+// retired a whole turn of M ago, whose slot now holds a live page, is absent too
+void slidingPagesOverSeveralTurnsOfTheRoundedSlots() {
+	begin("slidingPagesOverSeveralTurnsOfTheRoundedSlots");
+	for (size_t capacity : { size_t(3), size_t(5), size_t(8), size_t(544) }) {
+		HeapPageTable table(capacity);
+		const size_t slots = table.slots_.size();
+		const size_t total = 4 * slots + capacity;
+		std::vector<HistoryPage> pages(total + 1);
+		bool live = true, retired = true, future = true, oldInOccupiedSlot = true, sawOccupiedSlot = false;
+		PageID oldest = 1;
+		for (PageID id = 1; id <= total; ++id) {
+			if (id - oldest == capacity) table.erase(oldest++);
+			pages[id].id = id;
+			table.insert(&pages[id]);
+			for (PageID l = oldest; l <= id; ++l) live = live && table.find(l) == &pages[l];
+			if (oldest > 1) retired = retired && table.find(oldest - 1) == nullptr;
+			future = future && table.find(id + 1) == nullptr && table.find(id + slots) == nullptr;
+			if (id > slots) {
+				// id - slots shares id's slot, which holds the live page id now
+				sawOccupiedSlot = true;
+				oldInOccupiedSlot = oldInOccupiedSlot && table.slots_[(id - slots) & table.mask_] == &pages[id] &&
+				                    table.find(id - slots) == nullptr;
+			}
+		}
+		check(live, "every live ID finds its own page at every step");
+		check(retired, "the ID just retired is absent");
+		check(future, "IDs not yet issued are absent, also one a whole turn ahead");
+		check(sawOccupiedSlot && oldInOccupiedSlot, "an ID retired a turn ago is absent though its slot is occupied");
+	}
+	end();
+}
+
