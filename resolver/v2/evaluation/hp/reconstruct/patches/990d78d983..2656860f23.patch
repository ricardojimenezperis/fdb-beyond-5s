+// Exercise real allocation during a batch while a pending hint loses its leaf to cleanup
+struct PendingRetirement {
+    Tree* tree;
+    Tree::NodePage* victimPage;
+    std::vector<PoolPage*> held;
+    bool triggered = false;
+    std::vector<Tree::Node*> spare;
+};
+
+void retirePendingHintPage(void* context, PageUse use) {
+    auto& test = *static_cast<PendingRetirement*>(context);
+    Tree& tree = *test.tree;
+    if (test.triggered) { tree.reclaim(use); return; }
+    if (tree.writeHints_.size() == 3 && !tree.writeHints_[1].node) {
+        auto supply = std::find_if(test.spare.begin(), test.spare.end(),
+                                   [&](Tree::Node* node) { return node->owner != test.victimPage; });
+        if (supply != test.spare.end()) {
+            tree.recycleNode(*supply);
+            test.spare.erase(supply);
+            return;
+        }
+    }
+    CHECK(use == PageUse::Index && tree.writeHints_.size() == 3 && tree.writeBatchActive_);
+    const auto hint = tree.writeHints_[1];
+    CHECK(hint.node && hint.node->owner == test.victimPage);
+    test.triggered = true;
+    tree.validationMinRV_ = 1;
+    drainExpired(tree);
+    CHECK(!hint.node->allocated);
+    bool found = false;
+    for (auto* page = tree.pages_; page; page = page->next)
+        if (page == test.victimPage) found = true;
+    CHECK(found && tree.budget().indexPages > 0);
+    bool pending = false;
+    for (auto* node : retiredItems(tree))
+        if (node == hint.node) pending = true;
+    CHECK(pending);
+    for (auto* node : freeItems(tree)) CHECK(node != hint.node);
+    while (PoolPage* page = tree.pool_.tryAcquire(PageUse::Index)) {
+        CHECK(page != reinterpret_cast<PoolPage*>(test.victimPage));
+        test.held.push_back(page);
+    }
+    CHECK(!test.held.empty());
+    tree.pool_.release(test.held.back(), PageUse::Index);
+    test.held.pop_back();
+}
