+void pointOverwritePreservesSharedBoundaries() {
+    const std::string shared(Tree::InlineKeyBytes + 2, '\x81');
+    const std::string lo = shared + '\x10', mid = shared + '\x20', hi = shared + '\x30';
+    Tree tree(64, 0);
+    tree.addRange(1, sv(lo), sv(hi));
+    tree.addPoint(2, sv(mid));
+    CHECK(contents(tree) == (std::vector<Interval>{{lo, mid, 1}, {mid, mid + '\0', 2}, {mid + '\0', hi, 1}}));
+    verify(tree);
+    // The older fragments above reuse the point's bytes. Replace them with
+    // newer range records, then expire the point while retaining those ranges.
+    tree.addRange(3, sv(lo), sv(mid));
+    tree.addRange(3, sv(mid + '\0'), sv(hi));
+    tree.validationMinRV_ = 2;
+    drainExpired(tree);
+    CHECK(contents(tree) == (std::vector<Interval>{{lo, mid, 3}, {mid + '\0', hi, 3}}));
+    CHECK(!tree.hasConflict(2, sv(mid), sv(mid + '\0')));
+    CHECK(tree.hasConflict(2, sv(lo), sv(mid)));
+    CHECK(tree.hasConflict(2, sv(mid + '\0'), sv(hi)));
+    verify(tree);
+    tree.addRange(4, sv(lo), sv(hi));
+    CHECK(contents(tree) == (std::vector<Interval>{{lo, hi, 4}}));
+    verify(tree);
+}
