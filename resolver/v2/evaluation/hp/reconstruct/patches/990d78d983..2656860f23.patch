index 0000000000000000000000000000000000000000..fdf5f57585526ae5a4d2c74ea61eadfdc5f42e6c
--- /dev/null
+++ b/fdbserver/resolver/by5mono/verify.cpp
@@ -0,0 +1,52 @@
+#include "../By5Workload.h"
+#include <iostream>
+#include <unordered_set>
+int main(int argc,char** argv){try{
+ by5::require(argc==2,"usage: by5mono-verify TRACE");std::ifstream in(argv[1],std::ios::binary);by5::require(bool(in),"cannot open trace");
+ const auto c=by5::readHeader(in);by5::require(c.pattern==1,"not a monotonic trace");
+ const uint64_t cap=c.prefixCapacity();
+ std::vector<std::vector<uint32_t>> insertedAt(c.prefixes);std::vector<uint64_t> next(c.prefixes,0),accepted(c.prefixes,0);
+ const uint32_t none=UINT32_MAX;
+ uint64_t txns=0,empty=0,points=0,ranges=0,conflicts=0,mismatches=0,badWrites=0,badReads=0,badRv=0,badPoint=0,emptyWithKeys=0;
+ std::vector<uint64_t> widths(c.span+1,0),ageHist(8,0);
+ for(uint64_t b=0;b<c.totalBatches();++b){
+  const by5::Version now=by5::commitVersion(c,b),rv=std::max<by5::Version>(0,now-by5::Version(c.shortAgeUs));
+  const std::vector<uint64_t> available=next;bool anyAvailable=false;for(auto n:available)anyAvailable|=n>0;
+  for(uint64_t i=0;i<c.batchSize;++i){
+   by5::Transaction t;t.read={uint32_t(by5::get(in,4)),uint32_t(by5::get(in,4))};t.write={uint32_t(by5::get(in,4)),uint32_t(by5::get(in,4))};
+   t.readVersion=by5::Version(by5::get(in));t.ageClass=uint32_t(by5::get(in,4));const auto target=by5::get(in,4);t.expectedConflict=target==1;++txns;
+   badRv+=t.readVersion!=rv || t.ageClass!=0 || target>1;
+   const uint32_t wp=uint32_t(uint64_t(t.write.begin)/cap);
+   const bool writeOk=wp<c.prefixes && t.write.end==t.write.begin+1 && uint64_t(t.write.begin)==uint64_t(c.prefixBase(wp))+next[wp] && t.write.begin<c.domain;
+   if(!writeOk){++badWrites;continue;}
+   ++next[wp];insertedAt[wp].push_back(none);
+   bool conflict=false;
+   if(t.read.begin==0 && t.read.end==0){++empty;emptyWithKeys+=anyAvailable;}
+   else{
+    const uint32_t rp=uint32_t(uint64_t(t.read.begin)/cap);const uint64_t base=c.prefixBase(rp);
+    const bool readOk=rp<c.prefixes && t.read.end>t.read.begin && t.read.end-t.read.begin<=c.span && uint64_t(t.read.end)<=base+available[rp];
+    if(!readOk){++badReads;}
+    else{
+     const uint32_t w=t.read.end-t.read.begin;++widths[w];if(w==1)++points;else ++ranges;
+     for(uint32_t r=t.read.begin;r<t.read.end;++r){
+      const uint32_t at=insertedAt[rp][r-base];
+      if(at!=none && by5::commitVersion(c,at)>rv)conflict=true;
+      if(at!=none){const double age=double(now-by5::commitVersion(c,at))/1e6;unsigned k=age<2?0:age<10?1:age<60?2:age<300?3:age<1200?4:age<3600?5:6;++ageHist[k];}
+     }
+     if(w==1 && insertedAt[rp][t.read.begin-base]==none)++badPoint;
+    }
+   }
+   mismatches+=conflict!=t.expectedConflict;conflicts+=conflict;
+   if(!conflict){insertedAt[wp].back()=uint32_t(b);++accepted[wp];}
+  }
+ }
