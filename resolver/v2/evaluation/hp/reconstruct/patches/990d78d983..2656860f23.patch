+void pointHeapBytesAndViews() {
+    PagePool pool(8);
+    TemporalHeap compact(pool), previous(pool), ordinary(pool);
+    const std::string k = key(100, 128), end = k + '\0';
+    const auto one = compact.appendPointWithSuccessor(1, sv(k));
+    const auto two = compact.appendPointWithSuccessor(2, sv(k));
+    const auto oldOne = previous.appendRange(1, sv(k), sv(end));
+    const auto oldTwo = previous.appendRange(2, sv(k), sv(end));
+    CHECK(one.present() && two.present() && oldOne.present() && oldTwo.present());
+    CHECK(one.get().pageID == two.get().pageID && oldOne.get().pageID == oldTwo.get().pageID);
+    constexpr size_t alignment = std::max(alignof(PointConflictHeader), alignof(RangeConflictHeader));
+    auto aligned = [&](size_t n) { return (n + alignment - 1) & ~(alignment - 1); };
+    const auto compactBytes = two.get().offset - one.get().offset;
+    const auto previousBytes = oldTwo.get().offset - oldOne.get().offset;
+    CHECK(compactBytes == aligned(sizeof(PointConflictHeader) + k.size() + 1));
+    CHECK(previousBytes == aligned(sizeof(RangeConflictHeader) + k.size() + end.size()));
+    CHECK(compactBytes < previousBytes);
+    CHECK(one.get().length == sizeof(PointConflictHeader) + k.size());
+    CHECK(bytes(compact.getPoint(one.get()).get().key) == k);
+    // Ordinary point records exclude the optional successor byte.
+    const auto normalOne = ordinary.appendPoint(1, sv(k));
+    const auto normalTwo = ordinary.appendPoint(2, sv(k));
+    CHECK(normalOne.present() && normalTwo.present());
+    CHECK(normalTwo.get().offset - normalOne.get().offset == aligned(sizeof(PointConflictHeader) + k.size()));
+    CHECK(bytes(ordinary.getPoint(normalOne.get()).get().key) == k);
+    std::printf("[128-byte key: heap stride %u -> %u] ", previousBytes, compactBytes);
+}
+
+void pointSuccessorFitsAndReclaimsAtPageBoundary() {
+    PagePool pool(3);
+    TemporalHeap heap(pool);
+    constexpr size_t alignment = std::max(alignof(PointConflictHeader), alignof(RangeConflictHeader));
+    constexpr size_t first = (sizeof(HistoryPage) + alignment - 1) & ~(alignment - 1);
+    const std::string k(HISTORY_PAGE_BYTES - first - sizeof(PointConflictHeader) - 1, '\xff');
+    const auto point = heap.appendPointWithSuccessor(1, sv(k));
+    CHECK(point.present());
+    const HeapRef begin{point.get().pageID,
+                        point.get().offset + static_cast<uint32_t>(sizeof(PointConflictHeader)),
+                        static_cast<uint32_t>(k.size())};
+    HeapRef end = begin;
+    ++end.length;
+    CHECK(end.offset + end.length == HISTORY_PAGE_BYTES);
+    CHECK(bytes(heap.getKey(begin).get()) == k);
+    CHECK(bytes(heap.getKey(end).get()) == k + '\0');
+    const auto next = heap.appendPointWithSuccessor(2, sv("next"));
+    CHECK(next.present() && next.get().pageID != point.get().pageID);
+    CHECK(bytes(heap.getKey(end).get()) == k + '\0');
+    CHECK(heap.reclaimOldest().get() == 1);
+    CHECK(!heap.getKey(begin).present() && !heap.getKey(end).present());
+    CHECK(bytes(heap.getPoint(next.get()).get().key) == "next");
+}
