+        tree.addPoint(2,sv(empty));
+        CHECK(tree.root_->navigation.prefix.length==reference.length);
+        CHECK(tree.root_->navigation.prefix.bytes==reference.bytes);
+        std::vector<std::string> storage; storage.reserve(320);
+        std::vector<Tree::Query> queries{{0,sv(empty),sv(zero),false}};
+        for(unsigned i=0;i<160;++i) {
+            storage.push_back(k(i));storage.push_back(storage.back()+'\0');
+            queries.push_back({0,sv(storage[2*i]),sv(storage[2*i+1]),false});
+        }
+        checkSortedQueries(tree,queries);
+        verify(tree);
+    }
