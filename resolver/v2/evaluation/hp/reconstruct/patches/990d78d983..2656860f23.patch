+void reclaimablePriorityChoosesLargestCapacity() {
+    for (unsigned limit : {L, Tree::Capacity - 1, Tree::Capacity}) {
+        Version cv = 10000000;
+        auto tree = filledTree(600, false, cv);
+        Tree::Node* small = sameParentPair(*tree, tree->firstLeaf_);
+        CHECK(small);
+        Tree::Node* smallRight = small->navigation.leaf.next;
+        Tree::Node* large = sameParentPair(*tree, smallRight->navigation.leaf.next);
+        CHECK(large && large != smallRight);
+        Tree::Node* largeRight = large->navigation.leaf.next;
+        const unsigned fictitious = std::min(8u, Tree::Capacity - 3);
+        shape(*tree, small, 1, 0, cv);
+        shape(*tree, smallRight, 1, 0, cv);
+        shape(*tree, large, 2, fictitious, cv);
+        shape(*tree, largeRight, 1, fictitious, cv);
+        tree->fictitious_.pressureMergedLimit = limit;
+        for (auto* x = tree->firstLeaf_; x; x = x->navigation.leaf.next) tree->markPair(x);
+        tree->flushPairs();
+        checkTree(*tree);
+        CHECK(tree->checkPairIndex());
+        const unsigned smallPriority = tree->pairPriority(small), largePriority = tree->pairPriority(large);
+        CHECK(smallPriority && largePriority && smallPriority > largePriority);
+        CHECK(large->fict.fictitious + largeRight->fict.fictitious > small->fict.fictitious + smallRight->fict.fictitious);
+        CHECK(tree->pairIndex_.candidate() == small->ageIndex);
+        const auto before = tree->stats();
+        const auto leaves = tree->leafCount();
+        const uint32_t smallId = small->ageIndex, largeId = large->ageIndex;
+        CHECK(tree->pressureFusion(nullptr));
+        CHECK(tree->leafCount() == leaves - 1);
+        CHECK(tree->stats().pressureGlobalFusions == before.pressureGlobalFusions + 1);
+        CHECK(small->allocated && small->ageIndex == smallId && small->size() == 2 && !smallRight->allocated);
+        CHECK(large->allocated && large->ageIndex == largeId && largeRight->allocated && large->navigation.leaf.next == largeRight);
+        tree->flushPairs();
+        CHECK(tree->checkPairIndex());
+        checkTree(*tree);
+    }
+}
+void relaxedRandom() {
+    for (unsigned limit : {Tree::Capacity - 1, Tree::Capacity})
+        randomModel(4, 71 + limit, false, false, 48, 600, limit, R);
+}
+
+void zeroReserveRandom() {
+    for (unsigned limit : {Tree::Capacity - 1, Tree::Capacity})
+        randomModel(4, 201 + limit, false, false, 48, 600, limit, 0);
+}
+void defaultRandom() {
+    randomModel(4, 251, false);
+    randomModel(8, 252, false, true);
+}
+
+}
+
+int main() {
+    setvbuf(stdout, nullptr, _IONBF, 0);
+    std::printf("fictitious leaves v5: C=%u K=%zu inlineOnly=%d node=%zu\n", Tree::Capacity, Tree::InlineKeyBytes, int(Tree::InlineOnlyKeys), sizeof(Tree::Node));
+    const std::vector<std::pair<const char*, std::function<void()>>> cases = {
+        { "zeroReserveRandom", zeroReserveRandom },
+        { "defaults", defaults },
+        { "defaultRandom", defaultRandom },
+        { "reclaimableRandom", reclaimableRandom },
+        { "reclaimablePriorityChoosesLargestCapacity", reclaimablePriorityChoosesLargestCapacity },
+        { "relaxedPressureFusion", relaxedPressureFusion },
+        { "relaxedRandom", relaxedRandom },
+        { "configuration", configuration },
+        { "consecutiveReleasesThenSplit", consecutiveReleasesThenSplit },
+        { "randomSmall", randomSmall },
+        { "randomMedium", randomMedium },
+        { "randomLarge", randomLarge },
+        { "randomHeapKeys", randomHeapKeys },
+        { "randomPoints", randomPoints },
+        { "randomSingles", randomSingles },
+        { "fallbackWithoutFeasiblePairs", fallbackWithoutFeasiblePairs },
+        { "mergeConservesReserve", mergeConservesReserve },
+        { "redistributionRanks", redistributionRanks },
+        { "redistributionPriority", redistributionPriority },
+        { "redistributionSlack", redistributionSlack },
+        { "redistributionAges", redistributionAges },
+        { "redistributionFragments", redistributionFragments },
+        { "indexedCandidate", indexedCandidate },
+    };
+    unsigned passed = 0;
+    for (const auto& [name, run] : cases) {
+        std::printf("%s: ", name);
+        try {
+            run();
+            std::printf("OK\n");
+            ++passed;
+        } catch (const std::exception& e) {
+            std::printf("FAIL %s\n", e.what());
+        }
+    }
+    std::printf("%u/%zu OK\n", passed, cases.size());
+    return passed == cases.size() ? 0 : 1;
+}
diff --git a/fdbserver/resolver/btree/tests/FictitiousPrehistoryTests.cpp b/fdbserver/resolver/btree/tests/FictitiousPrehistoryTests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..81f50336f29ad6e4299978b541103cfaf6315917
--- /dev/null
+++ b/fdbserver/resolver/btree/tests/FictitiousPrehistoryTests.cpp
@@ -0,0 +1,183 @@
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <functional>
+#include <limits>
+#include <random>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+#include "flow/IRandom.h"
+#include "BlockQueue.h"
+#include "PagedTemporalSkipList.h"
+#define private public
+#include "PagedBTreeConflictSet.h"
+#undef private
+#include "FictitiousHistory.h"
+
+using Tree = paged_btree::PagedBTreeConflictSet;
+
+#define CHECK(c) do { if (!(c)) throw std::runtime_error(std::string(#c) + " line " + std::to_string(__LINE__)); } while (false)
+
+namespace {
+
+constexpr unsigned domain = 16384;
+
+struct Keys {
+    std::vector<std::string> keys;
+    explicit Keys(unsigned extra) : keys(domain + 1) {
+        for (unsigned i = 0; i <= domain; ++i) {
+            std::string k(8, '\0');
+            for (unsigned j = 0; j < 8; ++j) k[7 - j] = static_cast<char>(uint64_t(i) >> (8 * j));
+            keys[i] = k + std::string(extra, char('a' + i % 26));
+        }
+    }
+    StringRef operator()(unsigned i) const {
+        return StringRef(reinterpret_cast<const uint8_t*>(keys[i].data()), keys[i].size());
+    }
+};
+
+Tree::MemoryConfig memoryFor(uint64_t, bool) { return {}; }
+
+struct Batch {
+    std::array<Tree::Write, 48> writes;
+    std::array<std::pair<unsigned, unsigned>, 48> ranges;
+    void generate(std::mt19937& random, const Keys& key) {
+        for (unsigned i = 0; i < writes.size(); ++i) {
+            const unsigned a = random() % (domain - 32), b = a + 1 + random() % 8;
+            ranges[i] = { a, b };
+            writes[i] = Tree::Write{ key(a), key(b), ConflictKind::Range };
+        }
+    }
+};
+
+void primedAndColdAgreeWithRealOracle(uint64_t pages, bool heapKeys, unsigned seed) {
+    setThreadLocalDeterministicRandomSeed(seed);
+    const Keys key(heapKeys ? Tree::InlineKeyBytes + 16 : 0);
+    Tree primed(pages, 0, memoryFor(pages, heapKeys)), cold(pages, 0, memoryFor(pages, heapKeys));
+    by5::FictitiousHistory history({ 1600, 1, -4, seed });
+    std::mt19937 synthetic(seed), real(seed + 1000);
+    Batch batch;
+    std::vector<Version> floors;
+    history.preload(primed, [&](int64_t, uint64_t s) { CHECK(s == seed); batch.generate(synthetic, key); return batch.writes; },
+                    [&](int64_t b, int64_t cv, const Tree& tree) {
+                        CHECK(cv == b + 1 && tree.validationMinRV() <= cv);
+                        CHECK(floors.empty() || tree.validationMinRV() >= floors.back());
+                        floors.push_back(tree.validationMinRV());
+                    });
+    CHECK(history.ready() && history.completedBatches() == 1600 && history.syntheticEnd() == 1600 && history.realOffset() == 1604);
+    const Version handoverFloor = primed.validationMinRV();
+    const uint64_t handoverNodes = primed.nodeCount();
+    CHECK(handoverFloor < history.syntheticEnd());
+    if (pages <= 8) CHECK(handoverFloor > 0 && primed.stats().reclaimAgeCandidates > 0 && primed.stats().merges > 0);
+    uint64_t isolation = 0;
+    for (unsigned a = 0; a < domain; a += 17) {
+        const unsigned b = std::min(domain, a + 17);
+        CHECK(!primed.hasConflict(history.readVersion(-4), key(a), key(b)));
+        CHECK(!primed.hasConflict(history.readVersion(0), key(a), key(b)));
+        ++isolation;
+    }
+    CHECK(primed.validationMinRV() == handoverFloor && primed.nodeCount() == handoverNodes);
+    bool blocked = false;
+    try { history.readVersion(-5); } catch (const std::logic_error&) { blocked = true; }
+    CHECK(blocked);
+    blocked = false;
+    try { history.writeVersion(0); } catch (const std::logic_error&) { blocked = true; }
+    CHECK(blocked);
+    blocked = false;
+    try { history.preload(primed, [&](int64_t, uint64_t) { return batch.writes; }, [](int64_t, int64_t, const Tree&) {}); }
+    catch (const std::logic_error&) { blocked = true; }
+    CHECK(blocked);
+    std::vector<Version> oracle(domain, std::numeric_limits<Version>::lowest());
+    uint64_t checks = 0, crossBoundary = 0;
+    Version firstRealFloor = 0;
+    for (Version b = 1; b <= 1600; ++b) {
+        batch.generate(real, key);
+        const Version floorBefore = primed.validationMinRV();
+        primed.addWrites(history.writeVersion(b), batch.writes.data(), batch.writes.size());
+        cold.addWrites(history.writeVersion(b), batch.writes.data(), batch.writes.size());
+        CHECK(primed.validationMinRV() >= floorBefore && primed.validationMinRV() < history.writeVersion(b));
+        if (b == 1) CHECK(primed.validationMinRV() < history.syntheticEnd());
+        if (!firstRealFloor && history.realFloor(primed.validationMinRV()) > 0) firstRealFloor = b;
+        for (auto [x, y] : batch.ranges)
+            for (unsigned p = x; p < y; ++p) oracle[p] = b;
+        for (unsigned q = 0; q < 64; ++q) {
+            const unsigned x = real() % (domain - 64), y = x + 1 + real() % 64;
+            const Version low = std::max<Version>(-4, std::max(history.realFloor(primed.validationMinRV()), history.realFloor(cold.validationMinRV())));
+            const Version rv = low + Version(real() % uint64_t(b - low + 1));
+            bool expected = false;
+            for (unsigned p = x; p < y; ++p) expected |= oracle[p] > rv;
+            crossBoundary += rv < 0;
+            CHECK(primed.hasConflict(history.readVersion(rv), key(x), key(y)) == expected);
+            CHECK(cold.hasConflict(history.readVersion(rv), key(x), key(y)) == expected);
+            ++checks;
+        }
+    }
+    std::printf("[pages=%llu heapKeys=%d handoverFloor=%lld realFloorAt=%lld primedFloor=%lld coldFloor=%lld isolation=%llu checks=%llu crossBoundary=%llu] ",
+                (unsigned long long)pages, int(heapKeys), (long long)handoverFloor, (long long)firstRealFloor,
+                (long long)history.realFloor(primed.validationMinRV()), (long long)history.realFloor(cold.validationMinRV()),
+                (unsigned long long)isolation, (unsigned long long)checks, (unsigned long long)crossBoundary);
+    if (pages <= 8) CHECK(firstRealFloor > 0);
+}
+
+void primedSmall() { primedAndColdAgreeWithRealOracle(4, false, 91); }
+void primedMedium() { primedAndColdAgreeWithRealOracle(8, false, 92); }
+void primedLarge() { primedAndColdAgreeWithRealOracle(128, false, 93); }
+void primedHeapKeys() { primedAndColdAgreeWithRealOracle(8, !Tree::InlineOnlyKeys, 94); }
+
+void invalidConfigurations() {
+    bool rejected = false;
+    try { by5::FictitiousHistory bad({ std::numeric_limits<int64_t>::max(), 2, 0, 1 }); } catch (const std::overflow_error&) { rejected = true; }
+    CHECK(rejected);
+    rejected = false;
+    try { by5::FictitiousHistory bad({ 0, 1, 0, 1 }); } catch (const std::invalid_argument&) { rejected = true; }
+    CHECK(rejected);
+    rejected = false;
+    try { by5::FictitiousHistory bad({ 1, 0, 0, 1 }); } catch (const std::invalid_argument&) { rejected = true; }
+    CHECK(rejected);
+    rejected = false;
+    try { by5::FictitiousHistory bad({ 1, 1, std::numeric_limits<int64_t>::min(), 1 }); } catch (const std::invalid_argument&) { rejected = true; }
+    CHECK(rejected);
+    by5::FictitiousHistory unused({ 1, 1, 0, 1 });
+    rejected = false;
+    try { unused.readVersion(0); } catch (const std::logic_error&) { rejected = true; }
+    CHECK(rejected);
+    Tree used(4, 0, memoryFor(4, false));
+    const Keys key(0);
+    Tree::Write write{ key(1), key(2), ConflictKind::Range };
+    used.addWrites(1, &write, 1);
+    by5::FictitiousHistory fresh({ 1, 1, 0, 1 });
+    rejected = false;
+    try { fresh.preload(used, [&](int64_t, uint64_t) { return std::array<Tree::Write, 1>{ write }; }, [](int64_t, int64_t, const Tree&) {}); }
+    catch (const std::logic_error&) { rejected = true; }
+    CHECK(rejected && !fresh.ready());
+}
+
+}
+
+int main() {
+    setvbuf(stdout, nullptr, _IONBF, 0);
+    std::printf("fictitious prehistory: C=%u K=%zu inlineOnly=%d\n", Tree::Capacity, Tree::InlineKeyBytes, int(Tree::InlineOnlyKeys));
+    const std::vector<std::pair<const char*, std::function<void()>>> cases = {
+        { "primedSmall", primedSmall },
+        { "primedMedium", primedMedium },
+        { "primedLarge", primedLarge },
+        { "primedHeapKeys", primedHeapKeys },
+        { "invalidConfigurations", invalidConfigurations },
+    };
+    unsigned passed = 0;
+    for (const auto& [name, run] : cases) {
+        std::printf("%s: ", name);
+        try {
+            run();
+            std::printf("OK\n");
+            ++passed;
+        } catch (const std::exception& e) {
+            std::printf("FAIL %s\n", e.what());
+        }
+    }
+    std::printf("%u/%zu OK\n", passed, cases.size());
+    return passed == cases.size() ? 0 : 1;
+}
diff --git a/fdbserver/resolver/btree/tests/PoolBackingTests.cpp b/fdbserver/resolver/btree/tests/PoolBackingTests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ee85d37f3de1f7ad95ba029c0b6a8c1a8884acc9
--- /dev/null
+++ b/fdbserver/resolver/btree/tests/PoolBackingTests.cpp
@@ -0,0 +1,293 @@
+#include "PagedTemporalSkipList.h"
+#include "PagedBTreeConflictSet.h"
+#include "flow/IRandom.h"
+
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <functional>
+#include <random>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+using Tree = paged_btree::PagedBTreeConflictSet;
+
+#define CHECK(c) do { if (!(c)) throw std::runtime_error(std::string(#c) + " line " + std::to_string(__LINE__)); } while (false)
+
+namespace {
+
+constexpr size_t Huge = size_t{2} << 20;
+constexpr size_t PageBytes = HISTORY_PAGE_BYTES;
+
+StringRef sv(const std::string& value) {
+    return StringRef(reinterpret_cast<const uint8_t*>(value.data()), value.size());
+}
+
+std::string key(unsigned number, unsigned length) {
+    std::string result(length, 'k');
+    for (unsigned i = 0; i < 4 && i < length; ++i) { result[length - 1 - i] = static_cast<char>(number & 255); number >>= 8; }
+    return result;
+}
+
+long meminfo(const char* field) {
+    std::ifstream in("/proc/meminfo");
+    std::string name;
+    long value = -1;
+    while (in >> name) {
+        if (name == std::string(field) + ":") { in >> value; return value; }
+        in.ignore(256, '\n');
+    }
+    return -1;
+}
+
+unsigned smapsKiB(uintptr_t address) {
+    std::ifstream smaps("/proc/self/smaps");
+    std::string line;
+    bool inside = false;
+    while (std::getline(smaps, line)) {
+        unsigned long lo, hi;
+        char perms[8];
+        if (std::sscanf(line.c_str(), "%lx-%lx %7s", &lo, &hi, perms) == 3) { inside = address >= lo && address < hi; continue; }
+        if (inside && line.rfind("KernelPageSize:", 0) == 0) return static_cast<unsigned>(std::stoul(line.substr(15)));
+    }
+    return 0;
+}
+
+std::string smapsField(uintptr_t address, const std::string& field) {
+    std::ifstream smaps("/proc/self/smaps");
+    std::string line;
+    bool inside = false;
+    while (std::getline(smaps, line)) {
+        unsigned long lo, hi;
+        char perms[8];
+        if (std::sscanf(line.c_str(), "%lx-%lx %7s", &lo, &hi, perms) == 3) { inside = address >= lo && address < hi; continue; }
+        if (inside && line.rfind(field + ":", 0) == 0) return line.substr(field.size() + 1);
+    }
+    return std::string();
+}
+
+#if defined(__SANITIZE_ADDRESS__)
+constexpr bool MappingsObservable = false;
+#elif defined(__has_feature)
+#if __has_feature(address_sanitizer)
+constexpr bool MappingsObservable = false;
+#else
+constexpr bool MappingsObservable = true;
+#endif
+#else
+constexpr bool MappingsObservable = true;
+#endif
+
+std::set<std::pair<unsigned long, unsigned long>> reservedRegions() {
+    std::set<std::pair<unsigned long, unsigned long>> regions;
+    if (!MappingsObservable) return regions;
+    std::ifstream maps("/proc/self/maps");
+    std::string line;
+    while (std::getline(maps, line)) {
+        unsigned long lo, hi;
+        char perms[8];
+        if (std::sscanf(line.c_str(), "%lx-%lx %7s", &lo, &hi, perms) == 3 && std::string(perms) == "---p")
+            regions.emplace(lo, hi);
+    }
+    return regions;
+}
+
+void checkNoTransparentHugePages(const PagePool::BackingRange& range) {
+    if (!range.usefulBytes) return;
+    for (uintptr_t address : {range.begin, range.begin + range.usefulBytes - 1}) {
+        CHECK((" " + smapsField(address, "VmFlags") + " ").find(" nh ") != std::string::npos);
+        CHECK(std::strtoul(smapsField(address, "AnonHugePages").c_str(), nullptr, 10) == 0);
+    }
+}
+
+Tree::MemoryConfig withBacking(PoolBacking backing) {
+    Tree::MemoryConfig memory;
+    memory.backing = backing;
+    return memory;
+}
+
+bool hugeIndex(PoolBacking b) { return b == PoolBacking::Index || b == PoolBacking::Both; }
+
+void checkRange(const PagePool::BackingRange& range, size_t useful, bool huge) {
+    CHECK(range.usefulBytes == useful);
+    if (!useful) { CHECK(range.mappedBytes == 0 && range.pageKiB == 0); return; }
+    CHECK(range.pageKiB == (huge ? 2048u : 4u));
+    if (huge) {
+        const uintptr_t from = range.begin & ~(Huge - 1);
+        const uintptr_t to = (range.begin + useful + Huge - 1) & ~(Huge - 1);
+        CHECK(range.mappedBytes == to - from && range.mappedBytes >= useful && range.mappedBytes - useful < 2 * Huge);
+    } else CHECK(range.mappedBytes == useful);
+    CHECK(smapsKiB(range.begin) == range.pageKiB && smapsKiB(range.begin + useful - 1) == range.pageKiB);
+}
+
+struct Outcome {
+    std::vector<int> results;
+    Version minRV;
+    uint64_t splits, merges, insertions;
+    bool operator==(const Outcome& o) const {
+        return results == o.results && minRV == o.minRV && splits == o.splits && merges == o.merges && insertions == o.insertions;
+    }
+};
+
+Outcome workload(Tree& tree, unsigned length, unsigned seed) {
+    setThreadLocalDeterministicRandomSeed(seed);
+    std::mt19937 rng(seed);
+    Outcome outcome;
+    for (Version cv = 1; cv <= 6000; ++cv) {
+        unsigned a = cv % 2 ? rng() % 4000 : 4000 + rng() % 400000, c = a + 1 + rng() % 40;
+        tree.addRange(cv, sv(key(a, length)), sv(key(c, length)));
+        if (cv % 50) continue;
+        std::vector<std::string> keys;
+        std::vector<Tree::Query> queries;
+        keys.reserve(128);
+        for (unsigned i = 0; i < 64; ++i) {
+            a = i % 2 ? rng() % 4000 : 4000 + rng() % 400000; c = a + rng() % 60;
+            keys.push_back(key(a, length)); keys.push_back(key(c, length));
+        }
+        for (unsigned i = 0; i < 64; ++i)
+            queries.push_back({std::max(tree.validationMinRV(), cv - Version(rng() % 300)), sv(keys[2 * i]), sv(keys[2 * i + 1])});
+        tree.hasConflicts(queries.data(), queries.size());
+        for (auto& q : queries) outcome.results.push_back(q.conflict);
+    }
+    outcome.minRV = tree.validationMinRV();
+    outcome.splits = tree.stats().splits;
+    outcome.merges = tree.stats().merges;
+    outcome.insertions = tree.stats().intervalInsertions;
+    return outcome;
+}
+
+void requireFreeHugePages(long pages) {
+    const long free = meminfo("HugePages_Free");
+    if (free < pages)
+        throw std::runtime_error("needs " + std::to_string(pages) + " free 2 MiB HugeTLB pages, found " + std::to_string(free) +
+                                 "; reserve them (vm.nr_hugepages) before running these tests");
+}
+
+void namesRoundTrip() {
+    for (auto b : {PoolBacking::Normal, PoolBacking::Index, PoolBacking::Both}) {
+        PoolBacking parsed = PoolBacking::Normal;
+        CHECK(parsePoolBacking(poolBackingName(b), parsed) && parsed == b);
+    }
+    PoolBacking unchanged = PoolBacking::Both;
+    for (const char* bad : {"", "heap", "Normal", "huge", "both ", "indexes"}) CHECK(!parsePoolBacking(bad, unchanged) && unchanged == PoolBacking::Both);
+}
+
+void indexPoolLayout() {
+    requireFreeHugePages(8);
+    for (auto backing : {PoolBacking::Normal, PoolBacking::Index, PoolBacking::Both}) {
+        for (uint64_t pages : {uint64_t{96}, uint64_t{1}, uint64_t{32}, uint64_t{97}}) {
+            Tree tree(pages, 0, withBacking(backing));
+            const auto& report = tree.poolBacking();
+            CHECK(report.mapped && report.backing == backing);
+            checkRange(report.index, pages * PageBytes, hugeIndex(backing));
+            CHECK(report.index.begin % Huge == 0);
+            CHECK(tree.budget().limitPages == pages);
+            CHECK(report.setupNanoseconds > 0);
+        }
+    }
+}
+
+void backingKeepsDecisions() {
+    requireFreeHugePages(8);
+    for (unsigned length : {16u, 32u, 64u, 96u}) {
+        uint64_t pages = length > 16 ? 16 : 6;
+        for (; pages > 3; --pages) {
+            Tree probe(pages, 0, withBacking(PoolBacking::Normal));
+            const Outcome outcome = workload(probe, length, 9 + length);
+            if (outcome.merges > 0 && outcome.minRV > 0) break;
+        }
+        Tree reference(pages, 0, withBacking(PoolBacking::Normal));
+        const Outcome expected = workload(reference, length, 9 + length);
+        std::printf("[K%u pages=%llu merges=%llu minRV=%lld keyBlocks=%llu] ", length, (unsigned long long)pages,
+                    (unsigned long long)expected.merges, (long long)expected.minRV,
+                    (unsigned long long)reference.peakKeyBlockCount());
+        CHECK(expected.merges > 0 && expected.minRV > 0);
+        for (auto backing : {PoolBacking::Index, PoolBacking::Both}) {
+            Tree tree(pages, 0, withBacking(backing));
+            CHECK(workload(tree, length, 9 + length) == expected);
+            CHECK(tree.budget().heapPages == reference.budget().heapPages && tree.budget().indexPages == reference.budget().indexPages);
+            CHECK(tree.keyBlockCount() == reference.keyBlockCount() && tree.peakKeyBlockCount() == reference.peakKeyBlockCount());
+        }
+    }
+}
+
+void releaseReturnsHugePages() {
+    requireFreeHugePages(16);
+    const long before = meminfo("HugePages_Free");
+    for (auto backing : {PoolBacking::Index, PoolBacking::Both}) {
+        {
+            Tree tree(96, 0, withBacking(backing));
+            const long used = long(tree.poolBacking().index.mappedBytes / Huge);
+            CHECK(meminfo("HugePages_Free") == before - used);
+            workload(tree, 32, 3);
+            CHECK(meminfo("HugePages_Free") == before - used);
+        }
+        CHECK(meminfo("HugePages_Free") == before);
+    }
+}
+
+void normalRangesRefuseTransparentHugePages() {
+    requireFreeHugePages(8);
+    {
+        Tree tree(96, 0, withBacking(PoolBacking::Normal));
+        workload(tree, 32, 4);
+        checkNoTransparentHugePages(tree.poolBacking().index);
+    }
+    for (auto backing : {PoolBacking::Index, PoolBacking::Both}) {
+        Tree tree(96, 0, withBacking(backing));
+        CHECK(smapsField(tree.poolBacking().index.begin, "VmFlags").find("ht") != std::string::npos);
+    }
+}
+
+void reservationFailureIsClear() {
+    const long free = meminfo("HugePages_Free");
+    const auto mappings = reservedRegions();
+    CHECK(free >= 0);
+    const uint64_t pages = uint64_t(free + 2) * (Huge / PageBytes);
+    for (auto backing : {PoolBacking::Index, PoolBacking::Both}) {
+        bool failed = false;
+        std::string message;
+        try {
+            Tree tree(pages, 0, withBacking(backing));
+        } catch (const std::runtime_error& e) {
+            failed = true;
+            message = e.what();
+        }
+        CHECK(failed);
+        CHECK(message.find("HugeTLB pool backing failed for the index range") != std::string::npos);
+        CHECK(message.find("vm.nr_hugepages") != std::string::npos);
+        CHECK(meminfo("HugePages_Free") == free);
+        CHECK(reservedRegions() == mappings);
+    }
+}
+
+} // namespace
+
+int main() {
+    setvbuf(stdout, nullptr, _IONBF, 0);
+    std::printf("HugePages_Total=%ld HugePages_Free=%ld Hugepagesize=%ld kB\n", meminfo("HugePages_Total"),
+                meminfo("HugePages_Free"), meminfo("Hugepagesize"));
+    const std::vector<std::pair<const char*, std::function<void()>>> cases = {
+        {"namesRoundTrip", namesRoundTrip},
+        {"indexPoolLayout", indexPoolLayout},
+        {"backingKeepsDecisions", backingKeepsDecisions},
+        {"releaseReturnsHugePages", releaseReturnsHugePages},
+        {"normalRangesRefuseTransparentHugePages", normalRangesRefuseTransparentHugePages},
+        {"reservationFailureIsClear", reservationFailureIsClear},
+    };
+    unsigned passed = 0;
+    for (const auto& [name, run] : cases) {
+        std::printf("%s: ", name);
+        try {
+            run();
+            std::printf("OK\n");
+            ++passed;
+        } catch (const std::exception& e) {
+            std::printf("FAIL %s\n", e.what());
+        }
+    }
+    std::printf("%u/%zu OK\n", passed, cases.size());
+    return passed == cases.size() ? 0 : 1;
+}
diff --git a/fdbserver/resolver/btree/tests/PoolBackingTests.md b/fdbserver/resolver/btree/tests/PoolBackingTests.md
new file mode 100644
index 0000000000000000000000000000000000000000..f858559f1dca3920eea58034a7f3a7cf0e65b672
--- /dev/null
+++ b/fdbserver/resolver/btree/tests/PoolBackingTests.md
@@ -0,0 +1,91 @@
+# PoolBackingTests — the B+ pool's memory backing
+
+`PoolBackingTests.cpp` tests how `PagePool` maps the paged B+'s pool
+([PagedTemporalSkipList.h](../../PagedTemporalSkipList.h), [.cpp](../../PagedTemporalSkipList.cpp)) when
+`PagedBTreeConflictSet::MemoryConfig::backing` selects normal pages or 2 MiB HugeTLB pages. Since v107 the pool is
+one index range: B+ nodes and key blocks share its pages, and there is no key range. `index` and `both` back that
+range with HugeTLB pages and are equivalent; `normal` uses normal pages with transparent huge pages refused. `heap`
+is no longer a backing name. It complements the B+ battery, whose trees use normal pages.
+
+## Requirements and how to run it
+
+The cases that map HugeTLB ranges need 2 MiB pages reserved in the system before the run (`vm.nr_hugepages`); the
+program never reserves them. A case that finds too few free pages fails and names how many it needs: there is no
+silent skip. The runs below used 64 reserved pages.
+
+```bash
+BTREE_TESTS=$PWD/fdbserver/resolver/btree/tests/PoolBackingTests.cpp fdbserver/resolver/btree/run-btree-tests.sh
+SANITIZE=1 BTREE_TESTS=... fdbserver/resolver/btree/run-btree-tests.sh
+```
+
+The runner compiles this file with the component's sources and links FDB's libraries from the build tree, like the
+battery. It prints one line per case and exits non-zero if any case failed.
+
+## Environment
+
+| | |
+|---|---|
+| Image | `foundationdb/build:rockylinux9-latest` |
+| Compiler | clang 19.1.5, libc++ |
+| Kernel | Linux 6.8.0-138, 2 MiB default huge page size |
+| Flags | the build's defaults: C23, K64, inline-only; `-O2`, or `-O1 -g` with ASan/UBSan |
+
+## Cases
+
+- `namesRoundTrip`: `poolBackingName` and `parsePoolBacking` agree on `normal`, `index` and `both`; anything else,
+  `heap` included, is rejected and leaves the value unchanged.
+- `indexPoolLayout`: for each backing and pools of 96, 1, 32 and 97 pages, the report states the backing, the useful
+  bytes of the index range, the mapped bytes (the useful bytes for normal pages; whole 2 MiB pages covering them for
+  HugeTLB) and the page size, checked against `/proc/self/smaps` at the first and last useful byte. The range starts
+  on a 2 MiB boundary and the budget is the pool requested.
+- `backingKeepsDecisions`: one workload of 6,000 range writes and 7,680 queries, run on a normal-page tree and on
+  `index` and `both` trees with FDB's random generator reseeded identically, gives the same results, final boundary,
+  splits, merges, insertions, page use and key-block counts. The pools are small enough that fusion and reclamation
+  both happen: 9, 4, 1 and 7 merges and final boundaries of 5056, 880, 1556 and 3420 at 16, 32, 64 and 96-byte keys.
+  Only the 96-byte keys exceed the 64-byte inline prefix and take key blocks (a peak of 149).
+- `normalRangesRefuseTransparentHugePages`: a normal-page pool carries the kernel's `nh` flag (`MADV_NOHUGEPAGE`) in
+  `/proc/self/smaps` and holds no `AnonHugePages` after a workload; a HugeTLB pool carries `ht`.
+- `releaseReturnsHugePages`: building a `both` tree takes exactly the 2 MiB pages its report states from
+  `HugePages_Free`, running a workload takes no more, and destroying it returns them all.
+- `reservationFailureIsClear`: a pool larger than the free 2 MiB pages fails to build with `std::runtime_error`
+  naming the index range, the bytes and pages requested, the system's reason and `vm.nr_hugepages`. Afterwards
+  `HugePages_Free` is unchanged and the set of reserved (`---p`) regions in `/proc/self/maps` is exactly the one
+  before, so a failed build leaks neither pages nor any part of the address reservation. Checked for `index` and
+  `both`.
+
+The cases on the key/index split (`explicitSplitLayout`, `automaticSplitLayout`,
+`configurationErrorsAreNotMemoryFailures`) were removed with the split.
+
+## Results
+
+6/6 OK with `-O2` and 6/6 OK under ASan/UBSan, with no sanitizer report and no compiler warning (2026-10-12, v107
+consolidation, 64 reserved pages). Under ASan the sanitizer's allocator maps and splits large regions of its own, so
+the checks on `/proc/self/maps` run only in the build without sanitizers; the page counts are checked in both.
+
+## Mutation checks
+
+Each mutant was applied to a scratch copy of the sources and run with this program (2026-10-12):
+
+| mutant | detected by |
+|---|---|
+| the index range ignores HugeTLB | `indexPoolLayout` (page size), `releaseReturnsHugePages`, `normalRangesRefuseTransparentHugePages` (`ht` missing), `reservationFailureIsClear`: 2/6 |
+| `both` treated as `normal` | the same four cases: 2/6 |
+| normal ranges without `MADV_NOHUGEPAGE` | `normalRangesRefuseTransparentHugePages`, `nh` missing: 5/6 |
+| no `munmap` when the mapping fails | `reservationFailureIsClear`, reserved regions changed: 5/6 |
+
+All were caught by named checks. The last one survived the earlier form of `reservationFailureIsClear`, which counted
+only reserved regions of 64 MiB or more: a failed `MAP_FIXED` mapping first removes the part of the reservation it
+replaces, and what leaks is the few MiB on either side. The check now compares the exact set of reserved regions.
+Marking `MADV_NOHUGEPAGE` after populating instead of before cannot be told apart on these machines, whose THP mode
+is `madvise`; that order is kept by review.
+
+## What this does not cover
+
+- **Fragmentation.** The failure case runs out of reserved pages; it does not reproduce a reservation that the system
+  cannot satisfy because physical memory is fragmented, which is the system's step, outside the component.
+- **Non-Linux builds.** Only the Linux path is compiled and run here; elsewhere `normal` keeps the aligned allocation
+  and HugeTLB backing is rejected, which is not exercised. A source check confirms that every Linux-only call is
+  inside a `__linux__` block.
+- **The Resolver.** Selecting the backing through `PAGED_RESOLVER_POOL_BACKING`, the `PagedPoolBacking` trace event and
+  the failure path inside a running Resolver are covered by the integration cases and simulations, not here.
+- **Performance.** No timing; the effect of huge pages is measured separately.
diff --git a/fdbserver/resolver/btree/tests/UnifiedKeyBlockTests.cpp b/fdbserver/resolver/btree/tests/UnifiedKeyBlockTests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c7d0989c83e984a84a794137c69691756a51e2cc
--- /dev/null
+++ b/fdbserver/resolver/btree/tests/UnifiedKeyBlockTests.cpp
@@ -0,0 +1,217 @@
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <functional>
+#include <random>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#include "flow/IRandom.h"
+#include "BlockQueue.h"
+#include "PagedTemporalSkipList.h"
+#define private public
+#include "PagedBTreeConflictSet.h"
+#undef private
+#include "By5Workload.h"
+using Tree = paged_btree::PagedBTreeConflictSet;
+#define CHECK(c) do { if (!(c)) throw std::runtime_error(std::string(#c) + " at " + std::to_string(__LINE__)); } while (false)
+StringRef sv(const std::string& s) { return {reinterpret_cast<const uint8_t*>(s.data()), int(s.size())}; }
+std::string key(unsigned i, size_t size=96) {
+    std::string s(size, 'a');
+    for (unsigned j=0;j<4;++j) s[size-4+j]=char(i>>(24-8*j));
+    return s;
+}
+Tree::MemoryConfig config() { return {}; }
+void accounting(Tree& t) {
+    uint64_t slots=0,live=0,blocks=0,treeNodes=0;
+    for(auto* p=t.pages_;p;p=p->next) {
+        uint64_t used=0;
+        auto* raw=reinterpret_cast<std::byte*>(p)+Tree::nodeOffset();
+        for(size_t j=0;j<Tree::nodesPerPage();++j) {
+            auto* n=reinterpret_cast<Tree::Node*>(raw+j*sizeof(Tree::Node));
+            if(n->allocated) { ++treeNodes; ++used; }
+            else if(n->ageLinked && n->ageUse==PageUse::Heap) { ++blocks; ++used; }
+        }
+        CHECK(used==p->live);live+=used;slots+=Tree::nodesPerPage();
+    }
+    CHECK(blocks==t.keyBlockCount()); CHECK(treeNodes==t.nodeCount());
+    CHECK(slots==live+t.freeNodes_+t.retiredCount_);
+    CHECK(t.budget().heapPages==0);
+    std::vector<uint8_t> scratch;
+    for(auto* leaf=t.firstLeaf_;leaf;leaf=leaf->navigation.leaf.next)
+        for(unsigned r=0;r<leaf->size();++r) {
+            const auto& e=leaf->at(r);if(e.cv<=t.validationMinRV())continue;
+            if(!Tree::isInlineOnly(e.begin))CHECK(t.heap_.getKey(e.begin,scratch).present());
+            if(!Tree::isInlineOnly(e.end))CHECK(t.heap_.getKey(e.end,scratch).present());
+        }
+}
+void sameBlockReuse() {
+    Tree t(2,0,config());
+    CHECK(!t.heap_.getKey({0,0,1}).present());
+    CHECK(!t.heap_.getKey({UINT64_MAX,0,1}).present());
+    std::string k=key(1);
+    auto a=t.heap_.appendPointWithSuccessor(10,sv(k));CHECK(a.present());
+    const auto old=a.get(); auto* page=Tree::findKeyBlock(&t,old.pageID);auto* owner=Tree::keyBlockOwner(page);
+    Tree::LeafHint hint{owner,owner->incarnation};
+    CHECK(t.heap_.getPoint(old).present());CHECK(t.keyBlockCount()==1);
+    t.validationMinRV_=10;t.heap_.reclaimOldest();CHECK(!t.heap_.getPoint(old).present());
+    auto* reserved=t.allocateNode();CHECK(reserved==owner);
+    Tree::Reservation r;r.nodes[r.size++]=reserved;auto* node=t.take(r,true);
+    CHECK(node==owner && node->incarnation!=hint.incarnation);CHECK(!t.heap_.getPoint(old).present());
+    t.root_=t.firstLeaf_=node; t.releaseNode(node);t.root_=t.firstLeaf_=nullptr;--t.leafCount_;
+    auto b=t.heap_.appendPointWithSuccessor(20,sv(k));CHECK(b.present());CHECK(Tree::keyBlockOwner(Tree::findKeyBlock(&t,b.get().pageID))==owner);
+    CHECK(b.get().pageID!=old.pageID);CHECK(!t.heap_.getPoint(old).present());CHECK(t.heap_.getPoint(b.get()).present());
+    accounting(t);
+}
+void rejectBeforeMutation() {
+    Tree t(2,0,config());auto a=key(1);auto huge=key(2,t.maximumHeapRecordBytes()+1);
+    std::array<Tree::Write,2> w{{{sv(a),{},ConflictKind::Point},{sv(huge),{},ConflictKind::Point}}};
+    bool rejected=false;try {t.addWrites(10,w.data(),w.size());}catch(const std::invalid_argument&){rejected=true;}
+    CHECK(rejected);CHECK(t.nodeCount()==0 && t.keyBlockCount()==0 && t.lastWriteCV_==Tree::NoVersion);
+}
+void boundaryAndCV() {
+    Tree t(3,0,config());
+    const size_t size=t.heap_.contiguousRecordBytes()-sizeof(PointConflictHeader)-1;
+    auto k=key(1,size);
+    auto a=t.heap_.appendPointWithSuccessor(11,sv(k));CHECK(a.present());
+    auto view=t.heap_.getPoint(a.get());CHECK(view.present() && view.get().key==sv(k));
+    auto b=t.heap_.appendPointWithSuccessor(12,sv(k));CHECK(b.present());CHECK(t.keyBlockCount()==2);
+    CHECK(t.heap_.oldestPageNewestCV().get()==11);
+    t.validationMinRV_=11;t.heap_.reclaimOldest();CHECK(!t.heap_.getPoint(a.get()).present());CHECK(t.heap_.getPoint(b.get()).present());
+    accounting(t);
+}
+void randomModel(bool fictitious, bool mixed=false) {
+    Tree t(4,0,config());
+    if(fictitious){Tree::FictitiousLeafConfig f;f.rootReserve=f.splitReserve=(11*Tree::Capacity+11)/23;
+        f.pressureMergedLimit=Tree::Capacity;t.configureFictitiousLeaves(f);}
+    else t.configureFictitiousLeaves({0,0});
+    constexpr unsigned N=12000;std::vector<Version> model(N,0);std::mt19937 rng(31);
+    by5::Config profile;profile.keyProfile=1;
+    std::vector<std::string> keys;for(unsigned i=0;i<=N;++i)keys.push_back(mixed?by5::key(profile,i):key(i));
+    for(Version cv=1;cv<=2500;++cv) {
+        std::vector<Tree::Write> batch;
+        for(unsigned j=0;j<16;++j) {
+            unsigned a=rng()%(N-10),b=a+1+rng()%10;bool point=rng()%3==0;
+            batch.push_back({sv(keys[a]),point?StringRef{}:sv(keys[b]),point?ConflictKind::Point:ConflictKind::Range});
+            for(unsigned x=a;x<(point?a+1:b);++x)model[x]=cv;
+        }
+        t.addWrites(cv,batch.data(),batch.size());
+        std::array<Tree::Query,16> q;
+        for(auto& query:q) {unsigned a=rng()%(N-10),b=a+1+rng()%10;
+            Version rv=std::max(t.validationMinRV(),cv-Version(rng()%80));
+            query={rv,sv(keys[a]),sv(keys[b])};bool expected=false;for(unsigned x=a;x<b;++x)expected|=model[x]>rv;
+            CHECK(t.hasConflict(rv,query.begin,query.end)==expected);query.conflict=expected;}
+        auto grouped=q;t.hasConflicts(grouped.data(),grouped.size());for(size_t j=0;j<q.size();++j)CHECK(q[j].conflict==grouped[j].conflict);
+        if(cv%25==0)accounting(t);
+    }
+    CHECK(t.stats().heapPagesReclaimed>0);CHECK(t.validationMinRV()>0);accounting(t);
+}
+void largeKeys() {
+    Tree t(16,0,config());
+    std::vector<uint8_t> scratch;
+    auto a=key(1,10000),b=key(8,10000);
+    auto ref=t.heap_.appendRange(1,sv(a),sv(b));CHECK(ref.present());
+    CHECK(TemporalHeap::fragmented(ref.get()));
+    auto view=t.heap_.getRange(ref.get(),scratch);CHECK(view.present());
+    CHECK(view.get().begin==sv(a) && view.get().end==sv(b));
+    auto old=ref.get();t.validationMinRV_=1;t.heap_.reclaimOldest();
+    CHECK(!t.heap_.getRange(old,scratch).present());
+    constexpr unsigned N=160;
+    std::vector<std::string> keys;for(unsigned i=0;i<=N;++i)keys.push_back(key(i,10240));
+    std::vector<Version> model(N,0);std::mt19937 rng(822);
+    for(Version cv=2;cv<550;++cv) {
+        unsigned x=rng()%(N-8),y=x+1+rng()%8;bool point=(rng()%2)==0;
+        if(point)t.addPoint(cv,sv(keys[x]));else t.addRange(cv,sv(keys[x]),sv(keys[y]));
+        for(unsigned k=x;k<(point?x+1:y);++k)model[k]=cv;
+        std::array<Tree::Query,16> queries;std::array<bool,16> expected;
+        for(unsigned j=0;j<queries.size();++j){unsigned lo=rng()%(N-8),hi=lo+1+rng()%8;
+            Version rv=std::max(t.validationMinRV(),cv-Version(rng()%30));
+            queries[j]={rv,sv(keys[lo]),sv(keys[hi])};expected[j]=false;
+            for(unsigned k=lo;k<hi;++k)expected[j]|=model[k]>rv;}
+        for(unsigned group:{2u,3u}){t.configureReader(group);t.hasConflicts(queries.data(),queries.size());
+            for(unsigned j=0;j<queries.size();++j)CHECK(queries[j].conflict==expected[j]);}
+        Tree::ReadPipelineConfig cfg;cfg.breadthBoundaryLevels=Tree::MaxHeight;
+        t.hasConflicts(queries.data(),queries.size(),cfg);
+        for(unsigned j=0;j<queries.size();++j)CHECK(queries[j].conflict==expected[j]);
+        if(cv%30==0)accounting(t);
+    }
+    CHECK(t.stats().heapPagesReclaimed>0);
+    accounting(t);
+}
+
+void fragmentBoundaries() {
+    Tree t(8,0,config());std::string stored(10240,'m');
+    auto rec=t.heap_.appendPointWithSuccessor(1,sv(stored));CHECK(rec.present());
+    HeapRef ref=rec.get();ref.offset+=sizeof(PointConflictHeader);ref.length=stored.size();
+    TemporalHeap::FragmentCursor cursor;
+    std::vector<size_t> edges{0,stored.size()-1};
+    for(size_t pos=0;pos<stored.size();){const auto part=t.heap_.fragment(ref,pos,cursor);
+        CHECK(part.size()>0 && std::memcmp(part.begin(),stored.data()+pos,part.size())==0);
+        edges.push_back(pos);if(pos)edges.push_back(pos-1);pos+=part.size();}
+    std::vector<std::string> variants;
+    for(size_t pos:edges){auto part=t.heap_.fragment(ref,pos,cursor);CHECK(*part.begin()=='m');
+        auto lo=stored,hi=stored;lo[pos]='l';hi[pos]='n';
+        CHECK(t.heap_.compareKey(ref,sv(lo))>0);CHECK(t.heap_.compareKey(ref,sv(hi))<0);
+        CHECK(t.heap_.compareKey(ref,sv(lo),pos)>0);CHECK(t.heap_.compareKey(ref,sv(hi),pos)<0);
+        variants.push_back(std::move(lo));variants.push_back(std::move(hi));}
+    t.addPoint(2,sv(stored));auto end=stored+'\0';
+    std::vector<Tree::Query> queries;std::vector<bool> expected;
+    std::vector<std::string> ends;for(const auto& v:variants)ends.push_back(v+'\0');
+    for(size_t i=0;i<variants.size();++i){auto& v=variants[i];
+        queries.push_back({1,sv(v),v<stored?sv(end):sv(ends[i])});expected.push_back(v<stored);}
+    for(unsigned depth:{0u,unsigned(Tree::MaxHeight)})for(unsigned group:{2u,3u}){
+        Tree::ReadPipelineConfig cfg;cfg.breadthBoundaryLevels=depth;cfg.sweepGroupSize=group;
+        t.hasConflicts(queries.data(),queries.size(),cfg);
+        for(size_t i=0;i<queries.size();++i)CHECK(queries[i].conflict==expected[i]);}
+    auto prefix=stored.substr(0,5000);CHECK(t.heap_.compareKey(ref,sv(prefix))>0);
+    CHECK(t.heap_.compareKey(ref,sv(end))<0);CHECK(t.heap_.compareKey(ref,sv(stored))==0);
+}
+
+void fragmentedAllocationFailure() {
+    Tree t(1,0,config());
+    auto k=key(1,t.maximumHeapRecordBytes()-sizeof(PointConflictHeader)-1);
+    bool failed=false;
+    try { t.heap_.appendPointWithSuccessor(1,sv(k)); }
+    catch(const std::bad_alloc&) { failed=true; }
+    CHECK(failed);CHECK(!t.heap_.oldestPageNewestCV().present());
+    CHECK(t.keyBlockCount()==0);accounting(t);
+    auto small=key(1);t.addPoint(2,sv(small));accounting(t);
+}
+
+void keyProfileOrder() {
+    by5::Config c;c.keyProfile=1;std::mt19937 rng(9);
+    std::array<bool,129> lengths{};
+    for(unsigned i=0;i<100000;++i) {
+        uint32_t a=rng(),b=rng();auto ka=by5::key(c,a),kb=by5::key(c,b);
+        CHECK((ka<kb)==(a<b));lengths[ka.size()]=true;
+    }
+    for(unsigned n:{16u,24u,32u,48u,64u,100u,128u})CHECK(lengths[n]);
+}
+void inlineParity() {
+    if constexpr (Tree::InlineOnlyKeys && Tree::InlineKeyBytes>=4) {
+        Tree shared(3,0,config());
+        for(unsigned i=1;i<=15000;++i) {
+            auto k=key(i,4);shared.addPoint(i,sv(k));
+            CHECK(shared.keyBlockCount()==0);
+        }
+        CHECK(shared.keyBlockCount()==0 && shared.peakKeyBlockCount()==0);accounting(shared);
+    }
+}
+void phaseChange() {
+    Tree t(8,0,config());
+    for(unsigned i=1;i<=20000;++i){auto k=key(i,96);t.addPoint(i,sv(k));}
+    CHECK(t.peakKeyBlockCount()>0);const auto before=t.keyBlockCount();
+    for(unsigned i=20001;i<=60000;++i){auto k=key(i,4);t.addPoint(i,sv(k));}
+    if(Tree::InlineOnlyKeys && Tree::InlineKeyBytes>=4) CHECK(t.keyBlockCount()<before);
+    accounting(t);
+}
+int main() {
+    const std::vector<std::pair<const char*,std::function<void()>>> cases={
+        {"fragmentBoundaries",fragmentBoundaries},{"fragmentedAllocationFailure",fragmentedAllocationFailure},{"largeKeys",largeKeys},{"sameBlockReuse",sameBlockReuse},{"rejectBeforeMutation",rejectBeforeMutation},
+        {"boundaryAndCV",boundaryAndCV},{"randomModel",[]{randomModel(false);}},
+        {"randomFictitiousModel",[]{randomModel(true);}},{"mixed16to128",[]{randomModel(true,true);}},{"keyProfileOrder",keyProfileOrder},{"phaseChange",phaseChange},{"inlineParity",inlineParity}};
+    unsigned ok=0;for(auto& [name,f]:cases){try{f();++ok;printf("%s PASS\n",name);}catch(const std::exception& e){printf("%s FAIL %s\n",name,e.what());}}
+    Tree sample(2,0,config());printf("%u/%zu PASS nodeBytes=%zu maxRecordBytes=%zu\n",ok,cases.size(),Tree::layout().nodeBytes,sample.maximumHeapRecordBytes());return ok==cases.size()?0:1;
+}
diff --git a/fdbserver/resolver/btree/tests/WriteTwoPassEquivalence.cpp b/fdbserver/resolver/btree/tests/WriteTwoPassEquivalence.cpp
