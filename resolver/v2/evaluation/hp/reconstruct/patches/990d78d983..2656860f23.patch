+void recursionCoversEverySpanInTurn() {
+	begin("recursionCoversEverySpanInTurn");
+	onFreshThread([] {
+		LevelMirror mirror;
+		// Level 1 holds T1 (b), T2 (e) and T3 (g). T1's span is explored without a conflict:
+		// A1 is new but ends before the read, A2 reaches into it but is old. T2's span
+		// is old throughout and can be discarded. T3's span holds C1, which conflicts, and
+		// is the last span of the level
+		auto build = [&](TemporalConflictSet& set, bool withConflict) {
+			writeRange(set, mirror, 2, 1, "b", "c");
+			writeRange(set, mirror, 2, 2, "e", "f");
+			writeRange(set, mirror, 2, 3, "g", "h");
+			writeRange(set, mirror, 1, 4, "d", "m");
+			writeRange(set, mirror, 1, 5, "f", "p");
+			writeRange(set, mirror, 1, 200, "c", "d");
+			if (withConflict) {
+				writeRange(set, mirror, 1, 201, "h", "l");
+			}
+		};
+		TemporalConflictSet set(8, 0);
+		build(set, true);
+		check(levelVersions(set.ranges_, 1) == (std::vector<Version>{ 1, 2, 3 }) && set.ranges_.levels_[2].empty(),
+		      "level 1 holds the three towers and nothing is above it");
+		check(levelVersions(set.ranges_, 0) == (std::vector<Version>{ 1, 200, 4, 2, 5, 3, 201 }),
+		      "and level 0 holds every write in key order");
+		SkipEntry* t1 = set.ranges_.levels_[1].first_;
+		if (!check(t1 != nullptr && t1->next != nullptr, "the towers were built as steered")) {
+			return;
+		}
+		check(t1->summary.maxCV.present() && t1->summary.maxCV.get() > 100, "T1's span cannot be discarded by version");
+		check(t1->next->summary.maxCV.present() && t1->next->summary.maxCV.get() <= 100,
+		      "T2's span can be");
+		check(rangeConflict(set, 100, "k", "z"), "the search returns from T1's span, passes T2's, and finds C1 in the last");
+		check(!rangeConflict(set, 100, "x", "z"), "a read past every write reaches the end of the list without one");
+
+		TemporalConflictSet none(8, 0);
+		build(none, false);
+		check(!rangeConflict(none, 100, "k", "z"), "without C1, exploring every span finds nothing");
+
+		// A write with the same begin as T2, inserted before it, precedes T2 and so lies
+		// in T1's span, which ends at T2's copy below
+		TemporalConflictSet before(8, 0);
+		writeRange(before, mirror, 2, 1, "b", "c");
+		writeRange(before, mirror, 1, 200, "e", "m");
+		writeRange(before, mirror, 2, 201, "e", "f");
+		check(levelVersions(before.ranges_, 1) == (std::vector<Version>{ 1, 201 }) &&
+		          levelVersions(before.ranges_, 0) == (std::vector<Version>{ 1, 200, 201 }),
+		      "the write equal to T2's key precedes T2");
+		check(rangeConflict(before, 100, "k", "z"), "it is found in T1's span, just before the stop");
+
+		// The same key inserted after T2 lies in T2's span
+		TemporalConflictSet after(8, 0);
+		writeRange(after, mirror, 2, 1, "b", "c");
+		writeRange(after, mirror, 2, 2, "e", "f");
+		writeRange(after, mirror, 1, 200, "e", "m");
+		check(levelVersions(after.ranges_, 0) == (std::vector<Version>{ 1, 2, 200 }), "the equal key follows T2");
+		check(rangeConflict(after, 100, "k", "z"), "it is found in T2's span, just after the stop");
+
+		TemporalConflictSet old(8, 0);
+		writeRange(old, mirror, 2, 1, "b", "c");
+		writeRange(old, mirror, 1, 50, "e", "m");
+		writeRange(old, mirror, 2, 51, "e", "f");
+		check(!rangeConflict(old, 100, "k", "z"), "an old write at the stop does not conflict");
+	});
+	end();
+}
