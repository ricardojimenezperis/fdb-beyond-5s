+void writeHintRejectsMovedMinimum() {
+    Tree tree(64, 0);
+    for (unsigned i = 0; i < 300; ++i)
+        tree.addRange(1, sv(key(4 * i)), sv(key(4 * i + 2)));
+    Tree::Node* leaf = tree.firstLeaf_->navigation.leaf.next;
+    const Tree::LeafHint hint{leaf, leaf->incarnation};
+    const std::string begin = entryBytes(tree, leaf->at(0));
