@@ -0,0 +1,19 @@
+#!/bin/bash
+set -u
+HERE=$(cd "$(dirname "$0")" && pwd); OUT=${1:?output directory}
+[ -e "$OUT" ] && { echo "exists: $OUT"; exit 1; }
+mkdir -p "$OUT"
+for t in generate verify tests; do c++ -std=c++17 -Wall -Wextra -Werror -O2 -o "$OUT/by5mono-$t" "$HERE/$t.cpp" || exit 1; done
+BY5MONO_LEGACY_TRACE=${BY5MONO_LEGACY_TRACE:-} "$OUT/by5mono-tests" "$OUT" || exit 1
+fail=0
+"$OUT/by5mono-verify" "$OUT/good.trace" > "$OUT/good.txt"; r=$?; echo "good.trace exit=$r $(tail -1 "$OUT/good.txt")"; [ $r = 0 ] || fail=1
+for m in duplicate-write future-read flipped-expectation late-empty-read; do
+ "$OUT/by5mono-verify" "$OUT/$m.trace" > "$OUT/$m.txt" 2>&1; r=$?; echo "$m.trace exit=$r $(tail -1 "$OUT/$m.txt")"; [ $r != 0 ] || fail=1
+done
+for p in 1 16; do
+ "$OUT/by5mono-generate" --prefixes $p --seconds 120 --measure 60 --seed 1 --out "$OUT/p$p-a.trace" > "$OUT/p$p-a.gen.txt" 2>/dev/null || fail=1
+ "$OUT/by5mono-generate" --prefixes $p --seconds 120 --measure 60 --seed 1 --out "$OUT/p$p-b.trace" > /dev/null 2>&1 || fail=1
+ cmp -s "$OUT/p$p-a.trace" "$OUT/p$p-b.trace" && echo "p$p determinism identical" || { echo "p$p determinism DIFFERENT"; fail=1; }
+ "$OUT/by5mono-verify" "$OUT/p$p-a.trace" > "$OUT/p$p-a.verify.txt"; r=$?; echo "p$p verify exit=$r $(tail -1 "$OUT/p$p-a.verify.txt")"; [ $r = 0 ] || fail=1
+done
+echo "run-tests $([ $fail = 0 ] && echo PASS || echo FAIL)"; exit $fail
diff --git a/fdbserver/resolver/by5mono/tests.cpp b/fdbserver/resolver/by5mono/tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..31bd71d207814c37b4e42cda980496dc4f96982a
--- /dev/null
+++ b/fdbserver/resolver/by5mono/tests.cpp
@@ -0,0 +1,107 @@
+#include "../By5Monotonic.h"
+#include <cstring>
+#include <iostream>
+#include <map>
+#include <sstream>
+#define CHECK(c) do { if (!(c)) throw std::runtime_error(std::string(#c) + " line " + std::to_string(__LINE__)); } while (false)
+static std::string serialize(const by5::Config& c,uint64_t batches){
+ std::ostringstream o;by5::writeHeader(o,c);by5::MonotonicGenerator g(c);
+ for(uint64_t b=0;b<batches;++b)for(const auto&t:g.batch(b))by5::writeTransaction(o,t);
+ return o.str();
+}
+static void keyOrder(){
+ for(uint32_t prefixes:{1u,16u}){
+  auto c=by5::monotonicConfig(prefixes,60,30,1);by5::Random r{7};
+  for(int i=0;i<200000;++i){
+   uint32_t pa=uint32_t(r.below(prefixes)),pb=uint32_t(r.below(prefixes));
+   uint32_t a=c.prefixBase(pa)+uint32_t(r.below(by5::prefixLimit(c,pa))),b=c.prefixBase(pb)+uint32_t(r.below(by5::prefixLimit(c,pb)));
+   auto ka=by5::key(c,a),kb=by5::key(c,b);CHECK((ka<kb)==(a<b));CHECK(ka.size()>=16 && ka.size()<=64);CHECK(by5::prefixOf(c,a)==pa);
+  }
+ }
+}
+static void legacyHeader(){
+ by5::Config c;c.longPpm=0;c.domain=2000000000;c.warmupSeconds=1500;c.measureSeconds=300;
+ std::ostringstream o;by5::writeHeader(o,c);const std::string h=o.str();CHECK(h.substr(0,8)=="BY5RNG02");CHECK(h.size()==104+8*c.longAgesUs.size());
+ std::istringstream i(h);auto d=by5::readHeader(i);CHECK(d.pattern==0 && d.prefixes==1 && d.domain==c.domain);
+ std::ostringstream o2;by5::writeHeader(o2,d);CHECK(o2.str()==h);
+ const char* p=std::getenv("BY5MONO_LEGACY_TRACE");
+ if(p && *p){std::ifstream f(p,std::ios::binary);auto lc=by5::readHeader(f);const auto len=f.tellg();CHECK(lc.pattern==0);
+  std::ifstream g(p,std::ios::binary);std::string orig(size_t(len),'\0');g.read(&orig[0],len);std::ostringstream o3;by5::writeHeader(o3,lc);CHECK(o3.str()==orig);}
+}
+static void monotonicHeader(){
+ auto c=by5::monotonicConfig(16,120,60,3);std::ostringstream o;by5::writeHeader(o,c);CHECK(o.str().substr(0,8)=="BY5RNG03");
+ std::istringstream i(o.str());auto d=by5::readHeader(i);CHECK(d.pattern==1 && d.prefixes==16 && d.seed==3 && d.domain==c.domain);
+}
+static void determinism(){
+ for(uint32_t prefixes:{1u,16u}){
+  auto c=by5::monotonicConfig(prefixes,60,30,1),d=by5::monotonicConfig(prefixes,60,30,2);
+  const auto a=serialize(c,64),b=serialize(c,64),e=serialize(d,64);CHECK(a==b);CHECK(a!=e);
+ }
+}
+static void generatorProperties(){
+ for(uint32_t prefixes:{1u,16u}){
+  auto c=by5::monotonicConfig(prefixes,60,30,1);by5::MonotonicGenerator g(c);std::vector<uint64_t> next(prefixes,0);
+  uint64_t empty=0,reads=0;
+  for(uint64_t b=0;b<256;++b){
+   const std::vector<uint64_t> available=next;
+   for(const auto&t:g.batch(b)){
+    const uint32_t p=by5::prefixOf(c,t.write.begin);CHECK(t.write.end==t.write.begin+1);CHECK(t.write.begin==c.prefixBase(p)+next[p]);++next[p];
+    if(!by5::hasRead(t.read)){++empty;CHECK(!t.expectedConflict);continue;}
+    ++reads;const uint32_t rp=by5::prefixOf(c,t.read.begin);CHECK(t.read.begin<t.read.end && t.read.end-t.read.begin<=c.span);
+    CHECK(uint64_t(t.read.end)<=uint64_t(c.prefixBase(rp))+available[rp]);
+   }
+  }
+  CHECK(empty>=c.batchSize && reads>0);
+ }
+}
+struct Planned{by5::Range read;uint32_t write;bool expect;};
+static void writeNeighbours(const std::string& path){
+ by5::Config c=by5::monotonicConfig(1,4,2,1);c.rate=64;c.batchSize=2;c.validate();
+ uint32_t m=13;CHECK(by5::key(c,m).size()==64 && by5::key(c,m-1).size()==56 && by5::key(c,m+1).size()==16);
+ std::map<uint64_t,std::vector<Planned>> plan;
+ plan[0]={{{0,0},m-1,false},{{0,0},m+1,false}};
+ plan[60]={{{0,0},m,false},{{0,0},1000,false}};
+ plan[61]={{{m,m+1},2000,true},{{m-1,m},1001,false}};
+ plan[62]={{{m+1,m+2},1002,false},{{m-2,m},1003,false}};
+ plan[63]={{{m,m+2},1004,true},{{m+1,m+3},1005,false}};
+ plan[64]={{{2000,2001},1006,false},{{m-1,m+1},1007,true}};
+ plan[65]={{{0,0},3000,false},{{3000,3001},1008,true}};
+ std::ofstream out(path,std::ios::binary);by5::writeHeader(out,c);by5::History oracle;uint32_t filler=5000;
+ for(uint64_t b=0;b<c.totalBatches();++b){
+  const by5::Version now=by5::commitVersion(c,b),rv=std::max<by5::Version>(0,now-by5::Version(c.shortAgeUs));
+  std::vector<Planned> txns=plan.count(b)?plan[b]:std::vector<Planned>{{{0,0},filler++,false},{{0,0},filler++,false}};
+  for(const auto&t:txns){
+   const bool conflict=by5::readConflicts(oracle,t.read,rv);CHECK(conflict==t.expect);
+   if(!conflict)oracle.write({t.write,t.write+1},now);
+   by5::writeTransaction(out,{t.read,{t.write,t.write+1},rv,0,conflict});
+  }
+ }
+ CHECK(bool(out));
+}
+static void writeMutant(const std::string& path,const std::string& good,size_t txn,unsigned field,uint32_t value){
+ std::string m=good;const auto c=by5::monotonicConfig(1,60,30,1);std::ostringstream h;by5::writeHeader(h,c);
+ const size_t at=h.str().size()+txn*32+field*4;for(unsigned i=0;i<4;++i)m[at+i]=char(value>>(8*i));
+ std::ofstream f(path,std::ios::binary);f<<m;CHECK(bool(f));
+}
+int main(int argc,char** argv){
+ const std::vector<std::pair<const char*,void(*)()>> cases={{"keyOrder",keyOrder},{"legacyHeader",legacyHeader},{"monotonicHeader",monotonicHeader},{"determinism",determinism},{"generatorProperties",generatorProperties}};
+ unsigned ok=0;
+ for(auto&[n,f]:cases){try{f();std::printf("%s: OK\n",n);++ok;}catch(const std::exception&e){std::printf("%s: FAIL %s\n",n,e.what());}}
+ if(argc==2){
+  const std::string dir=argv[1];const auto c=by5::monotonicConfig(1,60,30,1);const auto good=serialize(c,c.totalBatches());
+  {std::ofstream f(dir+"/good.trace",std::ios::binary);f<<good;}
+  const size_t late=c.batchSize*200+5;
+  uint32_t w;std::memcpy(&w,good.data()+good.size()-32+8,4);
+  writeMutant(dir+"/duplicate-write.trace",good,late,2,w);
+  writeMutant(dir+"/future-read.trace",good,late,1,0xFFFFFF00u);
+  {std::string e=good;std::ostringstream h;by5::writeHeader(h,c);const size_t at=h.str().size()+late*32;
+   for(unsigned i=0;i<8;++i)e[at+i]=0;
+   for(unsigned i=0;i<4;++i)e[at+28+i]=0;
+   std::ofstream f(dir+"/late-empty-read.trace",std::ios::binary);f<<e;CHECK(bool(f));}
+  std::string flip=good;{std::ostringstream h;by5::writeHeader(h,c);flip[h.str().size()+late*32+28]^=1;}
+  {std::ofstream f(dir+"/flipped-expectation.trace",std::ios::binary);f<<flip;}
+  writeNeighbours(dir+"/neighbours.trace");
+  std::printf("mutants and neighbours trace written to %s\n",dir.c_str());
+ }
+ std::printf("%u/%zu OK\n",ok,cases.size());return ok==cases.size()?0:1;
+}
diff --git a/fdbserver/resolver/by5mono/verify.cpp b/fdbserver/resolver/by5mono/verify.cpp
