+// Fresh head, expired entries behind it: cleanup must not be blocked by the head.
+void bitmapCleanupBehindLiveHead() {
+    Tree tree(64, 0);
+    tree.addPoint(1, sv(key(0)));
+    tree.addPoint(1, sv(key(4)));
+    tree.addPoint(1, sv(key(8)));
+    auto* leaf = tree.root_;
+    CHECK(leaf->leaf && leaf->size() == 3);
+    const unsigned survivor = leaf->order.slotAt(0);
+    leaf->slots[survivor].cv = 3;
+    tree.refreshUp(leaf);
+    tree.validationMinRV_ = 1;
+    const bool changed = tree.purgeInsertionHead(leaf);
+    if constexpr (PAGED_BTREE_BITMAP_CLEANUP != 0) {
+        CHECK(changed);
+        CHECK(leaf->size() == 1);
+        CHECK(leaf->occupied == (1U << survivor));
+        CHECK(!tree.purgeInsertionHead(leaf));
+    } else {
+        CHECK(!changed);
+        CHECK(leaf->size() == 3);
+    }
+    verify(tree);
+}
