+// Bisected cuts at the top two levels must match linear cuts and scalar decisions.
+// Bound their probes logarithmically in the endpoint span.
+static unsigned ceilLog2(size_t n) { unsigned b = 0; while ((size_t(1) << b) < n) ++b; return b; }
+void sortedSearchBoundariesShapes() {
+    for (unsigned count : {12u, 120u, 900u, 4000u, 20000u}) {
+        Tree tree(2048, 0);
+        const std::string prefix(12, '\x81');
+        auto k = [&](unsigned n) { return prefix + key(n); };
+        for (unsigned i = 0; i < count; ++i) {
+            const Version cv = 1 + Version(7) * i / count; // non-decreasing, 1 to 7 across the key space
+            if (i % 3) tree.addPoint(cv, sv(k(4 * i)));
+            else tree.addRange(cv, sv(k(4 * i)), sv(k(4 * i + 2)));
+        }
+        const unsigned height = tree.height();
+        std::vector<std::string> storage; storage.reserve(200000);
+        std::vector<Tree::Query> queries;
+        auto add = [&](Version rv, std::string begin, std::string end) {
+            storage.push_back(std::move(begin)); storage.push_back(std::move(end));
+            queries.push_back({rv, sv(storage[storage.size() - 2]), sv(storage.back()), false});
+        };
+        // Separators of the top two levels, as keys: equality, just after, and ranges ending exactly there
+        std::vector<std::string> separators;
+        std::function<void(Tree::Node*, unsigned)> collect = [&](Tree::Node* node, unsigned depth) {
+            if (node->leaf || depth > 2) return;
+            for (unsigned r = 0; r < node->size(); ++r) {
+                separators.push_back(entryBytes(tree, tree.plainSeparator(node, node->at(r))));
+                collect(node->at(r).payload.link.child, depth + 1);
+            }
+        };
+        collect(tree.root_, 1);
+        for (const auto& s : separators) {
+            add(0, s, s + '\0');                 // a point at the separator
+            add(0, s + '\0', s + '\0' + '\0');   // just past it
+            add(3, k(0), s);                     // a range ending exactly at it: belongs only to the left
+            add(3, s, s + '\x01');               // a range starting exactly at it
+        }
+        // Repeated endpoints: the same query several times, and many queries sharing one begin
+        for (unsigned r = 0; r < 6; ++r) add(2, k(400), k(800));
+        for (unsigned r = 0; r < 6; ++r) add(4, k(1200), k(1200 + 40 * (r + 1)));
+        // Open ranges across many children, old enough to stay open, and new enough to conflict early (resolved)
+        add(0, k(0), k(4 * count));
+        add(100, k(0), k(4 * count));
+        add(6, k(8), k(4 * count - 8));
+        // Empty and reversed ranges, and ranges outside the stored keys
+        add(0, k(16), k(16)); add(0, k(20), k(16));
+        add(0, "", k(0)); add(0, k(4 * count + 4), k(4 * count + 400));
+        std::mt19937 rng(count);
+        for (unsigned i = 0; i < 2000; ++i) {
+            const unsigned b = rng() % (4 * count + 8);
+            add(rng() % 9, k(b), k(b + rng() % (i % 5 ? 12 : 4 * count)));
+        }
+        std::shuffle(queries.begin(), queries.end(), rng);
+        checkSortedQueries(tree, queries);
+        if constexpr (Tree::Stats::searchEnabled) {
+            const auto& r = tree.readPipelineStats();
+            const size_t endpoints = r.sortedEndpointCount;
+            // Each boundary of a prepared node at depth 1 or 2 costs at most ceil(log2(span + 1)) probes
+            size_t boundaries1 = tree.root_->leaf ? 0 : tree.root_->size(), boundaries2 = 0;
+            if (!tree.root_->leaf)
+                for (unsigned c = 0; c < tree.root_->size(); ++c) {
+                    auto* child = tree.root_->at(c).payload.link.child;
+                    if (!child->leaf) boundaries2 += child->size();
+                }
+            const size_t bound = (ceilLog2(endpoints + 1) + 1);
+            CHECK(r.sortedInternalComparisonsByDepth[0] <= boundaries1 * bound);
+            CHECK(r.sortedInternalComparisonsByDepth[1] <= boundaries2 * bound);
+            std::printf("[count=%u height=%u endpoints=%zu depth1=%llu depth2=%llu] ", count, height, endpoints,
+                        (unsigned long long)r.sortedInternalComparisonsByDepth[0], (unsigned long long)r.sortedInternalComparisonsByDepth[1]);
+        }
+        verify(tree);
+    }
+}
