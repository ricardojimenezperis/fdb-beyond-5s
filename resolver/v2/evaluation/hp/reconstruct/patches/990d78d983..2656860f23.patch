+void inlineOnlyMixedEndpoints() {
+    if constexpr (!Tree::InlineOnlyKeys) return;
+    for (bool shortBegin : {true, false}) {
+        if (!shortBegin && !Tree::InlineKeyBytes) continue;
+        Tree tree(8, 0);
+        const std::string begin(Tree::InlineKeyBytes + (shortBegin ? 0 : 7), 'a');
+        const std::string end(Tree::InlineKeyBytes + (shortBegin ? 7 : 0), 'z');
+        tree.addRange(1, sv(begin), sv(end));
+        const auto& entry = tree.root_->at(0);
+        CHECK(Tree::isInlineOnly(entry.begin) == shortBegin);
+        CHECK(Tree::isInlineOnly(entry.end) != shortBegin);
+        CHECK(!Tree::endSharesStorage(entry));
+        CHECK(entryBytes(tree, entry) == begin && entryBytes(tree, entry, true) == end);
+        const HeapRef ref = shortBegin ? entry.end : entry.begin;
+        const std::string& longKey = shortBegin ? end : begin;
+        const HeapRef record{ref.pageID, ref.offset - uint32_t(sizeof(PointConflictHeader)),
+                             uint32_t(sizeof(PointConflictHeader) + longKey.size())};
+        const auto stored = tree.heap_.getPoint(record);
+        CHECK(stored.present() && stored.get().cv == 1 && bytes(stored.get().key) == longKey);
+        CHECK(tree.keyBlockCount() == 1 && tree.budget().heapPages == 0);
+        CHECK(tree.hasConflict(0, sv(begin), sv(end)));
+        verify(tree);
+    }
+}
