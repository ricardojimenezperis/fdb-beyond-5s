+// Long shared prefixes force heap resolution. Shuffled ranges expose rank/slot confusion;
+// a tall tree reuses active slots. Check hints before correction can hide routing errors,
+// then compare grouped writes against scalar insertion.
+void groupedSearchReusesSeparatorKeys() {
+    auto tail = [](unsigned number) {
+        constexpr size_t length = std::max<size_t>(48, Tree::InlineKeyBytes + 16);
+        std::string result(length, 'p');
+        for (int i = 3; i >= 0; --i) { result[length - 4 + i] = static_cast<char>(number & 255); number >>= 8; }
+        return result;
+    };
+    Tree grouped(256, 0), scalar(256, 0);
+    std::vector<unsigned> order(1500);
+    for (unsigned i = 0; i < order.size(); ++i) order[i] = i;
+    std::shuffle(order.begin(), order.end(), std::mt19937(2026));
+    for (unsigned i : order) {
+        grouped.addRange(1, sv(tail(8 * i)), sv(tail(8 * i + 6)));
+        scalar.addRange(1, sv(tail(8 * i)), sv(tail(8 * i + 6)));
+    }
+    CHECK(grouped.height() > 2);
+    bool permuted = false;
+    auto walk = [&](auto&& self, Tree::Node* node) -> void {
+        if (node->leaf) return;
+        for (unsigned rank = 0; rank < node->size(); ++rank) {
+            permuted = permuted || node->order.slotAt(rank) != rank;
+            self(self, node->at(rank).payload.link.child);
+        }
+    };
+    walk(walk, grouped.root_);
+    CHECK(permuted);
+    std::vector<std::string> keys;
+    keys.reserve(3000);
+    std::vector<Tree::Write> writes;
+    for (unsigned i = 0; i < 1500; ++i) {
+        keys.push_back(tail(8 * i + 1 + i % 5));
+        keys.push_back(tail(8 * i + 7));
+        writes.push_back({sv(keys[2 * i]), sv(keys[2 * i + 1]), ConflictKind::Range});
+    }
+    const auto before = grouped.stats();
+    grouped.writeHints_.resize(writes.size());
+    grouped.findWriteLeaves(writes.data(), 0, writes.size());
+    if constexpr (Tree::Stats::searchEnabled) {
+        // Every tie needs the key, but a separator's is resolved at most once per node visit
+        const auto ties = grouped.stats().keyComparisonFallbacks - before.keyComparisonFallbacks;
+        const auto loads = grouped.stats().heapKeyLoads - before.heapKeyLoads;
+        CHECK(ties > 0 && loads < ties);
+    }
+    for (size_t i = 0; i < writes.size(); ++i) CHECK(grouped.writeHints_[i].node == grouped.findLeaf(writes[i].begin));
+    grouped.addWrites(2, writes.data(), writes.size());
+    for (const auto& write : writes) scalar.addRange(2, write.begin, write.end);
+    CHECK(contents(grouped) == contents(scalar));
+    verify(grouped);
+    verify(scalar);
+}
