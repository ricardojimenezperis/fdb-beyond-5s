+// A saturated incarnation proves nothing by itself: the guard also requires the anchor to be attached. A saturated
+// anchor still in its place is removed; an empty, allocated, saturated node outside the tree (a reservation) is not.
+void emptiedAnchorSaturatedIncarnation() {
+    {
+        Tree tree(64, 0);
+        std::vector<std::string> keys;
+        const auto leaves = criticalRootOfPoints(tree, keys, 0);
+        tree.validationMinRV_ = 1;
+        Tree::Node* anchor = leaves[2];
+        anchor->incarnation = Tree::SaturatedIncarnation;
+        const auto removed = tree.stats().emptiedAnchorsRemoved;
+        tree.addPoint(2, sv(keys[2]));
+        CHECK(!anchor->allocated && tree.stats().emptiedAnchorsRemoved == removed + 1 && emptyLeaves(tree) == 0);
+        checkPointsAgainstModel(tree, keys, 0);
+        verify(tree);
+    }
+    {
+        Tree tree(64, 0);
+        std::vector<std::string> keys;
+        criticalRootOfPoints(tree, keys, -1);
+        Tree::Reservation reservation;
+        tree.reserve(reservation, 1);
+        Tree::Node* outside = reservation.nodes[0];
+        outside->leaf = true;
+        outside->incarnation = Tree::SaturatedIncarnation;
+        CHECK(outside->allocated && !outside->size() && !tree.attachedLeaf(outside));
+        const auto removed = tree.stats().emptiedAnchorsRemoved;
+        tree.closeEmptiedAnchor(outside, Tree::SaturatedIncarnation);
+        CHECK(outside->allocated && tree.stats().emptiedAnchorsRemoved == removed);
+        const uint32_t live = 7;
+        outside->incarnation = live;
+        tree.closeEmptiedAnchor(outside, live + 1);
+        CHECK(outside->allocated && tree.stats().emptiedAnchorsRemoved == removed);
+        tree.releaseReservation(reservation);
+        checkPointsAgainstModel(tree, keys, -1);
+        verify(tree);
+    }
+}
