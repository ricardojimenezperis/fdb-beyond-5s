+void anExhaustedPoolStopsTheHeap() {
+	begin("anExhaustedPoolStopsTheHeap");
+	PagePool pool(1);
+	TemporalHeap heap(pool);
+
+	check(fillOnePage(heap, 1, 1000, 1) == -1,
+		  "the append that needed a second page returned absent");
+	check(pool.budget().heapPages == 1, "the heap still holds its one page");
+	check(pool.budget().freePages == 0, "and the pool has nothing left");
+	checkBudget(pool, "budget invariant at exhaustion");
+
+	// The refusal is not terminal: reclaiming frees capacity again.
+	check(heap.reclaimOldest().present(), "the page can be reclaimed");
+	const std::string key(1000, 'h');
+	check(heap.appendPoint(2, asRef(key)).present(), "and the heap accepts records again");
+	checkBudget(pool, "budget invariant after the retry");
+	end();
+}
+
+void reclaimingReturnsTheOldestPageAndItsVersion() {
+	begin("reclaimingReturnsTheOldestPageAndItsVersion");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+
+	// Two pages with known versions: the first ends at cv 1, the second at cv 2.
+	check(fillOnePage(heap, 1, 1000, 1) > 0, "the first page was filled");
+	const std::string key(10, 'z');
+	const HeapRef onSecond = appended(heap.appendPoint(2, asRef(key)),
+									  "a record lands on the second page");
+	check(onSecond.pageID == 2, "the second page is in use");
+
+	const uint64_t freeBefore = pool.budget().freePages;
+	const Version discarded = versionOf(heap.reclaimOldest(), "a page was reclaimed");
+
+	check(discarded == 1, "it reports the newest version it held");
+	check(heap.lastReclaimedPageID() == 1, "the oldest page ID is recorded");
+	check(versionOf(heap.reclaimedThroughCV(), "the discarded version is exposed") == 1,
+		  "and it is the version just discarded");
+	check(pool.budget().freePages == freeBefore + 1, "the page went back to the pool");
+	check(pool.budget().heapPages == 1, "one page remains in the heap");
+	checkBudget(pool, "budget invariant after a reclamation");
+	end();
+}
+
+void reclaimedRecordsBecomeObsoleteAndUnreadable() {
+	begin("reclaimedRecordsBecomeObsoleteAndUnreadable");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+
+	const std::string first(1000, 'o'), second(10, 'p');
+	const HeapRef onFirst = appended(heap.appendPoint(1, asRef(first)),
+									 "a record on the first page");
+	fillOnePage(heap, 1, 1000, 1);
+	const HeapRef onSecond = appended(heap.appendPoint(2, asRef(second)),
+									  "a record on the second page");
+	check(onSecond.pageID == 2, "the second page is in use");
+
+	check(!heap.obsolete(onFirst), "neither is obsolete yet");
+	check(heap.getPoint(onFirst).present(), "and both are readable");
+
+	heap.reclaimOldest();
+
+	check(heap.obsolete(onFirst), "the reclaimed record is obsolete");
+	check(!heap.getPoint(onFirst).present(), "and it cannot be read");
+	check(!heap.obsolete(onSecond), "the surviving record is not obsolete");
+	check(heap.getPoint(onSecond).present(), "and it is still readable");
+	end();
+}
+
+void reclaimedThroughCVNeverGoesBackwards() {
+	begin("reclaimedThroughCVNeverGoesBackwards");
+	PagePool pool(8);
+	TemporalHeap heap(pool);
+
+	// Three pages, each ending at a higher version than the last.
+	for (Version cv = 1; cv <= 3; ++cv) {
+		fillOnePage(heap, cv, 1000, static_cast<PageID>(cv));
+	}
+
+	Optional<Version> previous;
+	int reclaimed = 0;
+	while (true) {
+		Optional<Version> discarded = heap.reclaimOldest();
+		if (!discarded.present()) {
+			break;
+		}
+		++reclaimed;
+		if (previous.present()) {
+			check(discarded.get() >= previous.get(), "each reclamation discards no less");
+		}
+		check(versionOf(heap.reclaimedThroughCV(), "the discarded version stays set") ==
+				  discarded.get(),
+			  "and it equals the newest version discarded so far");
+		previous = discarded;
+	}
+	check(reclaimed >= 3, "every page was reclaimed");
+	check(pool.budget().heapPages == 0, "every page went back to the pool");
+	checkBudget(pool, "budget invariant after reclaiming everything");
+	end();
+}
+
+void pageIDsAreNotReusedAfterReclamation() {
+	begin("pageIDsAreNotReusedAfterReclamation");
+	PagePool pool(2);
+	TemporalHeap heap(pool);
+
+	const std::string a(10, 'a'), b(10, 'b');
+	const HeapRef first = appended(heap.appendPoint(1, asRef(a)), "the first record");
+	check(first.pageID == 1, "the first page is ID 1");
+	heap.reclaimOldest();
+
+	// The physical page comes back from the pool, but its logical ID must not.
+	const HeapRef second = appended(heap.appendPoint(2, asRef(b)), "a new page is acquired");
+	check(second.pageID == 2, "with a fresh ID, not the reclaimed one");
+	check(heap.obsolete(first), "the old reference stays obsolete");
+	check(!heap.getPoint(first).present(), "and unreadable");
+	check(heap.getPoint(second).present(), "while the new one reads");
+	end();
+}
+
+void staleRefsStayObsoleteAfterTheRingWraps() {
+	begin("staleRefsStayObsoleteAfterTheRingWraps");
+	const uint64_t capacity = 2;
+	PagePool pool(capacity);
+	TemporalHeap heap(pool);
+
+	// A reference to page 1, whose physical page and ring slot will later serve
+	// pages 3, 5, 7 ... because id % capacity is equal.
+	const std::string s(64, 's'), f(64, 'f');
+	const HeapRef stale = appended(heap.appendPoint(1, asRef(s)), "the stale record");
+	check(stale.pageID == 1, "the stale reference is on page 1");
+
+	for (PageID expected = 2; expected <= 7; ++expected) {
+		check(heap.reclaimOldest().present(), "the oldest page is reclaimed");
+		const HeapRef fresh = appended(heap.appendPoint(static_cast<Version>(expected), asRef(f)),
+									   "a page is available again");
+		check(fresh.pageID == expected, "IDs keep increasing past the ring size");
+
+		// Every other turn the new page occupies the stale reference's own ring slot
+		// and, with a pool this small, its very bytes at the very same offset.
+		if (expected % capacity == stale.pageID % capacity) {
+			check(fresh.offset == stale.offset,
+				  "the fresh record sits exactly where the stale one did");
+		}
+		check(heap.obsolete(stale), "the stale reference stays obsolete");
+		check(!heap.getPoint(stale).present(), "and it is never readable again");
+		check(pointAt(heap, fresh, "the fresh record is readable").cv ==
+				  static_cast<Version>(expected),
+			  "and reads its own version, not the stale one's");
+		checkBudget(pool, "budget invariant around the ring");
+	}
+	end();
+}
+
+void viewsPointIntoThePageRatherThanACopy() {
+	begin("viewsPointIntoThePageRatherThanACopy");
+	PagePool pool(4);
+	TemporalHeap heap(pool);
+
+	const std::string key = "shared bytes";
+	const HeapRef r = appended(heap.appendPoint(9, asRef(key)), "the record is appended");
+	const uint8_t* a = pointAt(heap, r, "the first read").key.begin();
+	const uint8_t* b = pointAt(heap, r, "the second read").key.begin();
+
+	check(a == b, "two reads return the same address, so nothing is copied");
+	check(a != reinterpret_cast<const uint8_t*>(key.data()),
+		  "and it is the heap's own copy, not the caller's buffer");
+	end();
+}
+
+void manyRecordsRoundTripAcrossPages() {
+	begin("manyRecordsRoundTripAcrossPages");
+	PagePool pool(8);
+	TemporalHeap heap(pool);
+
+	struct Written {
+		HeapRef ref;
+		std::string key;
+		Version cv;
+	};
+	std::vector<Written> written;
+
+	// Varying sizes over several pages, versions non-decreasing as the contract requires.
+	for (int i = 0; i < 400; ++i) {
+		const std::string key(static_cast<size_t>(i % 37) * 29 + 1, char('a' + i % 26));
+		const Version cv = 100 + i / 10;
+		Optional<HeapRef> r = heap.appendPoint(cv, asRef(key));
+		if (!r.present()) {
+			break;
+		}
+		written.push_back({ r.get(), key, cv });
+	}
+	check(written.size() == 400, "every record was appended: they all fit in eight pages");
+	check(!written.empty() && written.back().ref.pageID > 1, "more than one page was used");
+
+	int intact = 0;
+	for (const Written& w : written) {
+		Optional<PointConflictView> v = heap.getPoint(w.ref);
+		if (v.present() && v.get().cv == w.cv && v.get().key == asRef(w.key)) {
+			++intact;
+		}
+	}
+	check(intact == static_cast<int>(written.size()), "every live record read back intact");
+	checkBudget(pool, "budget invariant after many appends");
+	end();
+}
