+// Reclaiming the expired child collapses the parent being scanned.
+void bitmapCleanupInternalCollapse() {
+    Tree tree(64, 0);
+    auto take = [&](bool leaf) {
+        Tree::Reservation r; tree.reserve(r, 1); return tree.take(r, leaf);
+    };
+    auto* left = take(true); auto* right = take(true);
+    // Heap records are appended in CV order, as a batch appends them, so that with heap keys (inline-only off, K0)
+    // each heap page's newest CV stays its age bound
+    const Tree::Entry rightEntry = tree.prepareWrite(1, sv(key(4)), {}, true);
+    const Tree::Entry leftEntry = tree.prepareWrite(3, sv(key(0)), {}, true);
+    tree.insertSlot(left, 0, leftEntry);
+    tree.insertSlot(right, 0, rightEntry);
+    tree.refresh(left); tree.refresh(right);
+    left->navigation.leaf.next = right; right->navigation.leaf.previous = left;
+    tree.firstLeaf_ = left;
+    auto* parent = take(false);
+    Tree::Entry a, b; a.payload.link.child = left; b.payload.link.child = right;
+    tree.insertSlot(parent, 0, a); tree.insertSlot(parent, 1, b);
+    tree.root_ = parent; tree.refresh(parent);
+    tree.validationMinRV_ = 1;
+    const bool changed = tree.purgeInsertionHead(parent);
+    if constexpr (PAGED_BTREE_BITMAP_CLEANUP != 0) {
+        CHECK(changed); CHECK(tree.root_ == left); CHECK(!parent->allocated);
+        CHECK(left->navigation.leaf.next == nullptr);
+    } else { CHECK(!changed); CHECK(tree.root_ == parent); }
+    verify(tree);
+}
