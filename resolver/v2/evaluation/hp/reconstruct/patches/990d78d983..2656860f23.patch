+// A reclamation inside a batch that the retired nodes satisfy: no CV-list candidate, no boundary move,
+// the batch stays open and its hints stay as they were
+void stableHintDrainSatisfiesWithoutAdvance() {
+    Tree tree(64, 0);
+    for (unsigned i = 0; i < 300; ++i) tree.addRange(1, sv(key(4 * i)), sv(key(4 * i + 2)));
+    std::vector<Tree::Node*> held;
+    while (tree.freeNodes_) held.push_back(tree.allocateNode());
+    std::vector<PoolPage*> pages;
+    while (auto* page = tree.pool_.tryAcquire(PageUse::Index)) pages.push_back(page);
+    Tree::Node* victim = middleLeaf(tree);
+    {
+        Tree::WriteBatchScope batch(tree);
+        tree.writeHints_.assign(2, Tree::LeafHint{tree.firstLeaf_, tree.firstLeaf_->incarnation});
+        while (victim->size()) tree.eraseSlot(victim, 0);
+        tree.removeEmpty(victim);
+        CHECK(!victim->allocated && retiredItems(tree) == std::vector<Tree::Node*>{victim} && tree.freeNodes_ == 0);
+        const Version floor = tree.validationMinRV();
+        const auto candidates = tree.stats().reclaimAgeCandidates;
+        const auto incarnation = victim->incarnation;
+        tree.reclaim(PageUse::Index);
+        CHECK(tree.freeNodes_ == 1 && !tree.retired_ && victim->incarnation == incarnation);
+        Tree::Node* again = tree.allocateNode();
+        CHECK(again == victim && victim->incarnation == incarnation + 1);
+        tree.recycleNode(again);
+        CHECK(tree.validationMinRV() == floor && tree.stats().reclaimAgeCandidates == candidates);
+        CHECK(tree.writeBatchActive_ && !tree.reclaiming_ && tree.writeHints_.size() == 2);
+        CHECK(tree.writeHints_[0].node == tree.firstLeaf_ && tree.writeHints_[0].incarnation == tree.firstLeaf_->incarnation);
+    }
+    CHECK(!tree.writeBatchActive_ && tree.writeHints_.empty());
+    for (auto* node : held) tree.recycleNode(node);
+    for (auto* page : pages) tree.pool_.release(page, PageUse::Index);
+    verify(tree);
+}
