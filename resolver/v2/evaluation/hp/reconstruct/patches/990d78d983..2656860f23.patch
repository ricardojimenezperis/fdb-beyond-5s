+void randomAgeOperations(unsigned seed) {
+    NodePage n(128);
+    auto& p = n.pool;
+    auto& l = n.links;
+    std::array<bool, 128> active{};
+    std::array<Version, 128> values{};
+    std::mt19937 random(seed);
+    uint64_t exceptionalSteps = 0;
+    for (unsigned step = 0; step < 20000; ++step) {
+        const unsigned i = random() % 128, j = random() % 128, op = random() % 5;
+        if (!active[i]) {
+            values[i] = 1 + random() % 10000;
+            p.raiseAge(l[i], values[i], PageUse::Index);
+            active[i] = true;
+        } else if (op == 0) {
+            values[i] += random() % 200;
+            p.raiseAge(l[i], values[i], PageUse::Index);
+        } else if (op == 1) {
+            values[i] -= random() % 100;
+            p.lowerNodeAgeAfterSplit(l[i], values[i]);
+        } else if (op == 2 && i != j && active[j]) {
+            values[i] = values[j];
+            p.inheritAge(l[i], l[j], PageUse::Index);
+        } else if (op == 3) {
+            values[i] += 10000 + random() % 100;
+            p.raiseAge(l[i], values[i], PageUse::Index);
+        } else {
+            p.unlinkAge(l[i]);
+            active[i] = false;
+            p.setDetachedNext(l[i], nullptr);
+            l[i]->maxCV = std::numeric_limits<Version>::lowest();
+        }
+        Version minimum = std::numeric_limits<Version>::max();
+        unsigned count = 0;
+        for (unsigned k = 0; k < 128; ++k) {
+            CHECK(l[k]->ageLinked == active[k]);
+            if (!active[k]) continue;
+            CHECK(l[k]->maxCV == values[k] && p.ageCV(l[k]) == values[k]);
+            minimum = std::min(minimum, values[k]);
+            ++count;
+        }
+        CHECK(bool(p.oldestAge()) == (count != 0));
+        if (count) CHECK(p.oldestAgeCV() == minimum);
+        exceptionalSteps += p.exceptionAgeCount() != 0;
+        if (step % 50 == 0) checkAges(p);
+    }
+    const auto& stats = p.exceptionAgeStats();
+    std::printf("[seed %u: insertions %llu removals %llu updates %llu swaps %llu peak %llu, steps with exceptions %llu] ", seed,
+                (unsigned long long)stats.insertions, (unsigned long long)stats.removals, (unsigned long long)stats.updates,
+                (unsigned long long)stats.swaps, (unsigned long long)stats.peak, (unsigned long long)exceptionalSteps);
+    CHECK(stats.insertions > 0 && stats.removals > 0 && stats.updates > 0 && stats.swaps > 0);
+    n.unlinkAll();
+    checkAges(p);
+}
+
+void randomAgeOperationsA() { randomAgeOperations(472); }
+void randomAgeOperationsB() { randomAgeOperations(9001); }
+
+Tree::MemoryConfig memoryFor(uint64_t, bool) { return {}; }
+
+void treeModel(uint64_t pages, unsigned seed, bool heapKeys, unsigned keyBytes) {
+    setThreadLocalDeterministicRandomSeed(seed);
+    Tree tree(pages, 0, memoryFor(pages, heapKeys));
+    constexpr unsigned domain = 32768;
+    std::vector<std::string> keys(domain + 1);
+    for (unsigned i = 0; i <= domain; ++i) {
+        keys[i] = key(i);
+        if (keyBytes > 8) keys[i] += std::string(keyBytes - 8, char('a' + i % 26));
+    }
+    std::vector<Version> oracle(domain, 0);
+    std::mt19937 random(seed);
+    uint64_t checks = 0, heapAges = 0, exceptionBatches = 0;
+    const Tree::Node* previousRoot = nullptr;
+    uint64_t rootChanges = 0;
+    for (Version batch = 1; batch <= 1600; ++batch) {
+        std::array<Tree::Write, 48> writes;
+        std::array<std::pair<unsigned, unsigned>, 48> ranges;
+        for (unsigned w = 0; w < writes.size(); ++w) {
+            const unsigned a = random() % (domain - 32), b = a + 1 + random() % 8;
+            ranges[w] = { a, b };
+            writes[w] = Tree::Write{ sv(keys[a]), sv(keys[b]), ConflictKind::Range };
+        }
+        const Version floorBefore = tree.validationMinRV();
+        tree.addWrites(batch, writes.data(), writes.size());
+        CHECK(tree.validationMinRV() < batch && tree.validationMinRV() >= floorBefore);
+        for (auto [a, b] : ranges)
+            for (unsigned p = a; p < b; ++p) oracle[p] = batch;
+        const AgeSnapshot snapshot = checkAges(tree.pool_);
+        exceptionBatches += !snapshot.exceptions.empty();
+        uint64_t heapLinks = 0;
+        tree.pool_.forEachAge([&](const ReclaimLink* link) { heapLinks += link->ageUse == PageUse::Heap; });
+        CHECK(heapLinks == tree.keyBlockCount() && tree.budget().heapPages == 0);
+        heapAges += heapLinks;
+        if (tree.root_ != previousRoot) ++rootChanges;
+        previousRoot = tree.root_;
+        for (unsigned q = 0; q < 64; ++q) {
+            const unsigned a = random() % (domain - 64), b = a + 1 + random() % 64;
+            const Version floor = tree.validationMinRV();
+            const Version readVersion = floor + Version(random() % uint64_t(batch - floor + 1));
+            bool expected = false;
+            for (unsigned p = a; p < b; ++p) expected |= oracle[p] > readVersion;
+            CHECK(tree.hasConflict(readVersion, sv(keys[a]), sv(keys[b])) == expected);
+            ++checks;
+        }
+    }
+    const auto& stats = tree.pool_.exceptionAgeStats();
+    std::printf("[pages=%llu heapKeys=%d floor=%lld splits=%llu merges=%llu heapAgeSamples=%llu exceptionBatches=%llu "
+                "insertions=%llu updates=%llu peak=%llu rootChanges=%llu checks=%llu] ",
+                (unsigned long long)pages, int(heapKeys), (long long)tree.validationMinRV(),
+                (unsigned long long)tree.stats().splits, (unsigned long long)tree.stats().merges, (unsigned long long)heapAges,
+                (unsigned long long)exceptionBatches, (unsigned long long)stats.insertions, (unsigned long long)stats.updates,
+                (unsigned long long)stats.peak, (unsigned long long)rootChanges, (unsigned long long)checks);
+    if (pages <= 16) CHECK(tree.validationMinRV() > 0 && stats.insertions > 0);
+    if ((heapKeys || Tree::InlineKeyBytes < 8) && pages <= 16) CHECK(heapAges > 0);
+}
+
+void treeModelInlineSmall() { treeModel(4, 17, false, 8); }
+void treeModelInlineMedium() { treeModel(16, 18, false, 8); }
+void treeModelInlineLarge() { treeModel(128, 19, false, 8); }
+void treeModelHeapKeysSmall() {
+    if (Tree::InlineOnlyKeys) treeModel(4, 23, false, 8);
+    else treeModel(8, 23, true, Tree::InlineKeyBytes + 24);
+}
+void treeModelHeapKeysMedium() {
+    if (Tree::InlineOnlyKeys) treeModel(16, 24, false, 8);
+    else treeModel(16, 24, true, Tree::InlineKeyBytes + 24);
+}
