+void consecutiveReleasesThenSplit() {
+    Tree tree(64, 0, memoryFor(64, false));
+    tree.configureFictitiousLeaves(reserveConfig(R));
+    std::vector<std::string> keys(80);
+    for (unsigned i = 0; i < 80; ++i) keys[i] = key(1000 + 10 * i);
+    const unsigned initial = Tree::Capacity - R;
+    Version cv = 10000000;
+    for (unsigned i = 0; i < initial; ++i) {
+        Tree::Write w{ sv(keys[2 * i]), sv(keys[2 * i + 1]), ConflictKind::Range };
+        tree.addWrites(++cv, &w, 1);
+    }
+    CHECK(tree.root_->leaf && tree.root_->size() == initial && tree.root_->fict.fictitious == R && tree.root_->critical);
+    for (unsigned i = initial; i < Tree::Capacity; ++i) {
+        Tree::Write w{ sv(keys[2 * i]), sv(keys[2 * i + 1]), ConflictKind::Range };
+        tree.addWrites(++cv, &w, 1);
+        CHECK(tree.root_->leaf && tree.root_->size() == i + 1 && tree.root_->fict.fictitious == Tree::Capacity - i - 1);
+        CHECK(tree.validationMinRV() == 0 && tree.stats().fictitiousSplits == 0);
+        checkTree(tree);
+    }
+    CHECK(tree.stats().fictitiousReleased == R && tree.root_->critical && !tree.root_->fict.fictitious);
+    Tree::Write w{ sv(keys[2 * Tree::Capacity]), sv(keys[2 * Tree::Capacity + 1]), ConflictKind::Range };
+    tree.addWrites(++cv, &w, 1);
+    CHECK(!tree.root_->leaf && tree.leafCount() == 2 && tree.stats().fictitiousSplits == 1);
+    const Tree::Node* left = tree.firstLeaf_;
+    const Tree::Node* right = left->navigation.leaf.next;
+    CHECK(left->size() + right->size() == Tree::Capacity + 1 && left->fict.fictitious + right->fict.fictitious == R);
+    CHECK(left->size() + left->fict.fictitious < Tree::Capacity && right->size() + right->fict.fictitious < Tree::Capacity);
+    checkTree(tree);
+}
