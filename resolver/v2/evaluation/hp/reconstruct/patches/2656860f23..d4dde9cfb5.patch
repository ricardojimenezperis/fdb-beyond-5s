+    CHECK(copy.validationMinRV() == tree.validationMinRV() && copy.nodeCount() == tree.nodeCount() && copy.leafCount() == tree.leafCount());
+    CHECK(copy.lastWriteCV_ == tree.lastWriteCV_ && copy.inlineIdentity_ == tree.inlineIdentity_);
