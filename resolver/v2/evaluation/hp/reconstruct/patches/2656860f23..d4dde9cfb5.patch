+    for i in range(counts[0]):
+        (nid, inc, level, parent, pslot, prank, size, occupied, rhead, cursor, critical, ccrit, stored, age, cmax, cmin, linked, exc, pinit, plen) = r.take('IIHIBBBIBBBBqqqqBB BB'.replace(' ', ''))
