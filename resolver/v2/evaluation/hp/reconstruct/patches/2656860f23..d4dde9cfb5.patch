+                (unsigned long long)a.internalNodes, (unsigned long long)a.ageExceptions, (unsigned long long)a.bytes);
+}
+
+void roundTrip(uint64_t pages, unsigned seed) {
+    if (!Tree::InlineOnlyKeys) return;
+    setThreadLocalDeterministicRandomSeed(seed);
+    Tree tree(pages, 0, Tree::MemoryConfig{ 0, pages, 10 });
+    std::vector<std::string> keys(32769);
+    for (unsigned i = 0; i <= 32768; ++i) keys[i] = key(i);
+    std::mt19937 random(seed);
+    for (Version batch = 1; batch <= 1200; ++batch) {
+        std::array<Tree::Write, 48> writes;
+        for (auto& w : writes) {
+            const unsigned a = random() % 32700, b = a + 1 + random() % 8;
+            w = Tree::Write{ sv(keys[a]), sv(keys[b]), ConflictKind::Range };
+        }
+        tree.addWrites(batch, writes.data(), writes.size());
+    }
+    TreeStateCapture capture;
+    std::ostringstream first;
+    TreeStateExporter::write(tree, first, capture);
+    Tree copy(pages, 0, Tree::MemoryConfig{ 0, pages, 10 });
+    std::istringstream in(first.str());
+    const auto loaded = TreeStateExporter::load(copy, in, {});
