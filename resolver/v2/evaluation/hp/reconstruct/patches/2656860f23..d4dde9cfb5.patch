new file mode 100755
index 0000000000000000000000000000000000000000..19b752323f4e1ffd9b90154152f639814bad14b0
--- /dev/null
+++ b/fdbserver/resolver/btree/synthetic-profiles-to-bin.py
@@ -0,0 +1,25 @@
+import re
+import struct
+import sys
+
+src, dst = sys.argv[1], sys.argv[2]
+text = open(src).read()
+capacity = int(re.search(r'capacity = (\d+);', text).group(1))
+window = int(re.search(r'window = (-?\d+);', text).group(1))
+offsets = [int(x) for x in re.search(r'offsets\[\] = \{([^}]*)\}', text).group(1).split(',')]
+weights = [int(x) for x in re.search(r'weights\[\] = \{([^}]*)\}', text).group(1).split(',')]
+body = text[text.index('profiles[][23] = {') + len('profiles[][23] = {'):]
+body = body[:body.index('\n};')]
+rows = re.findall(r'\{([^}]*)\}', body)
+assert len(rows) == offsets[-1], (len(rows), offsets[-1])
+with open(dst, 'wb') as f:
+    f.write(b'BY5PROF1')
+    f.write(struct.pack('<Iq', capacity, window))
+    f.write(struct.pack(f'<{capacity + 1}I', *offsets))
+    f.write(struct.pack(f'<{capacity + 1}I', *weights))
+    f.write(struct.pack('<Q', len(rows)))
+    for r in rows:
+        v = [int(x) for x in r.split(',')]
+        assert len(v) == capacity
+        f.write(struct.pack(f'<{capacity}q', *v))
+print(capacity, window, len(rows))
