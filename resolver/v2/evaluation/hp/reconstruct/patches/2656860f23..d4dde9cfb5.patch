+        if (x.cv != y.cv || x.begin.pageID != y.begin.pageID || x.begin.offset != y.begin.offset || x.begin.length != y.begin.length) return false;
+        if (x.end.pageID != y.end.pageID || x.end.offset != y.end.offset || x.end.length != y.end.length) return false;
+        if (std::memcmp(x.beginInline.data(), y.beginInline.data(), std::min<size_t>(Tree::InlineKeyBytes, x.begin.length))) return false;
+        if (leaf) return true;
+        return x.payload.link.firstCV == y.payload.link.firstCV;
+    };
+    uint64_t compared = 0;
+    for (auto *x = tree.firstLeaf_, *y = copy.firstLeaf_; x || y; x = x->navigation.leaf.next, y = y->navigation.leaf.next) {
+        CHECK(x && y && x->size() == y->size() && x->maxCV == y->maxCV && x->critical == y->critical && x->parentSlot == y->parentSlot);
+        CHECK(x->occupied == y->occupied && x->incarnation == y->incarnation);
+        for (unsigned r = 0; r < x->size(); ++r) {
+            CHECK(x->order.slotAt(r) == y->order.slotAt(r) && sameEntry(x->at(r), y->at(r), true));
+            ++compared;
+        }
+    }
+    std::vector<std::pair<const Tree::Node*, const Tree::Node*>> queue{ { tree.root_, copy.root_ } };
+    for (size_t i = 0; i < queue.size(); ++i) {
+        auto [x, y] = queue[i];
