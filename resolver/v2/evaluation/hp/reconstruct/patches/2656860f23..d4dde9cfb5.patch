+    std::istringstream in2(second.str());
+    TreeStateExporter::load(copy2, in2, {});
+    std::ostringstream third;
+    TreeStateExporter::write(copy2, third, capture);
+    const std::string a = second.str(), b = third.str();
+    const size_t statsAt = a.rfind("STAT");
+    CHECK(a.size() == b.size() && statsAt != std::string::npos && a.compare(0, statsAt, b, 0, statsAt) == 0);
