+    for (unsigned i = 0; i <= 32768; ++i) keys[i] = key(i);
+    std::mt19937 random(seed);
+    for (Version batch = 1; batch <= 1200; ++batch) {
+        std::array<Tree::Write, 48> writes;
+        for (auto& w : writes) {
+            const unsigned a = random() % 32700, b = a + 1 + random() % 8;
+            w = Tree::Write{ sv(keys[a]), sv(keys[b]), ConflictKind::Range };
+        }
+        tree.addWrites(batch, writes.data(), writes.size());
+    }
+    const auto statsBefore = tree.stats();
+    const Version floor = tree.validationMinRV();
+    const uint64_t nodes = tree.nodeCount(), leaves = tree.leafCount(), peek = deterministicRandom()->peek();
+    TreeStateCapture capture;
+    capture.rngPeek = peek;
+    std::ostringstream first, second;
+    const auto a = TreeStateExporter::write(tree, first, capture);
+    const auto b = TreeStateExporter::write(tree, second, capture);
+    CHECK(std::memcmp(&statsBefore, &tree.stats(), sizeof(statsBefore)) == 0);
+    CHECK(tree.validationMinRV() == floor && tree.nodeCount() == nodes && tree.leafCount() == leaves);
+    CHECK(deterministicRandom()->peek() == peek);
+    CHECK(first.str() == second.str() && a.hash == b.hash && a.bytes == first.str().size());
+    const std::string bytes = first.str();
+    CHECK(bytes.compare(0, 8, std::string("BY5TREE\0", 8)) == 0 && field(bytes, 8, 4) == 1);
+    CHECK(int64_t(field(bytes, 12, 8)) == floor);
+    CHECK(a.leaves == leaves && a.internalNodes + a.leaves == nodes);
+    CHECK(a.ageMain + a.ageExceptions == nodes);
+    uint64_t entries = 0, expired = 0;
+    for (auto* x = tree.firstLeaf_; x; x = x->navigation.leaf.next)
